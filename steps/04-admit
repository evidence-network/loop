    finding.outside("the adjudication Results as stand-ins of step 09's adjudication_issued", "Mesh-LLM/capsules-plugin#58"),
    finding.outside("the controller declaration's format, a rehearsal stand-in", "Mesh-LLM/capsules-plugin#69"),
