def load(path):
    return json.loads(Path(path).read_text(encoding="utf-8"))


def sha256(data):
    return hashlib.sha256(data).hexdigest()


def capsulectl():
    if os.environ.get("CAPSULECTL"):
        return Path(os.environ["CAPSULECTL"])
    return Path(os.environ.get("LOOP_TOOLS", Path.home() / ".cache/evidence-network-loop")) / "bin/capsulectl"


def stamp(t):
    return t.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# --- The buyer's book ---------------------------------------------------------
class Book:
    """bob's book: a capsulectl profile signed with bob's TEST key, in a temporary home."""

    def __init__(self, home, key_pem, capsulectl_bin, name="bob"):
        self.home, self.bin, self.name = Path(home), Path(capsulectl_bin), name
        self.home.mkdir(parents=True, exist_ok=True)
        seed = self.home / "node.seed"
        seed.write_text(book_keys.seed_hex(key_pem) + "\n")
        seed.chmod(0o600)
        self.key = book_keys.pub_hex(key_pem)
        cp = json.loads(self.cap("key", "generate", "--output", str(self.home / "checkpoint.seed")).stdout)
        self.cap("profile", "create", "--name", name, "--type", "jsonl", "--jsonl-path", str(self.home / "store"),
                 "--log-id", f"{name}-book", "--operator", name, "--trusted-key", self.key,
                 "--signing-key-file", str(seed), "--checkpoint-signing-key-file", str(self.home / "checkpoint.seed"),
                 "--checkpoint-trusted-key", cp["public_key"])
        self.cap("store", "init", "--profile", name)
        self.n = 0

    def cap(self, *args):
        env = dict(os.environ, XDG_CONFIG_HOME=str(self.home / "config"),
                   CAPSULECTL_PLUGIN_ROOTS=os.environ.get("CAPSULECTL_PLUGIN_ROOTS", str(self.bin.parent)))
        r = subprocess.run([str(self.bin), *args], env=env, capture_output=True, text=True)
        if r.returncode != 0:
            raise RuntimeError(f"capsulectl {' '.join(args[:3])}: {r.stderr.strip() or r.stdout.strip()}")
        return r

    def seal(self, action_id, payload, cites=()):
        """Seal one record whose payload is `payload`, citing `cites`; its capsule_id."""
        self.n += 1
        refs = [{"Type": "agent-action-capsule", "DigestAlg": "SHA-256", "Digest": c, "CitationPurpose": "acted_on"}
                for c in cites]
        req = {"spec_version": "capsule-seal-request/v1",
               "capsule": {"ActionID": action_id, "ActionType": "fyi", "Operator": self.name,
                           "Developer": "loop-step04-admit", "Timestamp": stamp(dt.datetime.now(dt.timezone.utc)),
                           **({"References": refs} if refs else {})},
               "payload": payload}
        p = self.home / f"req-{self.n}.json"
        p.write_text(json.dumps(req))
        r = self.cap("book", "publish", "--profile", self.name, "--request", str(p))
        return json.loads(r.stdout.strip().splitlines()[-1])["capsule_id"]

    def checkpoint(self):
        self.cap("book", "cll", "checkpoint", "create", "--profile", self.name)

    def disclose(self, root, out):
        Path(out).unlink(missing_ok=True)
        self.cap("disclose", "--profile", self.name, "--root", root, "--out", str(out))


# --- Inputs -------------------------------------------------------------------
def node_keys(pop_dir):
    pop = load(Path(pop_dir) / "population.json")
    keys = {}
    for n in pop["nodes"]:
        kd = Path(n["key_dir"])
        keys[n["name"]] = (kd if kd.is_absolute() else ROOT / kd) / "node-key.pem"
    for need in ("alice", "bob"):
        if need not in keys:
            raise KeyError(f"{pop_dir}: no node named {need}")
    return pop["population"], keys


# --- The buyer: decide and seal ------------------------------------------------
def decide(pack, digest, offer, offer_digest, seller, buyer, plant=None):
    """The decision payload the buyer seals (one planted failure applied, when named)."""
    d = terms.evaluate(pack, offer)
    if plant == "go-over-bound":
        d["outcome"] = "GO"
    if plant == "ask-outcome":
        d["outcome"] = "ASK"
    if plant == "limit-outcome":
        d["outcome"] = "LIMIT"
    if plant == "digest-mismatch":
        digest = sha256(b"another pack")
    return {"kind": DECISION, "pack": {"id": pack["pack"], "version": pack["version"], "digest": digest},
            "deal_id": offer["deal_id"], "seller_key": seller, "buyer_key": buyer, "offer_digest": offer_digest, **d}


def deal_payload(offer, seller, buyer):
    return {"kind": DEAL, "deal_id": offer["deal_id"], "seller_key": seller, "buyer_key": buyer, "role": "buyer"}


def run_buyer(book, default_terms, scenarios, seller, out, plant=None):
    for name, d in scenarios:
        sd = out / "scenarios" / name
        sd.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(d / "offer.json", sd / "offer.json")
        shutil.copyfile(d / "terms.json" if (d / "terms.json").is_file() else default_terms, sd / "terms.json")
        pack, digest = terms.load(sd / "terms.json")
        offer = load(sd / "offer.json")
        p = plant if PLANT_SCENARIO.get(plant) == name else None
        decision = decide(pack, digest, offer, sha256((sd / "offer.json").read_bytes()), seller, book.key, plant=p)
        deal_id = f"deal/{offer['deal_id']}"
        if p == "unsealed":
            (sd / "unsealed-decision.json").write_text(json.dumps(decision, indent=2, sort_keys=True) + "\n")
            root = book.seal(deal_id, deal_payload(offer, seller, book.key))
        elif p == "sealed-after":
            first = book.seal(deal_id, deal_payload(offer, seller, book.key))
            root = book.seal(f"admission/{offer['deal_id']}", decision, cites=[first])
        else:
            dec = book.seal(f"admission/{offer['deal_id']}", decision)
            root = dec
            if decision["outcome"] == "GO":
                root = book.seal(deal_id, deal_payload(offer, seller, book.key), cites=[dec])
            elif p == "deal-after-no":
                book.seal(deal_id, deal_payload(offer, seller, book.key), cites=[dec])
        (sd / "root.txt").write_text(root + "\n")
    book.checkpoint()
    for name, _ in scenarios:
        sd = out / "scenarios" / name
        book.disclose((sd / "root.txt").read_text().strip(), sd / "bundle.json")


# --- The judge ----------------------------------------------------------------
def verify_bundle(bin_, home, bundle_path):
    """capsulectl's verdict on a bundle, offline, from the file alone (a fresh config home)."""
    r = subprocess.run([str(bin_), "book", "verify", "--bundle", str(bundle_path)], capture_output=True, text=True,
                       env=dict(os.environ, XDG_CONFIG_HOME=str(Path(home) / "verifier"),
                                CAPSULECTL_PLUGIN_ROOTS=os.environ.get("CAPSULECTL_PLUGIN_ROOTS", str(Path(bin_).parent))))
    try:
        return json.loads(r.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return {"verdict": "UNREADABLE", "stderr": r.stderr.strip()}


def mmr_leaves(size):
    """The number of leaves of a Merkle mountain range of `size` nodes, or None when no count gives that size."""
    for n in range(size + 1):
        if 2 * n - bin(n).count("1") == size:
            return n
    return None


def to_the_checkpoint(bundle):
    """(ok, detail): the bundle holds every record from its first to the last one under its checkpoint."""
    cert, size = bundle.get("completeness_certificate") or {}, (bundle.get("checkpoint") or {}).get("mmr_size")
    rp = cert.get("range_proof") or {}
    leaves = mmr_leaves(size) if isinstance(size, int) else None
    ok = ((bundle.get("completeness") or {}).get("records_mode") == "complete" and leaves is not None
          and rp.get("size") == size and rp.get("to_index") == leaves - 1)
    return ok, f"records complete through leaf {rp.get('to_index')} of the checkpoint's {leaves}"


def when(t):
    """A record's commit time as a datetime (the fraction's length is not fixed)."""
    return dt.datetime.fromisoformat(t.replace("Z", "+00:00"))


def judge(sd, verdict, buyer):
    """[{check, ok, detail}] for one scenario's proof bytes, and the sealed decision (or None)."""
    checks = []

    def check(name, ok, detail):
        checks.append({"check": name, "ok": bool(ok), "detail": detail})

    bundle = load(sd / "bundle.json")
    status = {x["capsule_id"]: x["status"] for x in verdict.get("disclosures", [])}
    records = {r["capsule_id"]: r for r in bundle.get("records", [])}
    disclosed = {cid: (v or {}).get("agent_input") for cid, v in (bundle.get("disclosures") or {}).items()}
    check("bundle_verifies", verdict.get("verdict") == "VALID", f"capsulectl verify --bundle: {verdict.get('verdict')}")
    offer = load(sd / "offer.json")

    def find(kind):
        hits = [cid for cid, p in disclosed.items() if isinstance(p, dict) and p.get("kind") == kind
                and p.get("deal_id") == offer["deal_id"] and status.get(cid) == "disclosure_match"
                and records.get(cid, {}).get("key_id") == buyer]
        return hits[0] if len(hits) == 1 else None

    dec_id = find(DECISION)
    check("decision_sealed", dec_id is not None, "the decision is in the buyer's book, signed by its key, disclosed "
          "and matched" if dec_id else "no sealed admission decision for this deal in the buyer's book")
    if dec_id is None:
        return checks, None
    dec = disclosed[dec_id]
    check("one_outcome", dec.get("outcome") in terms.OUTCOMES, f"outcome {dec.get('outcome')!r}")
    pack_bytes = (sd / "terms.json").read_bytes()
    check("pack_digest", (dec.get("pack") or {}).get("digest") == sha256(pack_bytes),
          f"the decision names pack digest {str((dec.get('pack') or {}).get('digest'))[:16]}…, the pack's bytes "
          f"hash to {sha256(pack_bytes)[:16]}…")
    check("offer_named", dec.get("offer_digest") == sha256((sd / "offer.json").read_bytes()),
          "the decision names the digest of the offer it read")
    pack, _ = terms.load(sd / "terms.json")
    want = terms.evaluate(pack, offer)
    diff = sorted(k for k in want if dec.get(k) != want[k])
    unmet = [r["id"] for r in want["rules"] if r["verdict"] == "unmet"]
    check("follows_terms", not diff, f"rule by rule as the pack gives on the offer ({want['outcome']}"
          f"{': unmet ' + ', '.join(unmet) if unmet else ''})" if not diff
          else f"differs from the pack in {', '.join(diff)} (expected {want['outcome']}"
               f"{': unmet ' + ', '.join(unmet) if unmet else ''})")
    citing = [cid for cid, r in records.items() if cid != dec_id and dec_id in json.dumps(r)]
    if dec.get("outcome") == "GO":
        deal_id = find(DEAL)
        check("deal_sealed", deal_id is not None, "the buyer's deal record is in the bundle, signed by the buyer's key"
              if deal_id else "no single deal record signed by the buyer, disclosed and matched")
        if deal_id is not None:
            dh, kh = records[dec_id]["evidence_record_header"], records[deal_id]["evidence_record_header"]
            check("sealed_before_deal", dh["seq"] < kh["seq"] and when(dh["committed_at"]) < when(kh["committed_at"]),
                  f"decision at seq {dh['seq']} ({dh['committed_at']}), deal at seq {kh['seq']} ({kh['committed_at']})")
            cites = [ln["target"] for ln in kh.get("links", []) if ln.get("type") == "cites"]
            check("deal_cites_decision", dec_id in cites, f"the deal record cites {len(cites)} records")
    else:
        complete, why = to_the_checkpoint(bundle)
        check("no_deal_after_no", complete and not citing and find(DEAL) is None,
              f"{why}; {len(citing)} records cite the decision")
    return checks, dec


def main_rehearsal(pop_dir, out, started, default_terms, plant=None):
    bin_ = capsulectl()
    if not bin_.is_file():
        print(f"04-admit: {bin_} is not installed; run steps/04-admit.setup.sh", file=sys.stderr)
        return 2
    population, keys = node_keys(pop_dir)
    step04 = Path(pop_dir) / "step04"
    scenarios = sorted((d.name, d) for d in (step04 / "scenarios").iterdir() if d.is_dir())
    for _, d in scenarios:
        terms.load(d / "terms.json" if (d / "terms.json").is_file() else default_terms)
    for f in ("finding.json", "checks.json", "counts.json"):
        (out / f).unlink(missing_ok=True)
    shutil.rmtree(out / "scenarios", ignore_errors=True)
    seller = book_keys.pub_hex(keys["alice"])
    with tempfile.TemporaryDirectory(prefix="04-admit-") as tmp:
        book = Book(Path(tmp) / "bob", keys["bob"], bin_)
        run_buyer(book, default_terms, scenarios, seller, out, plant=plant)
        # The judge reads only the proof files in out.
        results, proof, outcomes = {}, [], {}
        for name, _ in scenarios:
            sd = out / "scenarios" / name
            verdict = verify_bundle(book.bin, book.home, sd / "bundle.json")
            (sd / "verify.json").write_text(json.dumps(verdict, indent=2, sort_keys=True) + "\n")
            checks, dec = judge(sd, verdict, book.key)
            results[name] = checks
            if dec is not None:
                outcomes[name] = dec.get("outcome")
            proof += [f"scenarios/{name}/{f}" for f in ("bundle.json", "verify.json", "offer.json", "terms.json")]
    (out / "checks.json").write_text(json.dumps(results, indent=2, sort_keys=True) + "\n")
    refused = sorted(n for n, o in outcomes.items() if o == "NO")
    counts = {"decisions": len(outcomes), "refused": len(refused),
              "by_outcome": {o: sum(1 for x in outcomes.values() if x == o) for o in terms.OUTCOMES}}
    (out / "counts.json").write_text(json.dumps(counts, indent=2, sort_keys=True) + "\n")
    proof += ["checks.json", "counts.json"]
    failed = [f"{n}: {c['check']} ({c['detail']})" for n, cs in results.items() for c in cs if not c["ok"]]
    if failed:
        finding.write(out, result="FAIL", population=population, asserts=ASSERTS, pinned=PINNED, proof=proof,
                      detail=f"did not hold: {'; '.join(failed)}. {NO_SPEND}", started=started)
        return 0
    by = ", ".join(f"{n} {o}" for n, o in sorted(outcomes.items()))
    detail = (f"{len(outcomes)} admission decisions sealed in bob's book (TEST key), each GO before the deal record "
              f"that cites it and each NO with no deal record citing it up to the checkpoint: {by}. For each, "
              f"capsulectl found the bundle VALID and the judge recomputed the decision rule by rule from the pack "
              f"whose digest it names (scenarios/*/terms.json; go-adjusted runs under an operator's adjusted pack) "
              f"and found every check held (checks.json); {len(refused)} of {len(outcomes)} decisions refused on "
              f"terms. {NO_SPEND} {GAPS}")
    finding.write(out, result="PASS", population=population, asserts=ASSERTS, pinned=PINNED, proof=proof,
                  detail=detail, started=started)
    return 0


# --- Live ----------------------------------------------------------------------
# The pinned plugin's admission hook decides GO or NO from the operator's allow and deny lists and seals an
# admission_decision block in the node's own ledger before the exchange (capsules-plugin admission.rs).
# The step reads those blocks, read-only, and checks their shape; it evaluates no Terms Pack.
LIVE_NOT_CHECKED = [
    {"what": "the five base-policy rows (identity, key age, performed-and-settled, disputes, corroboration) sealed "
             "with each decision",
     "why": "the pinned plugin seals the verdict, its source and the operator policy it read, and no rows",
     "issue": "Mesh-LLM/capsules-plugin#116"},
    {"what": "each record's signature, and that each decision precedes the exchange record it admits",
     "why": "the step reads the node's ledger lines as written; it neither verifies their signatures nor pairs a "
            "decision with an exchange record",
     "issue": "evidence-network/loop: the live lab run, which fills population/live"},
    {"what": "the routing path enforcing the decision when it chooses a candidate",
     "why": "the routing choice cannot yet require a property of a candidate beyond its identity",
     "issue": "Mesh-LLM/mesh-llm#2061"},
]
VERDICTS = ("GO", "NO")
LIVE_GAPS = " ".join([
    finding.outside("the five base-policy rows sealed with each decision", "Mesh-LLM/capsules-plugin#116"),
    finding.outside("the routing path enforcing the decision when it chooses a candidate", "Mesh-LLM/mesh-llm#2061"),
])


ABSENT = object()
HEX64 = re.compile(r"^[0-9a-f]{64}$")
KEYS = {"peer_commitment", "verdict", "source", "reads", "request_id", "attempt", "model"}


def decision_block(ln):
    """The admission_decision member of one ledger line (None when sealed as null), or ABSENT."""
    try:
        return json.loads(ln)["model_attestation"]["compute_attestation"][DECISION]
    except (ValueError, KeyError, TypeError):
        return ABSENT


def digest_ok(d):
    return isinstance(d, dict) and set(d) == {"alg", "digest"} and d["alg"] == "SHA-256" \
        and isinstance(d["digest"], str) and bool(HEX64.match(d["digest"]))


def block_problems(blk):
    """Why a sealed admission_decision block is not the shape the plugin promises; [] when it is."""
    if not isinstance(blk, dict):
        return ["not an object"]
    errs = []
    if blk.get("verdict") not in VERDICTS:
        errs.append(f"verdict {blk.get('verdict')!r} is not GO or NO")
    if not (isinstance(blk.get("source"), str) and blk["source"]):
        errs.append("no source")
    if sorted(set(blk) - KEYS):
        errs.append(f"unexpected members {', '.join(sorted(set(blk) - KEYS))}")
    reads = blk.get("reads")
    # Exactly the one operator-policy read the pinned plugin writes; a pin that adds reads (capsules-plugin#116)
    # extends this check with it.
    pol = reads[0] if isinstance(reads, list) and len(reads) == 1 and isinstance(reads[0], dict) else {}
    # With no readable operator policy the plugin seals a NO and no digest, whether the policy or the target
    # was unreadable first; every other decision cites the policy's digest.
    unread = blk.get("source") in ("unreadable_policy", "unreadable_target") and blk.get("verdict") == "NO" \
        and pol.get("digest") is None
    if pol.get("kind") != "operator_policy" or set(pol) != {"kind", "policy", "digest"} \
            or not (unread or digest_ok(pol.get("digest"))):
        errs.append("reads does not cite the operator policy by digest")
    pc = blk.get("peer_commitment", ABSENT)
    if not (pc is None or digest_ok(pc)):
        errs.append("peer_commitment is missing or not a commitment")
    return errs


def node_decisions(data_dir):
    """([(line, block)], [problem], total) over the node's ledger lines that carry an admission decision;
    None when the ledger file cannot be read."""
    found, problems, total = [], [], 0
    try:
        lines = (data_dir / "ledger" / "capsules.jsonl").read_text(encoding="utf-8").splitlines()
    except OSError:
        return None
    for ln in lines:
        if not ln.strip():
            continue
        total += 1
        blk = decision_block(ln) if DECISION in ln else ABSENT
        if blk is ABSENT:
            continue
        found.append((ln, blk))
        problems += [f"record {total}: {e}" for e in block_problems(blk)]
    return found, problems, total


def main_live(pop, out, started):
    out.mkdir(parents=True, exist_ok=True)
    (out / "finding.json").unlink(missing_ok=True)
    details, not_checked, proof, problems, decided, unreadable = [], list(LIVE_NOT_CHECKED), [], [], 0, False
    for entry in pop["nodes"]:
        name = entry["name"]
        data_dir = live.readable(entry, "data_dir", "ledger")
        if data_dir is None:
            not_checked.append(live.not_checked(name, "data_dir"))
            details.append(f"node {name}: data_dir not set or unreadable")
            unreadable = True
            continue
        read = node_decisions(data_dir)
        if read is None:
            not_checked.append(live.not_checked(name, "ledger"))
            details.append(f"node {name}: ledger not readable")
            unreadable = True
            continue
        found, bad, total = read
        by = {v: sum(1 for _, b in found if isinstance(b, dict) and b.get("verdict") == v) for v in VERDICTS}
        details.append(f"node {name}: {len(found)} of {total} ledger records carry an admission decision "
                       f"({by['GO']} GO, {by['NO']} NO), read-only")
        problems += [f"node {name} {b}" for b in bad]
        decided += len(found)
        if found:
            (out / name).mkdir(exist_ok=True)
            (out / name / "decisions.jsonl").write_text("".join(ln + "\n" for ln, _ in found), encoding="utf-8")
            proof.append(f"{name}/decisions.jsonl")
    base = dict(population=pop["population"], asserts=ASSERTS_LIVE, pinned=LIVE_PINNED, started=started)
    summary = "; ".join(details)
    if problems:
        finding.write(out, result="FAIL", proof=proof, not_checked=[],
                      detail=f"{summary}. Did not hold: {'; '.join(problems)}. {NO_SPEND}", **base)
    elif decided and not unreadable:
        finding.write(out, result="PASS", proof=proof, not_checked=[],
                      detail=f"{summary}. Each decision is GO or NO, names its source, cites the operator policy it "
                             f"read by digest (or is a NO sealed with no readable policy), carries no member beyond the plugin's own and "
                             f"names the peer by commitment only; the step read the ledger lines "
                             f"as written, without verifying their signatures. {NO_SPEND} {LIVE_GAPS}", **base)
    else:
        gap = {"what": "an admission decision on a lab node",
               "why": "no ledger record carries one yet; no exchange with a peer has been admitted or refused",
               "issue": "evidence-network/loop: the live lab run, which fills population/live"}
        finding.write(out, result="NOT_CHECKED", proof=proof, not_checked=not_checked + ([] if decided else [gap]),
                      detail=f"{summary}. Not checked: "
                             f"{'a node could not be read' if decided else 'no admission decision was found'}. "
                             f"{NO_SPEND}", **base)
    return 0


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--population", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--terms", default=str(terms.DEFAULT),
                    help="the operator's Terms Pack (default: steps/04-admit.d/terms-pack.json)")
    ap.add_argument("--plant", choices=PLANTS, help="seal one wrong decision (tests only)")
    a = ap.parse_args(argv)
    started = finding.now()
    out = Path(a.out)
    out.mkdir(parents=True, exist_ok=True)
    pop = load(Path(a.population) / "population.json")
    if pop["population"] == "live":
        return main_live(pop, out, started)
    try:
        terms.load(a.terms)
    except (OSError, ValueError) as e:
        print(f"04-admit: --terms {a.terms}: {e}", file=sys.stderr)
        return 2
    return main_rehearsal(Path(a.population), out, started, Path(a.terms), plant=a.plant)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
