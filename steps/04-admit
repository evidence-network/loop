            "evidencebook-skills",
     "issue": "action-state-group/evidencebook-skills#51"},
]


def decision_records(data_dir):
    """How many records in the node's own ledger carry an admission decision member, and how many records."""
    n = total = 0
    try:
        lines = (data_dir / "ledger" / "capsules.jsonl").read_text(encoding="utf-8").splitlines()
    except OSError:
        return 0, 0
    for ln in lines:
        if not ln.strip():
            continue
        total += 1
        n += ('"admission_decision"' in ln)
    return n, total


def main_live(pop, out, started):
    out.mkdir(parents=True, exist_ok=True)
    (out / "finding.json").unlink(missing_ok=True)
    details, not_checked = [], list(LIVE_NOT_CHECKED)
    for entry in pop["nodes"]:
        name = entry["name"]
        data_dir = live.readable(entry, "data_dir", "ledger")
        if data_dir is None:
            not_checked.append(live.not_checked(name, "data_dir"))
            details.append(f"node {name}: data_dir not set or unreadable")
            continue
        n, total = decision_records(data_dir)
        details.append(f"node {name}: {n} of {total} ledger records carry an admission decision member, read-only "
                       f"(the pinned plugin seals none)")
    finding.write(out, result="NOT_CHECKED", population=pop["population"], asserts=ASSERTS, pinned=LIVE_PINNED,
                  proof=[], detail="; ".join(details) + f". Not checked on the lab nodes: the pinned plugin seals no "
                  f"admission decision and no shipped pack evaluates the baseline. {NO_SPEND}",
                  not_checked=not_checked, started=started)
    return 0


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--population", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--plant", choices=PLANTS, help="seal one wrong decision (tests only)")
    a = ap.parse_args(argv)
    started = finding.now()
    out = Path(a.out)
    out.mkdir(parents=True, exist_ok=True)
    pop = load(Path(a.population) / "population.json")
    if pop["population"] == "live":
        return main_live(pop, out, started)
    return main_rehearsal(Path(a.population), out, started, plant=a.plant)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
