# admission_decision block in the node's own ledger before the exchange (capsules-plugin admission.rs).
# The step reads those blocks, read-only, and checks their shape and the rules the plugin decides by (the verdict
# its source gives, the five rows, one verdict per peer under one policy digest); it evaluates no Terms Pack.
ROWS_OPEN = ("each base-policy row's value where the sealed decision does not fix it: identity's fail or not_read "
             "on no card, key age on a cited card, and the three local rows")
ROWS_OPEN_WHY = ("the decision cites the history card and names the peer only by commitments salted from the node's "
                 "signing key, and the plugin keeps neither the card nor its snapshot of its own chain; the step "
                 "reads neither the key nor the host config")
LIVE_NOT_CHECKED = [
    {"what": ROWS_OPEN, "why": ROWS_OPEN_WHY, "issue": "evidence-network/loop#81"},
    {"what": "each ledger record's producer signature and capsule_id",
     "why": "the step reads the node's ledger lines as written and verifies neither",
     "issue": "evidence-network/loop#135"},
    {"what": "the routing path enforcing the decision when it chooses a candidate",
     "why": "the routing choice cannot yet require a property of a candidate beyond its identity",
     "issue": "Mesh-LLM/mesh-llm#2061"},
]
VERDICTS = ("GO", "NO")
LIVE_GAPS = " ".join([
    finding.outside(ROWS_OPEN, "evidence-network/loop#81"),
    finding.outside("each ledger record's producer signature and capsule_id", "evidence-network/loop#135"),
