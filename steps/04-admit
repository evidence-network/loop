])


ABSENT = object()
HEX64 = re.compile(r"^[0-9a-f]{64}$")
KEYS = {"peer_commitment", "verdict", "source", "reads", "rows", "request_id", "attempt", "model"}
# The base policy's rows, in the order the plugin lists them, and a row's results (capsules-plugin admission/base.rs).
ROWS = ("identity", "key_age", "performed_and_settled", "disputes", "corroboration")
ROW_RESULTS = ("pass", "fail", "not_read")


def decision_block(ln):
    """The admission_decision member of one ledger line (None when sealed as null), or ABSENT."""
    try:
        return json.loads(ln)["model_attestation"]["compute_attestation"][DECISION]
    except (ValueError, KeyError, TypeError):
        return ABSENT


def digest_ok(d):
    return isinstance(d, dict) and set(d) == {"alg", "digest"} and d["alg"] == "SHA-256" \
        and isinstance(d["digest"], str) and bool(HEX64.match(d["digest"]))


def block_problems(blk):
    """Why a sealed admission_decision block is not the shape the plugin promises; [] when it is."""
    if not isinstance(blk, dict):
        return ["not an object"]
    errs = []
    if blk.get("verdict") not in VERDICTS:
        errs.append(f"verdict {blk.get('verdict')!r} is not GO or NO")
    if not (isinstance(blk.get("source"), str) and blk["source"]):
        errs.append("no source")
    if sorted(set(blk) - KEYS):
        errs.append(f"unexpected members {', '.join(sorted(set(blk) - KEYS))}")
    reads = blk.get("reads")
    rows = blk.get("rows", ABSENT)
    # The operator-policy read first. A decision with rows (capsules-plugin PR #116) has one more read, the
    # peer's history card; one sealed by an earlier build has neither.
    want = 1 if rows is ABSENT else 2
    pol = reads[0] if isinstance(reads, list) and len(reads) == want and isinstance(reads[0], dict) else {}
    # With no readable operator policy the plugin seals a NO and no digest, whether the policy or the target
    # was unreadable first; every other decision cites the policy's digest.
    unread = blk.get("source") in ("unreadable_policy", "unreadable_target") and blk.get("verdict") == "NO" \
        and pol.get("digest") is None
    if pol.get("kind") != "operator_policy" or set(pol) != {"kind", "policy", "digest"} \
            or not (unread or digest_ok(pol.get("digest"))):
        errs.append("reads does not cite the operator policy by digest")
    pc = blk.get("peer_commitment", ABSENT)
    # The plugin names no peer only for a NO on a target it could not read.
    no_peer = blk.get("verdict") == "NO" and blk.get("source") == "unreadable_target"
    if not (digest_ok(pc) or (pc is None and no_peer)):
        errs.append("peer_commitment is missing or not a commitment")
    if rows is not ABSENT:
        if pc is None:
            errs.append("rows on a decision that names no peer")
        if not (isinstance(rows, list) and len(rows) == len(ROWS)
                and all(isinstance(x, dict) and set(x) == {"row", "result"} and x["row"] == name
                        and x["result"] in ROW_RESULTS for x, name in zip(rows, ROWS))):
            errs.append("rows are not the five base-policy rows in order, each pass, fail or not_read")
        card = reads[1] if isinstance(reads, list) and len(reads) == 2 else None
        if not (card == {"kind": "history_card", "state": "not_read"}
                or (isinstance(card, dict) and set(card) == {"kind", "derivation", "commitment"}
                    and card["kind"] == "history_card" and card["derivation"] == "history_card/1"
                    and digest_ok(card["commitment"]))):
            errs.append("the second read is not the peer's history card")
    return errs


# The verdict each source gives (capsules-plugin admission.rs, Policy::decide); `default` gives the policy's default.
VERDICT_OF = {"allow_list": "GO", "deny_list": "NO", "unreadable_policy": "NO", "unreadable_target": "NO"}
SOURCES = (*VERDICT_OF, "default")
POLICY_WITH_ROWS = "base/1"
CARD_ROWS, LOCAL_ROWS = ROWS[:2], ROWS[2:]
NO_CARD = ("the plugin seals nowhere whether the last ask of the card failed to verify (fail) or went unanswered "
           "(not_read)")
CARD_AGE = "the card's first checkpoint time is not in the record, which cites the card by a salted commitment only"
SNAPSHOT = ("the plugin reads it from its in-memory snapshot of the node's chain, keyed by the peer in clear; the "
            "record names the peer only by a commitment salted from the node's signing key")


def row_checks(blk):
    """[{row, sealed, want, check, why}] for a well-shaped decision with rows: each row recomputed from what the
    decision sealed by the base policy's rules (capsules-plugin admission/base.rs). `check` is PASS when the
    record fixes the row and it matches, FAIL when the row is a value the rules cannot give, NOT_CHECKED when
    it is one they can but the record does not say which."""
    got = {x["row"]: x["result"] for x in blk["rows"]}
    cited = "commitment" in blk["reads"][1]
    allowed = {"identity": {"pass"} if cited else {"fail", "not_read"},
               "key_age": set(ROW_RESULTS) if cited else {"not_read"}}
    why = {"identity": "" if cited else NO_CARD, "key_age": CARD_AGE if cited else ""}
    # Card rows (card_rows): a cited card passes identity; with none, key age is not read.
    # Local rows (read_with_key): one snapshot gives all three. With none, all three are not_read; with one,
    # performed_and_settled and corroboration are pass or fail, and disputes is not_read only while the node
    # holds no verdict about the peer.
    settled, held = got["performed_and_settled"] == "not_read", got["corroboration"] == "not_read"
    no_snapshot = settled and held
    for row in LOCAL_ROWS:
        allowed[row] = {"not_read"} if no_snapshot else (set(ROW_RESULTS) if row == "disputes" else {"pass", "fail"})
        why[row] = SNAPSHOT
    out = []
    for row in ROWS:
        want = sorted(allowed[row])
        if settled != held and row in ("performed_and_settled", "corroboration"):
            other = "corroboration" if row == "performed_and_settled" else "performed_and_settled"
            out.append({"row": row, "sealed": got[row], "want": want, "check": "FAIL",
                        "why": f"{row} is {got[row]} while {other} is {got[other]}; the plugin reads both from one "
                               f"snapshot, so both are not_read or neither is"})
            continue
        if settled != held and row == "disputes":
            out.append({"row": row, "sealed": got[row], "want": sorted(ROW_RESULTS), "check": "NOT_CHECKED",
                        "why": "the other local rows disagree on whether there was a snapshot"})
            continue
        if got[row] not in allowed[row]:
            check = "FAIL"
            when = ("with a cited card" if cited else "with no card cited") if row in CARD_ROWS else \
                ("when the other local rows are not_read (no snapshot)" if no_snapshot
                 else "when the other local rows are read (a snapshot)")
            why_row = f"{row} is {got[row]}; the rules give {' or '.join(want)} {when}"
        elif len(want) == 1 and row in CARD_ROWS:
            check, why_row = "PASS", ""
        else:
            check, why_row = "NOT_CHECKED", why[row]
        out.append({"row": row, "sealed": got[row], "want": want, "check": check, "why": why_row})
    return out


def verdict_problems(blk):
    """Why a well-shaped decision's verdict does not follow from its source the way the plugin decides; [] when
    it does. The rows decide nothing (capsules-plugin admission.rs): only the operator's lists and default do."""
    errs, source, verdict = [], blk["source"], blk["verdict"]
    pol = blk["reads"][0]
    if source not in SOURCES:
        errs.append(f"source {source!r} is none the plugin gives")
    elif source in VERDICT_OF and verdict != VERDICT_OF[source]:
        errs.append(f"verdict {verdict} from {source}, which gives {VERDICT_OF[source]}")
    if source == "unreadable_policy" and pol.get("digest") is not None:
        errs.append("an unreadable policy cited by digest")
    if "rows" in blk and pol.get("policy") != POLICY_WITH_ROWS:
        errs.append(f"rows under policy {pol.get('policy')!r}, not {POLICY_WITH_ROWS}")
    if pol.get("policy") == POLICY_WITH_ROWS and blk.get("peer_commitment") is not None and "rows" not in blk:
        errs.append(f"policy {POLICY_WITH_ROWS} names a peer but seals no rows (the plugin always seals them)")
    return errs


def same_policy_problems(found):
    """Why decisions on one node disagree under one policy digest; [] when they agree. Per policy digest the
    default is one verdict, and per peer commitment the lists give one verdict and source."""
    errs, defaults, peers = [], {}, {}
    for n, blk in found:
        digest = (blk["reads"][0].get("digest") or {}).get("digest")
        if digest is None:
            continue
        if blk["source"] == "default":
            defaults.setdefault(digest, {}).setdefault(blk["verdict"], n)
        if blk.get("peer_commitment"):
            peers.setdefault((digest, blk["peer_commitment"]["digest"]), {}).setdefault(
                (blk["verdict"], blk["source"]), n)
    for digest, seen in defaults.items():
        if len(seen) > 1:
            errs.append(f"records {' and '.join(str(n) for n in sorted(seen.values()))}: the default gives both GO "
                        f"and NO under one policy digest")
    for _, seen in peers.items():
        if len(seen) > 1:
            errs.append(f"records {' and '.join(str(n) for n in sorted(seen.values()))}: one peer gets "
                        f"{' and '.join(f'{v} ({s})' for v, s in sorted(seen))} under one policy digest")
    return errs


def ledger_decisions(data_dir):
    """(total, [(record number, line)]) of the node's ledger: how many records it holds, and each line that carries
    an admission decision, numbered as the ledger counts records; None when the ledger file cannot be read."""
    try:
        lines = (data_dir / "ledger" / "capsules.jsonl").read_text(encoding="utf-8").splitlines()
    except OSError:
        return None
    kept, total = [], 0
    for ln in lines:
        if not ln.strip():
            continue
        total += 1
        if DECISION in ln and decision_block(ln) is not ABSENT:
            kept.append((total, ln))
    return total, kept


def judge_decisions(kept):
    """([(line, block)], [problem], {record: row checks}) over the decision lines `kept` ([(record number, line)])."""
    found, problems, rows, shaped = [], [], {}, []
    for n, ln in kept:
        blk = decision_block(ln)
        if blk is ABSENT:
            problems.append(f"record {n}: carries no admission decision")
            continue
        found.append((ln, blk))
        bad = block_problems(blk)
        problems += [f"record {n}: {e}" for e in bad]
        if bad:
            continue
        shaped.append((n, blk))
        problems += [f"record {n}: {e}" for e in verdict_problems(blk)]
        if "rows" in blk:
            rows[n] = row_checks(blk)
            problems += [f"record {n}: row {c['why']}" for c in rows[n] if c["check"] == "FAIL"]
    problems += same_policy_problems(shaped)
    return found, problems, rows


def node_decisions(data_dir):
    """([(line, block)], [problem], total, {record: row checks}) over the node's ledger lines that carry an
    admission decision; None when the ledger file cannot be read."""
    read = ledger_decisions(data_dir)
    if read is None:
        return None
    total, kept = read
    found, problems, rows = judge_decisions(kept)
    return found, problems, total, rows


# What the live judge reads, kept in the proof so step 08 runs it again on the proof alone (loop#188).
NODES_FILE = "nodes.json"  # per node: whether its data_dir and ledger were read, its record count, the numbers kept


def main_live(pop, out, started):
    """Read each lab node's ledger and keep, under out, the decision lines and nodes.json; then judge those files
    (judge_live), so the finding is a function of its proof."""
    out.mkdir(parents=True, exist_ok=True)
    (out / "finding.json").unlink(missing_ok=True)
    for entry in pop["nodes"]:
        shutil.rmtree(out / entry["name"], ignore_errors=True)
    nodes = {}
    for entry in pop["nodes"]:
        name = entry["name"]
        data_dir = live.readable(entry, "data_dir", "ledger")
        read = ledger_decisions(data_dir) if data_dir is not None else None
        if data_dir is None or read is None:
            nodes[name] = {"read": "data_dir" if data_dir is None else "ledger"}
            continue
        total, kept = read
        nodes[name] = {"read": "ok", "records": total, "kept": [n for n, _ in kept]}
        if kept:
            (out / name).mkdir(exist_ok=True)
            (out / name / "decisions.jsonl").write_text("".join(ln + "\n" for _, ln in kept), encoding="utf-8")
    (out / NODES_FILE).write_text(json.dumps(nodes, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    judge_live(pop, out, started)
    return 0


def judge_live(pop, out, started):
    """The live finding from what main_live kept under out (nodes.json and each node's decisions.jsonl) only."""
    out = Path(out)
    details, not_checked, proof, problems, decided, unreadable = [], list(LIVE_NOT_CHECKED), [NODES_FILE], [], 0, False
    tally = {"PASS": 0, "NOT_CHECKED": 0, "FAIL": 0}
    try:
        nodes = load(out / NODES_FILE)
        if not isinstance(nodes, dict):
            raise TypeError("not an object")
    except (OSError, ValueError, TypeError) as e:
        nodes, problems = {}, [f"{NODES_FILE} is not readable ({type(e).__name__}: {e})"]
    names = [e["name"] for e in pop["nodes"]]
    if nodes and sorted(nodes) != sorted(names):
        problems.append(f"{NODES_FILE} names nodes {sorted(nodes)}, the population {sorted(names)}")
    for name in names:
        node = nodes.get(name) if isinstance(nodes.get(name), dict) else {}
        if node.get("read") in ("data_dir", "ledger"):
            not_checked.append(live.not_checked(name, node["read"]))
            details.append(f"node {name}: {'data_dir not set or unreadable' if node['read'] == 'data_dir' else 'ledger not readable'}")
            unreadable = True
            continue
        try:
            total, numbers = int(node["records"]), [int(n) for n in node["kept"]]
            text = (out / name / "decisions.jsonl").read_text(encoding="utf-8") if numbers else ""
            lines = text.splitlines()
            if len(lines) != len(numbers):
                raise ValueError(f"decisions.jsonl holds {len(lines)} lines, nodes.json numbers {len(numbers)}")
        except (OSError, ValueError, KeyError, TypeError) as e:
            if nodes:
                problems.append(f"node {name}: its kept decisions are not readable ({type(e).__name__}: {e})")
            continue
        found, bad, rows = judge_decisions(list(zip(numbers, lines)))
        by = {v: sum(1 for _, b in found if isinstance(b, dict) and b.get("verdict") == v) for v in VERDICTS}
        details.append(f"node {name}: {len(found)} of {total} ledger records carry an admission decision "
                       f"({by['GO']} GO, {by['NO']} NO), read-only")
        problems += [f"node {name} {b}" for b in bad]
        decided += len(found)
        if found:
            proof.append(f"{name}/decisions.jsonl")
        if rows:
            (out / name / "rows.json").write_text(json.dumps({str(n): c for n, c in rows.items()}, indent=2) + "\n",
                                                  encoding="utf-8")
            proof.append(f"{name}/rows.json")
            for c in (c for cs in rows.values() for c in cs):
                tally[c["check"]] += 1
    base = dict(population=pop["population"], asserts=ASSERTS_LIVE, pinned=LIVE_PINNED, started=started)
    summary = "; ".join(details)
    if any(tally.values()):
        summary += (f"; of the base-policy rows sealed, {tally['PASS']} were fixed by the record and matched it, "
                    f"{tally['NOT_CHECKED']} are values the rules allow but the record does not fix (rows.json) "
                    f"and {tally['FAIL']} disagree")
    if problems:
        return finding.write(out, result="FAIL", proof=proof, not_checked=[],
                      detail=f"{summary}. Did not hold: {'; '.join(problems)}. {NO_SPEND}", **base)
    elif decided and not unreadable:
        return finding.write(out, result="PASS", proof=proof, not_checked=[],
                      detail=f"{summary}. Each decision is GO or NO, names its source, cites the operator policy it "
                             f"read by digest (or is a NO sealed with no readable policy), carries no member beyond "
                             f"the plugin's own and names the peer by commitment only; its verdict follows from its "
                             f"source alone, the same for one peer under one policy digest; each row it seals is one "
                             f"the base policy's rules give from what it read. The step read the ledger lines as "
                             f"written, without verifying their signatures. {NO_SPEND} {LIVE_GAPS}", **base)
    else:
        gap = {"what": "an admission decision on a lab node",
               "why": "no ledger record carries one: the host config grants the plugin no admission hook "
                  "(lab/lab.sh writes the grant), or no peer exchange has run since it did",
               "issue": "evidence-network/loop: the live lab run, which fills population/live"}
        return finding.write(out, result="NOT_CHECKED", proof=proof, not_checked=not_checked + ([] if decided else [gap]),
                      detail=f"{summary}. Not checked: "
                             f"{'a node could not be read' if decided else 'no admission decision was found'}. "
                             f"{NO_SPEND}", **base)


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--population", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--plant", choices=PLANTS, help="seal one wrong decision (tests only)")
    a = ap.parse_args(argv)
    started = finding.now()
    out = Path(a.out)
    out.mkdir(parents=True, exist_ok=True)
    pop = load(Path(a.population) / "population.json")
    if pop["population"] == "live":
        return main_live(pop, out, started)
    return main_rehearsal(Path(a.population), out, started, plant=a.plant)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
