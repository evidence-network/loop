class NotChecked(Exception):
    """The report cannot run here; args are (what, why, issue)."""

    def __init__(self, what, why, issue=SETUP_ISSUE):
        super().__init__(what, why, issue)


class Inherited(Exception):
    """Step 10 is NOT_CHECKED: its not_checked entries, carried over with the issues 10 names."""


class Refused(Exception):
    """An input does not hold, so nothing is rendered."""


load, dump = judge10.load, judge10.dump


# --- The inputs ---------------------------------------------------------------------------
def read_judge(judged, preview=False):
    """10's finding, once it holds; raises Refused, or NotChecked when 10 has no PASS to report on.

    A preview reports only a preview 10-judge, and a baseline report never one."""
    record = load(judged / "finding.json")
    errs = finding.check_record(judged, record) if isinstance(record, dict) else ["finding.json is not an object"]
    if errs:
        raise Refused(f"step 10's finding does not hold: {'; '.join(errs)}")
    if finding.is_preview(record) != preview:
        raise Refused("step 10's finding is an open-month preview, not a baseline result" if not preview else
                      "step 10's finding is not an open-month preview; --preview-open-month reports only a preview")
    if record["result"] == "FAIL":
        raise Refused("step 10's finding is FAIL, so its Results are not reported")
    if record["result"] == "NOT_CHECKED":
        raise Inherited([{"what": f"the report over step 10's Results: {x['what']}",
                          "why": f"step 10 is NOT_CHECKED, so there is no Result to report: {x['why']}",
                          "issue": x["issue"]} for x in record["not_checked"]])
    return record


def check_preview_pairing(judged, source):
    """A preview 10 is of the manifest in `source` (--run): a stale 10-judge beside --out is refused. Raises Refused."""
    try:
        w = load(judged / "window.json")
    except (OSError, ValueError):
        raise Refused("step 10's preview has no readable window.json, so it cannot be tied to --run's manifest")
    manifest = source / "08-verify" / "verified.json"
    if not (isinstance(w, dict) and w.get("preview") == "open-month" and manifest.is_file()
            and w.get("manifest_sha256") == finding.sha256(manifest)):
        raise Refused("step 10's preview was not judged from --run's 08 manifest (window.json names another or none)")


def check_records(manifest, cited):
    """Every record a Result cites has the sha256 08's manifest gives it, in a step 08 reproduced."""
    listed = {f"{e['dir']}/{f['path']}": f["sha256"] for e in manifest["steps"] if e["status"] == "reproduced"
              for f in e.get("files", [])}
    return [f"{k} is cited with sha256 {s[:12]}, but 08's manifest gives {listed[k][:12] if k in listed else 'it nothing'}"
            for k, s in sorted(cited.items()) if listed.get(k) != s]


def read_results(judged, record, manifest, capsulectl, judge_key, tmp):
    """(finer {dir: statement}, rollup statement, cited {ref: sha256}, problems) from the bundles 10's finding binds."""
    problems, finer, finer_valid, cited, roots = [], {}, set(), {}, set()
    rollup, rollup_cites = None, []
    # Only the bundles 10's proof names: a copy dropped beside them would otherwise be counted as another Result.
    bundles = sorted(judged / p["path"] for p in record["proof"]
                     if p["path"].startswith("bundles/") and p["path"].endswith(".bundle.json"))
    for path in bundles:
        root, statement, disclosed, probs = judge10.open_bundle(path, judge10.verify_bundle(capsulectl, path, tmp), judge_key)
        problems += probs
        if root in roots:
            problems.append(f"{path.name} is a second bundle of a Result already read")
        roots.add(root)
        name = path.name.replace(".bundle.json", "")
        if name == "rollup":
            rollup, rollup_cites = statement, judge10.evidence(statement)
            continue
        finer[name] = statement
        if not probs:
            finer_valid.add(root)
        for digest in judge10.evidence(statement):
            p = disclosed.get(digest) or {}
            if not {"step", "path", "sha256"} <= set(p):
                problems.append(f"{path.name}: cited record {digest[:12]} is not a disclosed record capsule")
                continue
            problems += judge10.check_cited_once(cited, f"{p['step']}/{p['path']}", p["sha256"], path.name)
    if rollup is None:
        problems.append("step 10 left no roll-up bundle")
    problems += judge10.check_rollup(rollup_cites, finer_valid)
    problems += check_records(manifest, cited)
    return finer, rollup, cited, problems


# --- Exchanges: counted from what the cited records say, not from their names --------------
def record_holds(path, sha):
    """The file's bytes have the sha256 08's manifest gives it."""
    return path.is_file() and finding.sha256(path) == sha


def cited_records(source, cited, pack):
    """[(ref, path, sha256)] of the deal and settlement records the Results cite; only these are read."""
    steps = {nn for nn, k in pack["kinds"].items() if k["kind"] in ("deal", "settlement")}
    return [(ref, source / ref, sha) for ref, sha in sorted(cited.items()) if ref[:2] in steps]


def documents(path):
    """The JSON objects a record holds, one for a .json file, one per line for a .jsonl one; none if it is neither."""
    text = path.read_text(encoding="utf-8", errors="replace")
    try:
        docs = [json.loads(line) for line in text.splitlines() if line.strip()] if path.suffix == ".jsonl" \
            else [json.loads(text)]
    except ValueError:
        return []
    return [d for d in docs if isinstance(d, dict)]


def deal_of(doc):
    """The deal id a deal record seals, or None: its top-level deal_id."""
    return doc["deal_id"] if isinstance(doc.get("deal_id"), str) and doc["deal_id"] else None


def exchange_of(doc):
    for key in ("exchange", "exchange_id"):
        if isinstance(doc.get(key), str) and doc[key]:
            return doc[key]
    return None


def count_exchanges(source, cited, pack):
    """{"deals": {id: refs}, "exchanges": {id: refs}} from the cited records' contents; raises Refused on a bad digest."""
    found = {"deals": {}, "exchanges": {}}
    kinds = {nn: k["kind"] for nn, k in pack["kinds"].items()}
    for ref, path, sha in cited_records(source, cited, pack):
        if not record_holds(path, sha):
            raise Refused(f"{ref} does not match the sha256 08's manifest gives it")
        for doc in documents(path):
            # A deal is sealed by a deal record; a settlement line that carries a deal_id seals nothing.
            for name, value in (("deals", deal_of(doc) if kinds[ref[:2]] == "deal" else None),
                                ("exchanges", exchange_of(doc))):
                if value:
                    found[name].setdefault(value, set()).add(ref)
    return found


# --- The figures: counted from the inputs, each with its denominator ----------------------
def figure(fid, section, text, verdict, evidence):
    return {"id": fid, "section": section, "text": text, "verdict": verdict, "evidence": sorted(evidence)}


def render_figures(manifest, finer, rollup, cited, pack, found):
    """The page's figures. `evidence` holds record refs until the report Result is sealed."""
    figures = []
    kinds = {nn: k["kind"] for nn, k in pack["kinds"].items()}
    steps = [e for e in manifest["steps"] if e["status"] == "reproduced" and e["step"] in kinds]
    for nn, k in pack["kinds"].items():
        mine = [e for e in steps if e["step"] == nn]
        # The same definition 10 judges by: a record is a primary record file (binding.json `records`), so a count means
        # deals, settlements, asks or disputes, not the bundles and proof files beside them.
        refs = [f"{e['dir']}/{f['path']}" for e in mine for f in e.get("files", [])
                if any(fnmatch.fnmatchcase(f["path"], g) for g in k["records"])]
        hit = [r for r in refs if r in cited]
        counted = any(t.get("counted") for t in k["terms"])
        figures.append(figure(
            f"count:{k['kind']}", "adjudications",
            f"{PLURAL[k['kind']]} {'counted as found' if counted else 'judged'}: {len(hit)} of {len(refs)} {k['kind']} "
            f"records step 08 lists, from {sum(e['dir'] in finer for e in mine)} of {len(mine)} {k['kind']} steps.",
            "met", hit))
    for nn, k in pack["kinds"].items():
        dirs = sorted(d for d in finer if d[:2] == nn)
        for t in k["terms"]:
            claims = [c for d in dirs for c in finer[d].get("claims", []) if c.get("requirement_ref") == t["id"]]
            n = len(claims)
            count = {v: sum(c["verdict"] == v for c in claims) for v in ("met", "not_met", "not_evaluable")}
            said = next((c["presentation"]["narrative"] for c in claims if c["presentation"].get("narrative")), None)
            worst = next((v for v in ("not_met", "not_evaluable", "met") if count[v]), "not_evaluable")
            refs = [r for r in cited if r[:2] == nn]
            figures.append(figure(
                f"term:{t['id']}", "outcomes",
                f"{t['id']} ({t['name']}): met in {count['met']} of {n}, not met in {count['not_met']} of {n}, not "
                f"evaluable in {count['not_evaluable']} of {n} {k['kind']} Results."
                + (f" {said}." if said else ""), worst, refs))
    claims = (rollup or {}).get("claims", [])
    n = len(claims)
    count = {v: sum(c["verdict"] == v for c in claims) for v in ("met", "not_met", "not_evaluable")}
    figures.append(figure(
        "decisions:rollup", "decisions",
        f"The roll-up cites {len(judge10.evidence(rollup or {}))} of {len(finer)} finer Results: met in {count['met']} "
        f"of {n}, not met in {count['not_met']} of {n}, not evaluable in {count['not_evaluable']} of {n}.",
        next((v for v in ("not_met", "not_evaluable", "met") if count[v]), "not_evaluable"), []))
    deals, exchanges = found["deals"], found["exchanges"]
    if deals or exchanges:
        figures.append(figure(
            "exchanges:deals", "exchanges",
            f"Paid exchanges, each counted from the payer's sealed deal: {len(deals)} of {len(exchanges)} exchanges in "
            "the window. A free exchange gets no deal and no receipt, by design: it stays in this denominator and is "
            "no gap.",
            "met", {r for refs in (*deals.values(), *exchanges.values()) for r in refs}))
    return figures


def report_doc(figures, digests, rollup):
    """The report Result: one claim per figure, the figure's text shown as its summary."""
    claims, buckets = [], {"met": [], "not_met": [], "not_evaluable": []}
    for f in figures:
        refs = [{"digest_alg": "SHA-256", "digest": digests[r]} for r in f["evidence"]]
        status = {"met": "SATISFIED", "not_met": "CONTRADICTED", "not_evaluable": "INSUFFICIENT"}[f["verdict"]]
        claims.append({"id": f["id"], "contract_ref": CONTRACT, "requirement_ref": f["id"], "tier": "recomputed",
                       "grade": "self-attested", "verdict": f["verdict"], "evidence": refs, "proofs": [],
                       "sufficiency": "SATISFIED" if f["verdict"] != "not_evaluable" else "INSUFFICIENT",
                       "presentation": {"kind": "analysis", "status": status, "summary": f["text"]}})
        buckets[f["verdict"]].append(f["id"])
    doc = {"result_version": "evidence-result-v0", "generated_at": finding.now(), "claims": claims,
           "aggregate": {"coverage": {"evaluated_population": len(claims), "excluded_not_applicable": 0,
                                      "unknown_count": 0}, "buckets": buckets},
           "x-report": {"figures": figures}}
    if (rollup or {}).get("x-window"):
        doc["x-window"] = rollup["x-window"]
    return doc


# --- The reporting book -------------------------------------------------------------------
class Reporter:
    """A book profile driven through the pinned capsulectl: a scratch one, or a node's own join book."""

    def __init__(self, home, capsulectl, profile):
        self.home, self.capsulectl, self.profile = Path(home), Path(capsulectl), profile
        self.work = self.home

    @classmethod
    def scratch(cls, home, capsulectl, keys):
        book = cls(home, capsulectl, "reporter")
        book.home.mkdir(parents=True, exist_ok=True)
        for k in ("reporter", "checkpoint"):
            f = book.home / f"{k}.seed"
            f.write_text(judge10.seed_hex(keys / f"{k}.pem"))
            f.chmod(0o600)
        book.cap("profile", "create", "--name", "reporter", "--type", "jsonl", "--jsonl-path", str(book.home / "store"),
                 "--log-id", "reporter", "--operator", "loop-reporter",
                 "--trusted-key", judge10.pub_hex(keys / "reporter.pub.pem"),
                 "--signing-key-file", str(book.home / "reporter.seed"),
                 "--checkpoint-signing-key-file", str(book.home / "checkpoint.seed"),
                 "--checkpoint-trusted-key", judge10.pub_hex(keys / "checkpoint.pub.pem"))
        book.cap("store", "init", "--profile", "reporter")
        return book

    def run(self, *args):
        env = dict(os.environ, XDG_CONFIG_HOME=str(self.home / "config"),
                   CAPSULECTL_PLUGIN_ROOTS=os.environ.get("CAPSULECTL_PLUGIN_ROOTS", str(self.capsulectl.parent)))
        return subprocess.run([str(self.capsulectl), *args], env=env, capture_output=True, text=True, timeout=300)

    def cap(self, *args):
        r = self.run(*args)
        if r.returncode != 0:
            raise RuntimeError(f"capsulectl {' '.join(args[:3])}: {(r.stderr.strip() or r.stdout)[:400]}")
        lines = r.stdout.strip().splitlines()
        return json.loads(lines[-1]) if lines else {}

    def publish(self, step, path, sha):
        """A capsule for one cited record; its payload is the record's {step, path, sha256}."""
        req = {"spec_version": "capsule-seal-request/v1",
               "capsule": {"ActionID": f"loop-report-record:{step}/{path}", "ActionType": "fyi",
                           "Operator": self.profile, "Developer": "evidence-network/loop", "Timestamp": finding.now()},
               "payload": {"step": step, "path": path, "sha256": sha}, "agent_output": {"ok": True}}
        f = self.work / "request.json"
        dump(f, req)
        return self.cap("publish", "--profile", self.profile, "--request", str(f))["capsule_id"]

    def seal_result(self, doc, out):
        f = self.work / "report.input.json"
        dump(f, doc)
        rid = self.cap("book", "result", "build", "--profile", self.profile, "--result", str(f),
                       "--out", str(self.work / "report.result.json"))["record_id"]
        self.disclose(rid, out)
        return rid

    def disclose(self, rid, path):
        self.cap("book", "disclose", "--profile", self.profile, "--root", rid, "--payloads", "selected", "--out", str(path))

    def seal_page(self, bundle, page):
        """The pinned builder: it renders the page from the bundle and seals the page's digest in this book."""
        return self.cap("book", "report", "build", "--profile", self.profile, "--bundle", str(bundle), "--card", "outcome",
                        "--out", str(page), "--seal")

    def rebuild(self, bundle, page):
        """The same page again from the same bundle, sealing nothing: the pinned builder is deterministic."""
        return self.cap("book", "report", "build", "--profile", self.profile, "--bundle", str(bundle), "--card",
                        "outcome", "--out", str(page))

    def check_page(self, page):
        """`book report check` as JSON, whatever it exits with: a mismatch is an answer, not a broken tool."""
        r = self.run("book", "report", "check", "--profile", self.profile, "--page", str(page))
        try:
            return json.loads(r.stdout.strip().splitlines()[-1])
        except (ValueError, IndexError):
            return {"page": "no answer", "error": (r.stderr.strip() or r.stdout)[:300]}


# --- The checks, on the page's bytes ------------------------------------------------------
def page_bundle(page):
    """The Evidence Bundle the page embeds."""
    m = BUNDLE_SCRIPT.search(Path(page).read_text(encoding="utf-8"))
    if not m:
        raise ValueError("the page embeds no Evidence Bundle")
    return json.loads(m.group(1))


def page_statement(page):
    b = page_bundle(page)
    return b["disclosures"][b["root"]]["agent_input"]["statement"]


def tool_versions(capsulectl, plugin):
    """What the page was built by: each pinned binary's own `--version` line. The viewer is built into capsulectl-book."""
    def version(binary):
        r = subprocess.run([str(binary), "--version"], capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
        return r.stdout.strip().splitlines()[0] if r.returncode == 0 and r.stdout.strip() else "unknown"
    return {"capsulectl": version(capsulectl), "capsulectl-book": version(plugin),
            "viewer": "the capsule-viewer script built into capsulectl-book, at its version"}


def check_rebuilds(pages, seal_bundle):
    """Two rebuilds of the page from the Result's bundle have the same bytes, and those are the bytes the seal holds."""
    digests = [f"sha256:{finding.sha256(p)}" for p in pages]
    problems = []
    if len(set(digests)) > 1:
        problems.append(f"two rebuilds of the page from result.bundle.json differ: {' and '.join(d[:19] for d in digests)}")
    b = load(seal_bundle)
    record = (b.get("disclosures", {}).get(b.get("root")) or {}).get("agent_input") or {}
    sealed = (record.get("statement") or {}).get("page_digest")
    if digests[0] != sealed:
        problems.append(f"the rebuilt page is {digests[0][:19]}, the seal holds {str(sealed)[:19]}")
    return problems


def check_seal(page, answer, seal_bundle, verdict, key):
    """`book report check` says match, and the disclosed seal record, under the book's key, holds the page's sha256."""
    problems = []
    digest = f"sha256:{finding.sha256(page)}"
    if answer.get("page") != "match":
        problems.append(f"the page's bytes do not match the sealed digest: book report check says "
                        f"{answer.get('page')}, the page is {digest[:19]}")
    b = load(seal_bundle)
    record = (b.get("disclosures", {}).get(b.get("root")) or {}).get("agent_input") or {}
    sealed = (record.get("statement") or {}).get("page_digest")
    if record.get("record_type") != "report_page_seal" or sealed != digest:
        problems.append(f"the disclosed seal record holds {str(sealed)[:19]}, the page is {digest[:19]}")
    if verdict.get("verdict") != "VALID":
        problems.append(f"the seal record's bundle does not verify: {verdict.get('verdict') or 'no verdict'}")
    if b.get("extensions", {}).get("producer-key/v1", {}).get("public_key") != key:
        problems.append("the seal record is not under the reporting book's key")
    return problems


def bad_number(text):
    """Why a figure's text has a number with no denominator, or None."""
    for k, n in FRACTION.findall(text):
        if int(k) > int(n):
            return f"{k} of {n}"
    rest = IDENTIFIER.sub("", FRACTION.sub("", text))
    m = re.search(r"\d+", rest)
    return m.group(0) if m else None


def check_denominators(statement):
    """Every number the page's figures show is "k of n", with k <= n."""
    problems = []
    for c in statement.get("claims", []):
        bad = bad_number(c["presentation"].get("summary", ""))
        if bad:
            problems.append(f"{c['id']}: {bad!r} has no denominator: {c['presentation'].get('summary')}")
    return problems


def score_like(x, where=""):
    """Each score-like key or word in a JSON value, by where it is."""
    out = []
    if isinstance(x, dict):
        for k, v in x.items():
            if SCORE_KEY.search(str(k)):
                out.append(f"{where}/{k}")
            out += score_like(v, f"{where}/{k}")
    elif isinstance(x, list):
        for i, v in enumerate(x):
            out += score_like(v, f"{where}/{i}")
    elif isinstance(x, str) and SCORE_WORD.search(x):
        out.append(f"{where}: {x[:80]}")
    return out


def check_no_score(page, report):
    """No score-like field or word in the page's bundle, its HTML outside scripts, or the report.json it is written with."""
    hits = score_like(page_bundle(page), "page") + score_like(report, "report.json")
    html = SCRIPT.sub("", Path(page).read_text(encoding="utf-8"))
    hits += [f"page html: {m.group(0)}" for m in SCORE_WORD.finditer(html)]
    return [f"a score-like field: {h}" for h in hits]


def check_result_bundle(verdict):
    """The report Result's bundle, which the page embeds, verifies."""
    return [] if verdict.get("verdict") == "VALID" else \
        [f"the report Result's bundle does not verify: {verdict.get('verdict') or 'no verdict'}"]


def check_no_paid_product(page, report):
    """No enterprise or paid-product text in the page's bundle, its HTML outside scripts, or the report.json it is written with."""
    texts = " ".join(re.findall(r'"[^"]*"', json.dumps(page_bundle(page)))) + " " + json.dumps(report) + " " + SCRIPT.sub("", Path(page).read_text(encoding="utf-8"))
    return [f"paid-product text: {m.group(0)!r}" for m in PAID_WORD.finditer(texts)][:5]


# --- The run ------------------------------------------------------------------------------
def run_inputs(run, out, population, population_dir, preview=False):
    """(10's dir, the dir holding 08's manifest, is it the stand-in), running 10 on the stand-in where it applies.

    A preview reads 10's output beside `out` (PREVIEW/10-judge) and 08's manifest from `run`, and never a stand-in."""
    if preview:
        judged = out.parent / "10-judge"
        if not (judged / "finding.json").is_file():
            raise NotChecked("the preview report page, over step 08's manifest and step 10's open-month Results",
                             f"{out.parent.name} holds no 10-judge/ preview output to render from; run 10-judge "
                             "--preview-open-month --run first", RUN_ISSUE)
        return judged, run, False
    judged = run / "10-judge"
    standin = population_dir / "step10" / "run"
    if not (judged / "finding.json").is_file():
        if population == "rehearsal" and not (run / "08-verify").is_dir() and (standin / "08-verify").is_dir():
            shutil.rmtree(out / "standin", ignore_errors=True)
            judge10.main(["--population", str(population_dir), "--out", str(out / "standin" / "10-judge")])
            return out / "standin" / "10-judge", standin, True
        raise NotChecked("the report page, over step 08's manifest and step 10's Results",
                         f"{run.name} holds no 10-judge/ output to render from" +
                         (" and the live population has no stand-in; this step never fetches "
                          "records through a peer" if population == "live" else ""), RUN_ISSUE)
    if not (judged / "window.json").is_file():
        return judged, run, False
    is_standin = load(judged / "window.json").get("source") == "stand-in"
    return judged, (standin if is_standin else run), is_standin


def reporting_book(population, pop, keys, tmp, capsulectl):
    """(Reporter, its key) for this population, or raise NotChecked."""
    if population != "live":
        if not (keys / "reporter.pem").is_file():
            raise NotChecked("the page's digest, sealed", f"the {population} population lists no reporter key (step11/keys)",
                             f"evidence-network/loop: population/{population}/step11/keys")
        return Reporter.scratch(Path(tmp) / "book", capsulectl, keys), judge10.pub_hex(keys / "reporter.pub.pem")
    node = pop["nodes"][0]
    data_dir = live.readable(node, "data_dir", "keys/node-key.pub.pem")
    if data_dir is None:
        raise NotChecked(f"live node {node['name']}: the page's digest, sealed", "data_dir not set or unreadable", live.ISSUE)
    book_dir = live.readable(node, "book_dir", "config")
    if book_dir is None:
        raise NotChecked(f"live node {node['name']}: the page's digest, sealed", "book_dir not set or unreadable", live.ISSUE)
    book = Reporter(book_dir, capsulectl, node["name"])
    book.work = Path(tmp)
    return book, judge10.pub_hex(data_dir / "keys" / "node-key.pub.pem")


def report(run, out, population, pop, population_dir, proof, tmp, page=None, preview=False):
    """Render, seal and check the page. Returns (problems, lines, is_standin); raises NotChecked or Refused."""
    judged, source, is_standin = run_inputs(run, out, population, population_dir, preview)
    record = read_judge(judged, preview)
    if preview:
        check_preview_pairing(judged, source)
    try:
        manifest, _ = judge10.read_manifest(source)
    except judge10.NotChecked as e:
        raise NotChecked(*e.args)
    except ValueError as e:
        raise Refused(str(e))
    if manifest.get("population") != population:
        raise Refused(f"08's manifest is of population {manifest.get('population')}, this run is {population}")
    judge_pub = population_dir / "step10" / "keys" / "judge.pub.pem"
    if not judge_pub.is_file():
        raise NotChecked("step 10's Results, under the judge key", f"the {population} population lists no judge "
                         "public key (step10/keys/judge.pub.pem)", LIVE_KEY_ISSUE)
    capsulectl, plugin = judge10.tools()
    if not (capsulectl.is_file() and plugin.is_file()):
        raise NotChecked("the report page, built and sealed", f"capsulectl and capsulectl-book are not installed "
                         f"({capsulectl.parent}); steps/11-report.setup.sh installs them")
    finer, rollup, cited, problems = read_results(judged, record, manifest, capsulectl, judge10.pub_hex(judge_pub), tmp)
    if problems:
        raise Refused("; ".join(problems))
    try:
        pack = judge10.load_pack()
    except judge10.NotChecked as e:
        raise NotChecked(*e.args)
    figures = render_figures(manifest, finer, rollup, cited, pack, count_exchanges(source, cited, pack))
    book, key = reporting_book(population, pop, population_dir / "step11" / "keys", tmp, capsulectl)
    digests = {}
    for ref, sha in sorted(cited.items()):
        step, path = ref.split("/", 1)
        digests[ref] = book.publish(step, path, sha)
    rollup_ref = "10-judge/bundles/rollup.bundle.json"
    digests[rollup_ref] = book.publish("10-judge", "bundles/rollup.bundle.json", finding.sha256(judged / "bundles" / "rollup.bundle.json"))
    for f in figures:  # a Result's claim cites at least one record; a figure with none rests on the roll-up
        f["evidence"] = f["evidence"] or [rollup_ref]
    built_page, bundle, seal = Path(tmp) / "report.html", out / "result.bundle.json", out / "seal.bundle.json"
    page_out = page
    page = built_page
    book.seal_result(report_doc(figures, digests, rollup), bundle)
    built = book.seal_page(bundle, page)
    page.chmod(0o644)
    book.disclose(built["page_seal"]["record_id"], seal)
    answer = book.check_page(page)
    verdict = judge10.verify_bundle(capsulectl, seal, tmp)
    rebuilt = [Path(tmp) / f"rebuild-{i}.html" for i in (1, 2)]
    for r in rebuilt:
        book.rebuild(bundle, r)
    report_json = {"source": "stand-in" if is_standin else "run", **({"preview": "open-month"} if preview else {}),
                   "figures": figures,
                   "report_html_sha256": finding.sha256(page), "report_html_bytes": page.stat().st_size,
                   "built_by": tool_versions(capsulectl, plugin),
                   "manifest_sha256": finding.sha256(source / "08-verify" / "verified.json"),
                   "rollup_sha256": finding.sha256(judged / "bundles" / "rollup.bundle.json")}
    dump(out / "report.json", report_json)
    dump(out / "check.json", {"build": {k: built.get(k) for k in ("bundle_digest", "root", "page_seal", "verdict")},
                              "check": answer, "seal_verdict": verdict.get("verdict")})
    proof += ["report.json", "result.bundle.json", "seal.bundle.json", "check.json"]
    if is_standin:
        proof += [f"standin/10-judge/{p.relative_to(judged)}" for p in sorted(judged.rglob("*")) if p.is_file()]
    problems = check_seal(page, answer, seal, verdict, key) + check_rebuilds(rebuilt, seal)
    problems += check_result_bundle(judge10.verify_bundle(capsulectl, bundle, tmp))
    statement = page_statement(page)
    problems += check_denominators(statement)
    problems += check_no_score(page, report_json)
    problems += check_no_paid_product(page, report_json)
    if page_out:
        shutil.copyfile(page, page_out)
    return problems, [c["presentation"]["summary"] for c in statement["claims"]], is_standin


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--population", required=True, type=Path)
    ap.add_argument("--out", required=True, type=Path)
    ap.add_argument("--page", type=Path, help="also leave the rendered page here, a local copy to look at: the finding "
                    "commits report.json and the page's sha256, not the page")
    ap.add_argument("--preview-open-month", action="store_true",
                    help="report over step 10's open-month preview (PREVIEW/10-judge beside --out), a preview and not a "
                    "baseline result; needs --run")
    ap.add_argument("--run", type=Path, help="with --preview-open-month: the loop run holding 08-verify/ and the "
                    "records (--out is then elsewhere, outside it)")
    a = ap.parse_args(argv)
    preview = a.preview_open_month
    if preview != (a.run is not None):
        ap.error("--preview-open-month and --run go together")
    started = finding.now()
    out = a.out.resolve()
    if preview and judge10.preview_out_problem(out, a.run.resolve()):
        ap.error(judge10.preview_out_problem(out, a.run.resolve()))
    run = a.run.resolve() if preview else out.parent
    out.mkdir(parents=True, exist_ok=True)
    shutil.rmtree(out / "standin", ignore_errors=True)
    for p in ("finding.json", "report.html", "report.json", "result.bundle.json", "seal.bundle.json", "check.json"):
        (out / p).unlink(missing_ok=True)
    population_dir = a.population.resolve()
    pop = load(population_dir / "population.json")
    population = pop["population"]
    problems, not_checked, lines, proof, pinned, is_standin = [], [], [], [], [], False
    try:
        with tempfile.TemporaryDirectory(prefix="11-report-") as tmp:
            problems, lines, is_standin = report(run, out, population, pop, population_dir, proof, tmp,
                                                  a.page.resolve() if a.page else None, preview)
        pinned = PINNED
    except NotChecked as e:
        what, why, issue = e.args
        not_checked.append({"what": what, "why": why, "issue": issue})
    except Inherited as e:
        not_checked += e.args[0]
    except Refused as e:
        problems = [f"refused, nothing rendered: {e}"]
    except (RuntimeError, OSError, ValueError, KeyError, TypeError, IndexError, subprocess.SubprocessError) as e:
        problems = [f"the report did not run to the end ({type(e).__name__}: {str(e)[:300]})"]
    result = "FAIL" if problems else ("NOT_CHECKED" if not_checked else "PASS")
    what = (f"the committed stand-in run population/{population}/step10/run (dated in a closed month), not this run's "
            f"records" if is_standin else f"run {run.name}")
    detail = (finding.PREVIEW + ". " if preview else "") + f"{what}: "
    detail += (" ".join(lines) + " " if lines else "no page rendered. " if result != "PASS" else "")
    detail += f"Did not hold: {'; '.join(problems)}. " if problems else ""
    if result == "PASS":
        detail += ("The page is the pinned builder's, its digest sealed in the reporting book by book report build "
                   "--seal and matched by book report check; the builder's viewer script is pinned code and was not "
                   "scanned for score-like words. ")
        detail += (LIVE_LABEL + " " if population == "live" else "")
        detail += finding.outside("the pinned pack's own evaluator does not run here: step 10 applies the "
                                  "pack's terms to the results 08 re-derived", PACK_ISSUE) + " "
        detail += finding.outside("the page's text naming its two questions (did the evidence verify, is this the "
                                  "page the publisher issued)", VIEWER_ISSUE) + " "
        detail += finding.outside("a check that both sides' deals agree: only the payer seals a deal for now",
                                  PROVIDER_DEAL_ISSUE)
    if population == "live":
        detail += f" On live, step 10's Results are under the live judge key: {judge10.LIVE_JUDGE}."
    proof = [p for p in proof if (out / p).is_file()]
    finding.write(out, result=result, population=population, asserts=PREVIEW_ASSERTS if preview else ASSERTS,
                  pinned=pinned, proof=proof,
                  detail=detail.strip(), not_checked=[] if result == "PASS" else not_checked, started=started)
    print(f"11-report: {result}: {detail.strip()}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
