def rederive_07(m, c):
    cap = need(m.tools(), "step 07", "capsulectl")
    pubs = node_pubs(c.pop)
    keys = {n: load(c.work / n / "advertised" / "book.json")["node_key"] for n in pubs
            if (c.work / n / "advertised" / "book.json").is_file()}
    not_checked = []
    failures, answered, proof, lines = m.judge_run(c.work, keys, cap, c.tmp, not_checked)
    return m.conclude(c.work, c.population, failures, not_checked, answered, proof, lines, c.started, "book")


def rederive_07_live(m, c):
    """Live 07 (the reporter backend): its own judge_reporter on the copied proof. It reads the attempts, each
    ask's ledger extract, each node's exchange subject, the commitment it kept and ask.json, and from the
    repository the nodes/ listings (the listed keys); no console and no data dir."""
    if not openssl_ed25519():  # step 03's checker verifies each kept commitment with it
        raise Unreproducible("step 07: its judge, run again here",
                             "openssl 3.0 or later (Ed25519 pkeyutl -rawin) is not installed where 08 runs")
    pop = load(c.pop / "population.json")
    if m.backend(pop) != "reporter":
        raise Unreproducible("step 07: its live result re-derived from its proof bytes",
                             f"08 re-derives the live reporter backend only, not {m.backend(pop)!r}", LIVE_ISSUE)
    old_shape(c, "07", "ask.json")
    return m.conclude(c.work, c.population, *m.judge_reporter(pop, c.work), c.started, "reporter")


def openssl_ed25519():
    """Whether the openssl on PATH is OpenSSL 3.0 or later, which verifies Ed25519 with pkeyutl -rawin (LibreSSL,
    whose version string also starts with 3, does not)."""
    if shutil.which("openssl") is None:
        return False
    r = subprocess.run(["openssl", "version"], capture_output=True, text=True)
    m = re.match(r"OpenSSL (\d+)\.", r.stdout)
    return r.returncode == 0 and bool(m) and int(m.group(1)) >= 3


