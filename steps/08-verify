def stages():
    """{stage: [step numbers]} as loop.sh lists them (STAGE_<n>="01 02 ..."): the one list of what a stage runs."""
    text = (ROOT / "loop.sh").read_text(encoding="utf-8")
    return {m.group(1): m.group(2).split() for m in re.finditer(r'^STAGE_(\w+)="([0-9 ]+)"', text, re.M)}


STAGES = stages()


class Mismatch(Exception):
    """The re-run changed bytes the finding cites; the argument says which."""


class Unreproducible(Exception):
    """The step's result cannot be re-derived here; args are (what, why, issue)."""

    def __init__(self, what, why, issue=SETUP_ISSUE):
        super().__init__(what, why, issue)


def load(path):
    return json.loads(Path(path).read_text(encoding="utf-8"))


def step_module(base):
    """steps/<base> as a module (its own fresh copy: the step's file is read, never changed)."""
    loader = importlib.machinery.SourceFileLoader(f"verify_{base.replace('-', '_')}", str(HERE / base))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def pub_key(pem):
    """The raw Ed25519 public key (hex) of an SPKI PEM file in the repository."""
    return cc.key_id_of(cc.spki_from_pem(Path(pem).read_text(encoding="utf-8")))


def repo_path(p):
    p = Path(p)
    return p if p.is_absolute() else ROOT / p


def node_pubs(pop_dir):
    """{node name: raw public key} of the population's nodes, from the repository's key files."""
    return {n["name"]: pub_key(repo_path(n["key_dir"]) / "node-key.pub.pem")
            for n in load(Path(pop_dir) / "population.json")["nodes"]}


def nodes_of(work, pop_dir):
    """The population's nodes whose directory the step wrote."""
    return [n for n in node_pubs(pop_dir) if (work / n).is_dir()]


def need(path, what, tool):
    if path is None or not Path(path).is_file():
        raise Unreproducible(f"{what}: its judge, run again here", f"{tool} is not installed where 08 runs "
                                                                   f"({path}); its setup.sh installs it")
    return path


class Ctx:
    """One step: its bundle dir, the scratch copy of its proof (named as the step's dir), its finding."""

    def __init__(self, bundle, work, tmp, pop_dir, record):
        self.bundle, self.work, self.tmp, self.pop, self.record = bundle, work, tmp, Path(pop_dir), record
        self.population = record["population"]
        self.started = record["started"]
        self.relies = []  # what this step's re-derivation rests on beyond LIVE_RELIES_ON (its keys check adds them)


# --- Keys: each key the proof relies on is the repository's ------------------------------
def keys_01(c, m=None):
    node = load(c.work / "checks.json").get("node")
    pubs = node_pubs(c.pop)
    got = load(c.work / "capsule.json").get("key_id")
    return [] if pubs.get(node) == got else [f"capsule.json key_id {got} is not the repository key of node {node}"]


def keys_02(c, m=None):
    w = load(c.pop / "population.json").get("witness")
    if not (c.work / "witnesses.json").is_file():
        return ["the population names a witness but witnesses.json is not in the proof"] if w else []
    if not w or repo_path(w["directory"]).read_bytes() != (c.work / "witnesses.json").read_bytes():
        return ["witnesses.json is not the repository's witness directory"]
    return []


def keys_commitments(c, path):
    pubs, bad = node_pubs(c.pop), []
    for n in pubs:
        f = c.work / path.format(n=n)
        if f.is_file():
            got = load(f).get("key_id")
            if got != pubs[n]:
                bad.append(f"{f.relative_to(c.work)} key_id {got} is not the repository key of node {n}")
    return bad


def keys_04(c):
    """The scenarios step 04 must have judged are the repository's, not the ones its own finding lists."""
    want = {d.name for d in (c.pop / "step04" / "scenarios").iterdir() if d.is_dir()}
    have = {Path(p["path"]).parts[1] for p in c.record["proof"] if p["path"].startswith("scenarios/")}
    return ([f"scenario {n} is in the repository but not in the finding's proof" for n in sorted(want - have)]
            + [f"scenario {n} is in the finding's proof but not in the repository" for n in sorted(have - want)])


def keys_05(c):
    """Each controller declaration is the repository's: a controller-binding/0 record naming exactly the controller's
    key and one node key it covers (loop#134); its signatures are 05's own judge's to check, which runs again."""
    pubs = node_pubs(c.pop)
    want = []
    for ctl in load(c.pop / "step05" / "controllers.json")["controllers"]:
        key = pub_key(repo_path(ctl["key_dir"]) / "controller-key.pub.pem")
        want += [sorted([key, pubs[n]]) for n in ctl["nodes"]]
    decls = load(c.work / "declarations.json")
    got = [sorted(d.get("keys") or []) if isinstance(d, dict) else [] for d in decls]
    # The driver reads every declaration, so a repeated pair would let an unchecked one stand behind a checked one.
    if len(got) != len({tuple(g) for g in got}):
        return ["declarations.json repeats a controller binding"]
    return [f"declarations.json binding {g} is not the repository's" for g in got if g not in want] + [
        f"the repository's controller binding {w} is not in declarations.json" for w in want if w not in got]


def keys_06(c):
    decl = load(c.pop / "rail" / "rail.json")
    if (c.pop / "rail" / decl["public_key"]).read_bytes() != (c.work / "rail-key.pub.pem").read_bytes():
        return ["rail-key.pub.pem is not the repository's rail key"]
    return []


def keys_07(c, m):
    pubs, bad = node_pubs(c.pop), []
    # Every ask the step puts to every node pair is in the proof, so a proof cut down to nothing to judge can't read PASS.
    for a in pubs:
        for b in pubs:
            if a != b:
                bad += [f"the proof holds no {a}/asks/{b}/{name}/request.json" for name in sorted(m.ASKS)
                        if not (c.work / a / "asks" / b / name / "request.json").is_file()]
    for n in nodes_of(c.work, c.pop):
        f = c.work / n / "advertised" / "book.json"
        got = load(f).get("node_key") if f.is_file() else None
        if f.is_file() and got != pubs[n]:
            bad.append(f"{n}/advertised/book.json node_key {got} is not the repository key of node {n}")
    bad += [f"the proof holds no book of node {n}" for n in sorted(pubs) if not (c.work / n / "advertised" / "book.json").is_file()]
    return bad + keys_commitments(c, "{n}/advertised/commitment.json")


def keys_09(c, m):
    """The dispute is the repository's (roles, node ids, key directories), byte for byte; the announced keys are its keys."""
    repo = c.pop / "step09" / "dispute.json"
    if repo.read_bytes() != (c.work / "dispute.json").read_bytes():
        return ["dispute.json is not the repository's step09/dispute.json"]
    doc, announced = load(c.work / "dispute.json"), load(c.work / "announced.json")["announced_keys"]
    bad = []
    for name, entry in doc["nodes"].items():
        want = pub_key(m.key_dir_of(c.pop, name, entry) / "node-key.pub.pem")
        if announced.get(entry["node_id"]) != want:
            bad.append(f"announced.json key of {name} is {announced.get(entry['node_id'])}, the repository's is {want}")
    return bad


# --- Re-derivation: the step's own judge on the copied proof bytes ------------------------
# Each returns the re-derived finding (a dict), or raises Unreproducible.
def rederive_01(m, c):
    python, verifier = m.tools()
    _, missing = m.installed_pins(python, verifier)
    missing = [x for x in missing if x["what"] != "capsule-emit"]  # nothing is sealed again
    if missing:
        raise Unreproducible("step 01: its judge, run again here", "; ".join(x["why"] for x in missing))
    node = load(c.work / "checks.json")["node"]
    # The step's own --sealed path: it checks the given capsule exactly as it checks one it sealed.
    m.main(["--population", str(c.pop), "--out", str(c.work), "--node", node, "--sealed", str(c.bundle / "capsule.json")])
    return load(c.work / "finding.json")


def rederive_02(m, c):
    bin_ = need(m.driver(), "step 02", "the loop-step02-book driver")
    population, _, pub = m.node(c.pop, "alice")
    return m.decide(bin_, c.work, population=population, book_id=f"{population}-alice", pub=pub, started=c.started)


def rederive_03(m, c):
    if shutil.which("git") is None:
        raise Unreproducible("step 03: its judge, run again here", "git is not installed where 08 runs")
    if shutil.which("openssl") is None:
        raise Unreproducible("step 03: its judge, run again here", "openssl is not installed where 08 runs")
    src = c.tmp / "carrier.bundle"
    shutil.copyfile(c.work / "carrier.bundle", src)
    inputs = {n["name"]: n.get("inputs") for n in load(c.work / "verification.json").get("nodes", [])}

    def from_bundle(population, node, carrier):
        # In place of signing and publishing: the carrier is the bundle's, and check_node reads its HEAD.
        if m.git(carrier, "rev-parse", "-q", "--verify", "HEAD", check=False).returncode != 0:
            m.git(carrier, "fetch", "-q", str(src), "HEAD")
            m.git(carrier, "reset", "-q", "--hard", "FETCH_HEAD")
        key_id = pub_key(repo_path(node["key_dir"]) / "node-key.pub.pem")
        return {"name": node["name"], "node_id": node.get("node_id") or key_id, "key_id": key_id,
                "inputs": inputs.get(node["name"]), "signed_by": "the harness, with the node's rehearsal TEST key",
                "published_commit": m.git(carrier, "rev-parse", "HEAD").stdout.decode().strip()}, key_id

    m.rehearsal_node = from_bundle
    m.main(["--population", str(c.pop), "--out", str(c.work)])
    # The judge writes its commitment and policy files again from the carrier; the cited ones must be those bytes,
    # or a corrupted cited file would be replaced by a good one before it is judged.
    changed = [p["path"] for p in c.record["proof"] if p["path"].endswith((".commitment.json", ".policy.json"))
               and (c.work / p["path"]).read_bytes() != (c.bundle / p["path"]).read_bytes()]
    if changed:
        raise Mismatch(f"the judge's own copy of {', '.join(changed)} differs from the cited bytes")
    return load(c.work / "finding.json")


def rederive_04(m, c):
    bin_ = need(m.capsulectl(), "step 04", "capsulectl")
    buyer = m.book_keys.pub_hex(repo_path(next(n["key_dir"] for n in load(c.pop / "population.json")["nodes"]
                                               if n["name"] == "bob")) / "node-key.pub.pem")
    results, outcomes, proof = {}, {}, []
    names = sorted({Path(p["path"]).parts[1] for p in c.record["proof"] if p["path"].startswith("scenarios/")})
    for name in names:
        sd = c.work / "scenarios" / name
        verdict = m.verify_bundle(bin_, c.tmp / "04", sd / "bundle.json")
        (sd / "verify.json").write_text(json.dumps(verdict, indent=2, sort_keys=True) + "\n")
        results[name], block = m.judge(sd, verdict, buyer)
        if block is not None:
            outcomes[name] = m.verdict_of(block)
        proof += [f"scenarios/{name}/{f}" for f in ("bundle.json", "verify.json", "decision.json")]
    # main_rehearsal's decision, as it writes it: FAIL when a check did not hold, else PASS; never not_checked.
    refused = sorted(n for n, o in outcomes.items() if o == "NO")
    counts = {"decisions": len(outcomes), "refused": len(refused),
              "by_outcome": {o: sum(1 for x in outcomes.values() if x == o) for o in m.VERDICTS}}
    (c.work / "counts.json").write_text(json.dumps(counts, indent=2, sort_keys=True) + "\n")
    failed = [f"{n}: {x['check']}" for n, cs in results.items() for x in cs if not x["ok"]]
    return {"result": "FAIL" if failed else "PASS", "not_checked": []}


