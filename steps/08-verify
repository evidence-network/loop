def rederive_06_live(m, c):
    """Live 06 on the Lightning rail (loop#243): its own main_lightning on the copied proof. Each node's
    recorded.json is the record 06 read from its ledger, so the ruled checks (reference, finality, band, rail_fee,
    exchange_match) run again on them. counterparty_count is decided from counterparty.json's rows by 06's own
    counterparty_verdict: 08 takes each row's status, bundle sha256, disclosed count and bundle settlement count from
    06 (the check files and signed bundles are not in the proof) and decides again that the bundle's settlements and
    the books' pairs in the window both number what the books pair here, with no undated or unmatched settlement
    counted (loop#303). An open check 06 made because it could not read the bundle (missing, changed, or no bundle)
    is 06's word, never a pass; a row judged under another window than the population's is a mismatch. checks.json is written again and must be the cited bytes; counterparty.json is validated as rows and
    carried."""
    old_shape(c, "06", "checks.json")
    old_shape(c, "06", "counterparty.json")
    pop = load(c.pop / "population.json")
    if pop.get("rail") != "lightning":
        raise Unreproducible("step 06: its live result re-derived from its proof bytes",
                             f"08 re-derives the live Lightning rail only, not {pop.get('rail')!r}", LIVE_ISSUE)
    ids = {n["name"]: n.get("node_id") for n in pop["nodes"]}
    recorded_checks = load(c.bundle / "checks.json")  # unlinked from the copy: the judge writes it again
    if not isinstance(recorded_checks, dict):
        raise Mismatch("checks.json is not an object of checks")
    rows = load(c.bundle / "counterparty.json")
    keys = {"books_only", "books_pair", "bundle_only", "bundle_settlements", "bundle_sha256", "bundle_undated",
            "disclosed_settlements", "method", "node", "paired", "peer", "status", "unpaired", "window_from"}
    since = m.window_from(pop)
    window = since.strftime("%Y-%m-%dT%H:%M:%SZ") if since is not None else None
    if isinstance(rows, list) and rows and all(isinstance(r, dict) and "books_pair" not in r for r in rows):
        raise Unreproducible("step 06: its live result re-derived from its proof bytes",
                             "its counterparty.json rows carry no window counts: the finding predates the proof shape "
                             "08 re-derives (loop#303)", OLD_SHAPE_ISSUE)
    pairs = {}
    for r in rows if isinstance(rows, list) else [None]:
        if not (isinstance(r, dict) and set(r) == keys and r["node"] in ids and r["peer"] in ids
                and r["node"] != r["peer"] and (r["node"], r["peer"]) not in pairs
                and all(type(r[k]) is int for k in ("paired", "unpaired")) and isinstance(r["status"], str)
                and isinstance(r["bundle_sha256"], str)):
            raise Mismatch(f"counterparty.json holds a row that is not one check of a node's book against a peer's "
                           f"signed bundle: {json.dumps(r, sort_keys=True)[:200]}")
        if r["window_from"] != window:
            raise Mismatch(f"counterparty.json's row for {r['node']} against {r['peer']} was judged with the window from "
                           f"{r['window_from']}, and the population's window is from {window}")
        pairs[(r["node"], r["peer"])] = r
    judge = m.lightning_checks

    def lightning_checks(found, _ids, _checks_dir, since=None):
        checks, _ = judge(found, ids, None, since)  # checks 1-5; the counterparty entries are decided from the rows
        cross = m.crosscheck(found, every_node=False)
        expected = {}
        for p in cross["paired"].values():
            k = tuple(sorted((p["payer"], p["payee"])))
            expected[k] = expected.get(k, 0) + 1
        for (me, peer), r in sorted(pairs.items()):
            what = f"counterparty_count:{me}:{peer}"
            n = expected.get(tuple(sorted((me, peer))), 0)
            ok, detail = m.counterparty_verdict(r, n, since)
            kept = recorded_checks.get(what)
            if ok is not False and isinstance(kept, dict) and kept.get("ok") is None and str(kept.get("detail")).startswith(
                    f"{me}'s check names a"):
                # 06 could not read the bundle (missing, changed or no bundle): its word, only ever open, never a pass.
                ok, detail = None, kept["detail"]
            checks[what] = {"ok": ok, "detail": detail}
        return checks, [pairs[k] for k in sorted(pairs)]

    m.lightning_checks = lightning_checks
    found, proof, details, not_checked = {}, [], [], []
    for n in pop["nodes"]:
        if (c.work / n["name"] / "recorded.json").is_file():
            found[n["name"]] = load(c.work / n["name"] / "recorded.json")
            proof.append(f"{n['name']}/recorded.json")
        else:
            not_checked.append(m.live.not_checked(n["name"], "data_dir"))
            details.append(f"node {n['name']}: not checked, data_dir or its ledger not set or unreadable")
    m.main_lightning(pop, c.work, c.started, found, proof, details, not_checked)
    return load(c.work / "finding.json")


