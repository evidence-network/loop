def keys_02_live(c, m):
    """The witness listing 02 cites is the repository's (lab/witness/witnesses.json), and each listed node's key
    02 kept in inputs.json is the key its nodes/ listing publishes."""
    old_shape(c, "02", "nodes.json")  # an older shape is not_reproduced before anything is held to the repository
    bad = []
    receipts = list(c.work.glob("*/witness-status.json"))
    kept_listing = c.work / "witnesses.json"
    if receipts and not kept_listing.is_file():
        bad.append("a receipt is judged, but the proof cites no witnesses.json to hold it to")
    if kept_listing.is_file() and (not m.LISTING.is_file() or m.LISTING.read_bytes() != kept_listing.read_bytes()):
        bad.append("witnesses.json is not the repository's lab witness listing")
    ids = {n["name"]: n.get("node_id") for n in load(c.pop / "population.json")["nodes"]}
    pop_nodes = load(c.pop / "population.json")["nodes"]
    listed_keys = {listed(n.get("node_id")) for n in pop_nodes} - {None}
    books = join_commitment_books()
    for p in sorted(c.work.glob("*/inputs.json")):
        kept, name = load(p), p.parent.name
        node_id = ids.get(name)
        listing = nodes_dir() / f"{node_id}.json"
        if kept.get("node_pub") is None:
            continue  # a failed stage before the key was read: judge_live FAILs it
        # Each node's receipt is held apart from that node's own node_keys: each must hold every listed key.
        if not listed_keys <= set(kept.get("node_keys") or []):
            state_relies(c, "02", f"node {name}'s node keys a receipt is held apart from (not every listed node "
                                  "key is among them)")
        if not (node_id and listing.is_file()):
            c.relies.append({"what": f"step 02: node {name}'s key, book and trusted keys", "why": "the node has no "
                             "nodes/ listing, so the key, book id, checkpoint key and the keys the book's profile "
                             "trusts (`bound`) inputs.json records are 02's reading of its data_dir",
                             "issue": TRUST_ISSUE})
            continue
        if kept["node_pub"] != load(listing).get("key_id"):
            bad.append(f"{name}/inputs.json node_pub is not the key nodes/{node_id}.json lists")
            continue
        # The book and its checkpoint key are held to a join commitment the node signed (lab/runs). The keys the
        # book's profile trusts (`bound`) are in nothing the node signs, so they are always 02's reading.
        joined = (kept.get("book_id"), kept.get("book_key")) in books.get(kept["node_pub"], set()) and \
            kept.get("checkpoint_pub") == kept.get("book_key")
        state_relies(c, "02", f"node {name}'s " + ("" if joined else "book id and checkpoint key (no join "
                              "commitment the node signed under lab/runs names them), and its book's ") +
                     "trusted keys (`bound`, read from the book's profile on the node)")
    try:
        kept_nodes = load(c.work / "nodes.json")
        read_all = not kept_nodes["missing"] and all(
            (kept_nodes["nodes"].get(n["name"]) or {}).get("read") == "ok" for n in pop_nodes)
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        read_all = False
    if not read_all:
        state_relies(c, "02", "what nodes.json says of each node (read, or why not) and the pins missing")
    marked = {p.parent.name: load(p).get("receipt_check") == m.RECEIPT_CHECK for p in c.work.glob("*/inputs.json")}
    held_offline = [p.parent.name for p in receipts if marked.get(p.parent.name)]
    if held_offline and m.driver() is None:  # 02's judge verifies those receipts offline with the step 02 driver
        raise Unreproducible("step 02: its judge, run again here",
                             "the step 02 driver (loop-step02-book lab-check) is not installed where 08 runs; "
                             "steps/02-book.setup.sh installs it")
    if held_offline and not openssl_ed25519():  # and checks each signature again with openssl
        raise Unreproducible("step 02: its judge, run again here",
                             "openssl 3.0 or later (Ed25519 pkeyutl -rawin) is not installed where 08 runs")
    if len(held_offline) < len(receipts):  # a run before the offline check: the receipt is capsulectl's reading
        c.relies.append({"what": "step 02: each witness receipt's verified state",
                         "why": "the run predates 02's offline receipt check, so the state is capsulectl's "
                                "re-verification against the node's book on the lab, not a check 08 makes from the "
                                "bundle", "issue": WITNESS_ISSUE})
    return bad


def git(*args, root=None):
    """stdout of git in the repository (root, else ROOT), or None when git fails."""
    r = subprocess.run(["git", "-C", str(root or ROOT), *args], capture_output=True)
    return r.stdout if r.returncode == 0 else None


def revocations_anchor(m, c, nn, snap):
    """Hold the main commit C a live 05 or 12 read nodes/revocations/ from (`snap`, nodes.json's revocations_main) to
    this clone's origin/main A, which the run does not choose (loop#281): nodes.json is unsigned, so C alone could be
    an older commit from before a statement merged. Returns None when the judge's run at C is all there is to check:
    there is no C (the judge then declares no list and revocation stays NOT_CHECKED, never PASS), or
    nodes/revocations/ is the same tree at C and A. Otherwise returns A, and the caller judges again with the lists
    at A (judge_at_anchor). Which statements A holds is this checkout's main (steps/08-verify.md, T2)."""
    commit = snap.get("commit") if isinstance(snap, dict) else None
    if commit is None:
        return None
    if not (isinstance(commit, str) and re.fullmatch(r"[0-9a-f]{40}", commit)):
        raise Mismatch(f"{c.work.name}: nodes.json's revocations commit {commit!r} is not a commit id")
    root = m.revocations_root()
    if not m.bv.holds_on_main(root, commit):  # 08's clone may be behind the run's fetch
        raise Unreproducible(f"step {nn}: its revocation reads, run again here",
                             f"this clone's origin/main does not hold the commit {commit[:12]} {nn} read "
                             "nodes/revocations/ from (fetch main's history)")
    anchor = (git("rev-parse", "--verify", "-q", "origin/main^{commit}", root=root) or b"").decode().strip()
    if not anchor:  # holds_on_main passed, so origin/main is there; never trust C in its place
        raise Unreproducible(f"step {nn}: its revocation reads, run again here",
                             "this clone's origin/main cannot be read to hold them to")
    folder = f"nodes/{m.bv.REVOCATIONS}"
    same = git("rev-parse", "--verify", "-q", f"{commit}:{folder}", root=root) == \
        git("rev-parse", "--verify", "-q", f"{anchor}:{folder}", root=root)  # absent at both is the same (None)
    return None if same else anchor


def judge_at_anchor(m, c, nn, anchor):
    """The judge again, on a fresh copy of the proof whose nodes.json reads nodes/revocations/ at `anchor`
    (revocations_anchor): judge_live takes the commit from nodes.json alone. The same started and bind_at keep the
    declaration time and the times asked about. Its result, and its not_checked by what and issue, must be the
    recorded ones; each why may name the anchor's commit and list digest. A statement merged since C that applies at
    those times turns a recorded PASS into a Mismatch, and one removed since C that applied turns a recorded FAIL into
    one, never a pass. This copy's re-written files are never compared: the cited bytes are held to the run at C."""
    work = Path(c.tmp) / "revocations-at-anchor" / c.work.name
    for p in c.record["proof"]:
        if any(fnmatch.fnmatchcase(p["path"], g) for g in LIVE_AGAIN.get(nn, [])):
            continue  # the judge writes it again, as on the first run
        (work / p["path"]).parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(c.bundle / p["path"], work / p["path"])
    kept = load(work / "nodes.json")
    commit = kept["revocations_main"]["commit"]
    kept["revocations_main"] = {"commit": anchor}
    (work / "nodes.json").write_text(json.dumps(kept, indent=2, sort_keys=True) + "\n")
    again = m.judge_live(load(c.pop / "population.json"), work, c.started)

    def gaps(f):
        return sorted({json.dumps([x.get("what"), x.get("issue")]) for x in f["not_checked"]})
    if again["result"] != c.record["result"] or gaps(again) != gaps(c.record):
        raise Mismatch(f"{c.work.name}: re-derived with nodes/{m.bv.REVOCATIONS}/ as main held it at {anchor[:12]} "
                       f"(this clone's origin/main): {again['result']}, not_checked {gaps(again)}; recorded "
                       f"{c.record['result']}, not_checked {gaps(c.record)} with the list at {commit[:12]}: the step "
                       "read a different revocation list than main holds")


