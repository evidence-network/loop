STEPS = {
    "01": (rederive_01, keys_01),
    "02": (rederive_02, keys_02),
    "03": (rederive_03, lambda c: keys_commitments(c, "{n}.commitment.json")),
    "04": (rederive_04, keys_04),
    "05": (rederive_05, keys_05),
    "06": (rederive_06, keys_06),
    "07": (rederive_07, keys_07),
    "09": (rederive_09, keys_09),
    "12": (rederive_12, lambda c: keys_commitments(c, "{n}/commitment.json")),
}


# Live steps 08 re-derives: their judge reads only the proof and the repository. Every other live step's judge
# reads a lab node's data dir or console while it decides (LIVE_ISSUE).
LIVE_STEPS = {"01": (rederive_01_live, keys_01_live), "02": (rederive_02_live, keys_02_live), "03": (rederive_03_live, keys_03_live), "04": (rederive_04_live, keys_04_live), "07": (rederive_07_live, keys_07_live)}

# Key checks that read the step module too (its ASKS, its key_dir_of).
NEEDS_MODULE = {"01", "02", "07", "09"}


def canon(items):
    return sorted(json.dumps(x, sort_keys=True) for x in items)


def mismatches(recorded, again):
    """What differs between the recorded finding and the re-derived one: result, then not_checked."""
    out = []
    if again["result"] != recorded["result"]:
        out.append(f"recorded {recorded['result']}, re-derived {again['result']}"
                   + (f" ({str(again.get('detail', ''))[:600]})" if again["result"] == "FAIL" else ""))
    if canon(again["not_checked"]) != canon(recorded["not_checked"]):
        out.append(f"recorded not_checked {canon(recorded['not_checked'])}, re-derived {canon(again['not_checked'])}")
    return out


def verify_step(d, pop_dir, population, tmp):
    """One step's manifest entry: {step, name, status, recorded, rederived, problems, not_checked, files}."""
    nn, name = d.name.split("-", 1)
    entry = {"step": nn, "name": name, "dir": d.name, "recorded": None, "rederived": None, "problems": [],
             "not_checked": None, "files": []}

    def done(status):
        entry["status"] = status
        return entry

    f = d / "finding.json"
    try:
        record = load(f)
    except (OSError, ValueError) as e:
        entry["problems"].append(f"finding.json is not readable JSON ({e})")
        return done("failed")
    entry["files"].append({"path": "finding.json", "sha256": finding.sha256(f)})
    if not isinstance(record, dict):
        entry["problems"].append("finding.json is not an object")
        return done("failed")
    try:
        errs = finding.check_record(d, record)
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as e:
        errs = [f"finding.json could not be checked ({type(e).__name__}: {str(e)[:200]})"]
    if errs:
        entry["problems"] += errs
        return done("failed")
    entry["recorded"] = {"result": record["result"], "not_checked": record["not_checked"]}
    entry["files"] += [{"path": p["path"], "sha256": finding.sha256(d / p["path"])} for p in record["proof"]]
    if record["population"] != population:
        entry["problems"].append(f"population is {record['population']}, this run is {population}")
        return done("failed")

    # Only the cited proof bytes, in a dir named as the step's, so the judge sees nothing else.
    work = Path(tmp) / "work" / d.name
    scratch = Path(tmp) / "scratch" / d.name
    work.mkdir(parents=True)
    scratch.mkdir(parents=True)
    for p in record["proof"]:
        (work / p["path"]).parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(d / p["path"], work / p["path"])
    c = Ctx(d, work, scratch, pop_dir, record)

    try:
        if record["asserts"] == BROKE and record["result"] == "FAIL":
            raise Unreproducible(f"step {nn}: its result re-derived from its proof bytes",
                                 "loop.sh wrote this FAIL because the step broke before writing its own finding; "
                                 "there is no judged result to run again", BROKE_ISSUE)
        if record["result"] == "NOT_CHECKED" and not record["proof"] and nn in EMPTY_PROOF_STEPS:
            # Nothing to judge again, and no key in the proof to check: not reproduced, never a key check FAIL
            # (loop#204). What the step says of why is its claim, which 08 cannot check, so it is quoted as such.
            raise Unreproducible(f"step {nn}: its result re-derived from its proof bytes",
                                 "its finding cites no proof, so 08 has nothing to judge again; the step says: "
                                 + "; ".join(f"{x['what']}: {x['why']}" for x in record["not_checked"]), EMPTY_ISSUE)
        if population != "rehearsal" and nn not in LIVE_STEPS:
            raise Unreproducible(f"step {nn}: its live result re-derived from its proof bytes",
                                 "its live judge reads a lab node's data dir or console while it decides, and the "
                                 "finding does not cite those bytes", LIVE_STEP_ISSUES.get(nn, LIVE_ISSUE))
        steps = STEPS if population == "rehearsal" else LIVE_STEPS
        if nn not in steps:
            raise Unreproducible(f"step {nn}: its result re-derived from its proof bytes",
                                 "08 has no re-derivation for this step", STAGE1_ISSUE)
        rederive, keys = steps[nn]
        if not (HERE / d.name).is_file():
            raise Unreproducible(f"step {nn}: its result re-derived from its proof bytes",
                                 f"there is no step script steps/{d.name} to take its judge from", STAGE1_ISSUE)
        m = step_module(d.name)
        try:
            bad = keys(c, m) if nn in NEEDS_MODULE else keys(c)
        except (OSError, ValueError, KeyError, TypeError, AttributeError) as e:
            bad = [f"the keys in the proof could not be read ({e})"]
        if bad:
            entry["problems"] += bad
            return done("failed")
        again_files = [p["path"] for p in record["proof"] if any(
            fnmatch.fnmatchcase(p["path"], g) for g in NUMBERS.get(nn, []) + (
                LIVE_AGAIN.get(nn, []) if population != "rehearsal" else []))]
        if population != "rehearsal":
            for n in again_files:
                (work / n).unlink()
        again = rederive(m, c)
    except Unreproducible as e:
        what, why, issue = e.args
        entry["not_checked"] = {"what": what, "why": why, "issue": issue}
        return done("not_reproduced")
    except Mismatch as e:
        entry["problems"].append(str(e))
        return done("failed")
    except (Exception, SystemExit) as e:  # the step's judge broke on bytes it had decided on
        entry["problems"].append(f"the step's judge did not run to the end on its proof bytes ({type(e).__name__}: "
                                 f"{str(e)[:300]})")
        return done("failed")

    entry["rederived"] = {"result": again["result"], "not_checked": again["not_checked"]}
    if population != "rehearsal":
        entry["relies_on"] = LIVE_RELIES_ON.get(nn, []) + c.relies
    entry["problems"] += mismatches(record, again)
    # Each cited file the judge writes again (a pattern may match one per node) must be the recorded bytes.
    entry["problems"] += [f"{n} re-derived is not the recorded {n}" for n in again_files
                          if not (work / n).is_file() or (work / n).read_bytes() != (d / n).read_bytes()]
    return done("failed" if entry["problems"] else "reproduced")


def expected_steps(run):
    """The step numbers run.json says the run holds, or None when it does not say."""
    try:
        steps = load(Path(run) / "run.json").get("steps")
    except (OSError, ValueError, AttributeError):
        return None
    ok = isinstance(steps, list) and steps and all(isinstance(s, str) and re.fullmatch(r"\d\d", s) for s in steps)
    return steps if ok else None


def verify_run(run, out, pop_dir, population):
    """[manifest entries] for every step dir in run except out's, and one failed entry for each step
    run.json lists that has no dir."""
    entries = []
    own = Path(out).resolve().name.split("-", 1)[0]
    for nn in expected_steps(run) or []:
        if nn != own and not any(finding.STEP_DIR.match(f.parent.name) for f in Path(run).glob(f"{nn}-*/finding.json")):
            entries.append({"step": nn, "name": None, "dir": f"{nn}-?", "recorded": None, "rederived": None,
                            "problems": [f"run.json lists step {nn} but the run holds no {nn}-*/finding.json"],
                            "not_checked": None, "files": [], "status": "failed"})
    for d in sorted(p for p in Path(run).iterdir() if p.is_dir()):
        if d.resolve() == Path(out).resolve() or not finding.STEP_DIR.match(d.name):
            continue
        with tempfile.TemporaryDirectory(prefix="08-verify-") as tmp:
            entries.append(verify_step(d, pop_dir, population, tmp))
    return entries


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--population", required=True, type=Path)
    ap.add_argument("--out", required=True, type=Path)
    a = ap.parse_args(argv)
    started = finding.now()
    out = a.out.resolve()
    out.mkdir(parents=True, exist_ok=True)
    for p in ("finding.json", "verified.json"):
        (out / p).unlink(missing_ok=True)
    population = load(a.population / "population.json")["population"]
    entries = verify_run(out.parent, out, a.population.resolve(), population)

    failed = [e for e in entries if e["status"] == "failed"]
    unrun = [e for e in entries if e["status"] == "not_reproduced"]
    not_checked = [e["not_checked"] for e in unrun]
    # A reproduced live step still names what it rests on, so 08 never reads PASS over it.
    not_checked += [x for e in entries if e["status"] == "reproduced" for x in e.get("relies_on", [])]
    listed = expected_steps(out.parent)
    if listed is None:
        not_checked.append({"what": "which steps the run holds",
                            "why": f"{out.parent.name}/run.json lists no steps, so 08 cannot tell a step left out "
                                   "from a step never run",
                            "issue": RUN_ISSUE})
    else:
        # The stage's steps are loop.sh's list, so a run.json cut down to fewer steps can't read as the whole stage.
        stage = load(out.parent / "run.json").get("stage")
        full = STAGES.get(stage) if isinstance(stage, str) else None
        if full is None:
            not_checked.append({"what": "which steps the stage holds",
                                "why": f"run.json names stage {stage!r}, which loop.sh does not list", "issue": RUN_ISSUE})
        else:
            own = out.name.split("-", 1)[0]
            not_checked += [{"what": f"step {nn}: its finding reproduced",
                             "why": f"this run did not run step {nn} of stage {stage} (run.json lists "
                                    f"{', '.join(listed)})", "issue": RUN_ISSUE} for nn in full if nn not in listed and nn != own]
    if not entries:
        not_checked = [{"what": "the run's findings", "why": f"{out.parent.name} holds no other step's finding",
                        "issue": RUN_ISSUE}]
    result = "FAIL" if failed else ("NOT_CHECKED" if not_checked else "PASS")
    manifest = {"run": out.parent.name, "population": population, "result": result, "steps": entries,
                "run_json": {"sha256": finding.sha256(out.parent / "run.json") if (out.parent / "run.json").is_file() else None,
                             "steps": listed}}
    (out / "verified.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")

    lines = []
    for e in entries:
        if e["status"] == "reproduced":
            lines.append(f"{e['dir']}: reproduced {e['recorded']['result']}")
        elif e["status"] == "not_reproduced":
            lines.append(f"{e['dir']}: recorded {e['recorded']['result']}, not reproduced")
        else:
            lines.append(f"{e['dir']}: did not hold: {'; '.join(e['problems'])}")
    detail = (f"run {out.parent.name}, offline, from the bundle and the repository's keys only: "
              + ("; ".join(lines) or "no step findings") + ". The manifest, per step, is this step's proof file.")
    pinned = sorted({n for e in entries if e["status"] == "reproduced"
                     for n in load(out.parent / e["dir"] / "finding.json")["pinned"]})
    finding.write(out, result=result, population=population, asserts=ASSERTS, pinned=pinned, proof=["verified.json"],
                  detail=detail, not_checked=not_checked, started=started)
    print(f"08-verify: {result}: {detail}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
