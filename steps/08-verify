def old_shape(c, nn, name):
    """Unreproducible when the live finding's proof lacks `name`, the file its re-derivable shape always holds: the
    finding predates that shape, so it is not reproduced, never failed."""
    if name not in {p["path"] for p in c.record["proof"]}:
        raise Unreproducible(f"step {nn}: its live result re-derived from its proof bytes",
                             f"its proof holds no {name}: the finding predates the proof shape 08 re-derives",
                             OLD_SHAPE_ISSUE)


def rederive_01_live(m, c):
    """Live 01: its own judge_live on the copied proof (nodes.json, each node's capsule.json and node-key.pub.pem),
    with the pinned cross_language verifier; nothing is sealed again."""
    old_shape(c, "01", "nodes.json")
    python, verifier = m.tools()
    _, missing = m.installed_pins(python, verifier)
    missing = [x for x in missing if x["what"] != "capsule-emit"]  # nothing is sealed again
    if missing:
        raise Unreproducible("step 01: its judge, run again here", "; ".join(x["why"] for x in missing))
    return m.judge_live(load(c.pop / "population.json"), c.work, c.started)


def keys_01_live(c, m):
    """Each node key 01 kept beside its capsule is the key its nodes/ listing publishes (01's own listing dir), so
    the capsule is judged under the repository's key, never one the bundle supplies."""
    bad = []
    for p in sorted(c.work.glob("*/node-key.pub.pem")):
        name = p.parent.name
        node_id = next((n.get("node_id") for n in load(c.pop / "population.json")["nodes"] if n["name"] == name), None)
        listed = m.listed_key(m.nodes_dir(), node_id) if node_id else None
        if listed is None:
            continue  # an unlisted node: 01's signature check names it (not_checked), and its key is the node's word
        if m.raw_public_hex(p) != listed:
            bad.append(f"{name}/node-key.pub.pem is not the key nodes/{node_id}.json lists")
    return bad


def rederive_02_live(m, c):
    """Live 02: its own judge_live on the copied proof (nodes.json, each node's inputs.json and proof files):
    capsulectl verify --bundle runs again on each bundle, offline, and 02's checks on the files."""
    old_shape(c, "02", "nodes.json")
    _, missing = m.capsulectl()
    if missing:
        raise Unreproducible("step 02: its judge, run again here", "; ".join(x["why"] for x in missing))
    return m.judge_live(load(c.pop / "population.json"), c.work, c.started)


def keys_02_live(c, m):
    """The witness listing 02 cites is the repository's (lab/witness/witnesses.json), and each listed node's key
    02 kept in inputs.json is the key its nodes/ listing publishes."""
    bad = []
    receipts = list(c.work.glob("*/witness-status.json"))
    kept_listing = c.work / "witnesses.json"
    if receipts and not kept_listing.is_file():
        bad.append("a receipt is judged, but the proof cites no witnesses.json to hold it to")
    if kept_listing.is_file() and (not m.LISTING.is_file() or m.LISTING.read_bytes() != kept_listing.read_bytes()):
        bad.append("witnesses.json is not the repository's lab witness listing")
    ids = {n["name"]: n.get("node_id") for n in load(c.pop / "population.json")["nodes"]}
    nodes_dir = Path(os.environ.get("LOOP_NODES_DIR", ROOT / "nodes"))  # as 01 and 05 read the listings
    for p in sorted(c.work.glob("*/inputs.json")):
        kept, name = load(p), p.parent.name
        node_id = ids.get(name)
        listing = nodes_dir / f"{node_id}.json"
        if kept.get("node_pub") is None:
            continue  # a failed stage before the key was read: judge_live FAILs it
        if not (node_id and listing.is_file()):
            c.relies.append({"what": f"step 02: node {name}'s key", "why": "the node has no nodes/ listing, so the "
                             "key inputs.json records is 02's reading of its data_dir", "issue": TRUST_ISSUE})
        elif kept["node_pub"] != load(listing).get("key_id"):
            bad.append(f"{name}/inputs.json node_pub is not the key nodes/{node_id}.json lists")
    if receipts:
        c.relies.append({"what": "step 02: each witness receipt's verified state",
                         "why": "08 runs 02's witness checks again on witness-status.json, but the state is "
                                "capsulectl's re-verification against the node's book on the lab, not a check 08 "
                                "makes from the bundle", "issue": WITNESS_ISSUE})
    return bad


def rederive_03_live(m, c):
    """Live 03: its own judge_live on the copied proof (carrier.json and each node's commitment and policy, as the
    carrier's HEAD held them). It verifies each commitment with step 03's checker under the listed key."""
    old_shape(c, "03", "carrier.json")
    if not openssl_ed25519():
        raise Unreproducible("step 03: its judge, run again here",
                             "openssl 3.0 or later (Ed25519 pkeyutl -rawin) is not installed where 08 runs")
    return m.judge_live(load(c.pop / "population.json"), c.work, c.started)


def keys_03_live(c):
    """Live 03's keys and carrier bytes, held to this checkout.

    Each node's listed key_id in carrier.json (None when HEAD listed none) must be what nodes/<node_id>.json lists
    here; otherwise not_reproduced (a key rotated since, or one never listed, loop#193). When carrier.json's head
    is a full commit id that this checkout holds, 08 works out each node's paths itself from that commit (its
    listing, its commitment and the policy the commitment names) and every one must be what carrier.json says HEAD
    held, byte for byte; a path carrier.json leaves out is checked too. Otherwise the bytes are not compared, and
    that is a not_checked entry on loop#193."""
    if "carrier.json" not in {p["path"] for p in c.record["proof"]}:
        return []  # an older shape: rederive_03_live says so
    doc = load(c.work / "carrier.json")
    nodes = doc.get("nodes") if isinstance(doc.get("nodes"), dict) else {}
    for name, entry in sorted(nodes.items()):
        if not isinstance(entry, dict):
            continue  # judge_live FAILs it
        listing = ROOT / "nodes" / f"{entry.get('node_id')}.json"
        listed = load(listing).get("key_id") if entry.get("node_id") and listing.is_file() else None
        if entry.get("node_id") and entry.get("key_id") != listed:
            raise Unreproducible(f"step 03: {name}'s listed key at the carrier's HEAD",
                                 "it is not the key nodes/ lists for the node in this checkout (a key rotated since "
                                 "the run, or a key the repository never listed)", TRUST_ISSUE)
    head = doc.get("head")
    full = isinstance(head, str) and re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", head)
    have = full and subprocess.run(["git", "-C", str(ROOT), "cat-file", "-e", f"{head}^{{commit}}"],
                                   capture_output=True).returncode == 0
    if not have:
        c.relies.append({"what": "step 03: the carrier's HEAD held the listing, commitment and policy bytes cited",
                         "why": (f"carrier.json's commit {head} is not in the checkout 08 runs in" if full else
                                 f"carrier.json names no full commit id ({head!r})") + ", so the bytes are not "
                                "compared with it", "issue": TRUST_ISSUE})
        return []

    def at(path):
        r = subprocess.run(["git", "-C", str(ROOT), "show", f"{head}:{path}"], capture_output=True)
        return r.stdout if r.returncode == 0 else None

    bad = []
    for name, entry in sorted(nodes.items()):
        if not isinstance(entry, dict) or not entry.get("node_id"):
            continue
        node_id, paths = entry["node_id"], entry.get("paths") if isinstance(entry.get("paths"), dict) else {}
        listing = at(f"nodes/{node_id}.json")
        try:
            listed_then = json.loads(listing)["key_id"] if listing is not None else None
        except (ValueError, KeyError, TypeError):
            listed_then = None
        if entry.get("key_id") != listed_then:
            bad.append(f"{name}: the listed key carrier.json records is not what nodes/{node_id}.json held at {head[:12]}")
        commitment = f"nodes/commitments/{node_id}.json"
        expect = {commitment: (at(commitment), c.work / f"{name}.commitment.json")}
        try:
            uri = json.loads(expect[commitment][0])["lcap"]["policy_uri"] if expect[commitment][0] else None
        except (ValueError, KeyError, TypeError):
            uri = None
        if isinstance(uri, str) and not ("://" in uri or uri.startswith("/") or ":" in uri.split("/")[0]):
            expect[f"nodes/commitments/{uri}"] = (at(f"nodes/commitments/{uri}"), c.work / f"{name}.policy.json")
        for path, (then, mine) in sorted(expect.items()):
            if bool(paths.get(path)) != (then is not None) or (then is not None and (
                    not mine.is_file() or mine.read_bytes() != then)):
                bad.append(f"{name}: {path} is not what the carrier's commit {head[:12]} holds")
        bad += [f"{name}: carrier.json says HEAD held {p}, which 03 never reads" for p in sorted(set(paths) - set(expect))]
    return bad


