def keys_12_live(c):
    """nodes.json's self node and own consoles are population nodes. The keys live 12 holds each node to (its listed
    key_id, for join's commitment and the answers) its judge reads from the repository's nodes/ itself."""
    old_shape(c, "12", "nodes.json")
    kept = load(c.work / "nodes.json")
    names = {n["name"] for n in load(c.pop / "population.json")["nodes"]}
    bad = []
    if kept.get("self_node") is not None and kept.get("self_node") not in names:
        bad.append(f"nodes.json names self node {kept.get('self_node')!r}, which is no population node")
    owns = kept.get("node_consoles")
    if not (isinstance(owns, list) and set(owns) <= names):
        bad.append(f"nodes.json names own consoles {owns!r}, not population nodes")
    # A node left out of node_consoles, or the self node without a second console, is judged NOT_CHECKED instead of
    # asked: which consoles the run held is its own record, so 08 names it when the proof shows a node not asked.
    state_relies(c, "12", f"the run's clock: nodes.json's bind_at {kept.get('bind_at')}, which the binding window and "
                 "the revocation statements are judged at (no node signs it)")
    if isinstance(owns, list) and (set(owns) != names or (kept.get("self_node") and not kept.get("second_console"))):
        state_relies(c, "12", "which consoles the run held (a node's own console, a second node's console), kept in "
                     "nodes.json")
    return bad


