def ledger_relies(c, m, nn, checkpointed):
    """What a live 04, 05 or 09 rests on for its ledger copies. A run since loop#288 kept each node's checkpoint reply
    beside each copy, and its judge (run here) shows each copy the node's whole file at that checkpoint
    (loop-ledger-check under the listed key): it rests only on what that check does not cover. An older run rests
    on the copies being whole."""
    if not checkpointed:
        c.relies.append(UNCHECKPOINTED[nn])
        return
    if m.ledger_proof.checker() is None:  # the verdict rests on that check, so a missing tool is not a result
        raise Unreproducible(f"step {nn}: its ledger checkpoint checks, run again here",
                             "loop-ledger-check is not installed where 08 runs (steps/ledger-check.setup.sh)", LIVE_ISSUE)
    c.relies += [
        {"what": f"step {nn}: each line of a node's copied capsules.jsonl is the record its capsule_id names",
         "why": "the checkpoint check takes a chain line's capsule_id as the line states it; it does not recompute "
                "a capsule_id from its record, so the records are read as written, a settlement observation's line "
                "whose preimage was withheld included (the only line a redaction marker counts on)",
         "issue": "evidence-network/loop#135"},
        {"what": f"step {nn}: each node's checkpoint reply was asked before its copy was read, and a file with no copy "
                 "held no line",
         "why": "a node's every genuine reply keeps checking a copy of its own size, and a checkpoint's time is no "
                "freshness test (the plugin reuses its last cut while a file has not grown), so that the reply was "
                "the node's answer at the step's ask is the step's word", "issue": TRUST_ISSUE}]


def checkpointed(c, m, per_node=False):
    """Whether the run's nodes.json says its copies were kept with their checkpoint replies (ledger_proof.SHAPE): at
    its top level, or (04) on any node it read."""
    try:
        kept, shape = load(c.work / "nodes.json"), m.ledger_proof.SHAPE
        return any(isinstance(v, dict) and shape in v for v in kept.values()) if per_node else shape in kept
    except (OSError, ValueError, AttributeError):
        return False


def state_relies(c, nn, what):
    """Name a run's record of its own state that the bundle does not bear out (#193)."""
    c.relies.append({"what": f"step {nn}: {what}", "why": f"the bundle does not bear it out, so it is {nn}'s record "
                     "of its run", "issue": TRUST_ISSUE})


def nodes_dir():
    """The nodes/ listings 08 holds keys to: LOOP_NODES_DIR, else this checkout's nodes/ (as 01, 02 and 05 read)."""
    return Path(os.environ.get("LOOP_NODES_DIR", ROOT / "nodes"))


def listed(node_id):
    """The key nodes/<node_id>.json lists, or None."""
    path = nodes_dir() / f"{node_id}.json"
    try:
        return load(path).get("key_id") if node_id and path.is_file() else None
    except (OSError, ValueError, AttributeError):
        return None


def join_commitment_books():
    """{key_id: {(book_id, checkpoint key)}}: the books the nodes' signed join commitments under lab/runs name, for
    those that verify under the key they name. Each is the book join.sh made for its node, as the node signed it.
    lab/runs is LOOP_LAB_RUNS when that is set."""
    books = {}
    step12 = step_module("12-join")
    runs = Path(os.environ.get("LOOP_LAB_RUNS") or ROOT / "lab" / "runs")
    for path in sorted(runs.glob("*/join/*/commitment.json")):
        try:
            doc = load(path)
            errs, notes = cc.verify(doc, cc.file_fetcher(path.parent))
            if not errs and not notes:
                books.setdefault(doc["key_id"], set()).add(step12.checkpoint_member(doc))
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            continue
    return books


def utc_time(s):
    """An RFC 3339 UTC time ('...Z', fractions allowed) as an aware datetime; ValueError otherwise."""
    if not isinstance(s, str) or not s.endswith("Z"):
        raise ValueError(f"{s!r} is not a UTC time")
    return dt.datetime.fromisoformat(s[:-1] + "+00:00")


def old_shape(c, nn, name):
