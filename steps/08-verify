def nodes_dir():
    """The nodes/ listings 08 holds keys to: LOOP_NODES_DIR, else this checkout's nodes/ (as 01, 02 and 05 read)."""
    return Path(os.environ.get("LOOP_NODES_DIR", ROOT / "nodes"))


def listed(node_id):
    """The key nodes/<node_id>.json lists, or None."""
    path = nodes_dir() / f"{node_id}.json"
    try:
        return load(path).get("key_id") if node_id and path.is_file() else None
    except (OSError, ValueError, AttributeError):
        return None


def join_commitment_books():
    """{key_id: {(book_id, checkpoint key)}}: the books the nodes' signed join commitments under lab/runs name, for
    those that verify under the key they name. Each is the book join.sh made for its node, as the node signed it."""
    books = {}
    step12 = step_module("12-join")
    for path in sorted((ROOT / "lab" / "runs").glob("*/join/*/commitment.json")):
        try:
            doc = load(path)
            errs, notes = cc.verify(doc, cc.file_fetcher(path.parent))
            if not errs and not notes:
                books.setdefault(doc["key_id"], set()).add(step12.checkpoint_member(doc))
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            continue
    return books


def utc_time(s):
    """An RFC 3339 UTC time ('...Z', fractions allowed) as an aware datetime; ValueError otherwise."""
    if not isinstance(s, str) or not s.endswith("Z"):
        raise ValueError(f"{s!r} is not a UTC time")
    return dt.datetime.fromisoformat(s[:-1] + "+00:00")


# Per run dir, the signed timestamps of the capsules a live 01 this 08 run reproduced as PASS kept: each one's
# signature its judge verified under the node's listed key. verify_run checks 01 before 03 (dirs in order).
SEALED = {}


def sealed_times(c):
    """The node-signed capsule timestamps of the run's 01 (SEALED), or [] when 08 did not reproduce it as PASS."""
    return SEALED.get(c.bundle.parent.resolve(), [])


def keep_sealed(d, work):
    """Record the timestamps of the capsules a reproduced, passing live 01 cites (its work copy)."""
    times = []
    for p in sorted(work.glob("*/capsule.json")):
        try:
            times.append(utc_time(load(p)["timestamp"]))
        except (OSError, ValueError, KeyError, TypeError):
            return
    if times:
        SEALED[d.parent.resolve()] = times


def old_shape(c, nn, name):
    """Unreproducible when the live finding's proof lacks `name`, the file its re-derivable shape always holds: the
    finding predates that shape, so it is not reproduced, never failed."""
    if name not in {p["path"] for p in c.record["proof"]}:
        raise Unreproducible(f"step {nn}: its live result re-derived from its proof bytes",
                             f"its proof holds no {name}: the finding predates the proof shape 08 re-derives",
                             OLD_SHAPE_ISSUE)


def rederive_01_live(m, c):
    """Live 01: its own judge_live on the copied proof (nodes.json, each node's capsule.json and node-key.pub.pem),
    with the pinned cross_language verifier; nothing is sealed again."""
    old_shape(c, "01", "nodes.json")
    python, verifier = m.tools()
    _, missing = m.installed_pins(python, verifier)
    missing = [x for x in missing if x["what"] != "capsule-emit"]  # nothing is sealed again
    if missing:
        raise Unreproducible("step 01: its judge, run again here", "; ".join(x["why"] for x in missing))
    return m.judge_live(load(c.pop / "population.json"), c.work, c.started)


def keys_01_live(c, m):
    """Each node key 01 kept beside its capsule is the key its nodes/ listing publishes (01's own listing dir), so
    the capsule is judged under the repository's key, never one the bundle supplies."""
    bad = []
    for p in sorted(c.work.glob("*/node-key.pub.pem")):
        name = p.parent.name
        node_id = next((n.get("node_id") for n in load(c.pop / "population.json")["nodes"] if n["name"] == name), None)
        listed = m.listed_key(m.nodes_dir(), node_id) if node_id else None
        if listed is None:
            continue  # an unlisted node: 01's signature check names it (not_checked), and its key is the node's word
        if m.raw_public_hex(p) != listed:
            bad.append(f"{name}/node-key.pub.pem is not the key nodes/{node_id}.json lists")
    # nodes.json's states are borne out when every node sealed under its listed key during this run: the capsule,
    # which 01's judge verifies under that key, is signed with a timestamp no earlier than 01 started. Sealing at
    # all shows the node's pinned tools were there, so no pin was missing.
    try:
        kept = load(c.work / "nodes.json")
        since = utc_time(c.started)

        def fresh(name):
            return utc_time(load(c.work / name / "capsule.json")["timestamp"]).replace(microsecond=0) >= since
        backed = not kept["pins"]["missing"] and all(
            (kept["nodes"].get(n["name"]) or {}).get("read") == "sealed"
            and (kept["nodes"].get(n["name"]) or {}).get("own_seal") is True
            and m.listed_key(m.nodes_dir(), n.get("node_id")) is not None and fresh(n["name"])
            for n in load(c.pop / "population.json")["nodes"])
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        backed = False
    if not backed:
        state_relies(c, "01", "what nodes.json says of each node (data_dir unread, a pin missing, or sealed by the "
                              "node itself in this run)")
    return bad


