def rederive_12_live(m, c):
    """Live 12 (reporter backend): its own judge_live on the copied proof (nodes.json, each node's reporter attempt,
    plugin calls (wire.json and the reply bytes) and binding record). The kept verification lines are computed again
    from their replies, join's commitment is verified under the listed key, and a kept binding is checked again by
    cross_language with the revocations main commit nodes.json names."""
    old_shape(c, "12", "nodes.json")
    if any(p["path"].endswith("/" + m.BINDING_FILE) for p in c.record["proof"]) and not m.cross_language().is_file():
        raise Unreproducible("step 12: its judge, run again here",
                             f"aac-go cross_language is not installed where 08 runs ({m.cross_language()}); "
                             "steps/01-seal.setup.sh installs it")
    kept = load(c.work / "nodes.json")
    snap = kept.get("revocations_main") if isinstance(kept, dict) else None
    commit = snap.get("commit") if isinstance(snap, dict) else None
    # The binding window is judged at bind_at, so it lies inside the step's run whatever revocations were read.
    at = kept.get("bind_at") if isinstance(kept, dict) else None
    if not (isinstance(at, str) and c.started <= at <= c.record["finished"]):
        raise Mismatch(f"12-join: nodes.json's bind_at {at!r} is not inside the step's run "
                       f"({c.started} to {c.record['finished']})")
    if commit is not None:
        # As live 05: the main commit nodes/revocations/ was read from is origin/main's at the binding time, held in
        # this clone's own history (never fetched here).
        if not (isinstance(commit, str) and re.fullmatch(r"[0-9a-f]{40}", commit)):
            raise Mismatch(f"12-join: nodes.json's revocations commit {commit!r} is not a commit id")
        expected = m.bv.main_commit(m.revocations_root(), at)
        if expected is None or not m.bv.holds_on_main(m.revocations_root(), commit):
            raise Unreproducible("step 12: its revocation reads, run again here",
                                 f"this clone's origin/main does not hold the commit {commit[:12]} 12 read "
                                 f"nodes/revocations/ from, or no history at {at} (fetch main's history)")
        if commit != expected:
            raise Mismatch(f"12-join: nodes.json reads nodes/revocations/ at {commit[:12]}, but origin/main held "
                           f"{expected[:12]} at the binding time {at}")
    return m.judge_live(load(c.pop / "population.json"), c.work, c.started)


