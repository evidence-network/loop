def lines(path):
    """The non-empty lines of a JSON-lines file, as text; none when it is absent."""
    try:
        return [ln for ln in Path(path).read_text(encoding="utf-8").splitlines() if ln.strip()]
    except FileNotFoundError:
        return []


def parsed(text):
    try:
        v = json.loads(text)
        return v if isinstance(v, dict) else None
    except ValueError:
        return None


def capsule_checks(raw):
    """Class 1 on the bytes and the capsule_id recomputed from them, by the Go verifier: (ok, detail)."""
    verifier = str(cross_language())
    v = subprocess.run([verifier, "verify"], input=raw.encode(), capture_output=True, timeout=120)
    capsule = parsed(raw) or {}
    carried = capsule.get("capsule_id")
    stripped = json.dumps({k: x for k, x in capsule.items() if k not in STRIPPED})
    s = subprocess.run([verifier, "seal"], input=stripped.encode(), capture_output=True, timeout=120)
    recomputed = (parsed(s.stdout.decode(errors="replace")) or {}).get("capsule_id") if s.returncode == 0 else None
    printed = (v.stdout.decode(errors="replace").split() or [None])[-1]
    ok = v.returncode == 0 and printed == carried and recomputed == carried and carried is not None
    return ok, (f"Class 1 exit {v.returncode}; carried {carried}, recomputed {recomputed}"
                + ("" if v.returncode == 0 else f" ({v.stderr.decode(errors='replace').strip()})"))


def cites(capsule, capsule_id):
    return any(isinstance(r, dict) and r.get("citation_purpose") == "counterparty_half" and r.get("digest") == capsule_id
               for r in capsule.get("references") or [])


HEX64 = set("0123456789abcdef")


def is_key(v):
    return isinstance(v, str) and len(v) == 64 and set(v) <= HEX64


def nodes_dir():
    """The node list whose commitments the sender's binding is read from: this clone's nodes/ working tree, as
    `lab.sh commitments` writes it (lab/commitments.py), not necessarily committed."""
    return Path(os.environ.get("LOOP_NODES_DIR", ROOT / "nodes"))


def published_binding(key_id):
    """(controller_binding.digest, {path, sha256}) of the commitment the node holding evidence key `key_id`
    published at nodes/commitments/<node_id>.json (loop#88); (None, None) when there is no such node or
    commitment, and a None digest when the commitment carries no binding. The path and the sha256 of the bytes
    read go into checks.json, so a finding that says "bound" can be reproduced after nodes/ changes."""
    d = nodes_dir()
    for entry in sorted(d.glob("*.json")):
        try:
            node = json.loads(entry.read_text(encoding="utf-8"))
            if node.get("key_id") != key_id:
                continue
            raw = (d / "commitments" / f"{node['node_id']}.json").read_bytes()
            digest = (json.loads(raw).get("controller_binding") or {}).get("digest")
        except (OSError, ValueError, KeyError, AttributeError):
            continue
        return (digest if is_key(digest) else None,
                {"path": f"nodes/commitments/{node['node_id']}.json", "sha256": hashlib.sha256(raw).hexdigest()})
    return None, None


def accepted(citing, half):
    """How the node's citing record says it accepted the half (capsules-plugin PR #77, #135): {ok, via, detail,
    bound}.

    Not ok when the record contradicts itself: a sender key other than the half's, an unknown
    accepted_via, a declaration with no binding digest or anchored on the node's own key, or a
    counterparty bound to the receiver's own controller (same_controller_as_receiver true). `bound` is
    true when the record names a controller_binding_digest equal to the controller_binding.digest in the
    sender's published commitment, however the key was accepted; a declaration has no anchor key under a
    bip340 anchor, so the own-key check applies only when one is present.
    """
    rh = ((citing.get("model_attestation") or {}).get("compute_attestation") or {}).get("received_half")
    rh = rh if isinstance(rh, dict) else {}
    via = rh.get("accepted_via")
    if rh.get("same_controller_as_receiver") is True:
        return {"ok": False, "via": str(via) if via is not None else "none recorded", "bound": False,
                "detail": "a counterparty whose key is bound to the receiver's own controller"}
    if via is None:
        return {"ok": True, "via": "none recorded", "detail": "the citing record names no accepted_via",
                "bound": False}
    if via not in ACCEPT_MODES:
        return {"ok": False, "via": str(via), "bound": False,
                "detail": f"the citing record names an unknown accepted_via {via!r}"}
    if rh.get("sender_key_id") != half.get("key_id"):
        return {"ok": False, "via": via, "bound": False,
                "detail": f"the citing record accepted key {rh.get('sender_key_id')}, "
                          f"not the half's key {half.get('key_id')}"}
    digest, anchor = rh.get("controller_binding_digest"), rh.get("controller_anchor_key_id")
    if via == "controller_declaration":
        if not is_key(digest) or (anchor is not None and not is_key(anchor)):
            return {"ok": False, "via": via, "bound": False,
                    "detail": "a declaration with no binding digest or a malformed anchor key"}
        if anchor is not None and anchor == citing.get("key_id"):
            return {"ok": False, "via": via, "bound": False, "detail": "a declaration anchored on the node's own key"}
        return {"ok": True, "via": via, "bound": True,
                "detail": f"under declaration {digest}" + (f", anchored on {anchor}" if anchor else "")}
    if is_key(digest):
        published, commitment = published_binding(half.get("key_id"))
        compared = {"commitment": commitment} if commitment else {}
        if digest == published:
            return {"ok": True, "via": via, "bound": True, **compared,
                    "detail": f"accepted the half's key {half.get('key_id')} via {via}, its operator binding "
                              f"{digest} the one in the sender's published commitment"}
        return {"ok": True, "via": via, "bound": False, **compared,
                "detail": f"accepted the half's key {half.get('key_id')} via {via}, naming operator binding "
                          f"{digest}, which the sender's published commitment does not carry"}
    return {"ok": True, "via": via, "bound": False,
            "detail": f"accepted the half's key {half.get('key_id')} via {via}"}


def exchange_key(capsule):
    """(client_nonce, role, agent_output_digest) of a held half: what joins its two halves into one exchange.

    Not agent_input_digest: every exchange that sends the same prompt shares it (loop#66). A member that is
    absent, empty or not a string is None, so a malformed half is named as unpaired, never raises."""
    ma = capsule.get("model_attestation")
    ca = ma.get("compute_attestation") if isinstance(ma, dict) else None
    ca = ca if isinstance(ca, dict) else {}
    x = next((v for k, v in ca.items() if k.startswith("x-mesh-poc-v1") and isinstance(v, dict)), {})
    return tuple(v if isinstance(v, str) and v else None
                 for v in (x.get("client_nonce"), x.get("role"), ca.get("agent_output_digest")))


def paired_exchanges(halves):
    """({client_nonce}, [why not]) for {node: [(client_nonce, role, agent_output_digest)]}.

    An exchange is a nonce held by two different nodes as one requested and one served half with the same
    output digest (present on both). Any other nonce, and any half with no nonce, is named in the second list."""
    by_nonce, notes = {}, []
    for node, keys in sorted(halves.items()):
        for nonce, role, out in keys:
            if not nonce:
                notes.append(f"a half held by {node} carries no client_nonce")
            else:
                by_nonce.setdefault(nonce, []).append((node, role, out))
    paired = set()
    for nonce, hs in sorted(by_nonce.items()):
        nodes, roles, outs = {h[0] for h in hs}, {h[1] for h in hs}, {h[2] for h in hs}
        if len(hs) == 2 and len(nodes) == 2 and roles == {"requested", "served"} and len(outs) == 1 \
                and None not in outs:
            paired.add(nonce)
        else:
            notes.append(f"nonce {nonce} is not one exchange held on two nodes: "
                         + ", ".join(f"{n} {r or 'no role'}" for n, r, _ in hs)
                         + ("" if len(outs) == 1 and None not in outs else " (output digests differ or are missing)"))
    return paired, notes


def sealed_since():
    """The instant the lab's current build started sealing, from LOOP_SEALED_SINCE (RFC 3339), or None: every
    held half is then judged. The citing record's timestamp, which its signature covers, is compared to it."""
    raw = os.environ.get("LOOP_SEALED_SINCE")
    if raw is None:
        return None
    since = parse_time(raw)
    if since is None or since.tzinfo is None:
        raise ValueError(f"LOOP_SEALED_SINCE {raw!r} is not an RFC 3339 time with a zone, such as 2026-10-30T01:56:00Z")
    return since


def parse_time(value):
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")) if isinstance(value, str) else None
    except ValueError:
        return None


def before(citing, since):
    """True when the citing record was sealed before `since`; a record with no readable timestamp is judged."""
    sealed = parse_time(citing.get("timestamp"))
    return since is not None and sealed is not None and sealed.tzinfo is not None and sealed < since


def cites_inclusion(capsule, cid, checkpoint_digest):
    """Whether `capsule` is a counterparty_inclusion record of half `cid` citing the checkpoint it was pushed under."""
    block = ((capsule.get("model_attestation") or {}).get("compute_attestation") or {}).get("counterparty_inclusion")
    refs = [r.get("digest") for r in capsule.get("references") or []
            if isinstance(r, dict) and r.get("citation_purpose") == "counterparty_inclusion"]
    return isinstance(block, dict) and block.get("half_capsule_id") == cid and checkpoint_digest in refs


def inclusion_cited(own_lines, cid, inc, verified_digest):
    """The node holds a counterparty_inclusion record of half `cid` that recomputes and cites the checkpoint the
    half was pushed under: the digest the driver recomputed from the held checkpoint, equal to the one the held
    inclusion line carries and the record cites."""
    if not verified_digest or inc.get("checkpoint_digest") != verified_digest:
        return {"ok": False, "detail": f"the held inclusion line's checkpoint_digest {inc.get('checkpoint_digest')} is "
                                       f"not the digest {verified_digest} recomputed from the held checkpoint"}
    for ln in own_lines:
        if cites_inclusion(parsed(ln) or {}, cid, verified_digest):
            ok, detail = capsule_checks(ln)
            return {"ok": ok, "detail": f"a counterparty_inclusion record cites {cid} and checkpoint {verified_digest}: {detail}"}
    return {"ok": False, "detail": f"no counterparty_inclusion record of the node cites {cid} with checkpoint {verified_digest}"}


def is_citing(capsule):
    """Whether the capsule is one of the node's citing records, not a half of an exchange it took part in."""
    ca = (capsule.get("model_attestation") or {}).get("compute_attestation")
    return isinstance(ca, dict) and ("received_half" in ca or "counterparty_inclusion" in ca)


def tie(citing, nonce, role, own_lines, held):
    """How the citing record ties the held half to the node's own half of the exchange: (state, detail) with
    state "tied", "never_tied", "ambiguous" or "bad". The member is sealed at seal time only, so a nonce that
    now has more than one own half or another held half is ambiguous, never a pass (loop#107)."""
    rh = ((citing.get("model_attestation") or {}).get("compute_attestation") or {}).get("received_half")
    own_id = rh.get("own_half_capsule_id") if isinstance(rh, dict) else None
    if own_id is None:
        return "never_tied", "the citing record names no own_half_capsule_id"
    owns = [(ln, cap) for ln, cap in zip(own_lines, map(parsed, own_lines))
            if cap and cap.get("capsule_id") == own_id]
    if not owns:
        return "bad", f"the citing record names own half {own_id}, which the node's chain does not hold"
    ln, own = owns[0]
    o_nonce, o_role, _ = exchange_key(own)
    if nonce is None or o_nonce != nonce or {role, o_role} != {"requested", "served"}:
        return "bad", (f"own half {own_id} is nonce {o_nonce} role {o_role}, not the opposite role of the held "
                       f"half's nonce {nonce} role {role}")
    ok, detail = capsule_checks(ln)
    if not ok:
        return "bad", f"own half {own_id}: {detail}"
    n_own = sum(1 for cap in map(parsed, own_lines) if cap and not is_citing(cap) and exchange_key(cap)[0] == nonce
                and exchange_key(cap)[1] in ("requested", "served"))
    n_held = sum(1 for r in held if exchange_key(parsed(r) or {})[0] == nonce) - 1
    if n_own != 1 or n_held > 0:
        return "ambiguous", f"own half {own_id} named, but the nonce has {n_own} own halves and {n_held} other held halves"
    return "tied", f"own half {own_id}, nonce {nonce}, role {o_role} against the held half's {role}"


def live_node(bin_, name, data_dir, out, work):
    """Check every half the node holds: (result, proof, detail, pairs, summary).

    summary: {"judged", "earlier", "tied", "never_tied", "ambiguous", "vias", "unbound"}. Acceptance and the tie
    are judged on the halves sealed under the current build (LOOP_SEALED_SINCE); an earlier half still has its
    bytes, provenance, inclusion and citation checked."""
    out.mkdir(parents=True, exist_ok=True)
    work.mkdir(parents=True, exist_ok=True)
    ledger = data_dir / "ledger"
    held = lines(ledger / "received-capsules.jsonl")
    provenance = [p for p in map(parsed, lines(ledger / "received-provenance.jsonl")) if p]
    inclusions = [p for p in map(parsed, lines(ledger / "received-inclusion.jsonl")) if p]
    own_lines = lines(ledger / "capsules.jsonl")
    own = [c for c in map(parsed, own_lines) if c]
    summary = {"judged": 0, "earlier": 0, "tied": 0, "never_tied": 0, "ambiguous": 0, "vias": set(), "unbound": {}}
    if not held:
        return "NOT_CHECKED", [], f"node {name}: holds no pushed half", [], summary
    since = sealed_since()
    checks, proof = [], []
    for n, raw in enumerate(held, 1):
        stem = f"held-{n}"
        (out / f"{stem}.json").write_text(raw + "\n")
        proof.append(f"{stem}.json")
        capsule = parsed(raw) or {}
        cid = capsule.get("capsule_id")
        c = {"held": stem, "capsule_id": cid}
        ok, detail = capsule_checks(raw)
        c["held_by_digest"] = {"ok": ok, "detail": detail}
        prov = next((p for p in provenance if p.get("capsule_id") == cid), None)
        c["provenance"] = {"ok": prov is not None,
                           "detail": f"received from {prov.get('received_from')} via {prov.get('via')} at "
                                     f"{prov.get('received_at')}" if prov else "no provenance line names it"}
        inc = next((i for i in inclusions if i.get("half_capsule_id") == cid), None)
        if inc is None:
            c["pushed_under_checkpoint"] = {"ok": False, "detail": "no held checkpoint and proof name it"}
        else:
            (work / f"{stem}-cp.json").write_text(json.dumps(inc.get("checkpoint")))
            (work / f"{stem}-proof.json").write_text(json.dumps(inc.get("inclusion_proof")))
            r = run(bin_, "held", "--record-id", cid or "", "--key-id", capsule.get("key_id") or "",
                    "--checkpoint", work / f"{stem}-cp.json", "--inclusion", work / f"{stem}-proof.json")
            v = parsed(r.stdout) or {"ok": False, "detail": r.stderr.strip()}
            if r.returncode in (0, 1) and "checkpoint_digest" not in v:
                raise RuntimeError("the installed step 05 driver predates the checkpoint_digest it prints; "
                                   "run steps/05-deal.setup.sh")
            (out / f"{stem}-inclusion.json").write_text(json.dumps(inc, indent=2, sort_keys=True) + "\n")
            proof.append(f"{stem}-inclusion.json")
            c["pushed_under_checkpoint"] = {"ok": r.returncode == 0 and v.get("ok") is True, "detail": v.get("detail")}
        citing = [ln for ln, cap in zip(own_lines, map(parsed, own_lines)) if cap and cites(cap, cid)]
        if not citing:
            c["cited"] = {"ok": False, "detail": f"none of the node's {len(own)} records cites {cid} as counterparty_half"}
        else:
            (out / f"{stem}-citing.json").write_text(citing[0] + "\n")
            proof.append(f"{stem}-citing.json")
            ok, detail = capsule_checks(citing[0])
            c["cited"] = {"ok": ok, "detail": f"record {parsed(citing[0]).get('capsule_id')} cites it: {detail}"}
            record = parsed(citing[0])
            c["current_build"] = not before(record, since)
            if c["current_build"]:
                c["accepted"] = accepted(record, capsule)
                nonce, role, _ = exchange_key(capsule)
                state, detail = tie(record, nonce, role, own_lines, held)
                c["tied"] = {"ok": state != "bad", "state": state, "detail": detail}
                if inc is not None:
                    c["inclusion_cited"] = inclusion_cited(own_lines, cid, inc, v.get("checkpoint_digest"))
        checks.append(c)
    (out / "checks.json").write_text(json.dumps({"node": name, "sealed_since": os.environ.get("LOOP_SEALED_SINCE"),
                                                 "held": checks}, indent=2, sort_keys=True) + "\n")
    proof.append("checks.json")
    failed = [f"{c['held']} {k} ({v['detail']})" for c in checks for k, v in c.items() if isinstance(v, dict) and not v["ok"]]
    current = [c for c in checks if "accepted" in c]
    summary["judged"] = len(current)
    summary["earlier"] = sum(1 for c in checks if c.get("current_build") is False)
    for c in current:
        if c["tied"]["state"] != "bad":
            summary[c["tied"]["state"]] += 1
        # A key tied to an operator by a binding the sender's commitment carries counts as accepted under a
        # controller declaration, however the plugin first accepted it; an unbound sender is its own line.
        a = c["accepted"]
        if a["bound"]:
            summary["vias"].add("controller_declaration")
        elif a["via"] in VIA_KEY:
            key = parsed(held[checks.index(c)]).get("key_id") or "unknown"
            summary["unbound"][key] = summary["unbound"].get(key, 0) + 1
            summary["vias"].add(a["via"])
        else:
            summary["vias"].add(a["via"])
    pairs = [exchange_key(capsule) for capsule in map(lambda r: parsed(r) or {}, held)]
    if failed:
        return "FAIL", proof, f"node {name}: did not hold: {'; '.join(failed)}", pairs, summary
    recorded = sorted({c["accepted"]["via"] for c in current})
    return "NOT_CHECKED", proof, (
        f"node {name}: {len(checks)} held halves, each held by its digest (Class 1 and the capsule_id recomputed by "
        f"the AAC Go verifier), under the checkpoint it was pushed with (evidencebook), and cited as "
        f"counterparty_half by the node's own record; {summary['judged']} sealed under the current build"
        + (f" (accepted the half's key via {', '.join(recorded)}; {summary['tied']} tied to the node's own half, "
           f"{summary['never_tied']} held, never tied, {summary['ambiguous']} ambiguous)" if current else "")
        + (f", {summary['earlier']} earlier, not judged for acceptance or tie" if summary["earlier"] else "")), pairs, summary


def sharing_report(name, data_dir, out):
    """(detail, proof file or None) for the node's sharing-effective.json, read as the node's own report."""
    path = data_dir / SHARING_FILE
    doc = None
    try:
        doc = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        pass
    if not isinstance(doc, dict) or doc.get("share_record_at_completion") not in (POLICY_ON, DEFAULT_POLICY):
        return None, None
    shutil.copyfile(path, out / SHARING_FILE)
    raw = f" (raw value {doc['raw_value']!r} is not one the plugin knows)" if "raw_value" in doc else ""
    return (f"node {name} reports (node-reported, unsigned) share_record_at_completion "
            f"{doc['share_record_at_completion']} from {doc.get('source')} at {doc.get('written_at')}{raw}; the push "
            f"itself is judged from the sealed records"), f"{name}/{SHARING_FILE}"


def main_live(pop, out, started):
    sealed_since()  # a malformed cutoff stops the step before any node is read
    out.mkdir(parents=True, exist_ok=True)
    bin_ = driver()
    missing = live_tools(bin_)
    results, proof, details, not_checked = [], [], [], list(missing)
    halves = {}
    total = {"judged": 0, "earlier": 0, "tied": 0, "never_tied": 0, "ambiguous": 0}
    vias, unbound, no_sharing = set(), {}, []
    with tempfile.TemporaryDirectory(prefix="05-deal-") as tmp:
        for entry in pop["nodes"]:
            name = entry["name"]
            data_dir = live.readable(entry, "data_dir", "ledger")
            if data_dir is None or missing:
                results.append("NOT_CHECKED")
                if data_dir is None:
                    not_checked.append(live.not_checked(name, "data_dir"))
                details.append(f"node {name}: not checked, "
                               f"{'data_dir not set or unreadable' if data_dir is None else 'a pinned tool is missing'}")
                continue
            if (out / name).exists():
                shutil.rmtree(out / name)
            result, files, detail, pairs, summary = live_node(bin_, name, data_dir, out / name, Path(tmp) / name)
            results.append(result)
            proof += [f"{name}/{f}" for f in files]
            details.append(detail)
            halves[name] = pairs
            vias |= summary["vias"]
            for k in total:
                total[k] += summary[k]
            for k, n in summary["unbound"].items():
                unbound[k] = unbound.get(k, 0) + n
            if not files:
                not_checked.append({"what": f"{name}: a pushed half held", "why": "the node holds no pushed half "
                                    "from the lab run's exchanges", "issue": live.ISSUE})
            report, file = sharing_report(name, data_dir, out / name)
            if file:
                proof.append(file)
                details.append(report)
            else:
                no_sharing.append(name)
    both, unpaired = paired_exchanges(halves)
    details.append(f"exchanges with a half held on each of two nodes (joined on client_nonce): {len(both)}"
                   + (f" ({'; '.join(unpaired)})" if unpaired else ""))
    since = os.environ.get("LOOP_SEALED_SINCE")
    details.append(f"judged under the current build{f' (sealed since {since})' if since else ' (LOOP_SEALED_SINCE unset: every held half)'}: "
                   f"{total['judged']} halves, {total['tied']} tied to the node's own half, {total['never_tied']} "
                   f"{LIVE_NEVER_TIED}, {total['ambiguous']} ambiguous; {total['earlier']} sealed earlier, not judged")
    acceptance_gaps = [LIVE_DECLARATION] if "controller_declaration" in vias else []
    if unbound:
        acceptance_gaps.append(live_unbound(unbound, sorted(vias & set(VIA_KEY))))
    if "none recorded" in vias:
        acceptance_gaps.append({"what": ACCEPTANCE_WHAT, "issue": LIVE_NO_VIA,
                                "why": "a citing record names no accepted_via, so it was sealed by a build "
                                       "before the pinned one"})
    if not total["judged"]:
        acceptance_gaps.append({"what": ACCEPTANCE_WHAT, "issue": live.ISSUE,
                                "why": "no node holds a current-build half its own record cites, so there is no "
                                       "acceptance or tie to read"})
    untied = ([live_never_tied(total["never_tied"])] if total["never_tied"] else []) + \
             ([live_ambiguous(total["ambiguous"])] if total["ambiguous"] else [])
    default = [dict(LIVE_DEFAULT_ABSENT, why=LIVE_DEFAULT_ABSENT["why"].format(nodes=", ".join(no_sharing)))] \
        if no_sharing else []
    for nc in (*untied, *default, *acceptance_gaps, LIVE_SIGNATURE):
        if nc not in not_checked:
            not_checked.append(nc)
    result = live.worst(results + ["NOT_CHECKED"])
    finding.write(out, result=result, population=pop["population"], asserts=LIVE_ASSERTS, pinned=LIVE_PINNED,
                  proof=proof, detail="; ".join(details) + f". {NO_SPEND}", not_checked=not_checked,
                  started=started)
    return 0


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--population", required=True)
    ap.add_argument("--out", required=True)
    a = ap.parse_args(argv)
    started = finding.now()
    pop = json.loads((Path(a.population) / "population.json").read_text(encoding="utf-8"))
    if pop["population"] == "live":
        try:
            return main_live(pop, Path(a.out), started)
        except ValueError as e:
            print(f"05-deal: {e}", file=sys.stderr)
            return 2
    bin_ = driver()
    if bin_ is None:
        print("05-deal: the driver is not installed; run steps/05-deal.setup.sh", file=sys.stderr)
        return 2
    population, keys = nodes(a.population)
    out = Path(a.out)
    clean(out)
    deal(bin_, population, keys, settings(a.population), out, started,
         decls=declarations(bin_, a.population, keys, started))
    decide(bin_, out, population=population, keys=keys, started=started)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
