def tools_dir():
    return Path(os.environ.get("LOOP_TOOLS", Path.home() / ".cache" / "evidence-network-loop"))


def run(bin_, *args):
    return subprocess.run([str(bin_), *map(str, args)], capture_output=True, text=True, timeout=300)


def nodes(population_dir):
    """(population name, {name: (private key PEM, public key PEM)}) for alice and bob."""
    pop = json.loads((Path(population_dir) / "population.json").read_text(encoding="utf-8"))
    keys = {}
    for n in pop["nodes"]:
        if n["name"] in SIDES:
            key_dir = Path(n["key_dir"])
            key_dir = key_dir if key_dir.is_absolute() else ROOT / key_dir
            keys[n["name"]] = (key_dir / "node-key.pem", key_dir / "node-key.pub.pem")
    missing = [s for s in SIDES if s not in keys]
    if missing:
        raise KeyError(f"{population_dir}: no node named {', '.join(missing)}")
    return pop["population"], keys


def settings(population_dir):
    """Each side's {share_record_at_completion, accepted_via}: a side the settings do not
    name is off (the pinned plugin's default) and accepts under a controller declaration
    when one binds the sender."""
    p = Path(population_dir) / "step05" / "settings.json"
    doc = json.loads(p.read_text(encoding="utf-8")) if p.is_file() else {}
    out = {}
    for s in SIDES:
        side = doc.get(s) or {}
        out[s] = {"share_record_at_completion": side.get("share_record_at_completion", DEFAULT_POLICY),
                  "accepted_via": side.get("accepted_via", ACCEPT_MODES[0])}
        if out[s]["accepted_via"] not in ACCEPT_MODES:
            raise ValueError(f"{p}: {s} accepted_via is one of {', '.join(ACCEPT_MODES)}")
    return out


def raw_public_hex(pub_pem):
    """The raw Ed25519 key of an SPKI PEM, hex."""
    der = base64.b64decode("".join(ln for ln in Path(pub_pem).read_text().splitlines() if not ln.startswith("-----")))
    if len(der) != 44 or der[:12] != bytes.fromhex("302a300506032b6570032100"):
        raise ValueError(f"{pub_pem}: not an Ed25519 SPKI public key")
    return der[12:].hex()


def declarations(bin_, population_dir, keys, time):
    """The controller declarations `<population dir>/step05/controllers.json` names, each
    signed by its controller's TEST key: [{...}], or [] when there is no such file.

    controllers.json: {"controllers": [{"id", "key_dir" (controller-key.pem), "nodes": [...]}]}
    """
    p = Path(population_dir) / "step05" / "controllers.json"
    if not p.is_file():
        return []
    out = []
    for c in json.loads(p.read_text(encoding="utf-8"))["controllers"]:
        key_dir = Path(c["key_dir"])
        key_dir = key_dir if key_dir.is_absolute() else ROOT / key_dir
        bound = ",".join(raw_public_hex(keys[n][1]) for n in c["nodes"])
        r = run(bin_, "declare", "--controller-key", key_dir / "controller-key.pem", "--controller-id", c["id"],
                "--keys", bound, "--time", time)
        if r.returncode != 0:
            raise RuntimeError(f"driver declare: {r.stderr.strip()}")
        out.append(json.loads(r.stdout))
    return out


def deal(bin_, population, keys, side_settings, out, time, decls=(), plant=None):
    """Run the deal both sides make; write the proof files into out."""
    out = Path(out)
    with tempfile.TemporaryDirectory() as work:
        decl_file = Path(work) / "declarations.json"
        decl_file.write_text(json.dumps(list(decls)))
        args = ["deal", "--a-key", keys["alice"][0], "--b-key", keys["bob"][0], "--a-name", "alice",
                "--b-name", "bob", "--population", population, "--deal-id", f"{population}-deal-{time}",
                "--time", time, "--work", Path(work) / "books", "--out", out, "--declarations", decl_file]
        for flag, side in (("a", "alice"), ("b", "bob")):
            args += [f"--{flag}-policy", side_settings[side]["share_record_at_completion"],
                     f"--{flag}-accept", side_settings[side]["accepted_via"]]
        r = run(bin_, *args, *(["--plant", plant] if plant else []))
    if r.returncode != 0:
        raise RuntimeError(f"driver deal: {r.stderr.strip()}")


def decide(bin_, out, *, population, keys, started):
    """Verify the proof bytes in out with the driver and write the finding."""
    out = Path(out)
    r = run(bin_, "verify", "--a-pub", keys["alice"][1], "--b-pub", keys["bob"][1], "--a-name", "alice",
            "--b-name", "bob", "--dir", out)
    if r.returncode not in (0, 1):
        raise RuntimeError(f"driver verify: {r.stderr.strip()}")
    (out / "verify.json").write_text(r.stdout)
    verdict = json.loads(r.stdout)
    held = sorted({c["check"] for c in verdict["checks"] if c["ok"]})
    failed = [f"{c['side']} {c['check']} ({c['detail']})" for c in verdict["checks"] if not c["ok"]]
    proof = [p for p in PROOF if (out / p).is_file()]
    where = f"deal {verdict['deal_id']} between books {', '.join(verdict['books'])}"
    if r.returncode == 1 or failed:
        return finding.write(out, result="FAIL", population=population, asserts=ASSERTS, pinned=PINNED,
                             proof=proof, detail=f"{where}: did not hold: {'; '.join(failed)}. {NO_SPEND}",
                             started=started)
    unaccepted = verdict.get("acceptance_not_checked") or []
    if unaccepted:
        vias = sorted({f"{u['accepted_via']} ({u['side']})" for u in unaccepted})
        detail = (f"{where}: evidencebook found these held on the proof bytes: {', '.join(held)}. "
                  f"Acceptance not checked: {', '.join(vias)} is not a controller declaration. {NO_SPEND}")
        return finding.write(out, result="NOT_CHECKED", population=population, asserts=ASSERTS, pinned=PINNED,
                             proof=proof, detail=detail, not_checked=[acceptance(vias)], started=started)
    detail = (f"{where}: evidencebook found these held on the proof bytes, for both sides: {', '.join(held)}. "
              f"Each push was accepted on the sender's evidence key under a controller declaration (rehearsal "
              f"TEST controller keys) that binds it, and the two keys are under different controllers. "
              f"{NO_SPEND} {STAND_IN}")
    return finding.write(out, result="PASS", population=population, asserts=ASSERTS, pinned=PINNED,
                         proof=proof, detail=detail, started=started)


def clean(out):
    out = Path(out)
    out.mkdir(parents=True, exist_ok=True)
    for p in ["deal.json", "declarations.json", "verify.json", "finding.json"]:
        (out / p).unlink(missing_ok=True)
    for s in SIDES:
        shutil.rmtree(out / s, ignore_errors=True)


