{
  "binds": "the pinned inference-deals pack (versions.lock `inference-deals`) onto the loop's rehearsal stand-ins; the pack's terms, tiers and window come from the pinned pack, not from this file",
  "pack": "inference-deals",
  "own_contract_ref": "loop-inference-deals-rehearsal@v0",
  "verdicts": {
    "PASS": "met",
    "FAIL": "not_met",
    "NOT_CHECKED": "not_evaluable"
  },
  "kinds": {
    "05": {
      "kind": "deal",
      "records": [
        "deal.json"
      ],
      "terms": [
        {
          "requirement": "come_through.served_as_agreed"
        },
        {
          "requirement": "come_through.served_named_model",
          "model_attestation": true
        }
      ]
    },
    "06": {
      "kind": "settlement",
      "records": [
        "ledger.jsonl"
      ],
      "terms": [
        {
          "requirement": "come_through.paid_as_agreed"
        }
      ]
    },
    "07": {
      "kind": "ask",
      "records": [
        "*/asks/*/*/request.json"
      ],
      "terms": [
        {
          "id": "ask-answered",
          "name": "an ask is answered or its absence recorded",
          "own": true
        }
      ]
    },
    "09": {
      "kind": "dispute",
      "records": [
        "dispute.json"
      ],
      "terms": [
        {
          "id": "referee-result",
          "name": "the referee's sealed Result, cited and counted as found, never judged again",
          "own": true,
          "counted": true
        }
      ]
    }
  }
}
