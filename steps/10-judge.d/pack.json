{
  "pack": "inference-deals-rehearsal",
  "contract_ref": "loop-inference-deals-rehearsal@v0",
  "source": "the terms of action-state-group/evidencebook-skills packs/inference-deals (#71), read onto the loop's rehearsal stand-ins; that pack's own code is not pinned and does not run here",
  "window": {
    "period": "month",
    "periods": 12
  },
  "verdicts": {
    "PASS": "met",
    "FAIL": "not_met",
    "NOT_CHECKED": "not_evaluable"
  },
  "kinds": {
    "05": {
      "kind": "deal",
      "terms": [
        {
          "id": "term-2",
          "name": "served as agreed",
          "must_have": true
        },
        {
          "id": "term-3",
          "name": "served the model it named",
          "must_have": true,
          "model_attestation": true
        }
      ],
      "records": [
        "deal.json"
      ]
    },
    "06": {
      "kind": "settlement",
      "terms": [
        {
          "id": "term-1",
          "name": "paid as agreed",
          "must_have": true
        }
      ],
      "records": [
        "ledger.jsonl"
      ]
    },
    "07": {
      "kind": "ask",
      "terms": [
        {
          "id": "ask-answered",
          "name": "an ask is answered or its absence recorded",
          "must_have": true
        }
      ],
      "records": [
        "*/asks/*/*/request.json"
      ]
    },
    "09": {
      "kind": "dispute",
      "terms": [
        {
          "id": "referee-result",
          "name": "the referee's sealed Result, cited and counted as found, never judged again",
          "must_have": true,
          "counted": true
        }
      ],
      "records": [
        "dispute.json",
        "outcome.json"
      ]
    }
  }
}
