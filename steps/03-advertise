def b64(raw):
    return base64.b64encode(raw).decode("ascii")


def standin_staple(key_id):
    """A history_card/1 answer in the plugin's flat evidence-interop/0 shape; its sig is a stand-in."""
    artifact = json.dumps({"halves": []}, separators=(",", ":")).encode()
    card = {
        "profile": cc.STAPLE_PROFILE,
        "subject": {"book": key_id},
        "derivation": "history_card/1",
        "anchor": {"digest": hashlib.sha256(b"rehearsal checkpoint").hexdigest(), "freshness": "as-of"},
        "artifact_digest": hashlib.sha256(artifact).hexdigest(),
        "responder": key_id,
        "issued_at": "2026-10-27T00:00:00Z",
        "sig": "stand-in",
        "artifact": cc.b64url(artifact),
    }
    return (json.dumps(card, indent=2, sort_keys=True) + "\n").encode()


def standin_checkpoint():
    cp = {"profile": "rehearsal-stand-in", "root": hashlib.sha256(b"rehearsal checkpoint").hexdigest(),
          "signature": "stand-in"}
    return (json.dumps(cp, indent=2, sort_keys=True) + "\n").encode()


def node_inputs(population, node):
    """(settings, staple bytes, checkpoint bytes, source) for one node."""
    d = population / "advertise" / node["name"]
    if d.is_dir():
        settings = dict(DEFAULTS, **json.loads((d / "commitment.json").read_text(encoding="utf-8")))
        return settings, (d / "history_card.json").read_bytes(), (d / "checkpoint.json").read_bytes(), f"advertise/{node['name']}"
    return dict(DEFAULTS), None, standin_checkpoint(), "stand-in"


def build(node_id, key_id, spki, settings, staple, checkpoint, private_key):
    """(commitment, policy bytes): both signed by the node key."""
    policy = cc.sign({"profile": cc.POLICY_PROFILE, "key_id": key_id, "policy": settings["policy"]}, private_key)
    policy_bytes = (json.dumps(policy, indent=2, sort_keys=True) + "\n").encode()
    doc = {
        "profile": cc.PROFILE,
        "node_id": node_id,
        "key_id": key_id,
        "spki": b64(spki),
        "issued_at": finding.now(),
        "ask": {"endpoint": f"mesh:{node_id}", "bindings": settings["ask"]["bindings"]},
        "answers": settings["answers"],
        "lcap": {"policy_digest": hashlib.sha256(policy_bytes).hexdigest(),
                 "policy_uri": f"policies/{node_id}.json",
                 "predicate_classes": settings["predicate_classes"]},
        "checkpoint": {"sha256": hashlib.sha256(checkpoint).hexdigest(), "bytes": b64(checkpoint)},
        "human_gated": settings["human_gated"],
        "answers_within": settings["answers_within"],
        "history_card": {"derivation": "history_card/1", "sha256": hashlib.sha256(staple).hexdigest(),
                         "bytes": b64(staple)},
    }
    return cc.sign(doc, private_key), policy_bytes


def git(repo, *args, check=True):
    r = subprocess.run(["git", "-C", str(repo), *GIT_ID, *args], capture_output=True)
    if check and r.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)}: {r.stderr.decode(errors='replace').strip()}")
    return r


def publish(carrier, node_id, doc, policy_bytes):
    """Commit nodes/commitments/<node_id>.json and its policy to the carrier repository."""
    tree = carrier / "nodes" / "commitments"
    (tree / "policies").mkdir(parents=True, exist_ok=True)
    (tree / f"{node_id}.json").write_text(json.dumps(doc, indent=2, sort_keys=True) + "\n")
    (tree / "policies" / f"{node_id}.json").write_bytes(policy_bytes)
    if PUBLISH_HOOK:
        PUBLISH_HOOK(carrier)
    git(carrier, "add", "nodes")
    git(carrier, "commit", "-q", "--allow-empty", "-m", f"advertise: commitment for {node_id}")


def fetch(carrier, path, ref="HEAD"):
    """The bytes at <ref>:<path> in the carrier, or None."""
    r = git(carrier, "show", f"{ref}:{path}", check=False)
    return r.stdout if r.returncode == 0 else None


def node_signed(node, signed, carrier, key_id, key_dir=None, out=None, rev=None):
    """Publish the commitment and policy the node signed itself (the Goose rehearsal: G1's loop_advertise), byte for
    byte; the harness signs nothing. Returns (record, key_id): the key is the node's own, from its key_dir, so a
    commitment under another key fails the check."""
    raw = Path(signed["commitment"]).read_bytes()
    try:
        node_id = json.loads(raw)["node_id"]
    except (ValueError, KeyError, TypeError):
        node_id = None
    if not (isinstance(node_id, str) and cc.HEX64.fullmatch(node_id)):
        node_id = key_id  # a node_id that names no file of ours: published under the key, refused by the check
    tree = carrier / "nodes" / "commitments"
    (tree / "policies").mkdir(parents=True, exist_ok=True)
    (tree / f"{node_id}.json").write_bytes(raw)
    (tree / "policies" / f"{node_id}.json").write_bytes(Path(signed["policy"]).read_bytes())
    for part in STAPLE_PARTS:  # the node's standard_history staple, when it signed a commitment naming one
        if signed.get(f"standard_history_{part}"):
            (tree / "standard_history").mkdir(exist_ok=True)
            (tree / "standard_history" / f"{node_id}.{part}.json").write_bytes(
                Path(signed[f"standard_history_{part}"]).read_bytes())
    if PUBLISH_HOOK:
        PUBLISH_HOOK(carrier)
    git(carrier, "add", "nodes")
    git(carrier, "commit", "-q", "--allow-empty", "-m", f"advertise: commitment for {node_id}, as the node signed it")
    rec = {"name": node["name"], "node_id": node_id, "key_id": key_id, "inputs": "signed by the node",
           "signed_by": signed.get("by") or (f"the Goose node {node['name']} itself, tool loop_advertise"
                                              + (f", goose-g1 {rev}" if rev else "") + "; never the harness"),
           "published_commit": git(carrier, "rev-parse", "HEAD").stdout.decode().strip()}
    if key_dir is not None and out is not None:
        # The key the commitment must be under, kept in the proof so "under the node's own key" can be re-checked.
        shutil.copyfile(Path(key_dir) / "node-key.pub.pem", Path(out) / f"{node['name']}.node-key.pub.pem")
        rec["node_key_file"] = f"{node['name']}.node-key.pub.pem"
    return rec, key_id


def rehearsal_node(population, node, carrier, signed=None, out=None, rev=None):
    """Sign a rehearsal node's commitment with its TEST key and publish it, or publish the one the node signed
    (`signed`: {commitment, policy} paths, and optionally standard_history_request and standard_history_reply).
    Returns (record, key_id)."""
    key_dir = Path(node["key_dir"])
    if not key_dir.is_absolute():
        key_dir = population.parent.parent / key_dir
    spki = cc.spki_from_pem((key_dir / "node-key.pub.pem").read_text(encoding="utf-8"))
    key_id = cc.key_id_of(spki)
    if signed:
        return node_signed(node, signed, carrier, key_id, key_dir, out, rev)
    node_id = node.get("node_id") or key_id
    settings, staple, checkpoint, source = node_inputs(population, node)
    staple = staple if staple is not None else standin_staple(key_id)
    doc, policy_bytes = build(node_id, key_id, spki, settings, staple, checkpoint, key_dir / "node-key.pem")
    publish(carrier, node_id, doc, policy_bytes)
    return {"name": node["name"], "node_id": node_id, "key_id": key_id, "inputs": source,
            "signed_by": "the harness, with the node's rehearsal TEST key",
            "published_commit": git(carrier, "rev-parse", "HEAD").stdout.decode().strip()}, key_id


def live_node(node, carrier, ref="HEAD"):
    """A live node: the harness never signs for it. Returns (record, the listed key_id or None).

    The commitment must be one the node signed and published itself; the key it
    must be under is the node's key_id in the list (nodes/<node_id>.json) at HEAD.
    """
    rec = {"name": node["name"], "node_id": node.get("node_id"), "signed_by": "the node (never the harness)"}
    if not node.get("node_id"):
        return rec, None
    listed = fetch(carrier, f"nodes/{node['node_id']}.json", ref)
    try:
        key_id = json.loads(listed)["key_id"] if listed is not None else None
    except (ValueError, KeyError, TypeError):
        key_id = None
    rec["key_id"] = key_id
    return rec, key_id


def recorded_signed(population, node):
    """advertise/<name>/signed/{commitment,policy}.json: a commitment signed beforehand, published byte for byte."""
    d = population / "advertise" / node["name"] / "signed"
    if (d / "commitment.json").is_file() and (d / "policy.json").is_file():
        return {"commitment": d / "commitment.json", "policy": d / "policy.json",
                "by": f"{node['name']}'s rehearsal TEST key, beforehand (recorded); never the harness at run time"}
    return None


def check_node(population, out, node, carrier, signed=None, rev=None):
    """One rehearsal node's verification record, and the proof files it wrote."""
    rec, key_id = rehearsal_node(population, node, carrier, signed or recorded_signed(population, node), out, rev)
    read = lambda path: fetch(carrier, path)  # noqa: E731
    rec, files = verify_node(out, node["name"], rec, key_id, read, False)
    files += [rec["node_key_file"]] if rec.get("node_key_file") else []
    return nostr_node(population, out, node["name"], rec, key_id, read, files)


NOSTR_FILE = "nostr.json"  # advertise/<name>/nostr.json: what a REQ returned from each relay (nostr_carrier)


def octets_checker(key_id):
    """The step 03 check of commitment octets from another carrier: (document or None, errors), the commitment
    under the node's key."""
    def check(octets):
        try:
            doc = json.loads(octets)
        except (ValueError, RecursionError) as e:
            return None, [f"not JSON ({type(e).__name__})"]
        if not isinstance(doc, dict):
            return None, ["not a JSON object"]

        # The policy and staples are checked on the git bytes (verify_node); another commitment may change them, so
        # here only its own fields, signature and digests count, and the policy digest is not matched to bytes.
        try:
            errs, _ = cc.verify(doc, lambda uri: None, lambda part: None)
        except (RecursionError, TypeError, ValueError, KeyError, AttributeError) as e:  # hostile nesting or types
            return None, [f"the checker could not read it ({type(e).__name__})"]
        if doc.get("key_id") != key_id:
            errs.append("the commitment is not under this node's key")
        return doc, errs
    return check


def nostr_node(population, out, node_name, rec, key_id, read, files):
    """The second carrier: a node with recorded relay responses is read back from Nostr and its bytes must equal the
    git carrier's. No recording means the node is not advertising there: a note, never a failure."""
    recorded = population / "advertise" / node_name / NOSTR_FILE
    if not recorded.is_file():
        rec["nostr"] = {"result": "NOT_ADVERTISED", "note": "not advertised on nostr"}
        return rec, files
    (out / f"{node_name}.{NOSTR_FILE}").write_bytes(recorded.read_bytes())
    files = files + [f"{node_name}.{NOSTR_FILE}"]
    if rec["result"] != "PASS":
        rec["nostr"] = {"result": "NOT_CHECKED", "note": "the git carrier did not pass, so there are no bytes to compare"}
        return rec, files
    try:
        recording = json.loads(recorded.read_text(encoding="utf-8"))
        why = None if isinstance(recording, dict) else f"{NOSTR_FILE} is not a JSON object"
    except (ValueError, RecursionError) as e:
        why = f"{NOSTR_FILE} is not JSON ({type(e).__name__})"
    if why:
        rec["nostr"] = {"result": "FAIL", "reasons": [f"nostr.recording: {why}"], "events": {}}
    else:
        rec["nostr"] = nostr_carrier.read_back(recording, read(f"nodes/commitments/{rec['node_id']}.json"),
                                               rec["node_id"], octets_checker(key_id))
    if rec["nostr"]["result"] == "FAIL":
        rec["result"] = "FAIL"
        rec["errors"] = list(rec["errors"]) + rec["nostr"]["reasons"]
    elif rec["nostr"]["result"] == "NOT_CHECKED":
        rec["result"] = "NOT_CHECKED"
        rec["errors"] = list(rec["errors"]) + rec["nostr"]["reasons"]
    return rec, files


def verify_node(out, name, rec, key_id, read, live):
    """The verification record of one node's commitment, and the proof files it wrote: `read(path)` is the
    carrier's bytes at HEAD:<path> (or None), from git (check_node) or from the proof (judge_live)."""
    rec["carrier"] = ("git repository" if live else "git scratch repository (carrier.bundle)") + \
        f" HEAD:nodes/commitments/{rec['node_id']}.json"
    if not rec["node_id"]:
        rec["result"], rec["errors"], rec["notes"] = "NOT_CHECKED", ["the node has no node_id yet"], []
        return rec, []
    path = f"nodes/commitments/{rec['node_id']}.json"
    fetched = read(path)
    if fetched is None:
        rec["result"], rec["errors"], rec["notes"] = "NOT_CHECKED", [f"no commitment at HEAD:{path}"], []
        return rec, []
    proofs = [f"{name}.commitment.json"]
    (out / proofs[0]).write_bytes(fetched)

    def fetch_policy(uri):
        if "://" in uri or uri.startswith("/") or ":" in uri.split("/")[0]:
            return None
        got = read(f"nodes/commitments/{uri}")
        if got is not None:
            (out / f"{name}.policy.json").write_bytes(got)
            proofs.append(f"{name}.policy.json")
        return got if got is not None else b""

    try:
        doc = json.loads(fetched)
    except ValueError as e:
        doc = None
        errs, notes = [f"fetched bytes are not JSON ({e})"], []
    if doc is not None:
        def fetch_staple(part):
            got = read(f"nodes/commitments/standard_history/{rec['node_id']}.{part}.json")
            if got is not None:
                (out / f"{name}.standard_history.{part}.json").write_bytes(got)
                proofs.append(f"{name}.standard_history.{part}.json")
            return got
        errs, notes = cc.verify(doc, fetch_policy, fetch_staple)
        if key_id is None:
            errs.append(f"nodes/{rec['node_id']}.json does not list the node's key_id at HEAD")
        elif isinstance(doc, dict) and doc.get("key_id") != key_id:
            errs.append("the commitment is not under this node's key")
        if not errs:
            sv = (sv_.unchecked("the staple is a rehearsal stand-in in an evidence-commitment/0, not a card the node's book "
                                "signed; capsule-cli takes no keys for /0 and the Goose population verifies a real /1 card", legacy=True)
                  if rec.get("inputs") == "stand-in" else sv_.verify(out / proofs[0], key_id))
            errs += sv["errors"]
            rec["staple_verify"] = {k: sv[k] for k in ("state", "not_checked", "outside", "legacy")}
            rec["staple_verify"]["capsule_cli"] = sv_.pinned_version()
            rec["staple_verify"]["ran"] = sv["report"] is not None  # capsule-cli gave a report, whatever it found
            if sv["report"] is not None:
                (out / f"{name}.staple-verify.json").write_text(json.dumps(sv["report"], indent=2, sort_keys=True) + "\n")
                proofs.append(f"{name}.staple-verify.json")
    rec["result"] = "FAIL" if errs else "PASS"
    rec["errors"], rec["notes"] = errs, notes
    if doc is not None and not errs:
        rec["sha256"] = hashlib.sha256(fetched).hexdigest()
        rec["signature"] = "Ed25519 over the JCS form without sig, verified under spki (openssl pkeyutl)"
        rec["policy_digest"] = doc["lcap"]["policy_digest"]
        rec["history_cards"] = hc.history_cards(doc)
        if "standard_history" in doc:
            rec["standard_history"] = {**doc["standard_history"], "bytes_checked": not any(n.startswith(cc.STD_NOT_SUPPLIED) for n in notes)}
    return rec, proofs


def tool_versions():
    """The runner's openssl and git, which the step uses (base-image tools, not versions.lock components)."""
    out = [subprocess.run([t, a], capture_output=True, text=True).stdout.strip()
           for t, a in (("openssl", "version"), ("git", "--version"))]
    return " and ".join(out)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--population", required=True, type=Path)
    ap.add_argument("--out", required=True, type=Path)
    ap.add_argument("--carrier", type=Path, default=ROOT,
                    help="live only: the git repository whose HEAD is read (default: this repository)")
    args = ap.parse_args(argv)
    started = finding.now()
    population = args.population.resolve()
    out = args.out.resolve()
    out.mkdir(parents=True, exist_ok=True)
    pop = json.loads((population / "population.json").read_text(encoding="utf-8"))
    kind = pop["population"]
    live = kind == "live"
    if live:
        collect_live(pop, out, args.carrier.resolve())
        judge_live(pop, out, started)
        return 0
    records, proof = [], []
    goose = pop.get("goose") or {}
    signed = goose.get("commitments") or {}
    pinned, gaps = [], []
    if signed:  # the Goose rehearsal: the commitments are G1's, so the finding pins goose-g1 and names the revision
        pinned = ["goose-g1"]
        if goose.get("rev") != finding.pins()["goose-g1"][1]:
            gaps.append({"what": "goose-g1", "why": f"installed {goose.get('rev')}, versions.lock pins "
                         f"{finding.pins()['goose-g1'][1]}",
                         "issue": "none: steps/goose.setup.sh has not installed the pin"})
    with tempfile.TemporaryDirectory() as tmp:
        carrier = Path(tmp) / "carrier"
        carrier.mkdir()
        git(carrier, "init", "-q")
        for node in pop["nodes"]:
            rec, files = check_node(population, out, node, carrier, signed.get(node["name"]), goose.get("rev"))
            records.append(rec)
            proof += files
        git(carrier, "bundle", "create", "-q", str(out / "carrier.bundle"), "--all")
        proof.append("carrier.bundle")
    conclude(out, kind, records, proof, started, pinned, gaps)
    return 0


# --- Live: what the carrier held, kept in the proof so step 08 runs the judge again on it (loop#188) ---------
CARRIER_FILE = "carrier.json"  # the carrier's HEAD commit, and per node its listed key_id and what HEAD held


def collect_live(pop, out, carrier):
    """Read each live node's listing, commitment and policy at the carrier's HEAD; keep what was read under out
    (carrier.json, <name>.commitment.json, <name>.policy.json). The harness never signs for a live node."""
    out = Path(out)
    for p in [out / CARRIER_FILE, out / "verification.json", out / "finding.json",
              *out.glob("*.commitment.json"), *out.glob("*.policy.json")]:
        p.unlink(missing_ok=True)
    rev = git(carrier, "rev-parse", "HEAD", check=False)
    head = rev.stdout.decode().strip() if rev.returncode == 0 else None
    ref = head or "HEAD"  # every read is at the one commit recorded, even if the carrier moves meanwhile
    held = {}
    for node in pop["nodes"]:
        _, key_id = live_node(node, carrier, ref)
        held[node["name"]] = entry = {"node_id": node.get("node_id"), "key_id": key_id, "paths": {}}
        if not node.get("node_id"):
            continue
        path = f"nodes/commitments/{node['node_id']}.json"
        got = fetch(carrier, path, ref)
        entry["paths"][path] = got is not None
        if got is None:
            continue
        (out / f"{node['name']}.commitment.json").write_bytes(got)
        try:
            uri = json.loads(got)["lcap"]["policy_uri"]
        except (ValueError, KeyError, TypeError):
            continue
        if isinstance(uri, str) and not ("://" in uri or uri.startswith("/") or ":" in uri.split("/")[0]):
            pol = fetch(carrier, f"nodes/commitments/{uri}", ref)
            entry["paths"][f"nodes/commitments/{uri}"] = pol is not None
            if pol is not None:
                (out / f"{node['name']}.policy.json").write_bytes(pol)
    doc = {"head": head, "nodes": held}
    (out / CARRIER_FILE).write_text(json.dumps(doc, indent=2, sort_keys=True) + "\n")


def judge_live(pop, out, started):
    """The live finding from carrier.json and the commitment and policy files collect_live kept, only."""
    out = Path(out)
    try:
        held = json.loads((out / CARRIER_FILE).read_text(encoding="utf-8"))["nodes"]
        if not isinstance(held, dict):
            raise TypeError("nodes is not an object")
    except (OSError, ValueError, KeyError, TypeError) as e:
        rec = {"name": CARRIER_FILE, "node_id": None, "result": "FAIL", "carrier": CARRIER_FILE,
               "errors": [f"{CARRIER_FILE} is not readable ({type(e).__name__}: {e})"], "notes": []}
        return conclude(out, "live", [rec], [], started)
    records, proof = [], [CARRIER_FILE]
    names = [n["name"] for n in pop["nodes"]]
    for node in pop["nodes"]:
        name = node["name"]
        entry = held.get(name)
        rec = {"name": name, "node_id": node.get("node_id"), "signed_by": "the node (never the harness)"}
        if not isinstance(entry, dict) or entry.get("node_id") != node.get("node_id") or \
                not isinstance(entry.get("paths"), dict):
            records.append({**rec, "result": "FAIL", "carrier": CARRIER_FILE, "notes": [],
                            "errors": [f"{CARRIER_FILE} does not record this node as the population names it"]})
            continue
        rec["key_id"] = entry.get("key_id")
        files = {f"nodes/commitments/{node.get('node_id')}.json": out / f"{name}.commitment.json"}

        def read(path, entry=entry, files=files, name=name):
            if not entry["paths"].get(path):
                return None
            f = files.get(path, out / f"{name}.policy.json")
            return f.read_bytes()
        try:
            r, files_written = verify_node(out, name, rec, entry.get("key_id"), read, True)
        except OSError as e:
            r, files_written = {**rec, "result": "FAIL", "carrier": CARRIER_FILE, "notes": [],
                                "errors": [f"a file carrier.json says HEAD held is not in the proof ({e})"]}, []
        records.append(r)
        # Every file collect_live kept for the node is cited, even one the checker stopped before reading.
        proof += files_written + [f for f in (f"{name}.commitment.json", f"{name}.policy.json")
                                  if f not in files_written and (out / f).is_file()]
    extra = sorted(set(held) - set(names))
    if extra:
        records.append({"name": CARRIER_FILE, "node_id": None, "result": "FAIL", "carrier": CARRIER_FILE,
                        "notes": [], "errors": [f"{CARRIER_FILE} names nodes outside the population: {extra}"]})
    return conclude(out, "live", records, proof, started)


def conclude(out, kind, records, proof, started, pinned=(), gaps=()):
    """verification.json and the finding, from the per-node records."""
    live = kind == "live"
    verification = {"tool": f"scripts/check_commitment.py with {tool_versions()}", "nodes": records}
    (out / "verification.json").write_text(json.dumps(verification, indent=2, sort_keys=True) + "\n")
    proof = [*proof, "verification.json"]

    results = {r["result"] for r in records}
    not_checked = [{"what": f"{r['name']}: the node-signed commitment is published and verifies",
                    "why": "; ".join(r["errors"]) + (f"; a live commitment is signed by the node, never by the "
                                                     f"harness: {LIVE_GAP}" if live else ""),
                    "issue": LIVE_ISSUE if live else "evidence-network/loop: step 12 Join (steps/12-join) publishes it"}
                   for r in records if r["result"] == "NOT_CHECKED"]
    not_checked += list(gaps)
    checked = [r for r in records if r["result"] == "PASS"]
    # The staple's signature and the checkpoint attestation are outside the assertion: on a PASS they are
    # sentences in detail, otherwise not_checked entries. A policy digest not checked is inside it.
    outside = []
    for r in checked:
        streams = ", ".join(str(c["stream"]) for c in r["history_cards"] if c["stream"])
        if r["staple_verify"]["state"] != "PASS":
            outside.append({"what": f"{r['name']}: the stapled history_card/1 verifies"
                                    + (f" (streams {streams})" if len(r["history_cards"]) > 1 else ""),
                            "why": "its bytes, digest, profile and responder are checked; its signature is not: "
                                   + "; ".join(r["staple_verify"]["not_checked"]),
                            "issue": LEGACY_ISSUE if r["staple_verify"]["legacy"] else STAPLE_ISSUE})
        outside.append({"what": f"{r['name']}: the stapled checkpoint attestation verifies",
                        "why": "its bytes match the committed digest; verifying the checkpoint is step 02's assertion",
                        "issue": CHECKPOINT_ISSUE})
        if "standard_history" in r:
            outside.append({"what": f"{r['name']}: the standard_history/1 staple verifies",
                            "why": "its two digests " + ("and its answer's responder and request are checked" if r["standard_history"]["bytes_checked"]
                                                         else "are shape-checked, the bytes were not supplied")
                                   + "; the staple's signature is evidencebook's CheckStaple, not run here",
                            "issue": STANDARD_ISSUE})
        for n in r["notes"]:
            if n.startswith(cc.STD_NOT_SUPPLIED):
                continue
            not_checked.append({"what": f"{r['name']}: the policy digest", "why": n,
                                "issue": "evidence-network/loop: the step fetches policies from the carrier only"})
    if "FAIL" in results:
        result = "FAIL"
    elif checked and not not_checked:
        result = "PASS"
    else:
        result = "NOT_CHECKED"
    nostr_read = any(r.get("nostr", {}).get("result") in ("PASS", "FAIL") for r in records)
    detail = "; ".join(
        f"{r['name']}: {r['result']} via {r['carrier']}"
        + (" and nostr" if r.get("nostr", {}).get("result") == "PASS" else "")
        + (", not advertised on nostr" if r.get("nostr", {}).get("result") == "NOT_ADVERTISED" else "")
        + (f" ({'; '.join(r['errors'])})" if r["errors"] else "")
        + (f", inputs {r['inputs']}" if "inputs" in r else "")
        for r in records)
    detail += f". Runner tools: {tool_versions()} (not versions.lock components)."
    if result == "PASS":
        names = ", ".join(r["name"] for r in checked)
        standins = [r["name"] for r in checked if r.get("inputs") == "stand-in"]
        if standins:
            detail += f" The staple of {', '.join(standins)} is a rehearsal stand-in."
        detail += (f" The stapled checkpoint attestation is step 02's assertion; here ({names}) only its bytes are "
                   "matched to the committed digest.")
        verified = [r["name"] for r in checked if r["staple_verify"]["state"] == "PASS"]
        if verified:
            detail += (f" The stapled history_card/1 of {', '.join(verified)} verifies with capsule-cli "
                       f"{sv_.pinned_version()} (a pre-release; every capsule-cli release is one) `verify --history`, under "
                       "the node key and the checkpoint key each card entry names: digest, envelope and checkpoint "
                       "signatures, the card's checkpoint anchor and responder. Caller invariance and request binding are not part of it (a "
                       "commitment carries no request, and no second caller's answer is held).")
        for r in checked:
            if r["staple_verify"]["state"] != "PASS":
                detail += " " + finding.outside(
                    f"the stapled history_card/1 signature ({r['name']}) is not verified: "
                    + "; ".join(r["staple_verify"]["not_checked"]),
                    LEGACY_ISSUE if r["staple_verify"]["legacy"] else STAPLE_ISSUE)
        stapled = [r for r in checked if "standard_history" in r]
        if stapled:
            with_bytes = [r["name"] for r in stapled if r["standard_history"]["bytes_checked"]]
            shape_only = [r["name"] for r in stapled if not r["standard_history"]["bytes_checked"]]
            coverage = []
            if with_bytes:
                coverage.append("the digests, the answer's responder and its request were checked from the published "
                                f"bytes ({', '.join(with_bytes)})")
            if shape_only:
                coverage.append(f"the bytes were not published, so only the member's shape was checked ({', '.join(shape_only)})")
            detail += " " + finding.outside(
                f"the standard_history/1 staple of {', '.join(r['name'] for r in stapled)}: its signature is "
                "evidencebook's CheckStaple, not run here; " + "; ".join(coverage), STANDARD_ISSUE)
    else:
        not_checked += outside
    ran = any(r.get("staple_verify", {}).get("ran") for r in records)
    return finding.write(out, result=result, population=kind, asserts=ASSERTS + (ASSERTS_NOSTR if nostr_read else "") + (ASSERTS_STAPLE if ran else ""),
                         pinned=list(pinned) + (["capsule-cli"] if ran else []), proof=proof, detail=detail, not_checked=not_checked, started=started)


if __name__ == "__main__":
    sys.exit(main())
