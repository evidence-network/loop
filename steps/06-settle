def check(ok, detail):
    return {"ok": bool(ok), "detail": detail}


def read_json(path):
    return json.loads(Path(path).read_text(encoding="utf-8"))


def nodes_of(population_dir):
    """{name: key_id} of the population's nodes, from their public keys."""
    out = {}
    for n in read_json(Path(population_dir) / "population.json")["nodes"]:
        key_dir = Path(n["key_dir"])
        key_dir = key_dir if key_dir.is_absolute() else ROOT / key_dir
        out[n["name"]] = cc.key_id_of(cc.spki_from_pem((key_dir / "node-key.pub.pem").read_text()))
    return out


def gather(population_dir, out):
    """Copy the rail's and the step's inputs into out: the proof bytes the step decides on."""
    rail_dir, inputs = Path(population_dir) / "rail", Path(population_dir) / "step06"
    decl = read_json(rail_dir / "rail.json")
    for f in RAIL_FILES:
        shutil.copyfile(rail_dir / f, out / f)
    shutil.copyfile(rail_dir / decl["public_key"], out / "rail-key.pub.pem")
    for f in INPUTS + sorted(p.name for p in inputs.glob("disclosure-*.json")):
        shutil.copyfile(inputs / f, out / f)


def ledger_checks(lines, decl, spki):
    """(reports per line, the ledger check)."""
    reports = [mock_rail.verify(ln, decl, spki) for ln in lines]
    problems = []
    for i, rs in enumerate(reports, 1):
        bad = [r["property"] for r in rs if r["property"] in ("object_form", "rail_signature", "settlement_id")
               and r["status"] != mock_rail.PASS]
        if bad:
            problems.append(f"line {i}: {', '.join(bad)}")
    objs = [json.loads(ln) if not problems else None for ln in lines]
    if not problems:
        seqs = [o["sequence"] for o in objs]
        if seqs != list(range(1, len(objs) + 1)):
            problems.append(f"sequences {seqs}, not 1..{len(objs)}")
        ids = [o["settlement_id"] for o in objs]
        dup = sorted({i for i in ids if ids.count(i) > 1})
        if dup:
            problems.append(f"duplicate settlement {', '.join(dup)}")
    return reports, check(lines and not problems,
                          "; ".join(problems) or f"{len(lines)} settlements, each signed by the rail, in sequence, "
                                                  "no id repeated")


def volume(objs, reports, decl, controllers):
    """Raw and filtered settlement counts over the ledger, overall and per band."""
    raw, filtered = {}, {}
    for o, rs in zip(objs, reports):
        st = {r["property"]: r["status"] for r in rs}
        if not all(st[p] == mock_rail.PASS for p in ("object_form", "rail_signature", "settlement_id", "finality")):
            continue
        b = mock_rail.band(o["currency"], o["amount_atomic"], o["decimals"]) or "unbanded"
        raw[b] = raw.get(b, 0) + 1
        payer, payee = controllers.get(o["payer"]), controllers.get(o["payee"])
        if st["rail_fee"] == mock_rail.PASS and payer and payee and payer != payee:
            filtered[b] = filtered.get(b, 0) + 1
    return {"rail": decl.get("rail"), "unit": "settlements", "raw": sum(raw.values()),
            "filtered": sum(filtered.values()), "raw_by_band": raw, "filtered_by_band": filtered,
            "filter": "final, on a fee-paying rail, payer and payee declared under different controllers"}


def decide(out, *, population, nodes, started, goose=False, pinned=None):
    """Check the proof bytes in out and write the finding."""
    out = Path(out)
    checks = {}
    decl, spki = mock_rail.rail_key(out, out / "rail-key.pub.pem")
    lines = (out / "ledger.jsonl").read_bytes().splitlines()
    reports, checks["ledger"] = ledger_checks(lines, decl, spki)
    objs = [json.loads(ln) if checks["ledger"]["ok"] else {} for ln in lines]

    exchange = read_json(out / "exchange.json")
    ref = exchange.get("settlement_ref")
    hits = [i for i, o in enumerate(objs) if isinstance(ref, dict) and o.get("settlement_id") == ref.get("settlement_id")]
    by_ref = (sorted(exchange) == EXCHANGE_KEYS and isinstance(ref, dict) and sorted(ref) == ["rail", "settlement_id"]
              and ref["rail"] == decl["rail"])
    checks["reference"] = check(by_ref and len(hits) == 1,
                                f"settlement_ref {json.dumps(ref, sort_keys=True)} names {len(hits)} ledger line(s); "
                                f"exchange members {sorted(exchange)}")
    adapter_out = {"adapter": mock_rail.declare(), "settlement": None, "reports": []}
    if len(hits) == 1:
        obj, rs = objs[hits[0]], reports[hits[0]]
        adapter_out.update(settlement={"line": hits[0] + 1, "settlement_id": obj["settlement_id"]}, reports=rs)
        st = {r["property"]: r for r in rs}
        checks["adapter"] = check(all(st[p]["status"] == mock_rail.PASS
                                      for p in ("object_form", "rail_signature", "settlement_id")),
                                  ", ".join(f"{p} {st[p]['status']}" for p in ("object_form", "rail_signature",
                                                                               "settlement_id")))
        band = st["band"]["detail"]
        for p in ("finality", "rail_fee", "band"):
            checks[p] = check(st[p]["status"] == mock_rail.PASS, f"{st[p]['status']}: {st[p]['detail']}")
        diff = [k for k in MATCHED if obj.get(k) != exchange.get(k)]
        checks["exchange_match"] = check(not diff, ", ".join(f"{k}: settlement {obj.get(k)!r}, exchange "
                                                            f"{exchange.get(k)!r}" for k in diff)
                                         or f"exchange {exchange.get('exchange_id')}: " + ", ".join(MATCHED) + " match")
    else:
        for p in ("adapter", "finality", "rail_fee", "band", "exchange_match"):
            checks[p] = check(False, "no single settlement object to check")
    (out / "adapter.json").write_text(json.dumps(adapter_out, indent=2, sort_keys=True) + "\n")

    by_key = {v: k for k, v in nodes.items()}
    for name in sorted(set(nodes) | {f.stem[len("disclosure-"):] for f in out.glob("disclosure-*.json")}):
        f = out / f"disclosure-{name}.json"
        key_id = nodes.get(name)
        if not f.is_file():
            checks[f"ledger_count:{name}"] = check(False, f"{name} made no disclosure of its settlement count")
            continue
        d = read_json(f)
        signed = key_id is not None and d.get("key_id") == key_id and cc.verify_sig(d, cc.ED25519_SPKI + bytes.fromhex(key_id))
        through = d.get("through_sequence")
        counted = sum(1 for o in objs if o and o["final"] is True and key_id in (o["payer"], o["payee"])
                      and isinstance(through, int) and o["sequence"] <= through)
        ok = (signed and d.get("rail") == decl["rail"] and checks["ledger"]["ok"]
              and isinstance(through, int) and through <= len(objs) and d.get("settlements") == counted)
        checks[f"ledger_count:{name}"] = check(ok, f"{name} discloses {d.get('settlements')!r} through sequence "
                                                   f"{through!r} (signature {'verifies' if signed else 'fails'}); "
                                                   f"the public ledger counts {counted}")
    if not any(k.startswith("ledger_count:") for k in checks):
        checks["ledger_count"] = check(False, "no node disclosure to compare with the ledger")

    controllers = read_json(out / "controllers.json").get("controllers", {})
    vol = volume(objs, reports, decl, controllers) if checks["ledger"]["ok"] else None
    (out / "checks.json").write_text(json.dumps({"checks": checks}, indent=2, sort_keys=True) + "\n")
    proof = RAIL_FILES + ["rail-key.pub.pem"] + INPUTS + sorted(p.name for p in out.glob("disclosure-*.json")) + \
        ["adapter.json", "checks.json"]
    if vol is not None:
        (out / "volume.json").write_text(json.dumps(vol, indent=2, sort_keys=True) + "\n")
        proof.append("volume.json")
    failed = [f"{k} ({c['detail']})" for k, c in checks.items() if not c["ok"]]
    where = f"exchange {exchange.get('exchange_id')}, settlement {ref.get('settlement_id') if isinstance(ref, dict) else ref}"
    payer = by_key.get(exchange.get("payer"), "an unknown key")
    payee = by_key.get(exchange.get("payee"), "an unknown key")
    if failed:
        return finding.write(out, result="FAIL", population=population, asserts=ASSERTS, pinned=pinned or PINNED, proof=proof,
                             detail=f"{where}: did not hold: {'; '.join(failed)}", started=started)
    detail = (f"{where} ({payer} pays {payee}) on the mock rail, a rehearsal rail under a TEST key that moves no "
              f"value: these held on the proof bytes: {', '.join(checks)}. Band {band}. "
              f"Volume: {vol['filtered']} filtered of {vol['raw']} raw settlements ({vol['filter']}). "
              + finding.outside("the exchange's sealed halves, which this step reads as an unsigned stand-in, and "
                                "the controller declarations, which are rehearsal stand-ins", DEAL_ISSUE) + " "
              + finding.outside("a settlement object on a real rail, verified with finality by its adapter",
                                ADAPTER_ISSUE))
    if goose:  # the Goose rehearsal (scripts/goose_rehearsal.py): say what ties the deal to the rail's object
        detail += " " + finding.outside("the settlement is tied to the Goose deal by construction (the "
                                        "driver passed the rail's settlement id to the buyer's loop_settle; "
                                        "that the pay record commits it is not read), and this step reads the "
                                        "exchange, controller and settlement-disclosure files the rehearsal "
                                        "driver wrote (the disclosures signed by the driver with each node's "
                                        "key, their counts computed by the driver from the rail's ledger), not "
                                        "the deal's pay record", "evidence-network/loop#330")
    return finding.write(out, result="PASS", population=population, asserts=ASSERTS, pinned=pinned or PINNED, proof=proof,
                         detail=detail, started=started)


# --- The live population: what the nodes recorded, read and listed, never paid for ----
LIVE_PINNED = ["capsules", "mesh-llm-pr-2620"]
SETTLEMENT_BLOCK = ("model_attestation", "compute_attestation", "x-mesh-settlement-v1")


def utc(text):
    """A record's RFC 3339 timestamp as an aware UTC datetime; None when it is not one."""
    if not isinstance(text, str):
        return None
    try:
        t = dt.datetime.fromisoformat(text.strip().replace("Z", "+00:00"))
    except ValueError:
        return None
    return t.astimezone(dt.timezone.utc) if t.tzinfo else None


def window_from(pop):
    """The population's window start (population.json "window": {"from": ...}) as a datetime; None for no window."""
    w = pop.get("window")
    if w is None:
        return None
    start = utc(w.get("from")) if isinstance(w, dict) and set(w) == {"from"} else None
    if start is None:
        raise ValueError('population window must be {"from": "<RFC 3339 time with a zone>"}')
    return start


HEX32 = re.compile(r"[0-9a-f]{64}")


def preimage_check(preimage, payment_hash):
    """The finality check on one observation (capsules-plugin adapters/lightning-v0.md, "preimage"): None when it
    carries no preimage; "malformed" when the preimage is not 32 bytes of lowercase hex, whatever the hash;
    "no_payment_hash" when it names no hash to check against (none, or not 32 bytes of lowercase hex);
    "verified" when sha256(preimage) == payment_hash, else "mismatch"."""
    if preimage is None:
        return None
    if not isinstance(preimage, str) or not HEX32.fullmatch(preimage):
        return "malformed"
    if not isinstance(payment_hash, str) or not HEX32.fullmatch(payment_hash):
        return "no_payment_hash"
    return "verified" if hashlib.sha256(bytes.fromhex(preimage)).hexdigest() == payment_hash else "mismatch"


def lifecycle(rec):
    """(the capsule, its payment.lifecycle.v1 block or None) of one ledger or bundle record."""
    rec = rec.get("capsule", rec) if isinstance(rec, dict) else {}
    if not isinstance(rec, dict):
        return {}, None
    block = rec
    for k in SETTLEMENT_BLOCK:
        block = block.get(k) if isinstance(block, dict) else None
    return rec, block if isinstance(block, dict) else None


def in_window(rec, since):
    """"in", "outside" or "undated": where a record's signed capsule timestamp falls against the window start."""
    if since is None:
        return "in"
    at = utc(rec.get("timestamp"))
    return "undated" if at is None else "outside" if at < since else "in"


# The lifecycle phases that say an exchange was delivered or its bill accounted (mesh-llm's payment.lifecycle.v1).
DELIVERY_PHASES = ("delivered", "final_accounted")


def leg_kind(leg):
    """A settlement leg's kind (terms, payer_observed, payee_observed, delivered)."""
    return leg.get("leg") or leg.get("kind")


def leg_hash(leg):
    """The payment hash a settlement leg's payment_ref names, or None."""
    ref = leg.get("payment_ref")
    ok = isinstance(ref, dict) and ref.get("type") == "ln.payment_hash" and isinstance(ref.get("value"), str)
    return ref["value"] if ok else None


def recorded(ledger, since=None):
    """The settlement records in a node's capsules ledger: legs and wallet-reported lifecycle observations.

    With `since`, only settlement records whose signed capsule timestamp is at or after it count; the earlier
    ones, and those with no readable timestamp, are counted in "outside_window" and "undated" and not listed.
    Records that are neither a leg nor an observation (padding, for one) are never counted. An observation's
    preimage is checked (preimage_check) and only the outcome kept: the preimage itself is never listed.

    More lists serve unsettled_invoices(), each read over the whole ledger, window or not, so a window can only
    keep an invoice judged: "invoices", the node's *_invoice_issued observations (exchange id and payment hash);
    "delivered_exchanges", the exchange ids it recorded as delivered or accounted; "orphan_deliveries", those of
    them no lifecycle record of the node ties to a payment hash; "named_hashes", every payment hash any of its legs
    or lifecycle records names; "settled_hashes", those its settlement observations (*_settlement_observed) or legs
    other than a terms leg name; and "settled_exchanges", the exchange ids of its settlement observations, with a
    payment hash or not.
    """
    legs, observed, invoices, delivered, settled, tied, settled_ex, named = [], [], [], set(), set(), set(), set(), set()
    outside = undated = 0
    for line in ledger.read_text(encoding="utf-8").splitlines():
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        rec, block = lifecycle(rec)
        leg = rec.get("settlement")
        phase = str(block.get("phase", "")) if block else ""
        if phase in DELIVERY_PHASES and isinstance(block.get("exchange_id"), str):
            delivered.add(block["exchange_id"])
        if block and isinstance(block.get("payment_hash"), str):
            named.add(block["payment_hash"])
            if isinstance(block.get("exchange_id"), str):
                tied.add(block["exchange_id"])
        if isinstance(leg, dict) and leg_hash(leg):
            named.add(leg_hash(leg))
        if phase.endswith("_invoice_issued"):
            invoices.append({"exchange_id": block.get("exchange_id"), "payment_hash": block.get("payment_hash")})
        has_obs = phase.endswith("_settlement_observed")
        if has_obs and isinstance(block.get("payment_hash"), str):
            settled.add(block["payment_hash"])
        if has_obs and isinstance(block.get("exchange_id"), str):
            settled_ex.add(block["exchange_id"])
        if isinstance(leg, dict) and leg_kind(leg) != "terms" and leg_hash(leg):
            settled.add(leg_hash(leg))
        if not (isinstance(leg, dict) or has_obs):
            continue
        where = in_window(rec, since)
        if where == "undated":
            undated += 1
            continue
        if where == "outside":
            outside += 1
            continue
        if isinstance(leg, dict):
            legs.append({"capsule_id": rec.get("capsule_id"), "leg": leg_kind(leg),
                         "payment_ref": leg.get("payment_ref")})
        if has_obs:
            observed.append({"capsule_id": rec.get("capsule_id"), "exchange_id": block.get("exchange_id"),
                             "phase": block.get("phase"), "source": block.get("source"),
                             "observed_by": block.get("observed_by"),
                             "payment_hash": block.get("payment_hash"), "amount_msat": block.get("amount_msat"),
                             "credited_msat": block.get("credited_msat"), "fee_msat": block.get("fee_msat"),
                             "preimage_check": preimage_check(block.get("preimage"), block.get("payment_hash"))})
    out = {"settlement_legs": legs, "settlement_observations": observed, "invoices": invoices,
           "delivered_exchanges": sorted(delivered), "orphan_deliveries": sorted(delivered - tied),
           "named_hashes": sorted(named),
           "settled_hashes": sorted(settled), "settled_exchanges": sorted(settled_ex)}
    if since is not None:
        out.update(window_from=since.strftime("%Y-%m-%dT%H:%M:%SZ"), outside_window=outside, undated=undated)
    return out


def payment_hashes(found):
    """The payment hashes a node recorded, from its legs' payment_ref and its wallet observations."""
    hashes = {leg["payment_ref"]["value"] for leg in found["settlement_legs"]
              if isinstance(leg.get("payment_ref"), dict) and leg["payment_ref"].get("type") == "ln.payment_hash"
              and isinstance(leg["payment_ref"].get("value"), str)}
    return hashes | {o["payment_hash"] for o in found["settlement_observations"]
                     if isinstance(o.get("payment_hash"), str)}


def is_int(v):
    return isinstance(v, int) and not isinstance(v, bool)


def crosscheck(found, every_node=True):
    """Compare the payment hashes the nodes recorded. found: {node: recorded()}. With every_node a hash every node
    did not record is unpaired (the demo's two nodes share every payment); without it, two nodes holding it suffice
    (a live population where each payment is between two of its nodes).

    A hash is paired when all its payer observations are on one node with one amount_msat, all its provider
    observations are on another node with one credited_msat + fee_msat, and the two amounts are equal (repeated
    identical observations from lifecycle phases still pair). Every other hash is unpaired with the reason.
    """
    seen = {}
    for name, hs in {n: payment_hashes(f) for n, f in found.items()}.items():
        for h in hs:
            seen.setdefault(h, []).append(name)
    paired, unpaired = {}, {}
    for h, names in sorted(seen.items()):
        payers, payees, malformed, unnumbered = set(), set(), [], []
        for name, f in found.items():
            for o in f["settlement_observations"]:
                if o.get("payment_hash") != h:
                    continue
                role = o.get("observed_by")
                if role == "payer" and is_int(o.get("amount_msat")):
                    payers.add((name, o["amount_msat"]))
                elif role == "provider" and is_int(o.get("credited_msat")) and is_int(o.get("fee_msat")):
                    payees.add((name, o["credited_msat"] + o["fee_msat"]))
                elif role == "provider" and all(o.get(k) is None or is_int(o.get(k)) for k in ("credited_msat", "fee_msat")):
                    unnumbered.append(name)  # the receiving wallet gave no numbers (lightning-v0: not present)
                else:
                    malformed.append(name)  # no role, or a role without integer amounts
        payer_nodes, payee_nodes = sorted({n for n, _ in payers}), sorted({n for n, _ in payees})
        payer_amts, payee_amts = sorted({a for _, a in payers}), sorted({a for _, a in payees})
        if len(names) < (len(found) if every_node else 2):
            unpaired[h] = f"recorded by {', '.join(sorted(names))} only"
        elif malformed:
            unpaired[h] = (f"an observation on {', '.join(sorted(set(malformed)))} has no payer or provider role "
                           "or no integer amounts")
        elif unnumbered and not payees:
            unpaired[h] = f"a provider observation on {', '.join(sorted(set(unnumbered)))} carries no credited_msat or fee_msat"
        elif not payers or not payees:
            unpaired[h] = "no payer observation or no provider observation, with amounts"
        elif len(payer_nodes) > 1 or len(payee_nodes) > 1:
            unpaired[h] = (f"payer observations on {', '.join(payer_nodes)} and provider observations on "
                           f"{', '.join(payee_nodes)}: one node of each role is needed")
        elif payer_nodes == payee_nodes:
            unpaired[h] = f"payer and provider observations are both on {payer_nodes[0]}"
        elif len(payer_amts) > 1 or len(payee_amts) > 1:
            unpaired[h] = f"conflicting amounts: payer {payer_amts}, provider credited plus fee {payee_amts}"
        elif payer_amts != payee_amts:
            unpaired[h] = f"payer amount_msat {payer_amts[0]} and provider credited_msat + fee_msat {payee_amts[0]} differ"
        else:
            paired[h] = {"payer": payer_nodes[0], "payee": payee_nodes[0], "amount_msat": payer_amts[0]}
    return {"nodes": sorted(found), "paired": paired, "unpaired": unpaired}


def finality_of(found):
    """({payment hash: True when a payer observation's preimage proves it}, [problems]) over all nodes' records:
    every hash a node recorded (payment_hashes, legs and observations alike) starts unproven.
    Only the payer's preimage proves the payment: the payer learns it once the payment completed, while the
    provider made it before it issued the invoice. Any observation's "malformed" or "mismatch" check is a
    problem whatever else holds."""
    proven, problems = {}, []
    for name, f in sorted(found.items()):
        for h in payment_hashes(f):
            proven.setdefault(h, False)
        for o in f["settlement_observations"]:
            check, h = o.get("preimage_check"), o.get("payment_hash")
            if isinstance(h, str):
                proven[h] = proven.get(h, False) or (check == "verified" and o.get("observed_by") == "payer")
            if check in ("malformed", "mismatch"):
                what = ("is not 32 bytes of lowercase hex" if check == "malformed"
                        else "does not hash to its payment_hash")
                problems.append(f"node {name}: the preimage of settlement observation {o.get('capsule_id')} "
                                f"(payment_hash {h}) {what}")
    return proven, problems


def band(amount_msat):
    """The capsules adapter's band (lightning-v0 "Band", settlement_adapter.rs band()): {currency, decade}, where
    decade = floor(log10(msat / 10^11)), the digits of msat minus 12; zero has no decade."""
    return {"currency": BAND_CURRENCY, "decade": len(str(amount_msat)) - 1 - BAND_ASSET_SCALE if amount_msat else None}


def terminal(found):
    """The node's terminal settlement observations (phase *_settlement_observed)."""
    return [o for o in found["settlement_observations"] if str(o.get("phase", "")).endswith("_settlement_observed")]


def unsettled_invoices(found):
    """The payment hashes agreed but unsettled as of the books read, which the ruled checks set aside (loop#303,
    Sherlock2 Buzz bb0d54d9). A hash is set aside only when all hold:
    - no node records a settlement for it: no settlement observation (*_settlement_observed) names it, and no leg
      but a terms leg does;
    - on every node that names it, that node's invoice observations tie it to exactly one exchange id of its own
      (the two books seal different ids for one payment);
    - none of those exchanges is delivered, accounted or settled on its node (a terminal observation under that
      exchange keeps the hash judged whatever payment hash, if any, it names);
    - no node holds an orphan delivery: an exchange delivered or accounted that none of its records ties to a payment
      hash. The books do not share exchange ids, so such a delivery could be the hash's own exchange with its
      invoice record lost; while one exists nothing is set aside (Sherlock2, Buzz 189cb0ca).
    All of it reads the whole ledger (recorded()), so a record outside the window still keeps the hash judged.
    Every other hash stays judged: the books cannot prove a payment unpaid, so a hash any book records as settled,
    delivered or accounted keeps finality and exchange_match open until a payer's preimage proves it."""
    settled, named = set(), set()
    for f in found.values():
        named |= payment_hashes(f)
        settled |= set(f["settled_hashes"])
    if any(f.get("orphan_deliveries") for f in found.values()):
        return []
    out = []
    for h in sorted(named - settled):
        ok = True
        for f in found.values():
            exchanges = {i.get("exchange_id") for i in f["invoices"] if i.get("payment_hash") == h}
            if h not in f["named_hashes"]:
                continue  # no record of this node names the hash, in the window or before it
            if len(exchanges) != 1 or not isinstance(next(iter(exchanges)), str) \
                    or exchanges & set(f["delivered_exchanges"] + f["settled_exchanges"]):
                ok = False
                break
        if ok:
            out.append(h)
    return out


def bundle_settlements(doc, since):
    """(the payment hashes of the terminal settlement records in a counterparty bundle file in the window, the
    number of its settlement records with no readable timestamp under a window); None when it holds no bundle."""
    records = (doc.get("bundle") or {}).get("records") if isinstance(doc, dict) and doc.get("state") == "bundle" else None
    if not isinstance(records, list):
        return None
    hashes, undated = set(), 0
    for r in records:
        rec, block = lifecycle(r)
        if not (block and str(block.get("phase", "")).endswith("_settlement_observed")):
            continue
        where = in_window(rec, since)
        undated += where == "undated"
        if where == "in" and isinstance(block.get("payment_hash"), str):
            hashes.add(block["payment_hash"])
    return hashes, undated


def counterparty_verdict(row, n, since):
    """(ok, detail) of counterparty_count for one counterparty.json row whose books pair n payments in the window,
    once its bundle file was read: the decision steps/08-verify takes again from the proof. A whole-book FAIL is a
    FAIL; a whole-book status other than PASS is open; so is a bundle with settlement records the window cannot
    place (bundle_undated), or whose settlements in the window are not the books' pairs (bundle_only: settlements
    only the bundle holds; books_only: pairs only the books hold). A PASS holds when none is, and both sides number
    n. Only counts are in the row, never a hash or a record."""
    me, peer, status, paired, unpaired = row["node"], row["peer"], row["status"], row["paired"], row["unpaired"]
    span = "in the window" if since is not None else "in all"
    if status == "FAIL":
        return False, f"{me}'s book contradicts {peer}'s signed bundle: {unpaired} unpaired"
    if status != "PASS":
        return None, (f"{me}'s check of {peer}'s signed bundle over the whole books reads {status} with {paired} paired "
                      f"and {unpaired} unpaired")
    if row["bundle_undated"]:
        return None, (f"{peer}'s signed bundle holds {row['bundle_undated']} settlement records with no timestamp, "
                      "which the window cannot place")
    if row["bundle_only"] or row["books_only"] or row["bundle_settlements"] != n or row["books_pair"] != n:
        return None, (f"{peer}'s signed bundle holds {row['bundle_settlements']} settlements {span}, while the books "
                      f"pair {n} payments between them there ({row['books_only']} not in the bundle, "
                      f"{row['bundle_only']} not paired in the books): the check predates a payment or a record sits "
                      "on the window's edge (run lab/lab.sh bundles)")
    return True, (f"{me}'s {row['disclosed_settlements']} settlements against {peer}'s signed bundle (sha256 "
                  f"{str(row['bundle_sha256'])[:12]}): PASS over the whole books, {paired} paired, {unpaired} unpaired; "
                  f"the {n} payments the books pair between them {span} are exactly the bundle's")


def lightning_checks(found, ids, checks_dir, since=None):
    """The ruled checks over every node's records: ({name: {ok, detail}}, published counterparty rows).

    found: {node name: recorded()}; ids: {node name: node_id}; checks_dir: where lab.sh bundles wrote
    check.<node id>.<peer node id>.json, or None; since: the window start, or None. ok is True, False (a FAIL) or
    None (not checked)."""
    checks = {}
    def put(name, ok, detail):
        checks[name] = {"ok": ok, "detail": detail}
    # 0. Invoices agreed but unsettled as of the books read leave the judged hashes (unsettled_invoices); only their
    # terms legs name them, so dropping those legs drops them from finality and exchange_match, and from nothing else.
    unsettled = set(unsettled_invoices(found))
    found = {n: {**f, "settlement_legs": [l for l in f["settlement_legs"] if leg_hash(l) not in unsettled]}
             for n, f in found.items()}
    # 1. Reference: each book's terminal settlements name a payment_hash and an exchange_id, one exchange per hash.
    # Per book: each side seals its own exchange id for the same payment (on the lab the payer's and the payee's ids
    # differ for one hash), so one hash under two exchanges is checked within a book, and the books join by hash.
    missing, repeated = [], []
    for name, f in sorted(found.items()):
        by_hash = {}
        for o in terminal(f):
            if not (isinstance(o.get("payment_hash"), str) and isinstance(o.get("exchange_id"), str)):
                missing.append(f"{name}: settlement {o.get('capsule_id')}")
                continue
            by_hash.setdefault(o["payment_hash"], set()).add(o["exchange_id"])
        repeated += [f"{name}: payment_hash {h} under {len(x)} exchanges" for h, x in sorted(by_hash.items()) if len(x) > 1]
    hashes = sorted({o["payment_hash"] for f in found.values() for o in terminal(f) if isinstance(o.get("payment_hash"), str)})
    put("reference", False if repeated else None if missing or not hashes else True,
        "; ".join(repeated) if repeated else
        f"settlements without a payment_hash or exchange_id: {', '.join(missing)}" if missing else
        "no paid exchange recorded" if not hashes else
        f"{len(hashes)} payments, each referenced by one payment_hash under one exchange in each book")
    # 2. Final by preimage, from the payer's copy.
    proven, problems = finality_of(found)
    unproven = [h for h, ok in proven.items() if not ok]
    put("finality", False if problems else None if unproven or not proven else True,
        "; ".join(problems) if problems else
        f"{len(unproven)} of {len(proven)} payment hashes not proven by a payer's preimage" if unproven else
        "no payment hash recorded" if not proven else
        f"{len(proven)} of {len(proven)} payment hashes final by the payer's preimage")
    # 3. One band per side per exchange: the side's distinct terminal settlements, summed.
    bands, zero = [], []
    for name, f in sorted(found.items()):
        sides = {}
        for o in terminal(f):
            if not isinstance(o.get("exchange_id"), str):
                continue
            if not (is_int(o.get("amount_msat")) and o["amount_msat"] > 0):
                zero.append(f"{name} settlement {o.get('capsule_id')} amount {o.get('amount_msat')!r}")
                continue
            sides.setdefault((o["exchange_id"], o.get("observed_by")), {})[o.get("payment_hash")] = o["amount_msat"]
        for (ex, side), amounts in sorted(sides.items(), key=lambda kv: (kv[0][0], str(kv[0][1]))):
            b = band(sum(amounts.values()))
            bands.append({"node": name, "exchange_id": ex, "side": side, "band": b})
    put("band", False if zero else True if bands else None,
        f"settlements with no positive amount: {', '.join(zero)}" if zero else
        ", ".join(f"{b['node']} {b['side']} {b['band']['currency']} decade {b['band']['decade']}" for b in bands)
        if bands else "no side settled")
    # 4. A fee paid to a third party, per payment: some observation of the hash reports fee_msat > 0.
    unpaid = [h for h in hashes if not any(o.get("payment_hash") == h and is_int(o.get("fee_msat")) and o["fee_msat"] > 0
                                           for f in found.values() for o in terminal(f))]
    put("rail_fee", False if unpaid else True if hashes else None,
        f"payments with no fee paid to a third party: {', '.join(unpaid)}" if unpaid else
        f"each of {len(hashes)} payments carries a wallet provider's fee (fee_msat > 0)" if hashes else "no payment")
    # 5. The two books agree: the payer's amount equals the payee's credit plus fee (loop#183's pairing rule).
    cross = crosscheck(found, every_node=False)
    # One-sided, or a provider observation without the wallet's numbers (lightning-v0: not checked, not a FAIL).
    one_sided = {h: why for h, why in cross["unpaired"].items()
                 if why.startswith("recorded by") or why.startswith("no payer observation")
                 or why.startswith("a provider observation on")}
    contradicted = {h: why for h, why in cross["unpaired"].items() if h not in one_sided}
    put("exchange_match", False if contradicted else None if one_sided or not cross["paired"] else True,
        "; ".join(f"{h}: {why}" for h, why in sorted(contradicted.items())) if contradicted else
        "; ".join(f"{h}: {why}" for h, why in sorted(one_sided.items())) if one_sided else
        "no payment to pair" if not cross["paired"] else
        f"{len(cross['paired'])} payments paired: the payer's amount equals the payee's credit plus fee")
    # 6. counterparty_count, from each counterparty's signed bundle, for every pair of nodes that settled together.
    # The check is the plugin's over the two whole books, so it must PASS whatever the window (a FAIL stays a FAIL),
    # and its bundle file must still hash to the digest it recorded. Then like with like: the payments of the bundle's
    # terminal settlement records in the window must be exactly the payments the windowed books pair between the two
    # nodes (else the check predates a later payment, or a record sits on the window's edge).
    rows = []
    pair_hashes = {}
    for h, p in cross["paired"].items():
        pair_hashes.setdefault(tuple(sorted((p["payer"], p["payee"]))), set()).add(h)
    by_id = {v: k for k, v in ids.items() if v}
    wanted = {(me, peer) for a, b in pair_hashes for me, peer in ((a, b), (b, a))}
    present = set()
    if checks_dir and checks_dir.is_dir():
        for f in sorted(checks_dir.glob("check.*.*.json")):
            parts = f.name.split(".")
            if len(parts) == 4 and parts[1] in by_id and parts[2] in by_id:
                present.add((by_id[parts[1]], by_id[parts[2]]))
    for me, peer in sorted(wanted | present):
        what = f"counterparty_count:{me}:{peer}"  # one per ordered pair: a node may settle with several peers
        path = checks_dir / f"check.{ids.get(me)}.{ids.get(peer)}.json" if checks_dir else None
        try:
            doc = json.loads(path.read_text(encoding="utf-8")) if path else None
            cc = doc["report"]["counterparty_count"] if doc else None
        except (OSError, ValueError, KeyError, TypeError):
            doc, cc = None, None
        if not isinstance(cc, dict) or doc.get("node_id") != ids.get(me) or doc.get("peer_node_id") != ids.get(peer):
            put(what, None, f"no check of {me}'s book against {peer}'s signed bundle (run lab/lab.sh bundles)")
            continue
        bundle_file = checks_dir / str(doc.get("bundle_file"))
        try:
            raw = bundle_file.read_bytes() if doc.get("bundle_file") else None
        except OSError:
            raw = None
        digest = hashlib.sha256(raw).hexdigest() if raw is not None else None
        try:
            held = bundle_settlements(json.loads(raw), since) if raw is not None and digest == doc.get("bundle_sha256") \
                else None
        except ValueError:
            held = None
        status, paired = cc.get("status"), cc.get("paired")
        disclosed = (doc["report"].get("disclosed_count") or {}).get("settlements")
        unpaired = len(cc.get("unpaired") or [])
        expected = pair_hashes.get(tuple(sorted((me, peer))), set())
        rows.append({"node": me, "peer": peer, "status": status, "method": cc.get("method"), "paired": paired,
                     "unpaired": unpaired, "disclosed_settlements": disclosed, "bundle_sha256": doc.get("bundle_sha256"),
                     "bundle_settlements": len(held[0]) if held else None, "books_pair": len(expected),
                     "bundle_undated": held[1] if held else None,
                     "bundle_only": len(held[0] - expected) if held else None,
                     "books_only": len(expected - held[0]) if held else None,
                     "window_from": since.strftime("%Y-%m-%dT%H:%M:%SZ") if since is not None else None})
        if status == "FAIL":
            put(what, *counterparty_verdict(rows[-1], len(expected), since))
        elif digest is None or digest != doc.get("bundle_sha256"):
            put(what, None, f"{me}'s check names a bundle that is missing or changed since (run lab/lab.sh bundles)")
        elif held is None:
            put(what, None, f"{me}'s check names a file that holds no bundle from {peer} (run lab/lab.sh bundles)")
        else:
            put(what, *counterparty_verdict(rows[-1], len(expected), since))
    if not pair_hashes:
        put("counterparty_count", None, "no two nodes settled with each other")
    checks["public_ledger_count"] = {"ok": None, "detail": "Lightning has no public ledger; the counterparty's signed "
                                     "book stands in (counterparty_count), and this gap stays named", "gap": True}
    if unsettled:
        checks["unsettled_invoices"] = {
            "ok": None, "gap": True, "count": len(unsettled), "payment_hashes": sorted(unsettled),
            "detail": f"{len(unsettled)} invoices agreed but unsettled as of the books read (no book records a "
                      "settlement, a delivery or an accounted bill for them) are set aside, not judged: the books "
                      "cannot prove a payment unpaid"}
    return checks, rows


def main_lightning(pop, out, started, found, proof, details, not_checked):
    """The live Lightning PASS path (loop#243): the ruled checks, checks.json and counterparty.json (counts and
    bundle digests only, never a bundle) as proof."""
    ids = {n["name"]: n.get("node_id") for n in pop["nodes"]}
    checks, rows = lightning_checks(found, ids, live.path(pop, "settlement_checks"), window_from(pop))
    (out / "checks.json").write_text(json.dumps(checks, indent=2, sort_keys=True) + "\n")
    (out / "counterparty.json").write_text(json.dumps(rows, indent=2, sort_keys=True) + "\n")
    proof += ["checks.json", "counterparty.json"]
    judged = {k: v for k, v in checks.items() if not v.get("gap")}
    failed = sorted(k for k, v in judged.items() if v["ok"] is False)
    open_ = sorted(k for k, v in judged.items() if v["ok"] is None)
    details += [f"{k}: {v['detail']}" for k, v in sorted(judged.items())]
    unsettled = checks.get("unsettled_invoices")
    if unsettled:
        details.append(f"unsettled_invoices: {unsettled['detail']}")
    not_checked += [{"what": f"step 06 {k} on the Lightning rail", "why": judged[k]["detail"], "issue": LIGHTNING_ISSUE}
                    for k in open_]
    result = "FAIL" if failed else "NOT_CHECKED" if not_checked else "PASS"
    detail = "; ".join(details) + ". " + SPEND
    if result == "PASS":
        detail += " " + finding.outside("a public ledger's count of each node's settlements (Lightning has none; the "
                                        "counterparty's signed book stands in)", PUBLIC_LEDGER_ISSUE)
        if unsettled:
            detail += " " + finding.outside(f"{unsettled['count']} invoices agreed but unsettled as of the books read, "
                                            "which the books cannot prove unpaid", ADAPTER_ISSUE)
    finding.write(out, result=result, population=pop["population"], asserts=LIGHTNING_ASSERTS,
                  pinned=pop.get("pinned", LIVE_PINNED), proof=proof, detail=detail, not_checked=not_checked,
                  started=started)
    return 0


def main_live(pop, out, started):
    out.mkdir(parents=True, exist_ok=True)
    since = window_from(pop)
    pinned = pop.get("pinned", LIVE_PINNED)
    proof, details, not_checked, hashes = [], [], [], {}
    lightning = pop.get("rail") == "lightning"  # the ruled Lightning checks decide (loop#243), not the rail gaps below
    for stale in ("crosscheck.json", "checks.json", "counterparty.json"):  # a rerun must not keep an earlier run's
        (out / stale).unlink(missing_ok=True)
    for entry in pop["nodes"]:
        name = entry["name"]
        shutil.rmtree(out / name, ignore_errors=True)  # a rerun must not keep an earlier run's file
        data_dir = live.readable(entry, "data_dir", "ledger/capsules.jsonl")
        if data_dir is None:
            not_checked.append(live.not_checked(name, "data_dir"))
            details.append(f"node {name}: not checked, data_dir or its ledger not set or unreadable")
            continue
        found = recorded(data_dir / "ledger" / "capsules.jsonl", since)
        hashes[name] = found
        (out / name).mkdir()
        (out / name / "recorded.json").write_text(json.dumps(found, indent=2, sort_keys=True) + "\n")
        proof.append(f"{name}/recorded.json")
        n_legs, n_obs = len(found["settlement_legs"]), len(found["settlement_observations"])
        if since is not None:
            details.append(f"node {name}: window from {found['window_from']}: {found['outside_window']} settlement "
                           f"records before it and {found['undated']} without a timestamp left out")
        if n_legs or n_obs:
            n_pre = sum(o["preimage_check"] == "verified" for o in found["settlement_observations"])
            details.append(f"node {name}: {n_legs} settlement legs and {n_obs} wallet-reported settlement "
                           f"observations recorded, {n_pre} with a preimage that hashes to its payment_hash"
                           + ("" if lightning else "; none is the rail's own object"))
            if lightning:
                continue
            not_checked.append({"what": f"settlements node {name} recorded, against the rail",
                                "why": "the node records its wallet's report of a Lightning payment, not the rail's "
                                       "settlement object by reference; the pinned adapter (capsules-plugin lightning-v0) "
                                       "reports on the node's own book, and this step checks only the preimages",
                                "issue": ADAPTER_ISSUE})
        else:
            details.append(f"node {name}: no settlement recorded")
            if lightning:
                continue
            if since is not None:
                why = (f"the node recorded no settlement in the window from {found['window_from']} "
                       f"({found['outside_window']} settlement records before it, {found['undated']} without a timestamp), "
                       "so the adapter has nothing in the window to report on")
            else:
                why = ("the node has recorded no settlement: no paid exchange has run on it (with no wallet, or "
                       "no exchange it paid or served), so the adapter has nothing to report on")
            not_checked.append({"what": f"a settlement for an exchange of node {name}", "why": why,
                                "issue": WALLET_ISSUE})
    if lightning:
        return main_lightning(pop, out, started, hashes, proof, details, not_checked)
    proven, problems = finality_of(hashes)
    unproven = sorted(h for h, ok in proven.items() if not ok)
    if proven:
        details.append(f"finality: {len(proven) - len(unproven)} of {len(proven)} recorded payment hashes proven by "
                       "a payer's preimage (sha256(preimage) == payment_hash)")
    if unproven:
        not_checked.append({"what": "the finality of the payments the nodes recorded that no payer preimage proves",
                            "why": f"{len(unproven)} recorded payment hashes are not proven by a payer's preimage, so "
                                   "their finality is at most the wallet's terminal report (a host passes the "
                                   "preimage with mesh-llm#2744, open, and the lexe-wallet-plugin#7 build)",
                            "issue": ADAPTER_ISSUE})
    if pop.get("crosscheck") == "payment_hash":
        preimages = (f"{len(unproven)} of {len(proven)} recorded payment hashes are not proven by a payer's preimage"
                     if unproven else
                     "every recorded payment hash is proven by a payer's preimage, but not against the rail's object"
                     if proven else "no payment hash was recorded")
        if len(hashes) > 1:
            cross = crosscheck(hashes)
            (out / "crosscheck.json").write_text(json.dumps(cross, indent=2, sort_keys=True) + "\n")
            proof.append("crosscheck.json")
            n_ok, n_bad = len(cross["paired"]), len(cross["unpaired"])
            details.append(f"payment hashes compared across {', '.join(cross['nodes'])}: {n_ok} paired (one node's "
                           f"payer amount equals the other's credited plus fee), {n_bad} unpaired; agreement "
                           "between the nodes' own records is not finality")
            why = ("the nodes' records " + ("pair every payment hash they recorded" if n_ok and not n_bad
                                            else "leave some payment hashes unpaired" if n_bad
                                            else "hold no payment hash to compare")
                   + ", and either way they are records of wallet-reported payments; " + preimages)
        else:
            details.append("payment hash comparison requested but fewer than two nodes were read, so it was not run")
            why = "fewer than two nodes' ledgers were readable, so no comparison ran; and " + preimages
        not_checked.append({"what": "that the payment hashes the nodes recorded settled, with their preimages",
                            "why": why, "issue": ADAPTER_ISSUE})
    if pop.get("rail") is None:
        details.append("the live population names no rail")
    if not any("settlements node" in n["what"] for n in not_checked):
        not_checked.append({"what": "the live rail's settlement object for an exchange, its finality and its band",
                            "why": "the live population names no rail and its nodes have no settlement object to read; the "
                                   "pinned Lightning adapter checks the node's own book, with no preimage and no "
                                   "settlement object by reference on a rail",
                            "issue": WALLET_ISSUE})
    details += problems
    finding.write(out, result="FAIL" if problems else "NOT_CHECKED", population=pop["population"], asserts=ASSERTS,
                  pinned=pinned, proof=proof, detail="; ".join(details) + ". " + SPEND, not_checked=not_checked,
                  started=started)
    return 0


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--population", required=True)
    ap.add_argument("--out", required=True)
    a = ap.parse_args(argv)
    started = finding.now()
    pop = read_json(Path(a.population) / "population.json")
    out = Path(a.out)
    # "live" is the lab's population; any other population naming "kind": "live" (demo) takes the same path.
    if pop["population"] == "live" or pop.get("kind") == "live":
        try:
            return main_live(pop, out, started)
        except ValueError as e:
            print(f"06-settle: {a.population}: {e}", file=sys.stderr)
            return 2
    if pop.get("rail") != "mock" or not (Path(a.population) / "rail" / "rail.json").is_file():
        print(f"06-settle: {a.population} names no mock rail with rail/rail.json", file=sys.stderr)
        return 2
    out.mkdir(parents=True, exist_ok=True)
    for p in out.iterdir():
        if p.is_file():
            p.unlink()
    gather(a.population, out)
    decide(out, population=pop["population"], nodes=nodes_of(a.population), started=started,
           goose="goose" in pop, pinned=pop.get("pinned"))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
