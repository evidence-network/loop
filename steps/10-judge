        lines.append(f"roll-up {sealed['rollup'][:12]} over {len(sealed['finer'])} Results")
    except NotChecked as e:
        what, why, issue = e.args
        not_checked.append({"what": what, "why": why, "issue": issue})
    except RuntimeError as e:
        problems = problems or [str(e)]
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as e:
        problems = [f"the judge did not run to the end ({type(e).__name__}: {str(e)[:300]})"]

    result = "FAIL" if problems else ("NOT_CHECKED" if not_checked else "PASS")
    window = ((f"window {stamp(start)} to {stamp(end)} (the open month)" if preview else
               f"window {stamp(start)} to {stamp(end)} ({pack['window']['periods']} whole closed months)")
              if start else "no window")
    packname = f"{pack['pack']} ({pack['pin']})" if pack else "inference-deals (not loaded)"
    what = (f"the committed stand-in run population/{population}/step10/run (dated in a closed month), not this "
            f"run's records" if standin else f"run {run.name}")
    detail = ((finding.PREVIEW + ". " if preview else "")
              + f"{what}, {window}, deterministic pack {packname} (no model): "
              f"{len(records)} records in the window from {len({r['dir'] for r in records})} steps. "
              + ("; ".join(lines) + ". " if lines else "")
              + (f"Did not hold: {'; '.join(problems)}. " if problems else "")
              + (f"Refused, not read: {'; '.join(refused)}. " if refused else "")
              + "Records are the primary record files of each kind that step 08's manifest lists, cited by sha256 through one capsule each."
              + (f" On live, {LIVE_JUDGE}." if population == "live" else ""))
    if result == "PASS" and unevaluated:
        detail += " " + finding.outside(evaluator_gap(unevaluated, population, kinds=pack["kinds"]), GAP_ISSUE)
    finding.write(out, result=result, population=population, asserts=PREVIEW_ASSERTS if preview else ASSERTS,
                  pinned=pinned, proof=proof, detail=detail, not_checked=[] if result == "PASS" else not_checked, started=started)
    print(f"10-judge: {result}: {detail}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
