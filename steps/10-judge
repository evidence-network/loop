# --- The window ---------------------------------------------------------------------------
def window_of(as_of, periods=12):
    """[start, end): the `periods` whole calendar months closed before as_of's month. Never rolling."""
    end = dt.datetime(as_of.year, as_of.month, 1, tzinfo=dt.timezone.utc)
    months = end.year * 12 + end.month - 1 - periods
    return dt.datetime(months // 12, months % 12 + 1, 1, tzinfo=dt.timezone.utc), end


def open_month_of(as_of):
    """[start, end): the calendar month containing as_of, which has not closed. Only --preview-open-month uses it."""
    start = dt.datetime(as_of.year, as_of.month, 1, tzinfo=dt.timezone.utc)
    months = start.year * 12 + start.month
    return start, dt.datetime(months // 12, months % 12 + 1, 1, tzinfo=dt.timezone.utc)


def preview_out_problem(out, run):
    """Why a preview may not write to `out`, or None: not into the run it reads, nor where findings or the baseline live.

    The ecosystem gate reads only the findings directory it is handed (and refuses a preview finding anyway); this keeps a
    preview from being written next to a baseline's findings in the first place."""
    findings = Path(os.environ.get("LOOP_FINDINGS") or ROOT / "findings")
    for base, name in ((run, "the run it reads"), (findings, "the findings directory"), (ROOT / "baseline", "baseline/")):
        base = Path(base).resolve()
        # samefile, not path equality: a case-insensitive file system spells one directory several ways.
        if out == base or base in out.parents or \
                any(p.exists() and base.exists() and os.path.samefile(p, base) for p in (out, *out.parents)):
            return f"a preview is written outside {name} ({base}), not into it"
    return None


def read_manifest(run):
    """(manifest, as_of) from RUN/08-verify, or raise NotChecked / ValueError (a FAIL)."""
    d = Path(run) / "08-verify"
    if not (d / "finding.json").is_file() or not (d / "verified.json").is_file():
        raise NotChecked("the run's records, by step 08's manifest",
                         f"{Path(run).name} holds no 08-verify/verified.json for this step to read", RUN_ISSUE)
    record = load(d / "finding.json")
    errs = finding.check_record(d, record) if isinstance(record, dict) else ["finding.json is not an object"]
    if errs:
        raise ValueError(f"step 08's finding does not hold: {'; '.join(errs)}")
    if "verified.json" not in [p["path"] for p in record["proof"]]:
        raise ValueError("step 08's finding does not name verified.json in its proof")
    return load(d / "verified.json"), utc(record["finished"])


def select(run, manifest, start, end, pack):
    """(records, refused, not_checked, problems) over 08's manifest.

    A record is {dir, step, path, sha256, kind, result}: a primary record file (binding.json `records`) that 08 lists for a reproduced step of the pack's kinds
    whose step finished in [start, end). Only finding.json is read before that is known, and only after its
    bytes match 08's digest.
    """
    records, refused, not_checked, problems = [], [], [], []
    for e in manifest["steps"]:
        d = Path(run) / e["dir"]
        files = {f["path"]: f["sha256"] for f in e.get("files", [])}
        if e["status"] != "reproduced":
            refused.append(f"{e['dir']}: {len(files)} files, {e['status']} by 08")
            # The gap is 08's for that step: its issue is the one 08 names.
            not_checked.append({"what": f"step {e['step']}: its records, judged in the window",
                                "why": f"step 08 shows it {e['status']}, so its records are not verified by 08 and "
                                       "this step does not read them",
                                "issue": (e.get("not_checked") or {}).get("issue") or FAILED_ISSUE})
            continue
        if e["step"] not in pack["kinds"]:
            refused.append(f"{e['dir']}: {len(files)} files, not a record kind of this pack")
            continue
        if finding.sha256(d / "finding.json") != files.get("finding.json"):
            problems.append(f"{e['dir']}/finding.json does not match the sha256 08's manifest gives it")
            continue
        finished = utc(load(d / "finding.json")["finished"])
        if not start <= finished < end:
            refused.append(f"{e['dir']}: {len(files)} files, finished {stamp(finished)}, outside the window")
            continue
        unlisted = sorted(str(p.relative_to(d)) for p in d.rglob("*") if p.is_file()
                          and str(p.relative_to(d)) not in files and p.name != "loop-step.log")
        refused += [f"{e['dir']}/{p}: not in 08's manifest" for p in unlisted]
        kind = pack["kinds"][e["step"]]["kind"]
        patterns = pack["kinds"][e["step"]]["records"]
        # A record is the step's primary record file(s) of its kind, so a count means deals, settlements, asks or
        # disputes; the bundles and proof files beside them are 08's, not counted.
        matched = {p: s for p, s in files.items() if any(fnmatch.fnmatchcase(p, g) for g in patterns)}
        wanted = {}
        for p, s in matched.items():
            if (d / p).is_file() and finding.sha256(d / p) == s and not is_record(pack["kinds"][e["step"]], p, d / p):
                refused.append(f"{e['dir']}/{p}: not a {kind} record (binding.json `only`: "
                               f"{next(c['why'] for g, c in pack['kinds'][e['step']]['only'].items() if fnmatch.fnmatchcase(p, g))})")
                continue
            wanted[p] = s
        inputs = {p: s for p, s in files.items() if is_input(pack["kinds"][e["step"]], p)}
        if not wanted:
            refused.append(f"{e['dir']}: {len(files)} files, none is a {kind} record ({', '.join(patterns)})")
            problems.append(f"{e['dir']}: 08 lists no {kind} record ({', '.join(patterns)})"
                            + (f"; the {len(matched)} files matching those names are not {kind} records "
                               "(binding.json `only`)" if matched else ""))
            continue
        for path, sha in sorted(wanted.items()):
            if not (d / path).is_file() or finding.sha256(d / path) != sha:
                problems.append(f"{e['dir']}/{path} does not match the sha256 08's manifest gives it")
                continue
            records.append({"dir": e["dir"], "step": e["step"], "path": path, "sha256": sha, "kind": kind,
                            "result": e["rederived"]["result"], "finished": stamp(finished)})
        for path, sha in sorted(inputs.items()):  # the evaluator's inputs, cited beside the records (loop#157)
            if not (d / path).is_file() or finding.sha256(d / path) != sha:
                problems.append(f"{e['dir']}/{path} does not match the sha256 08's manifest gives it")
                continue
            records.append({"dir": e["dir"], "step": e["step"], "path": path, "sha256": sha, "kind": kind,
                            "result": e["rederived"]["result"], "finished": stamp(finished), "role": "input"})
    return records, refused, not_checked, problems


def ref(r):
    return f"{r['dir']}/{r['path']}"


def is_input(kind, path):
    """Whether `path` is one of the kind's evaluator inputs (binding.json `inputs`): a file the pinned pack's
    evaluator reads, cited like a record but never counted as one (loop#157)."""
    return any(fnmatch.fnmatchcase(path, g) and re.fullmatch(c["path"], path) for g, c in kind.get("inputs", {}).items())


REHEARSAL_GAP = ("the pinned pack's own evaluator does not run on the rehearsal stand-ins: this step applies the "
                 "pack's terms to the results 08 re-derived")


def evaluator_gap(dirs, population, rehearsal=REHEARSAL_GAP, kinds=None):
    """What a PASS leaves outside its assertion when the pack terms of `dirs` are applied from the results 08
    re-derived, the pinned pack's own evaluator not having run for them: on rehearsal `rehearsal` (its stand-ins are
    no Mesh book records); on live each step named with why: a kind binding.json gives no evaluator inputs (06), or a
    step whose proof keeps no node's own chain (an older live 05). `kinds` is the pack's {step: kind}."""
    if population != "live":
        return rehearsal
    kinds = kinds or {}
    never = [d for d in dirs if not (kinds.get(d[:2]) or {}).get("inputs")]
    unchained = [d for d in dirs if d not in never]
    why = ([f"{', '.join(never)}, whose kind binding.json gives no evaluator inputs"] if never else []) + \
          ([f"{', '.join(unchained)}, whose proof keeps no node's own chain"] if unchained else [])
    return (f"the pinned pack's own evaluator does not run for {'; nor for '.join(why)}: this step applies the "
            "pack's terms there to the results 08 re-derived")


def git_blob(data):
    """The git blob id of `data`: how a file of the pinned commit is named in its tree."""
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def load_evaluator():
    """The pinned pack's own evaluator module (scripts/evaluators/inference_deals.py at the inference-deals pin), each
    of its files held to its git blob id, or raise NotChecked."""
    repo, ref = pin("inference-deals")
    where = tools_dir() / "packs" / f"inference-deals-{ref}"
    if ref != EVALUATOR_REF:
        raise NotChecked("the pinned pack's own evaluator", f"inference-deals is pinned at {ref}, but this step holds "
                         f"its evaluator's files to {EVALUATOR_REF}", GAP_ISSUE)
    source = {}
    for f, blob in EVALUATOR.items():
        try:
            data = (where / f).read_bytes()
        except OSError:
            raise NotChecked("the pinned pack's own evaluator", f"{repo} {ref} {f} is not fetched into {where}; "
                             "steps/10-judge.setup.sh fetches it", GAP_ISSUE)
        if git_blob(data) != blob:
            raise NotChecked("the pinned pack's own evaluator", f"{where / f} is not blob {blob} of {repo} {ref}",
                             GAP_ISSUE)
        source[f] = data
    # The bytes just checked are the bytes run: each module is compiled from them, never imported from disk (no
    # .pyc), and its helpers are the pinned ones only while the evaluator loads (it imports them by name).
    helpers = {Path(f).stem: f for f in EVALUATOR if not f.startswith("scripts/evaluators/")}
    saved = {name: sys.modules.get(name) for name in helpers}
    saved_path = list(sys.path)  # the pinned modules put their own directory on sys.path when they run

    def module(name, f):
        mod = types.ModuleType(name)
        mod.__file__ = str(where / f)
        sys.modules[name] = mod
        exec(compile(source[f], str(where / f), "exec"), mod.__dict__)
        return mod
    try:
        module("rollup", helpers["rollup"])  # result_v0 imports rollup
        for name in ("result_v0", "capsulectl_calls"):
            module(name, helpers[name])
        return module("inference_deals_pinned", "scripts/evaluators/inference_deals.py")
    except Exception as e:  # pinned code that does not load here (an older Python, say) is not checked, never a crash
        raise NotChecked("the pinned pack's own evaluator", f"it does not load here ({type(e).__name__}: "
                         f"{str(e)[:200]})", GAP_ISSUE)
    finally:
        sys.path[:] = saved_path
        sys.modules.pop("inference_deals_pinned", None)
        for name, old in saved.items():
            if old is None:
                sys.modules.pop(name, None)
            else:
                sys.modules[name] = old


# The evaluator's bounds are step 10's, never the pack's: a reader of the Result must not take its verdicts for the
# pack's own weekly ones (Sherlock2, Buzz b1effd94).
CHAIN_START = dt.datetime(1970, 1, 1, tzinfo=dt.timezone.utc)
EVALUATOR_BOUNDS = ("step 10's window, by each step's finding finished; each chain read whole up to the window's end; "
                    "not the pack's weekly period_policy")


def evaluate(ev, run, inputs, start, end):
    """{term id: [(verdict, reading, grade)]} and the exchanges, of the pinned evaluator over each node's own chain
    (`inputs`, records of role input): its collect() and judge_deal() per deal, a shop_preauth deal not counted, as
    the pack's own build_result does. Only the bounds differ from the pack's own run (Sherlock2 confirmed, Buzz
    b1effd94): a chain is in step 10's window as its step is, by the step's finding `finished`, never by the dates
    in its entries (a record's own clock is the operator's), so a chain is read whole, up to `end`, exactly as the
    halves beside it are taken whole. The pack's weekly period_policy is not used. Each chain is read once and held to
    its sha256 first. Raises ValueError (the evaluator's DealsError) when a chain cannot be read as the pack reads a
    book."""
    verdicts, exchanges = {}, set()
    for r in inputs:
        data = (Path(run) / r["dir"] / r["path"]).read_bytes()
        if hashlib.sha256(data).hexdigest() != r["sha256"]:
            raise ValueError(f"{r['dir']}/{r['path']} does not match the sha256 08's manifest gives it")
        records = []
        for line in data.decode("utf-8").splitlines():
            if line.strip():
                body = json.loads(line)
                records.append((body.get("capsule_id"), body))
        found, legs, own_keys = ev.collect(records, CHAIN_START, end)
        for deal in found.values():
            if ev.counterparty_class(deal)[0] == "shop_preauth":
                continue  # the pack's own run does not count it
            got, extras, _, _, _ = ev.judge_deal(deal, legs, own_keys)
            if any(v != "out_of_scope" for v in got.values()):
                exchanges.add(deal.exchange_id)
            for term, v in got.items():
                x = extras.get(term) or {}
                verdicts.setdefault(term, []).append((v, x.get("x-reading"), x.get("grade")))
    return verdicts, exchanges


def is_record(kind, path, file):
    """Whether `path` (a file 08 lists, at `file`) is a record of `kind`: it matches one of the kind's `records`
    patterns and, where binding.json's `only` names a condition for that pattern, the file meets it. A live 05 held
    half is a deal record only when its action_id is a host-served capsule's, never a settlement leg (Sherlock2,
    loop#250). `file` is read only for such a condition, after its bytes match 08's digest."""
    if not any(fnmatch.fnmatchcase(path, g) for g in kind["records"]):
        return False
    for pattern, cond in kind.get("only", {}).items():
        if fnmatch.fnmatchcase(path, pattern):
            if cond.get("path") and not re.fullmatch(cond["path"], path):
                return False  # the glob alone lets * cross a / and [0-9] check one character
            try:
                action = load(file).get("action_id")
            except (OSError, ValueError, AttributeError):
                return False
            return isinstance(action, str) and action.startswith(cond["action_id_prefix"])
    return True


# --- The pack: deterministic, no model ----------------------------------------------------
def attested(path):
    """True when a JSON record carries a model_attestation that is not null."""
    try:
        doc = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    stack = [doc]
    while stack:
        x = stack.pop()
        if isinstance(x, dict):
            if x.get("model_attestation") is not None:
                return True
            stack += list(x.values())
        elif isinstance(x, list):
            stack += x
    return False


def claim(cid, requirement, verdict, refs, contract_ref, narrative=None):
    """One claim; `evidence` holds record refs until seal() puts the capsule digests in."""
    sufficiency = "SATISFIED" if verdict in ("met", "not_met") else "INSUFFICIENT"
    c = {"id": cid, "contract_ref": contract_ref, "requirement_ref": requirement, "tier": "recomputed",
         "grade": "self-attested", "sufficiency": sufficiency, "verdict": verdict, "evidence": list(refs),
         "proofs": []}
    if narrative:
        c["presentation"] = {"kind": "story", "status": {"met": "SATISFIED", "not_met": "CONTRADICTED"}.get(
            verdict, "INSUFFICIENT"), "narrative": narrative}
    else:
        c["presentation"] = {"kind": "disclosure", "status": "SATISFIED" if verdict == "met" else
                             ("CONTRADICTED" if verdict == "not_met" else "INSUFFICIENT"), "evidence": None}
    return c


def result_doc(claims, pack, start, end, extra=None):
    buckets = {"met": [], "not_met": [], "not_evaluable": []}
    for c in claims:
        buckets[c["verdict"]].append(c["id"])
    doc = {"result_version": "evidence-result-v0", "generated_at": stamp(end), "claims": claims,
           "aggregate": {"coverage": {"evaluated_population": len(claims), "excluded_not_applicable": 0,
                                      "unknown_count": 0}, "buckets": buckets},
           "x-window": {"start": stamp(start), "end": stamp(end), "period": pack["window"]["period"],
                        "periods": pack["window"]["periods"], "pack": pack["pack"]}}
    if pack.get("preview"):
        doc["x-window"]["preview"] = pack["preview"]
    doc.update(extra or {})
    return doc


def judge_records(records, run, pack, start, end, not_checked):
    """{step dir: Result document} with one claim per term, each citing every record of the step."""
    docs = {}
    for d in sorted({r["dir"] for r in records}):
        mine = [r for r in records if r["dir"] == d]
        nn, refs = mine[0]["step"], [ref(r) for r in mine]
        verdict = pack["verdicts"][mine[0]["result"]]
        inputs = [r for r in mine if r.get("role") == "input"]
        evaluated = None
        if inputs:  # a live step whose own chains are cited: the pinned pack's own evaluator decides its terms
            try:
                evaluated = evaluate(load_evaluator(), run, inputs, start, end)
            except NotChecked as e:
                what, why, issue = e.args
                not_checked.append({"what": f"{d}: {what}", "why": why, "issue": issue})
            except (OSError, ValueError, KeyError, TypeError, AttributeError) as e:
                not_checked.append({"what": f"{d}: the pinned pack's own evaluator over the nodes' own chains",
                                    "why": f"it did not run to the end ({type(e).__name__}: {str(e)[:200]})",
                                    "issue": GAP_ISSUE})
        claims = []
        for t in pack["kinds"][nn]["terms"]:
            cid = f"{d}:{t['id']}"
            cref = pack["own_contract_ref"] if t.get("own") else pack["contract_ref"]
            if evaluated is not None and not t.get("own"):
                got, exchanges = evaluated
                answered = [a for a in got.get(t["id"], []) if a[0] != "out_of_scope"]
                verdicts = [v for v, _, _ in answered]
                worst = next((v for v in ("not_met", "not_evaluable", "met") if v in verdicts), "not_evaluable")
                said = ", ".join(f"{v} {verdicts.count(v)}" for v in ("met", "not_met", "not_evaluable") if v in verdicts)
                readings = sorted({r for _, r, _ in answered if r})
                c = claim(cid, t["id"], worst, refs, cref,
                          f"the pinned pack's own evaluator, over {len(exchanges)} exchanges in {len(inputs)} nodes' "
                          f"own chains, answers this term for {len(answered)} deal sides: "
                          f"{said or 'no deal in the window carried this term'}"
                          + (f" ({', '.join(readings)})" if readings else ""))
                # countersigned only when every answer is; the provider_states reading is the provider's word
                if answered and all(g == "countersigned" for _, _, g in answered):
                    c["grade"] = "countersigned"
                claims.append(c)
            elif t.get("model_attestation"):
                if any(attested(Path(run) / d / r["path"]) for r in mine):
                    not_checked.append({"what": f"{d}: {t['id']} ({t['name']}), recomputed from model_attestation",
                                        "why": "a record carries model_attestation and this pack has no "
                                               "recomputation for it yet", "issue": GAP_ISSUE})
                    claims.append(claim(cid, t["id"], "not_evaluable", refs, cref, "model_attestation is present; this "
                                        "pack does not recompute it yet, so the term is not judged"))
                else:
                    claims.append(claim(cid, t["id"], "not_evaluable", refs, cref, "provider states the model it "
                                        "served (self-attested); no record carries model_attestation, so this is "
                                        "never a judged match"))
            else:
                claims.append(claim(cid, t["id"], verdict, refs, cref))
        docs[d] = result_doc(claims, pack, start, end,
                             {"x-evaluator": {"inputs": len(inputs), "exchanges": len(evaluated[1]),
                                              "bounds": EVALUATOR_BOUNDS}} if evaluated else None)
    return docs


def rollup_doc(finer, pack, start, end):
    """The roll-up: one claim per finer Result, citing its record id, with its worst verdict."""
    claims = []
    for d, (rid, doc) in sorted(finer.items()):
        verdicts = {c["verdict"] for c in doc["claims"]}
        worst = next(v for v in ("not_met", "not_evaluable", "met") if v in verdicts)
        claims.append(claim(f"window:{d}", f"{d}:all-must-have", worst, [rid], pack["own_contract_ref"]))
    return result_doc(claims, pack, start, end)


# --- Sealing: a fresh book under the repository's judge key -------------------------------
def seed_hex(pem):
    """The 32-byte Ed25519 seed (hex) of a PKCS#8 PEM file."""
    body = "".join(line for line in Path(pem).read_text().splitlines() if line and not line.startswith("-----"))
    der = base64.b64decode(body)
    if len(der) != 48:
        raise ValueError(f"{pem} is not an Ed25519 PKCS#8 key")
    return der[16:].hex()


def pub_hex(pem):
    return cc.key_id_of(cc.spki_from_pem(Path(pem).read_text(encoding="utf-8")))


def judge_keys(population, keys):
    """{"judge": (private PEM, public PEM), "checkpoint": (...)} for the population, or raise NotChecked.

    Rehearsal: the committed TEST keys in `keys`. Live: the private key is the lab's own, at LOOP_JUDGE_KEY (default
    $LAB_DIR/judge/judge.pem) and never in this tree; it signs the checkpoints too, and its public half must be the
    committed keys/judge.pub.pem, which the book's trusted key enforces (capsulectl refuses a producer it does not list)."""
    if population != "live":
        if not (keys / "judge.pem").is_file():
            raise NotChecked("the pack's Results, sealed", f"the {population} population lists no judge key "
                                                           "(step10/keys)", JUDGE_KEY_ISSUE)
        return {k: (keys / f"{k}.pem", keys / f"{k}.pub.pem") for k in ("judge", "checkpoint")}
    pub = keys / "judge.pub.pem"
    if not pub.is_file():
        raise NotChecked("the pack's Results, sealed", "the live population lists no judge public key "
                                                       "(step10/keys/judge.pub.pem)", JUDGE_KEY_ISSUE)
    named = os.environ.get("LOOP_JUDGE_KEY") or (os.environ.get("LAB_DIR") and
                                                 str(Path(os.environ["LAB_DIR"]) / "judge" / "judge.pem"))
    if not named:
        raise NotChecked("the pack's Results, sealed", "neither LOOP_JUDGE_KEY nor LAB_DIR is set, so this step has no "
                                                       "live judge key (run it on the lab host)", JUDGE_KEY_ISSUE)
    pem = Path(named)
    if not (pem.is_file() and os.access(pem, os.R_OK)):
        raise NotChecked("the pack's Results, sealed", f"the live judge key {pem} is not a readable file here "
                                                       "(lab/lab.sh judge-key makes it on the lab host)", JUDGE_KEY_ISSUE)
    if pem.stat().st_mode & 0o077:
        raise NotChecked("the pack's Results, sealed", f"the live judge key {pem} is readable by group or others; "
                                                       "it must be mode 600", JUDGE_KEY_ISSUE)
    return {"judge": (pem, pub), "checkpoint": (pem, pub)}


def node_key_problems(pop, judge_key, nodes_dir=ROOT / "nodes"):
    """The judge key must be no node's: not a population node id, nor the key id any nodes/ entry lists.
    lab/lab.sh judge-key refuses a new key with this same check."""
    ids = {n.get("node_id") for n in pop.get("nodes", [])}
    ids |= {load(f).get("key_id") for f in Path(nodes_dir).glob("*.json")}
    return [f"the judge key {judge_key[:12]} is a node's key"] if judge_key in ids else []


class Book:
    """A scratch book profile under the judge key, driven through the pinned capsulectl."""

    def __init__(self, home, capsulectl, keys):
        self.home, self.capsulectl = Path(home), Path(capsulectl)
        self.home.mkdir(parents=True, exist_ok=True)
        self.home.chmod(0o700)
        for k, (pem, _) in keys.items():
            f = self.home / f"{k}.seed"
            f.touch(mode=0o600)
            f.write_text(seed_hex(pem))
        self.cap("profile", "create", "--name", "judge", "--type", "jsonl", "--jsonl-path", str(self.home / "store"),
                 "--log-id", "judge", "--operator", "loop-judge", "--trusted-key", pub_hex(keys["judge"][1]),
                 "--signing-key-file", str(self.home / "judge.seed"),
                 "--checkpoint-signing-key-file", str(self.home / "checkpoint.seed"),
                 "--checkpoint-trusted-key", pub_hex(keys["checkpoint"][1]))
        self.cap("store", "init", "--profile", "judge")

    def cap(self, *args):
        env = dict(os.environ, XDG_CONFIG_HOME=str(self.home / "config"),
                   CAPSULECTL_PLUGIN_ROOTS=os.environ.get("CAPSULECTL_PLUGIN_ROOTS", str(self.capsulectl.parent)))
        r = subprocess.run([str(self.capsulectl), *args], env=env, capture_output=True, text=True, timeout=300)
        if r.returncode != 0:
            raise RuntimeError(f"capsulectl {' '.join(args[:2])}: {(r.stderr.strip() or r.stdout)[:400]}")
        lines = r.stdout.strip().splitlines()
        return json.loads(lines[-1]) if lines else {}

    def publish(self, r):
        """A capsule for one record; its payload is the record's {step, path, sha256}."""
        req = {"spec_version": "capsule-seal-request/v1",
               "capsule": {"ActionID": f"loop-record:{ref(r)}", "ActionType": "fyi", "Operator": "loop-judge",
                           "Developer": "evidence-network/loop", "Timestamp": r["finished"]},
               "payload": {"step": r["dir"], "path": r["path"], "sha256": r["sha256"]}, "agent_output": {"ok": True}}
        f = self.home / "request.json"
        dump(f, req)
        return self.cap("publish", "--profile", "judge", "--request", str(f))["capsule_id"]

    def result(self, doc, name):
        f = self.home / f"{name}.input.json"
        dump(f, doc)
        return self.cap("book", "result", "build", "--profile", "judge", "--result", str(f),
                        "--out", str(self.home / f"{name}.result.json"))["record_id"]

    def disclose(self, rid, path):
        Path(path).parent.mkdir(parents=True, exist_ok=True)
        self.cap("book", "disclose", "--profile", "judge", "--root", rid, "--payloads", "selected", "--out", str(path))


def fill(doc, digests):
    """The document with each claim's record refs replaced by digest refs."""
    for c in doc["claims"]:
        c["evidence"] = [{"digest_alg": "SHA-256", "digest": digests.get(e, e)} for e in c["evidence"]]
        if c["presentation"]["kind"] == "disclosure":
            c["presentation"]["evidence"] = c["evidence"]
    return doc


def seal(book, records, docs, pack, start, end, out):
    """Publish the records the documents cite, seal each finer Result and the roll-up, write their bundles.

    Returns {"finer": {step dir: record id}, "rollup": record id}.
    """
    by_ref = {ref(r): r for r in records}
    cited = sorted({e for doc in docs.values() for c in doc["claims"] for e in c["evidence"]})
    digests = {e: book.publish(by_ref[e]) for e in cited}
    finer = {}
    for d, doc in sorted(docs.items()):
        finer[d] = (book.result(fill(doc, digests), d), doc)
    rollup = book.result(fill(rollup_doc(finer, pack, start, end), {}), "rollup")
    for d, (rid, _) in finer.items():
        book.disclose(rid, out / "bundles" / f"{d}.bundle.json")
    book.disclose(rollup, out / "bundles" / "rollup.bundle.json")
    return {"finer": {d: rid for d, (rid, _) in finer.items()}, "rollup": rollup}


# --- The judge: on the bundles alone ------------------------------------------------------
def verify_bundle(capsulectl, path, tmp):
    """capsulectl verify --bundle under an empty config: the verdict, as JSON ({} when there is none)."""
    cfg = Path(tempfile.mkdtemp(dir=tmp))
    env = dict(os.environ, XDG_CONFIG_HOME=str(cfg))
    r = subprocess.run([str(capsulectl), "verify", "--bundle", str(path)], env=env, capture_output=True, text=True,
                       timeout=300)
    try:
        return json.loads(r.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return {}


def open_bundle(path, verdict, judge_key):
    """(root id, Result statement, {record id: disclosed agent_input}, problems) of one bundle."""
    name, problems = Path(path).name, []
    b = load(path)
    root = b.get("root")
    if verdict.get("verdict") != "VALID":
        bad = [f"{d['capsule_id'][:12]} {d['member']} {d['status']}" for d in verdict.get("disclosures", [])
               if d.get("status") not in ("disclosure_match", "withheld")]
        problems.append(f"{name} does not verify: {verdict.get('verdict') or 'no verdict'}"
                        + (f" ({', '.join(bad)})" if bad else ""))
    if b.get("extensions", {}).get("producer-key/v1", {}).get("public_key") != judge_key:
        problems.append(f"{name} is not under the repository's judge key")
    others = [r for r in b.get("records", []) if r.get("key_id") != judge_key]
    if others:
        problems.append(f"{name}: {len(others)} of its {len(b.get('records', []))} records are signed under another "
                        "key than the judge's")
    disclosed = {k: v.get("agent_input") for k, v in b.get("disclosures", {}).items()}
    header = disclosed.get(root) or {}
    if header.get("record_type") != RESULT_TYPE:
        problems.append(f"{name}: its root is not a disclosed Result")
    return root, header.get("statement") or {}, disclosed, problems


def evidence(statement):
    return [e["digest"] for c in statement.get("claims", []) for e in c.get("evidence", [])]


def check_cited_once(cited, key, sha, where):
    """A record cited twice has one digest: a later citation must not hide a wrong one behind the first."""
    return [] if cited.setdefault(key, sha) == sha else [f"{where}: {key} is cited with two different sha256 digests"]


def check_complete(window, cited):
    """Every record in the window is cited by a finer Result."""
    return [f"no Result cites {k} ({s[:12]}), a record in the window" for k, s in sorted(window.items())
            if k not in cited]


def check_exact(window, cited):
    """Every record a finer Result cites is a record in the window."""
    return [f"a Result cites {k} ({s[:12]}), which is outside the window" for k, s in sorted(cited.items())
            if window.get(k) != s]


def check_rollup(rollup_cites, finer_valid):
    """The roll-up cites exactly the finer Results, each the root of a VALID bundle."""
    return ([f"the roll-up cites {r[:12]}, a Result that does not verify (no VALID finer bundle is rooted on it)"
             for r in sorted(set(rollup_cites) - finer_valid)]
            + [f"the roll-up does not cite the finer Result {r[:12]}" for r in sorted(finer_valid - set(rollup_cites))])


def judge(out, records, capsulectl, judge_key, tmp):
    """(problems, lines) over out/bundles: verify, complete, exact, rollup."""
    problems, lines, finer_valid, cited = [], [], set(), {}
    verdicts = {}
    bundles = sorted((out / "bundles").glob("*.bundle.json"))
    for path in bundles:
        verdicts[path.name] = verify_bundle(capsulectl, path, tmp)
        dump(out / "verify" / path.name.replace(".bundle.json", ".verify.json"), verdicts[path.name])
    rollup = out / "bundles" / "rollup.bundle.json"
    rollup_cites = []
    for path in bundles:
        root, statement, disclosed, probs = open_bundle(path, verdicts[path.name], judge_key)
        problems += probs
        if path == rollup:
            rollup_cites = evidence(statement)
            continue
        if not probs:
            finer_valid.add(root)
        for digest in evidence(statement):
            p = disclosed.get(digest) or {}
            if not {"step", "path", "sha256"} <= set(p):
                problems.append(f"{path.name}: cited record {digest[:12]} is not a disclosed record capsule")
                continue
            key = f"{p['step']}/{p['path']}"
            problems += check_cited_once(cited, key, p["sha256"], path.name)
        lines.append(f"{path.name.replace('.bundle.json', '')}: {len(statement.get('claims', []))} claim(s), "
                     f"{len(set(evidence(statement)))} records cited, "
                     + ", ".join(f"{c['requirement_ref']} {c['verdict']}" for c in statement.get("claims", [])))
    if not rollup.is_file():
        problems.append("there is no roll-up bundle")
    window = {ref(r): r["sha256"] for r in records}
    problems += check_complete(window, cited)
    problems += check_exact(window, cited)
    problems += check_rollup(rollup_cites, finer_valid)
    return problems, lines


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--population", required=True, type=Path)
    ap.add_argument("--out", required=True, type=Path)
    ap.add_argument("--preview-open-month", action="store_true",
                    help="judge the open month, a preview and not a baseline result; needs --run")
    ap.add_argument("--run", type=Path, help="with --preview-open-month: the loop run holding 08-verify/ to read "
                    "(--out is then elsewhere, outside it)")
    a = ap.parse_args(argv)
    preview = a.preview_open_month
    if preview != (a.run is not None):
        ap.error("--preview-open-month and --run go together")
    started = finding.now()
    out = a.out.resolve()
    problem = preview_out_problem(out, a.run.resolve()) if preview else None
    if problem:
        ap.error(problem)
    out.mkdir(parents=True, exist_ok=True)
    for p in ("finding.json", "window.json"):
        (out / p).unlink(missing_ok=True)
    for p in ("bundles", "verify"):
        shutil.rmtree(out / p, ignore_errors=True)
    pop = load(a.population / "population.json")
    population = pop["population"]
    keys = a.population.resolve() / "step10" / "keys"
    run = a.run.resolve() if preview else out.parent
    # A run without 08's manifest is judged on the population's committed stand-in run, dated in a closed month.
    # A preview is of this run's records only.
    standin = a.population.resolve() / "step10" / "run"
    standin = standin if not preview and not (run / "08-verify").is_dir() and (standin / "08-verify").is_dir() else None
    source = standin or run

    problems, not_checked, refused, records, lines, proof = [], [], [], [], [], []
    unevaluated = []  # the steps whose pack terms are applied from 08's results, not the pinned evaluator (loop#157)
    start = end = None
    pinned = []
    pack = None
    try:
        try:
            manifest, as_of = read_manifest(source)
        except ValueError as e:
            raise RuntimeError(str(e))
        if manifest.get("population") != population:
            raise RuntimeError(f"08's manifest is of population {manifest.get('population')}, this run is {population}")
        pack = load_pack()
        if preview:
            # The same pack and key; only the window differs, and its Results say so (x-window.preview).
            pack = dict(pack, window={"period": pack["window"]["period"], "periods": 1}, preview="open-month")
            start, end = open_month_of(as_of)
        else:
            start, end = window_of(as_of, pack["window"]["periods"])
        records, refused, not_checked, problems = select(source, manifest, start, end, pack)
        dump(out / "window.json", {"source": "stand-in" if standin else "run", "as_of": stamp(as_of), "start": stamp(start), "end": stamp(end),
                                   "period": pack["window"]["period"], "periods": pack["window"]["periods"],
                                   **({"preview": "open-month", "manifest_sha256": finding.sha256(source / "08-verify" / "verified.json")}
                                      if preview else {}),
                                   "records": records, "refused": refused})
        proof.append("window.json")
        if problems:
            raise RuntimeError("; ".join(problems))
        if not records:
            raise NotChecked("the pack over the window",
                             f"no record of the run is in the window {stamp(start)} to {stamp(end)}: each reproduced "
                             "step of the pack's kinds finished outside it, or none is in the run",
                             PREVIEW_ISSUE if preview else WINDOW_ISSUE)
        signer = judge_keys(population, keys)
        problems = node_key_problems(pop, pub_hex(signer["judge"][1]))
        if problems:
            raise RuntimeError("; ".join(problems))
        capsulectl, book_plugin = tools()
        if not (capsulectl.is_file() and book_plugin.is_file()):
            raise NotChecked("the pack's Results, sealed and verified offline",
                             f"capsulectl and capsulectl-book are not installed ({capsulectl.parent}); "
                             "steps/10-judge.setup.sh installs them")
        pinned = PINNED + ["inference-deals"]
        with tempfile.TemporaryDirectory(prefix="10-judge-") as tmp:
            docs = judge_records(records, source, pack, start, end, not_checked)
            unevaluated = sorted(d for d, doc in docs.items() if not doc.get("x-evaluator")
                                 and any(not t.get("own") for t in pack["kinds"][d[:2]]["terms"]))
            book = Book(Path(tmp) / "book", capsulectl, signer)
