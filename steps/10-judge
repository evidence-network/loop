def load_pack():
    """The pinned inference-deals pack read onto BINDING, as {pack, contract_ref, window, verdicts, kinds, pin}.

    Terms, tiers and the window length are the pinned pack's own (its contract and compiled.json); the
    binding names which stand-in record files feed which term. NotChecked when the pinned pack is not fetched."""
    repo, ref = pin("inference-deals")
    where = tools_dir() / "packs" / f"inference-deals-{ref}"
    missing = NotChecked("the pinned inference-deals pack", f"{repo} {ref} is not fetched into {where}; "
                                                            "steps/10-judge.setup.sh fetches it")
    if not (where / COMPILED).is_file():
        raise missing
    compiled = load(where / COMPILED)
    name, _, version = compiled["contract_ref"].partition("@")
    if not (where / "contracts" / name / f"{version}.json").is_file():
        raise missing
    contract = load(where / "contracts" / name / f"{version}.json")
    if f"{contract['id']}@{contract['version']}" != compiled["contract_ref"]:
        raise NotChecked("the pinned inference-deals pack", f"its contract {contract['id']}@{contract['version']} "
                                                            f"is not the {compiled['contract_ref']} its compiled.json names")
    reqs = {r["id"]: r for r in contract["requirements"]}
    binding = load(BINDING)
    bound = {t["requirement"] for k in binding["kinds"].values() for t in k["terms"] if "requirement" in t}
    if set(reqs) != bound:
        raise NotChecked("the pinned inference-deals pack's terms", f"binding.json binds {sorted(bound)}, the pinned pack "
                                                                    f"has {sorted(reqs)}; bind each term before pinning it",
                         "evidence-network/loop: steps/10-judge.d/binding.json binds the pinned pack's terms")
    soft = sorted(r["id"] for r in reqs.values() if r["tier"] != "must_have")
    if soft:
        raise NotChecked("the pinned inference-deals pack's terms", f"{soft} are not must_have; this step judges "
                                                                    "must_have terms only",
                         "evidence-network/loop: steps/10-judge.d/binding.json binds the pinned pack's terms")
    kinds = {}
    for nn, k in binding["kinds"].items():
        terms = []
        for t in k["terms"]:
            if "requirement" in t:
                r = reqs[t["requirement"]]
                terms.append({"id": r["id"], "name": r["statement"], "must_have": True,
                              **({"model_attestation": True} if t.get("model_attestation") else {})})
            else:
                terms.append({"id": t["id"], "name": t["name"], "must_have": True, "own": True,
                              **({"counted": True} if t.get("counted") else {})})
        kinds[nn] = {"kind": k["kind"], "records": k["records"], "only": k.get("only", {}),
                     "inputs": k.get("inputs", {}), "terms": terms}
    return {"pack": compiled["contract_ref"], "contract_ref": compiled["contract_ref"],
            "own_contract_ref": binding["own_contract_ref"],
            "window": {"period": "month", "periods": compiled["window"]["months"]},
            "verdicts": binding["verdicts"], "kinds": kinds, "pin": f"{repo} {ref}"}


