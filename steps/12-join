def sha256(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def load(path):
    return json.loads(Path(path).read_text(encoding="utf-8"))


# --- The commitment: the one place this step reads it ----------------------
# join.sh writes it in step 03's format (steps/03-advertise.md); its checkpoint
# member carries the book's checkpoint attestation whole: {book_id,
# checkpoint_key, statement}. The commitment the node serves and the lab publishes carries it as the signed
# checkpoint itself (a COSE_Sign1, CBOR tag 18): its stream is the book id and its kid the checkpoint key.
def checkpoint_member(c):
    """(book_id, checkpoint_key) of a commitment's checkpoint member, in either form."""
    raw = base64.urlsafe_b64decode(c["checkpoint"]["bytes"] + "=" * (-len(c["checkpoint"]["bytes"]) % 4))
    if raw[:1] == b"\xd2":
        return hc.checkpoint_identity(raw)
    attestation = json.loads(raw)
    return attestation["book_id"], attestation["checkpoint_key"]


def advertised(node_dir, name="commitment.json"):
    c = load(Path(node_dir) / name)
    book_id, checkpoint_key = checkpoint_member(c)
    return {"node_key": c["key_id"], "checkpoint_key": checkpoint_key,
            "book_id": book_id, "policy_digest": c["lcap"]["policy_digest"],
            "policy_uri": c["lcap"]["policy_uri"], "subjects": c["answers"]["subjects"],
            "derivations": c["answers"]["derivations"], "streams": [x["stream"] for x in hc.history_cards(c)],
            "card_keys": {e.get("stream"): check_commitment_.card_checkpoint_key(e) for e in hc.entries(c)}}


def card_probe(adv, stream):
    """Where join.sh keeps the stranger's history_card/1 request and answer for a stream (no suffix), or None for a
    stream step 03's checker refuses: no path is built from it, so nothing is read or written outside probe/cards."""
    if stream == adv["book_id"]:
        return "probe/history_card"
    if not (isinstance(stream, str) and check_commitment_.STREAM.fullmatch(stream)):
        return None
    return f"probe/cards/{stream}"


def check_own_card(adv):
    """The commitment staples a history_card/1 for the join's own book, under that book's checkpoint key."""
    errs = []
    if adv["book_id"] not in adv["streams"]:
        errs.append(f"the commitment staples no history_card/1 for the join's own book {adv['book_id']}")
    own_key = adv["card_keys"].get(adv["book_id"])
    if own_key is not None and own_key != adv["checkpoint_key"]:
        errs.append(f"the card entry for {adv['book_id']} names a checkpoint key other than the book's checkpoint's")
    return errs


def check_staple(node_dir, adv):
    """The join's own book is stapled, and each stapled card is the kept answer for its book. Returns what is not."""
    node_dir = Path(node_dir)
    errs = check_own_card(adv)
    for e in hc.entries(load(node_dir / "commitment.json")):
        stream = e.get("stream")
        probe = card_probe(adv, stream) if stream else None
        kept = node_dir / f"{probe}.answer.json" if probe else None
        try:
            same = kept is not None and base64.b64decode(e["bytes"]) == kept.read_bytes()
        except (OSError, KeyError, TypeError, ValueError):
            same = False
        if not same:
            errs.append(f"the stapled card for stream {stream} is not the answer the stranger kept for that book")
    return errs


def staple_signatures(node_dir, name, commitment, node_key):
    """(failures, not_checked, proof names, state) for the history_card/1 `commitment` (a file in node_dir) staples, run
    through the pinned capsule-cli's `verify --history` under the node key and each card entry's checkpoint_key
    (scripts/staple_verify.py). A property that fails is a failure; one that cannot run (no binary, a card entry
    without a checkpoint_key) is a not_checked entry. The report is kept as staple-verify.json beside the commitment."""
    node_dir = Path(node_dir)
    got = staple_verify.verify(node_dir / commitment, node_key)
    proof = []
    if got["report"] is not None:
        (node_dir / "staple-verify.json").write_text(json.dumps(got["report"], indent=2, sort_keys=True) + "\n")
        proof.append("staple-verify.json")
    # An evidence-commitment/0 (what the pinned plugin signs) is not an entry here: capsule-cli takes no keys for it, and
    # step 12 never listed its staple as unchecked; step 03 names it.
    nc = [] if got["legacy"] else [{"what": f"{name}: the stapled history_card/1 signature verifies", "why": why,
                                    "issue": STAPLE_ISSUE} for why in got["not_checked"]]
    return [f"{name}: {e}" for e in got["errors"]], nc, proof, "LEGACY" if got["legacy"] else got["state"]


def check_commitment(node_dir):
    """The commitment verifies with step 03's checker, its policy fetched beside it. Returns what did not."""
    try:
        doc = load(Path(node_dir) / "commitment.json")
    except (OSError, ValueError) as e:
        return [f"the commitment is not readable JSON ({e})"]
    errs, notes = check_commitment_.verify(doc, check_commitment_.file_fetcher(node_dir))
    return [f"the commitment does not verify: {e}" for e in errs + notes]


def check_doctor(node_dir, adv):
    """What capsulectl book doctor --probe found. Returns what did not hold."""
    node_dir = Path(node_dir)
    try:
        found = {f["check"]: f for f in load(node_dir / "doctor.json")["findings"]}
    except (OSError, ValueError, KeyError, TypeError) as e:
        return [f"doctor.json is not capsulectl book doctor's findings ({e})"]
    errs = []
    for check in DOCTOR_PROBES:
        f = found.get(check, {})
        if f.get("state") != "match":
            errs.append(f"doctor --probe {check}: {f.get('state', 'absent')} ({f.get('detail', 'no finding')})")
    binding = load(node_dir / "controller.json")["binding_digest"]
    if binding not in found.get("controller_binding", {}).get("records", []):
        errs.append(f"doctor does not list the controller binding {binding} as naming the node key")
    if found.get("checkpoint", {}).get("state") != "present":
        errs.append(f"doctor finds no checkpoint over the book: {found.get('checkpoint')}")
    return errs


def check_binding_record(node_dir, at, not_checked=None, lines=None):
    """What the Go verifier found wrong with binding.json, the record join.sh wrote: it has the digest
    controller.json names, names the node key and applies at `at`. A method or key type the verifier lacks cannot
    be told from a bad record here, and join.sh writes none of them, so it counts as not holding. A binding that
    applies with revocation NOT_CHECKED adds its entry to `not_checked`."""
    node_dir = Path(node_dir)
    try:
        c = load(node_dir / "controller.json")
        raw = (node_dir / "binding.json").read_text(encoding="utf-8")
        state, detail = binding_check(node_dir.name, raw, c["binding_digest"], c["node_key"], at)
    except (OSError, ValueError, KeyError, TypeError) as e:
        return [f"binding.json and controller.json are not the controller binding join.sh writes ({e})"]
    if state == "open" and not_checked is not None:
        not_checked.append(revocation_open(detail))
    if state in ("ok", "open") and lines is not None:
        lines.append(detail)  # what the revocation PASS is scoped to, or why it is not checked
    return [] if state in ("ok", "open") else [f"the controller binding does not hold: {state}: {detail}"]


def check_policy_match(node_dir, adv):
    """The answers match the advertised policy. Returns a list of what did not."""
    node_dir = Path(node_dir)
    errs = []
    published = node_dir / adv["policy_uri"]
    try:
        signed = load(published) if sha256(published) == adv["policy_digest"] else None
    except (OSError, ValueError):
        signed = None
    if signed is None or signed.get("policy") != load(node_dir / "policy.json"):
        errs.append("the node answers under a policy that is not the one it advertises")
    for probe in PROBES:
        req = load(node_dir / "probe" / f"{probe}.request.json")
        ans = load(node_dir / "probe" / f"{probe}.answer.json")
        asked = "+".join([*req["subject"], *([req["derivation"]] if "derivation" in req else [])])
        if not all(s in adv["subjects"] for s in req["subject"]) or \
                ("derivation" in req and req["derivation"] not in adv["derivations"]):
            errs.append(f"{asked} is not among the subjects and derivations the node advertises")
        if "artifact" not in ans or "reason" in ans:
            errs.append(f"{asked} is refused ({ans.get('reason', 'no artifact')}), "
                        "but the advertised policy answers it to anyone")
            continue
        if ans.get("subject") != req["subject"] or ans.get("derivation") != req.get("derivation"):
            errs.append(f"the answer to {asked} is for another subject or derivation")
    return errs


def verify_answers(node_dir, adv, capsulectl, work):
    """Each probe answer verifies under the advertised keys, by the pinned capsulectl-book.

    The stranger's book is copied into `work` and its profile made again
    there, so the proof bytes are never written to. Writes
    probe/<probe>.verified.json (the verifier's output) and returns a list of
    what did not verify.
    """
    node_dir, work = Path(node_dir), Path(work)
    st = node_dir / "probe" / "stranger"
    home = work / "stranger"
    shutil.copytree(st, home)
    for seed in home.glob("*.seed"):
        seed.chmod(0o600)
    env = dict(os.environ, XDG_CONFIG_HOME=str(home / "config"),
               CAPSULECTL_PLUGIN_ROOTS=os.environ.get("CAPSULECTL_PLUGIN_ROOTS", str(Path(capsulectl).parent)))
    prof = load(home / "profile.json")

    def cap(*args):
        return subprocess.run([str(capsulectl), *args], env=env, capture_output=True, text=True)

    r = cap("profile", "create", "--name", "stranger", "--type", "jsonl", "--jsonl-path", str(home / "store"),
            "--log", "book", "--log-id", prof["log_id"], "--operator", prof["operator"],
            "--trusted-key", load(home / "signing.json")["public_key"],
            "--signing-key-file", str(home / "signing.seed"),
            "--checkpoint-signing-key-file", str(home / "checkpoint.seed"),
            "--checkpoint-trusted-key", load(home / "checkpoint.json")["public_key"])
    if r.returncode == 0:
        r = cap("store", "init", "--profile", "stranger")
    if r.returncode != 0:
        raise RuntimeError(f"could not make the stranger's profile again: {r.stderr.strip()}")
    errs = []
    # The own book's two answers under its checkpoint key; each other card under the key its entry names.
    asked = [(f"probe/{probe}", probe, adv["checkpoint_key"]) for probe in PROBES]
    asked += [(card_probe(adv, stream), f"history_card of {stream}", key)
              for stream, key in sorted(adv["card_keys"].items())
              if stream and stream != adv["book_id"] and key and card_probe(adv, stream)]
    for base, probe, checkpoint_key in asked:
        rid = load(node_dir / f"{base}.asked.json")["record_id"]
        r = cap("book", "request", "--profile", "stranger", "--for", rid,
                "--response", str(node_dir / f"{base}.answer.json"),
                "--responder-key", adv["node_key"], "--responder-checkpoint-key", checkpoint_key)
        out = r.stdout.strip().splitlines()[-1] if r.stdout.strip() else ""
        try:
            verdict = json.loads(out) if out else {}
        except ValueError:
            verdict = {}
        verdict.pop("response", None)
        verdict.pop("output", None)
        record = {"verifier": "capsulectl book request --for --response", "exit": r.returncode,
                  "result": verdict, "refused": r.stderr.strip().splitlines()[0] if r.returncode else ""}
        (node_dir / f"{base}.verified.json").write_text(json.dumps(record, indent=2, sort_keys=True) + "\n")
        if r.returncode != 0 or verdict.get("outcome") != "artifact":
            errs.append(f"the {probe} answer does not verify under the advertised node and checkpoint keys: "
                        f"{record['refused'] or verdict}")
    return errs


def book_plugin(capsulectl):
    """The capsulectl-book plugin file capsulectl runs `book` commands with (CAPSULECTL_PLUGIN_ROOTS, else beside it)."""
    return Path(os.environ.get("CAPSULECTL_PLUGIN_ROOTS", str(Path(capsulectl).parent))) / "capsulectl-book"


def verify_sealed_replies(asked, capsulectl, work):
    """{label: [what did not verify]} for replies to requests a tool other than the book composed and sent.
    Step 07's live replies use it; step 12's own doctor probes go through verify_answers, whose requests the
    stranger's book composes itself.

    `asked` is [(label, sealed request, reply, responder key, checkpoint key)]: the request exactly as it was
    sent (the capsules plugin's sealed one, with its audience, requester_id and requester_auth), the signed answer in
    the reply, and the keys the asked node announces. A scratch book in `work` records each request as sent
    (`book request --request F --sent`, which keeps every member and adds none), then verifies the reply against it
    (`--for ID --response F`) (loop#290).
    One scratch book per call: the book refuses a nonce it has recorded."""
    work = Path(work)
    home = work / "sealed-replies"
    home.mkdir(parents=True)
    env = dict(os.environ, XDG_CONFIG_HOME=str(home / "config"),
               CAPSULECTL_PLUGIN_ROOTS=os.environ.get("CAPSULECTL_PLUGIN_ROOTS", str(Path(capsulectl).parent)))

    def cap(*args):
        return subprocess.run([str(capsulectl), *args], env=env, capture_output=True, text=True)

    def last(r):
        out = r.stdout.strip().splitlines()[-1] if r.stdout.strip() else ""
        try:
            return json.loads(out) if out else {}
        except ValueError:
            return {}

    keys = {}
    for name in ("signing", "checkpoint"):
        r = cap("key", "generate", "-o", str(home / f"{name}.seed"))
        if r.returncode != 0:
            raise RuntimeError(f"could not make the scratch book's {name} key: {r.stderr.strip()}")
        keys[name] = last(r)["public_key"]
    r = cap("profile", "create", "--name", "sealed", "--type", "jsonl", "--jsonl-path", str(home / "store"),
            "--log", "book", "--log-id", "sealed-replies", "--operator", "loop",
            "--trusted-key", keys["signing"], "--signing-key-file", str(home / "signing.seed"),
            "--checkpoint-signing-key-file", str(home / "checkpoint.seed"),
            "--checkpoint-trusted-key", keys["checkpoint"])
    if r.returncode == 0:
        r = cap("store", "init", "--profile", "sealed")
    if r.returncode != 0:
        raise RuntimeError(f"could not make the scratch book: {r.stderr.strip()}")
    found = {}
    for i, (label, request, reply, responder_key, checkpoint_key) in enumerate(asked):
        files = {k: home / f"{i}.{k}.json" for k in ("request", "reply", "sent")}
        files["request"].write_text(json.dumps(request))
        files["reply"].write_text(json.dumps(reply))
        r = cap("book", "request", "--profile", "sealed", "--request", str(files["request"]), "--sent",
                "--responder", str(request.get("audience", "")), "--output", str(files["sent"]))
        rid = last(r).get("record_id")
        if r.returncode != 0 or not rid:
            found[label] = [f"the sealed request is not one the book records as sent: {r.stderr.strip()}"]
            continue
        r = cap("book", "request", "--profile", "sealed", "--for", rid, "--response", str(files["reply"]),
                "--responder-key", responder_key, "--responder-checkpoint-key", checkpoint_key)
        verdict = last(r)
        if r.returncode != 0 or verdict.get("outcome") not in ("artifact", "refusal"):
            found[label] = [f"the reply does not verify under the announced keys for the request sent: "
                            f"{r.stderr.strip().splitlines()[0] if r.stderr.strip() else verdict}"]
        else:
            found[label] = []
    return found


def judge(node_dir, capsulectl, work, at=None, said=None):
    """(failures, not_checked, proof paths relative to node_dir) for one joined node. `at` is the time the
    binding must apply at, now by default. The binding's line (what its revocation PASS is scoped to) is added to
    `said` when given."""
    node_dir = Path(node_dir)
    errs = check_commitment(node_dir)
    try:
        adv = advertised(node_dir)
    except (OSError, ValueError, KeyError, TypeError) as e:
        return errs + [f"the commitment does not advertise the node's keys and policy ({e})"], [], list(PROOF)
    errs += check_doctor(node_dir, adv)
    not_checked = []
    errs += check_binding_record(node_dir, at or utc_now(), not_checked, said)
    errs += check_policy_match(node_dir, adv)
    errs += check_staple(node_dir, adv)
    sig_fails, sig_nc, sig_proof, _ = staple_signatures(node_dir, node_dir.name, "commitment.json", adv["node_key"])
    errs += sig_fails
    not_checked += sig_nc
    errs += verify_answers(node_dir, adv, capsulectl, work)
    # The stranger's book too: the kept answers are verified again in it, so a rerun needs its bytes.
    proof = list(PROOF) + sig_proof + sorted(str(f.relative_to(node_dir)) for f in (node_dir / "probe/stranger").rglob("*")
                                             if f.is_file())
    for probe in PROBES:
        proof += [f"probe/{probe}.{k}.json" for k in ("request", "asked", "answer", "verified")]
    for stream in sorted({x for x in adv["streams"] if x and x != adv["book_id"] and card_probe(adv, x)}):
        if adv["card_keys"].get(stream) is None:
            not_checked.append({"what": f"the stapled history_card/1 of book {stream} verifies under the node key "
                                        "and that book's checkpoint key",
                                "why": "its card entry names no checkpoint_key; this card's bytes are matched to "
                                       "the stranger's kept answer",
                                "issue": STAPLE_ISSUE})
        proof += [f"{card_probe(adv, stream)}.{k}.json" for k in ("request", "asked", "answer", "respond", "verified")
                  if (node_dir / f"{card_probe(adv, stream)}.{k}.json").is_file()]
    return errs, not_checked, proof


def make_test_controller_key(path):
    """The rehearsal population has no controller keys: a test key made for this run."""
    subprocess.run(["openssl", "genpkey", "-algorithm", "ed25519", "-out", str(path)], check=True,
                   capture_output=True)


def merge(into, items):
    for item in items:
        if item not in into:
            into.append(item)


# --- Probe backend "doctor": join.sh on this machine, then the stranger probe --
def run_doctor(pop, out, tmp):
    """Join each node with join.sh and judge what it wrote. Returns (failures, not_checked, proof, lines)."""
    capsulectl = tools()
    if not capsulectl.is_file():
        raise SystemExit(f"12-join: no capsulectl at {capsulectl}; run steps/12-join.setup.sh")
    for node in pop["nodes"]:
        name = node["name"]
        key_dir = ROOT / node["key_dir"]  # relative to the repository root, as population.json gives it
        controller = key_dir / "controller-key.pem"
        if not controller.is_file():
            controller = Path(tmp) / f"{name}-controller-key.pem"
            make_test_controller_key(controller)
        node_out = out / name
        if node_out.exists():
            shutil.rmtree(node_out)
        env = dict(os.environ, CAPSULECTL=str(capsulectl))
        r = subprocess.run([str(ROOT / "join.sh"), "--name", name, "--node-key", str(key_dir / "node-key.pem"),
                            "--controller-key", str(controller), "--out", str(node_out),
                            "--home", str(Path(tmp) / f"{name}-home")],
                           env=env, capture_output=True, text=True)
        (out / f"{name}.join.log").write_text(r.stdout + r.stderr)
        (out / f"{name}.join.exit").write_text(f"{r.returncode}\n")
    return decide_nodes(out, [n["name"] for n in pop["nodes"]], capsulectl, tmp)


def decide_nodes(out, names, capsulectl, tmp):
    """Judge each joined node from the proof files in `out` alone: join.sh's kept exit code, then what it wrote.

    Returns (failures, not_checked, proof, lines). Run and reproduction both come through here, so a rerun on
    the cited bytes judges as the run did.
    """
    out = Path(out)
    failures, not_checked, proof, lines = [], [], [], []
    for name in names:
        proof += [x for x in (f"{name}.join.log", f"{name}.join.exit") if (out / x).is_file()]
        try:
            code = int((out / f"{name}.join.exit").read_text().strip())
        except (OSError, ValueError):
            failures.append(f"{name}: join.sh's exit code is not kept in {name}.join.exit")
            continue
        if code != 0:
            failures.append(f"{name}: join.sh did not complete (exit {code}); see {name}.join.log")
            continue
        node_out = out / name
        try:
            said = []
            errs, nc, p = judge(node_out, capsulectl, Path(tmp) / f"{name}-verify", said=said)
        except (OSError, ValueError, KeyError, TypeError) as e:  # a proof file altered or missing
            failures.append(f"{name}: the proof could not be judged ({type(e).__name__}: {str(e)[:200]})")
            errs, nc, said = [], [], []
            p = list(PROOF) + [str(f.relative_to(node_out)) for f in sorted(node_out.rglob("*")) if f.is_file()]
        failures += [f"{name}: {e}" for e in errs]
        merge(not_checked, nc)
        proof += [f"{name}/{x}" for x in dict.fromkeys(p) if (node_out / x).is_file()]
        lines.append(f"{name}: joined; the commitment verifies, doctor --probe finds both answers verify and match "
                     "the policy, and the kept answers verify under the advertised keys and match the advertised "
                     "policy" if not errs else f"{name}: {len(errs)} check(s) did not hold")
        lines += [f"{name}: {x}" for x in said]
    return failures, not_checked, proof, lines


# --- Probe backend "reporter": a Mesh node, asked through the daily reporter --
# doctor --probe asks a Go book's own responder in process and cannot reach a
# Mesh plugin node. For those the probe is the daily reporter's ask
# (scripts/daily_report.py, mesh_evidence_request through the reporter node's
# capsules plugin), reused as it is: the plugin verifies each answer under the
# key the node's host announces, and the reporter writes that verdict as a line.
# The answers are matched against the node's signed commitment and its policy (loop#161), as join returns them on
# the node's own console; a node whose commitment the run did not verify is matched against its nodes/ entry only.
SIGNED_WHAT = "the signed commitment and policy the answers are matched against"


DOCTOR_ROUTE = "/api/plugins/capsules/tools/doctor"
COMMITMENT_ROUTE = "/api/plugins/capsules/tools/mesh_commitment_fetch"
OWN_COMMITMENT_ROUTE = "/api/plugins/capsules/tools/commitment"
JOIN_ROUTE = "/api/plugins/capsules/tools/join"
# The commitments a findings run publishes (loop#88), one per node: nodes/commitments/<node_id>.json (in LOOP_NODES_DIR's
# listings when that is set).
PUBLISHED = Path(os.environ.get("LOOP_NODES_DIR", ROOT / "nodes")) / "commitments"
# A detail line saying a node's commitment is not the published one; it stays in detail on a FAIL too.
CHANGED = "commitment changed"
NODE_CONSOLE_ISSUE = "evidence-network/loop: lab/lab.sh loop gives each node's console (LOOP_NODE_CONSOLES)"
HEX64 = frozenset("0123456789abcdef")


def post_json(url, body, timeout):
    """The JSON a plugin tool answered, or None when nothing usable came back."""
    try:
        status, raw = daily_report.http("POST", url, body, timeout)
        return json.loads(raw) if status == 200 else None
    except (OSError, ValueError):
        return None


WIRE_FILE = "wire.json"  # per node: how each plugin call this run made ended, so judge_live replays it


class Wire:
    """A node's plugin calls (loop#188): live, each made over HTTP and kept under node_dir (wire.json records what a
    JSON call answered, and how a tool call ended beside its reply bytes, <stem>.json); or replayed from those files
    (judge_live), so the judge decides from the proof alone and step 08 gets the same verdict. A live Wire with no
    node_dir keeps nothing (a direct call, as a test makes)."""

    def __init__(self, node_dir=None, replay=False, timeout=30):
        self.dir, self.replay, self.timeout = (Path(node_dir) if node_dir else None), replay, timeout
        self.ended = load(self.dir / WIRE_FILE) if replay else {}
        if not isinstance(self.ended, dict):
            raise ValueError(f"{WIRE_FILE} is not an object")
        self.used = []

    def kept(self, stem):
        if not isinstance(self.ended.get(stem), dict):
            raise ValueError(f"{WIRE_FILE} records no {stem} call")
        return self.ended[stem]

    def keep(self, stem, record):
        if self.dir is not None:
            self.ended[stem] = record
            (self.dir / WIRE_FILE).write_text(json.dumps(self.ended, indent=2, sort_keys=True) + "\n")

    def post_json(self, stem, console, route, body):
        """The JSON a plugin tool answered, or None (post_json), kept in wire.json."""
        if self.replay:
            return self.kept(stem).get("reply")
        reply = post_json(console + route, body, self.timeout)
        self.keep(stem, {"reply": reply})
        return reply

    def tool(self, stem, console, route, body):
        """(reply object or None, the bytes, what went wrong or None), as tool(); the bytes are <stem>.json."""
        if self.replay:
            err = self.kept(stem).get("error")
            raw = (self.dir / f"{stem}.json").read_bytes()
        else:
            reply, raw, err = tool(console, route, body, self.timeout)
            if self.dir is not None:
                (self.dir / f"{stem}.json").write_bytes(raw)
            self.keep(stem, {"error": err})
        if err:
            return None, raw, err
        try:
            reply = json.loads(raw)
        except ValueError:
            return None, raw, "the reply is not JSON"
        return (reply, raw, None) if isinstance(reply, dict) else (None, raw, "the reply is not a JSON object")


def check_binding(name, node_id, key_id, doctor_console, commitment_console, timeout=30, wire=None):
    """(failure or None, not_checked or None, line, held digest or None, named) for the controller binding of one
    node. `named` is what the fetched commitment was read to name: its binding digest, "" for none, or None when it
    was not read (loop#201 reads the optional unbound case, and reports a commitment naming a binding once, by it).

    Its doctor, asked through its own console, says bound (with the binding digest) or unbound; its commitment,
    fetched through the asking console, may name a binding by digest. Both agree, or neither names one: the
    binding is optional. Only the digest is read, never the operator's key.

    Two ties keep the comparison about this node: the doctor console must answer as this node (its own
    commitment names node_id), and the fetched commitment must be under the node's listed key (key_id). The plugin
    reads both digests from the same held file, so this shows the node is consistent, not an independent check
    of the binding. A binding whose window closes between the two calls shows as one FAIL; that is rare, and
    a rerun settles it.
    """
    wire = wire or Wire(timeout=timeout)

    def unreadable(why):
        return None, no_binding(name, why), f"{name}: binding not read", None, None

    own = wire.post_json("binding-own-commitment", doctor_console, OWN_COMMITMENT_ROUTE, {})
    mine = own.get("commitment") if isinstance(own, dict) else None
    answered_as = mine.get("node_id") if isinstance(mine, dict) else None
    if answered_as != node_id:
        return unreadable(f"the console given for it answers as {answered_as or 'no node'}, not as {node_id}")
    doctor = wire.post_json("binding-doctor", doctor_console, DOCTOR_ROUTE, {})
    state = binding_state(doctor)
    if state is None:
        return unreadable("its doctor reports no controller_binding of bound or unbound (an older plugin, or no answer)")
    held = state[1]
    if state[0] == "bound" and not (isinstance(held, str) and len(held) == 64 and set(held) <= HEX64):
        return f"{name}: doctor reports the binding bound without a sha256 digest", None, "", None, None
    fetched = wire.post_json("binding-fetched-commitment", commitment_console, COMMITMENT_ROUTE, {"peer_id": node_id})
    if not isinstance(fetched, dict) or not isinstance(fetched.get("commitment"), dict) or fetched.get("problems"):
        return unreadable("its commitment could not be fetched and checked through the console that asks it"
                          + (f" ({'; '.join(map(str, fetched['problems']))})" if isinstance(fetched, dict)
                             and fetched.get("problems") else ""))
    # announced_key only says the commitment matches the host's announced key, not the listed one.
    if fetched["commitment"].get("key_id") != key_id:
        return unreadable(f"its commitment is not under the listed key {key_id}")
    named = (fetched["commitment"].get("controller_binding") or {}).get("digest")
    if named != held:
        return (f"{name}: the commitment names the controller binding {named or 'none'}, but doctor reports "
                f"{('it bound as ' + held) if held else 'no binding held'}"), None, "", None, named or ""
    return None, None, (f"{name}: doctor reports the controller binding bound ({held}); its signed commitment, "
                        "fetched through the console that asks it, names the same digest" if held
                        else f"{name}: doctor reports no controller binding held, and the signed commitment "
                             "names none"), held, named or ""


def settled_binding(fail, named):
    """What check_binding settled, for check_node_tools (loop#201): "" when doctor and the fetched commitment agreed
    there is no binding; the digest the fetched commitment names when check_binding FAILed on it, so a join
    commitment naming the same one is reported once; None otherwise (not read, or a binding that agreed, which a
    join commitment naming it while doctor reports none must still FAIL on)."""
    if fail is None and named == "":
        return ""
    return named if fail and named else None


def live_binding_record(name, node, entry, held, at, node_dir, snap=None, replay=False):
    """(failure or None, not_checked list, line or None, proof paths) of the Go verifier on the record the node
    holds in its data_dir (the population's `data_dir`, controller-binding.json), for the binding doctor reports
    `held`. The bytes checked are kept in node_dir, so the archived finding can recheck them; `replay` reads that
    kept copy instead (judge_live: none kept means the data_dir held none readable). A node that holds no binding
    has none to check; one whose data_dir or record is not readable is NOT_CHECKED."""
    if not held:
        return None, [], None, []
    src = Path(node_dir) if replay else live.path(node, "data_dir")
    try:
        raw = (src / BINDING_FILE).read_text(encoding="utf-8")
    except (OSError, ValueError, TypeError):
        return None, [no_binding(name, f"it has no readable {BINDING_FILE} in its data_dir (the population's) to "
                                       "check the record by")], None, []
    if not replay:
        (Path(node_dir) / BINDING_FILE).write_text(raw, encoding="utf-8")
    kept = [f"{name}/{BINDING_FILE}"]
    state, detail = binding_check(name, raw, held, entry["key_id"], at,
                                  from_main=snap or {"commit": None, "why": "no main commit was read"})
    if state == "bad":
        return f"{name}: {detail}", [], None, kept
    unchecked = binding_unchecked(state, detail)
    if unchecked:
        return None, [{**unchecked, "what": f"{name}: {unchecked['what']}"}], None, kept
    if state == "open":
        nc = revocation_open(detail)
        return None, [{**nc, "what": f"{name}: {nc['what']}"}], f"{name}: {detail}", kept
    return None, [], f"{name}: {detail}", kept


def no_binding(name, why):
    return {"what": f"{name}: the controller binding", "why": why, "issue": "evidence-network/loop: each lab node runs the pinned plugin's join, which binds its key to its controller (capsules-plugin PR #121, in the pin)"}


def tool(console, route, body, timeout):
    """(reply object or None, the bytes, what went wrong or None) for one plugin tool call."""
    try:
        status, raw = daily_report.http("POST", console + route, body, timeout)
    except (OSError, ValueError) as e:
        return None, json.dumps({"error": str(e)}).encode(), f"no reply ({e})"
    if status != 200:
        return None, raw, f"http {status}: {raw.decode('utf-8', 'replace')[:200]}"
    try:
        reply = json.loads(raw)
    except ValueError:
        return None, raw, "the reply is not JSON"
    return (reply, raw, None) if isinstance(reply, dict) else (None, raw, "the reply is not a JSON object")


def doctor_findings(reply):
    """{check: finding} from a doctor or join reply; {} when it carries none."""
    findings = reply.get("findings") if isinstance(reply, dict) else None
    return {f["check"]: f for f in findings if isinstance(f, dict) and isinstance(f.get("check"), str)} \
        if isinstance(findings, list) else {}


def binding_state(reply):
    """("bound", digest) or ("unbound", None) from doctor's controller_binding; None when it reports neither."""
    f = doctor_findings(reply).get("controller_binding")
    if not isinstance(f, dict) or f.get("state") not in ("bound", "unbound"):
        return None
    records = f.get("records")
    return f["state"], (records[0] if f["state"] == "bound" and isinstance(records, list) and records else None)


def judge_doctor(reply):
    """(failures, not_checked) for the plugin's doctor --probe findings.

    A finding the reply does not carry is NOT_CHECKED (an older plugin than the pin), never a failure.
    """
    found = doctor_findings(reply)
    fails, nc = [], []
    for check in DOCTOR_PROBES:
        f = found.get(check)
        state = f.get("state") if f else None
        if state is None or state == "NOT_CHECKED":  # NOT_CHECKED is the plugin's own: no checkpoint yet
            nc.append({"what": f"doctor --probe {check}",
                       "why": f"the plugin did not run it: {f.get('detail')}" if f else "doctor reports no such finding",
                       "issue": live.ISSUE})
        elif state != "match":
            fails.append(f"doctor --probe {check}: {state} ({f.get('detail', 'no detail')})")
    pic = found.get("policy_in_commitment")
    detail = str(pic.get("detail", "no detail")) if pic else ""
    # doctor.rs policy_in_commitment: `missing` both when no commitment is served yet (pending) and when the
    # one served does not verify or advertises another policy (a failure); the detail says which. The prefix
    # below is the pinned plugin's text for the first (capsules-plugin d1f4edc, doctor.rs); another wording
    # reads as a failure, so a pin bump must recheck it.
    if pic is None or (pic.get("state") == "missing" and detail.startswith("no commitment is served")):
        nc.append({"what": "the commitment the node serves on commitment/1, carrying the policy it answers under",
                   "why": f"doctor: {detail}" if pic else "doctor reports no policy_in_commitment finding",
                   "issue": live.ISSUE})
    elif pic.get("state") != "present":
        fails.append(f"doctor policy_in_commitment: {pic.get('state')} ({detail})")
    return fails, nc


def judge_join(reply, entry, node_dir):
    """(failures, not_checked, the commitment join returns or None, its policy bytes or None, whether that
    commitment holds) for the plugin's join report. It holds when it verifies with its policy bytes, under the listed
    key, for the listed node; join's probe findings are failures of their own and do not decide it.

    Writes the commitment pair it returns as commitment.json and disclosure-policy.json in node_dir.
    """
    fails, nc, doc, policy, holds = [], [], None, None, False
    pair = reply.get("commitment")
    if pair is None:
        nc.append({"what": "the commitment join returns", "why": "join returns none (the node serves no "
                   "commitment yet)", "issue": live.ISSUE})
    else:
        try:
            doc, policy = pair["commitment"], base64.b64decode(pair["policy"], validate=True)
            if not isinstance(doc, dict):
                raise TypeError("its commitment is not an object")
        except (KeyError, TypeError, ValueError) as e:
            doc = None
            fails.append(f"join's commitment pair is not {{commitment, policy}} ({e})")
        if doc is not None:
            (node_dir / "commitment.json").write_text(json.dumps(doc, indent=2, sort_keys=True) + "\n")
            (node_dir / "disclosure-policy.json").write_bytes(policy)
            errs, notes = check_commitment_.verify(doc, lambda uri: policy)
            held = [f"join's commitment does not verify: {e}" for e in errs + notes]
            if doc.get("key_id") != entry.get("key_id"):
                held.append(f"join's commitment is under key {doc.get('key_id')}, not the listed key")
            if doc.get("node_id") != entry.get("node_id"):
                held.append(f"join's commitment is for node {doc.get('node_id')}, not this node")
            fails += held
            holds = not held
    # join runs the probes itself and files a mismatch under pending as well (doctor.rs), so judge its findings.
    fails += [f"join: {x}" for x in judge_doctor(reply)[0]]
    if reply.get("joined") is not True:
        pending = reply.get("pending")
        nc.append({"what": "the plugin's join", "why": "join reports pending: " +
                   "; ".join(map(str, pending if isinstance(pending, list) and pending else ["(no pending list)"])),
                   "issue": live.ISSUE})
    return fails, nc, doc, policy, holds


def compare_published(name, node_id, doc, published=None):
    """A line on how join's commitment stands against the one published for the node, never a failure.

    A re-join does not rebuild the commitment, but a new checkpoint does (the pinned plugin's cache,
    commitment_bridge.rs), so the published file may lag the node: a change is reported for the
    findings run to republish.
    """
    f = (published or PUBLISHED) / f"{node_id}.json"
    if not f.is_file():
        return f"{name}: no commitment is published under nodes/commitments/ for it yet; nothing is compared"
    try:
        same = load(f) == doc
    except (OSError, ValueError):
        same = False
    return (f"{name}: join's commitment is the one published under nodes/commitments/" if same else
            f"{name}: {CHANGED}: join's commitment is not the one published under nodes/commitments/, "
            "so the findings run republishes it")


def signed_terms(doc, policy):
    """{subjects, derivations, stranger_safe} of a verified commitment and its signed policy bytes, or None when
    they do not carry them as lists of names."""
    try:
        answers, safe = doc["answers"], json.loads(policy)["policy"]["stranger_safe"]
        terms = {"subjects": answers["subjects"], "derivations": answers.get("derivations", []), "stranger_safe": safe}
    except (KeyError, TypeError, ValueError):
        return None
    return terms if all(isinstance(v, list) and all(isinstance(x, str) for x in v) for v in terms.values()) else None


def check_node_tools(name, entry, console, node_dir, timeout=30, fetched=None, wire=None):
    """(failures, not_checked, proof names in node_dir, lines, signed) for the plugin's doctor --probe and join.
    `fetched` is what check_binding settled this run: "" when doctor and the fetched commitment agree there is no
    binding, the digest the fetched commitment names when check_binding already FAILed on it, None otherwise.
    `signed` is the signed terms (signed_terms) of join's commitment when it holds (judge_join); False when it holds
    but its terms can't be read (a failure, already recorded); None when no commitment from join holds this run.

    The binding state is read from doctor before join; join is called only when it was, and a node that was
    bound must come back bound to the same binding in doctor after join. The console must answer as this
    node first: join is a write, and never sent to a node other than the one named.

    The binding is optional (Steven's ruling u137, Buzz 087f74f4; loop#201): a node unbound before and after the
    re-join is the optional case, with no not_checked entry, only when join's commitment holds this run and names
    no controller binding, and the commitment fetched through the asking console was read to name none
    (`fetched` ""). Otherwise it stays NOT_CHECKED. Join's commitment naming a binding the node does not hold is
    a FAIL, reported once when the fetched commitment already named the same one.
    """
    def nc_(what, why, issue=live.ISSUE):
        return {"what": f"{name}: {what}", "why": why, "issue": issue}

    wire = wire or Wire(node_dir, timeout=timeout)
    own = wire.post_json("tools-own-commitment", console, OWN_COMMITMENT_ROUTE, {})
    mine = own.get("commitment") if isinstance(own, dict) else None
    answered_as = mine.get("node_id") if isinstance(mine, dict) else None
    if answered_as != entry["node_id"]:
        why = f"the console given for it answers as {answered_as or 'no node'}, not as {entry['node_id']}"
        return [], [nc_("the plugin's doctor --probe and join", why)], [], [f"{name}: doctor and join not asked"], None
    fails, nc, proof, lines, signed = [], [], [], [], None
    doc, holds = None, False

    def call(stem, route, body):
        reply, raw, err = wire.tool(stem, console, route, body)
        proof.append(f"{stem}.json")
        return reply, err

    doctor, err = call("doctor-probe", DOCTOR_ROUTE, {"probe": True})
    if err:
        nc.append(nc_("the plugin's doctor --probe", err))
    else:
        f, n = judge_doctor(doctor)
        fails += [f"{name}: {x}" for x in f]
        nc += [{**x, "what": f"{name}: {x['what']}"} for x in n]
    before = binding_state(doctor) if not err else None
    if before is None:
        nc.append(nc_("the plugin's join", "the binding state could not be read from doctor first, so join was "
                                           "not called"))
        return fails, nc, proof, lines + [f"{name}: join not called, the binding state was not read first"], None
    joined, err = call("join", JOIN_ROUTE, {})
    if err:
        nc.append(nc_("the plugin's join", err))
    else:
        f, n, doc, policy, holds = judge_join(joined, entry, node_dir)
        fails += [f"{name}: {x}" for x in f]
        nc += [{**x, "what": f"{name}: {x['what']}"} for x in n]
        proof += [p for p in ("commitment.json", "disclosure-policy.json") if doc is not None]
        if holds:
            lines.append(compare_published(name, entry["node_id"], doc))
            f, n, p, staple_state = staple_signatures(node_dir, name, "commitment.json", entry["key_id"])
            if staple_state == "LEGACY":
                lines.append(f"{name}: its stapled history_card/1 is not verified (an evidence-commitment/0, {STAPLE_ISSUE}: capsule-cli "
                             "takes no keys for it)")
            fails += f
            nc += n
            proof += p
            signed = signed_terms(doc, policy)
            if signed is None:
                signed = False
                fails.append(f"{name}: join's commitment and policy do not carry answers.subjects and stranger_safe "
                             "as lists of names")
    after_reply, err = call("doctor-after", DOCTOR_ROUTE, {})
    after = binding_state(after_reply) if not err else None
    if after is None:
        nc.append(nc_("the controller binding after join", "doctor after join reports no controller_binding of "
                                                           "bound or unbound" + (f" ({err})" if err else "")))
    elif after[0] == "bound" and not (isinstance(after[1], str) and len(after[1]) == 64 and set(after[1]) <= HEX64):
        fails.append(f"{name}: doctor after join reports the node bound without a sha256 digest")
    elif before[0] == "bound" and after != before:
        fails.append(f"{name}: the node was bound ({before[1]}) before join, and doctor after join reports "
                     + (f"it bound as {after[1]}" if after[0] == "bound" else "it unbound"))
    elif before is not None and before[0] == "unbound" and after[0] == "unbound":
        join_named = (doc.get("controller_binding") or {}).get("digest") if holds else None
        if join_named:
            if fetched != join_named:  # equal only when check_binding already FAILed on that digest
                fails.append(f"{name}: join's commitment names the controller binding {join_named}, but doctor "
                             "reports no binding held")
        elif fetched:
            pass  # the fetched commitment names a binding doctor does not hold: check_binding FAILed on it
        elif holds and fetched == "":
            lines.append(f"{name}: unbound before and after the re-join (optional; its signed commitment, from join "
                         "and fetched through the asking console, carries no binding)")
        else:
            nc.append(nc_("the controller binding", "no controller binding recorded: the node was unbound before "
                                                    "the re-join and is after it (join {} sends no binding), and "
                                                    "this run did not read a signed commitment naming none"))
    if not fails and not nc:
        lines.append(f"{name}: doctor --probe finds both probes match and the commitment it serves carries its "
                     "policy; the re-join reports it joined, and its commitment holds under the listed key with "
                     f"its policy bytes; the binding is {before[0]} before the re-join and {after[0]} after")
    return fails, nc, proof, lines, signed


def check_listing(name, entry, signed):
    """The failures of a nodes/ entry against the node's signed commitment and policy (loop#161): the entry lists
    the signed policy's stranger_safe subjects, and each question they cover is advertised by the commitment."""
    listed = entry.get("disclosure", {}).get("stranger_safe", [])
    fails = []
    if sorted(listed) != sorted(signed["stranger_safe"]):
        fails.append(f"{name}: nodes/ lists {sorted(listed)} as stranger-safe, but the node's signed policy lists "
                     f"{sorted(signed['stranger_safe'])}")
    for stem, question in daily_report.QUESTION_NAMES.items():
        q = daily_report.QUESTIONS[stem]
        subjects, derivation = list(q["subject"]), q.get("derivation")
        if question in listed and not (all(s in signed["subjects"] for s in subjects)
                                       and (derivation is None or derivation in signed["derivations"])):
            fails.append(f"{name}: nodes/ lists {question} as stranger-safe, but the node's signed commitment does "
                         f"not advertise it (subjects {subjects}" + (f", derivation {derivation})" if derivation
                                                                       else ")"))
    return fails


def listed_entry(node):
    """A live node's nodes/ entry: node_id, key_id and what it lists as stranger-safe."""
    if "node_id" in node and "key_id" in node:
        return node
    return load(nodes_dir() / f"{node.get('node_id', node['name'])}.json")


PROBE_ISSUE = "evidence-network/loop: the daily reporter's ask (scripts/daily_report.py)"


def judge_reporter_line(stem, line, entry, signed=None):
    """(failure or None, not_checked or None) for one reporter verification line. `signed` is the node's verified
    signed terms (signed_terms): its policy's stranger_safe then decides which refusal fails, not the entry's."""
    name = daily_report.QUESTION_NAMES[stem]
    state = line.split(" ", 1)[0]
    safe = signed["stranger_safe"] if signed else \
        entry.get("disclosure", {}).get("stranger_safe", list(daily_report.QUESTION_NAMES.values()))
    if state == "verified":
        if "listed_key=match" not in line.split():
            return f"the {name} answer verifies under the announced key, which is not the listed key: {line}", None
        return None, None
    if state in ("refusal", "not_evidence"):
        if state == "refusal" and name not in safe:
            return None, None
        if state == "refusal":
            # A refusal is signed too: under the listed key, like an artifact (as step 07 checks it). Then it is
            # judged by its reason (Mesh-LLM/capsules-plugin#112, #114); the probe's requests name no profile, so
            # they are evidence-interop/0 ones.
            if "listed_key=match" not in line.split():
                return f"the {name} refusal is signed under a key that is not the listed key: {line}", None
            reason = next((w[len("reason="):] for w in line.split() if w.startswith("reason=")), None)
            verdict = refusal.refusal_verdict(reason)
            if verdict == "not_checked":
                return None, refusal.refusal_not_checked(f"the refusal of the {name} probe", reason)
            if verdict == "ok":  # the request is faulted, so the node gave no answer to check
                return None, {"what": f"the {name} probe answer",
                              "why": f"the node refused it for a reason that blames the request ({reason})",
                              "issue": PROBE_ISSUE}
        who = "the node's signed policy" if signed else "the node"
        why = (f"is refused, but {who} lists it as stranger-safe" if state == "refusal"
               else "does not verify under the announced key")
        return f"the {name} answer {why}: {line}", None
    return None, {"what": f"the {name} probe answer", "why": f"the reporter got no verifiable answer: {line}",
                  "issue": PROBE_ISSUE}


def said(line):
    """A reporter line's state for detail. A "verified" line reaching detail matched the listed key; the
    finding words it so, as a NOT_CHECKED detail may not claim a check (steps/finding.py)."""
    state = line.split(" ", 1)[0]
    return "answered under the listed key" if state == "verified" else state


NO_SECOND_CONSOLE_ISSUE = "evidence-network/loop: step 12 asks the reporter's own node through a second console"


def no_second_console(name):
    return {"what": f"{name}: the probe of the reporter's own node",
            "why": "a node can't be asked through its own console, and no second node's console was given "
                   "(--second-console, or LOOP_SECOND_CONSOLE)",
            "issue": NO_SECOND_CONSOLE_ISSUE}


NODES_FILE = "nodes.json"  # the live run's own choices, kept so judge_live replays them (loop#188)


def kept_lines(node_dir, entry):
    """{stem: verification line} of the node's one attempt in the proof. Each line is computed again from the kept
    reply, the announced key (peer-key.json) and the listed key, and must be the line kept; with no reply kept, the
    line may not claim one (as step 07's reporter_line). Raises ValueError naming what does not hold."""
    attempts = layout.attempts(node_dir)
    if len(attempts) != 1:
        raise ValueError(f"the proof holds {len(attempts)} attempts for it, not one")
    attempt, lines = attempts[0], {}
    try:
        said_key = json.loads((attempt / "peer-key.json").read_text(encoding="utf-8"))
        key = said_key.get("announced_key_id") if isinstance(said_key, dict) else None
        announced = key if isinstance(key, str) and daily_report.HEX64.fullmatch(key) else None
    except (OSError, ValueError):
        announced = None
    for stem in daily_report.QUESTIONS:
        try:
            kept = (attempt / f"{stem}.verification").read_text(encoding="utf-8").strip()
        except OSError:
            raise ValueError(f"the attempt holds no {stem}.verification")
        reply = attempt / f"{stem}.response.json"
        if reply.is_file():
            again = daily_report.verification_line(200, reply.read_bytes(), None, announced, entry["key_id"])
            if again != kept:
                raise ValueError(f"the {stem} line kept ({kept}) is not the one its reply gives ({again})")
        elif kept.split(" ", 1)[0] in ("verified", "refusal", "no_checkpoint_yet", "no_announced_key"):
            # not_evidence is the line of a malformed 502, which keeps no reply (as step 07's reporter_line)
            raise ValueError(f"the {stem} line claims a reply the attempt does not hold: {kept}")
        lines[stem] = kept
    return lines


def run_reporter(pop, out, console=None, timeout=30, self_node=None, second_console=None, node_consoles=None,
                 replay=False):
    """(failures, not_checked, proof, lines) of the reporter backend. Live, it asks each node and keeps, under
    `out`, everything it decides from: each node's attempt, its plugin calls (Wire: wire.json and the reply bytes)
    and binding record, and nodes.json (the self node, whether a second console and which own consoles were given,
    the binding time and the main commit revocations are read from). `replay` decides again from those files alone,
    with no console and no data dir (judge_live, step 08)."""
    failures, not_checked, proof, lines = [], [], [], []
    if replay:
        kept = load(out / NODES_FILE)
        self_node, second_console = kept["self_node"], kept["second_console"]
        node_consoles = {n: n for n in kept["node_consoles"]}  # names only: the calls are replayed, none is made
        bind_at, snap = kept["bind_at"], kept["revocations_main"]
        if not (isinstance(bind_at, str) and (snap is None or isinstance(snap, dict))):
            raise TypeError(f"{NODES_FILE} has the wrong shape")
        proof.append(NODES_FILE)
    else:
        at = daily_report.utc_now()
        bind_at = at.strftime("%Y-%m-%dT%H:%M:%SZ")  # the run's one time, for every node's binding window
        snap = None  # origin/main at bind_at, fetched once, when a binding is first read
    owns = []
    for node in pop["nodes"]:
        name = node["name"]
        asker, via = console, "the reporter's console"
        if self_node and name == self_node:
            if not second_console:
                merge(not_checked, [no_second_console(name), no_binding(name, "its commitment was not fetched"),
                                    {"what": f"{name}: the plugin's doctor --probe and join",
                                     "why": "the reporter's own node is not asked without a second console",
                                     "issue": NO_SECOND_CONSOLE_ISSUE}])
                lines.append(f"{name}: not asked, the reporter's own node and no second console")
                continue
            asker, via = second_console, "a second node's console"
        try:
            entry = listed_entry(node)
        except FileNotFoundError:
            merge(not_checked, [{"what": f"live node {name}", "why": "node_id not set, or no nodes/<node_id>.json",
                                 "issue": "evidence-network/loop: the live lab run, which fills population/live"}])
            merge(not_checked, [no_binding(name, "it has no nodes/ entry")])
            lines.append(f"{name}: not asked, no nodes/ entry")
            continue
        node_dir = out / name
        if replay:
            try:
                result = kept_lines(node_dir, entry)
            except (OSError, ValueError, KeyError, TypeError) as e:
                failures.append(f"{name}: its reporter attempt does not hold ({type(e).__name__}: {e})")
                continue
        else:
            if node_dir.exists():
                shutil.rmtree(node_dir)
            node_dir.mkdir(parents=True)
            result = daily_report.ask_attempt(asker, entry, node_dir, list(daily_report.QUESTIONS), at, "by=ask",
                                              timeout)
        attempt = layout.attempts(node_dir)[-1]
        proof += [str(f.relative_to(out)) for f in sorted(attempt.iterdir()) if f.is_file()]
        bad, signed = [], None
        own = (node_consoles or {}).get(name) or (console if self_node and name == self_node and not replay else None)
        if own:
            owns.append(name)
            try:
                wire = Wire(node_dir, replay=replay, timeout=timeout)
            except (OSError, ValueError) as e:
                failures.append(f"{name}: its plugin calls are not readable ({type(e).__name__}: {e})")
                continue
            try:
                fail, nc, line, held, named = check_binding(name, entry["node_id"], entry["key_id"], own, asker,
                                                            timeout, wire)
            except (OSError, ValueError) as e:
                if not replay:
                    raise
                failures.append(f"{name}: its plugin calls do not replay ({type(e).__name__}: {e})")
                continue  # a kept file missing or unreadable is this node's failure, not the whole proof's
            settled = settled_binding(fail, named)  # before `fail` is reused for the binding record below
            if fail:
                bad.append(fail)
            if nc:
                merge(not_checked, [nc])
            if line:
                lines.append(line)
            if not fail and not nc:
                if snap is None and not replay:
                    snap = bv.snapshot(revocations_root(), bind_at)
                fail, ncs, line, binding_kept = live_binding_record(name, node, entry, held, bind_at, node_dir, snap,
                                                                    replay)
                proof += binding_kept
                if fail:
                    bad.append(fail)
                merge(not_checked, ncs)
                if line:
                    lines.append(line)
            try:
                fails, nc, files, said_tools, signed = check_node_tools(name, entry, own, node_dir, timeout, settled,
                                                                        wire)
            except (OSError, ValueError) as e:
                if not replay:
                    raise
                failures += bad + [f"{name}: its plugin calls do not replay ({type(e).__name__}: {e})"]
                continue
            bad += fails
            merge(not_checked, nc)
            proof += [f"{name}/{f}" for f in files]
            proof.append(f"{name}/{WIRE_FILE}")
            lines += said_tools
            if signed is False:
                signed = None  # the failure is recorded; the answers are judged against the entry
            elif signed is None:
                merge(not_checked, [{"what": f"{name}: {SIGNED_WHAT}",
                                     "why": "this run verified no commitment from join under the listed key with its "
                                            "policy, so the answers are matched against the nodes/ entry",
                                     "issue": live.ISSUE}])
            else:
                misstated = check_listing(name, entry, signed)
                bad += misstated
                if not misstated:
                    lines.append(f"{name}: the answers are matched against its signed commitment and policy, and its "
                                 "nodes/ entry lists the same stranger-safe subjects")
        else:
            merge(not_checked, [no_binding(name, "its doctor is reachable only through its own console, which "
                                                 "this run does not hold (--node-console)"),
                                {"what": f"{name}: the plugin's doctor --probe and join",
                                 "why": "they are reachable only through the node's own console, which this run "
                                        "does not hold (--node-console)",
                                 "issue": NODE_CONSOLE_ISSUE},
                                {"what": f"{name}: {SIGNED_WHAT}",
                                 "why": "its commitment and signed policy come from join on the node's own console, "
                                        "which this run does not hold, so the answers are matched against the nodes/ "
                                        "entry",
                                 "issue": NODE_CONSOLE_ISSUE}])
        for stem, line in result.items():
            fail, nc = judge_reporter_line(stem, line, entry, signed)
            if fail:
                bad.append(f"{name}: {fail}")
            if nc:
                merge(not_checked, [{**nc, "what": f"{name}: {nc['what']}"}])
        failures += bad
        asked = f" (asked through {via})" if self_node else ""
        lines.append(f"{name}{asked}: " +
                     "; ".join(f"{daily_report.QUESTION_NAMES[k]} {said(v)}" for k, v in result.items()))
    if not replay:
        (out / NODES_FILE).write_text(json.dumps({"self_node": self_node, "second_console": bool(second_console),
                                                  "node_consoles": owns, "bind_at": bind_at, "revocations_main": snap},
                                                 indent=2, sort_keys=True) + "\n")
        proof.insert(0, NODES_FILE)
    return failures, not_checked, list(dict.fromkeys(proof)), lines


def judge_live(pop, out, started):
    """The live (reporter) finding decided from what run_reporter kept under `out` alone: no console is asked and
    no data dir read, so step 08 gets the same verdict from the cited proof (loop#188)."""
    out = Path(out)
    try:
        failures, not_checked, proof, lines = run_reporter(pop, out, replay=True)
    except (OSError, ValueError, KeyError, TypeError) as e:
        failures, not_checked, proof, lines = [f"{NODES_FILE} is not readable ({type(e).__name__}: {e})"], [], [], []
    return conclude(out, pop["population"], failures, not_checked, proof, lines, started, "reporter")


# --- The Goose rehearsal: a Goose node's join and a stranger's probe (loop#330) --------------------------------
# G1 has no join.sh and keeps no controller binding. A node's join is loop_join: it opens the node book, seals the join
# record and returns the node's keys and its signed commitment. The step reads the asks session of the Goose rehearsal
# (scripts/goose_ask_session.py: two nodes that joined and advertised, each asked by the other through the mailbox its
# commitment names) and judges, with step 07's own checks, each node's commitment and the stranger's probe
# (checkpoints with the history_card/1 derivation, the one probe the Goose asks session makes; a bare checkpoints ask
# is not made) of it. The probe is answered by the node polling its mailbox and is verified under the
# node's listed keys in a fresh book. The controller binding is optional (Steven, u137): a commitment that names none is
# the unbound case, stated, not a failure.
GOOSE_ASSERTS = ("one command on the pinned Goose release (loop_join) opens the node's book, seals its join record and "
                 "returns the node's signed commitment, the node then advertises the commitment it is asked through, "
                 "which names the keys it answers under, and a stranger's probe of the node (the checkpoints subject "
                 "with the history_card/1 derivation) verifies and matches the advertised policy; no controller "
                 "binding is kept" + STAPLE_ASSERT)
GOOSE_PINNED = ["goose-g1", "capsulectl", "capsulectl-book", "capsule-cli"]


def load_step07():
    loader = importlib.machinery.SourceFileLoader("step07_ask_for_goose", str(HERE / "07-ask"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


def goose_binding_errors(name, doc):
    """A Goose node keeps no controller binding: a commitment that names one is not the node's."""
    return [f"{name}: the commitment names a controller binding, which a Goose node does not keep"] \
        if "controller_binding" in doc else []


def goose_probe_errors(s07, request, adv):
    """The ask kept as the history_card/1 probe is that probe, and the advertised policy answers it to a stranger."""
    want = s07.ASKS["history_card"]["request"]
    errs = [] if all(request.get(k) == v for k, v in want.items()) else [
        f"the request is {s07.asked(request)} with coverage {request.get('coverage')}, not "
        f"checkpoints+history_card/1 with coverage {want['coverage']}"]
    if "checkpoints" not in adv["subjects"] or want["derivation"] not in adv["derivations"]:
        errs.append("the commitment does not advertise checkpoints and history_card/1")
    if not s07.stranger_safe(request, adv):
        errs.append("the advertised policy does not answer this request to a stranger")
    return errs


def run_goose(pop, out, tmp):
    """(failures, not_checked, proof, lines) for the nodes of the Goose rehearsal's asks session, judged on its bytes."""
    capsulectl = tools()
    s07 = load_step07()
    run = Path(pop["goose"]["asks"]["run"])
    nodes = load(run / "nodes.json")
    failures, not_checked, proof, lines = [], [], [], []
    expected = sorted(n["name"] for n in pop["nodes"])
    if sorted(nodes) != expected:
        failures.append(f"the asks session joined nodes {sorted(nodes)}, the population lists {expected}")
    for name in nodes:  # every node's tree first: a node is judged on the asks the others made of it
        shutil.rmtree(out / name, ignore_errors=True)
        shutil.copytree(run / name, out / name)
    for name, joined in sorted(nodes.items()):
        joined_dir, adv_dir = out / name / "joined", out / name / "advertised"
        # The join: loop_join's own commitment and the join record it sealed.
        jadv, errs = s07.advertisement(joined_dir, f"{joined['key_id']}.json")
        failures += [f"{name}: loop_join's commitment: {e}" for e in errs]
        if jadv is not None and jadv["node_key"] != joined["key_id"]:
            failures.append(f"{name}: loop_join's commitment is for key {jadv['node_key']}, the node joined as {joined['key_id']}")
        proof += [f"{name}/joined/{f.relative_to(joined_dir)}" for f in sorted(joined_dir.rglob("*")) if f.is_file()]
        bundle_path = joined_dir / "join-record.bundle.json"
        if bundle_path.is_file():
            verdict, verrs = s07.verify_bundle(bundle_path, capsulectl)
            bundle = load(bundle_path)
            head = s07.disclosed(bundle, bundle.get("root")) or {}
            held = [b for b in bundle.get("records", []) if b.get("capsule_id") == bundle.get("root")]
            failures += [f"{name}: the join record's bundle: {e}" for e in verrs]
            if not verrs and not (bundle.get("root") == joined["first_record"] and head.get("record_type") == "goose_joined"
                                  and held and held[0].get("key_id") == joined["key_id"]
                                  and (head.get("statement") or {}).get("key_id") == joined["key_id"]):
                failures.append(f"{name}: the bundle's root is not the node's goose_joined record signed by its key")
        else:
            failures.append(f"{name}: no join record was exported")
        # The commitment the node is asked through.
        adv, errs = s07.advertisement(adv_dir)
        if adv is None:
            failures += [f"{name}: {e}" for e in errs]
            continue
        proof += [f"{name}/advertised/{f.relative_to(adv_dir)}" for f in sorted(adv_dir.rglob("*")) if f.is_file()]
        if adv["node_key"] != joined["key_id"]:
            failures.append(f"{name}: the commitment is for key {adv['node_key']}, the node joined as {joined['key_id']}")
        failures += goose_binding_errors(name, load(adv_dir / "commitment.json"))
        failures += [f"{name}: {e}" for e in check_own_card(adv)]
        f, n, p, signed_state = staple_signatures(adv_dir, name, "commitment.json", adv["node_key"])
        if signed_state == "LEGACY":
            lines.append(f"{name}: its stapled history_card/1 is not verified (an evidence-commitment/0, {STAPLE_ISSUE}: capsule-cli takes no "
                         "keys for it)")
        failures += f
        not_checked += n
        proof += [f"{name}/advertised/{x}" for x in p]
        # A stranger's probe: every other node asked this one for history_card/1 (checkpoints with that derivation).
        probed = 0
        for asker in sorted(set(nodes) - {name}):
            d = out / asker / "asks" / name / "history_card"
            if not (d / "outcome.bundle.json").is_file():
                failures.append(f"{asker} asked {name}: no history_card/1 probe was recorded")
                continue
            events = [json.loads(ln) for ln in (out / asker / "asks" / name / "carrier.jsonl").read_text().splitlines()]
            verdict, verrs = s07.verify_bundle(d / "outcome.bundle.json", capsulectl)
            errs = list(verrs)
            if not errs:
                errs += goose_probe_errors(s07, load(d / "request.json"), adv)
                verifier = s07.Verifier(Path(tmp) / f"verify-{asker}-{name}", capsulectl)
                e, at = s07.judge_ask(d, adv, nodes[asker]["key_id"], [x for x in events if x["ask"] == "history_card"],
                                      verdict, verifier, not_checked, mailbox=True)
                errs += e
                bundle = load(d / "outcome.bundle.json")
                st = (s07.disclosed(bundle, bundle["root"]) or {}).get("statement", {})
                if not errs and (at is None or st.get("outcome") != "artifact"):
                    errs.append(f"history_card: answered {st.get('outcome')}, not with the artifact the advertised policy "
                                "gives a stranger")
            failures += [f"{asker} asked {name}: {e}" for e in errs]
            proof += [f"{asker}/asks/{name}/history_card/{f.name}" for f in sorted(d.iterdir()) if f.is_file()]
            proof.append(f"{asker}/asks/{name}/carrier.jsonl")
            probed += 1
        if probed == 0:
            failures.append(f"{name}: no stranger probed it")
        lines.append(f"{name}: joined as {joined['key_id'][:12]} (loop_join's commitment and its join record verify), the "
                     f"commitment it is asked through names no controller binding (optional, u137), history_card/1 "
                     f"probed by {probed} stranger(s)"
                     + (f"; its stapled history_card/1 verifies with capsule-cli {staple_verify.pinned_version()}"
                        if signed_state == "PASS" else ""))
    if not nodes:
        failures.append("the asks session joined no nodes")
    return failures, not_checked, list(dict.fromkeys(proof)), lines


def goose_not_checked(pop, out, started):
    """The NOT_CHECKED finding when the run or the host lacks what step 12 reads on the Goose rehearsal, else None."""
    asks = (pop["goose"].get("asks") or {}).get("run")
    want = finding.pins()["goose-g1"][1]
    cap = tools()
    if not asks or not Path(asks, "nodes.json").is_file():
        why = "the run wrote no asks session, so no Goose node's join or probe was kept"
    elif not cap.is_file():
        why = f"{cap} is not installed"
    elif pop["goose"]["rev"] != want:
        why = f"installed goose-g1 {pop['goose']['rev']}, versions.lock pins {want}"
    else:
        return None
    finding.write(out, result="NOT_CHECKED", population=pop["population"], asserts=GOOSE_ASSERTS, pinned=GOOSE_PINNED,
                  proof=[], detail=f"not checked: {why}", started=started,
                  not_checked=[{"what": "the Goose nodes' join and a stranger's probe", "why": why,
                                "issue": "evidence-network/loop: steps/goose.setup.sh, steps/12-join.setup.sh"}])
    return True


def backend(pop):
    """The probe backend is the population's choice: `probe` in population.json, else by population."""
    return pop.get("probe") or ("goose" if pop.get("goose") and pop["population"] != "live"
                                else "reporter" if pop["population"] == "live" else "doctor")


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.strip().splitlines()[0])
    ap.add_argument("--population", required=True, type=Path)
    ap.add_argument("--out", required=True, type=Path)
    ap.add_argument("--console", default=os.environ.get("LOOP_CONSOLE", daily_report.DEFAULT_CONSOLE),
                    help="the reporter node's console, for the reporter backend")
    ap.add_argument("--self-node", default=os.environ.get("LOOP_SELF_NODE") or None,
                    help="the population node whose console --console is; it is asked through --second-console")
    ap.add_argument("--second-console", default=os.environ.get("LOOP_SECOND_CONSOLE") or None,
                    help="another node's console, to ask the self node through")
    ap.add_argument("--node-console", action="append", default=[], metavar="NAME=URL",
                    help="a population node's own console, to read its doctor (repeatable; "
                         "or LOOP_NODE_CONSOLES=NAME=URL,...)")
    a = ap.parse_args(argv)
    node_consoles = {}
    # The flags come after the environment, so a flag overrides the same name there, as for the other options.
    for item in [x for x in os.environ.get("LOOP_NODE_CONSOLES", "").split(",") if x] + a.node_console:
        n, sep, url = item.partition("=")
        if not sep or not n or not url:
            print(f"12-join: --node-console {item!r} is not NAME=URL", file=sys.stderr)
            return 2
        node_consoles[n] = url.rstrip("/")
    started = finding.now()
    pop = load(a.population / "population.json")
    a.out.mkdir(parents=True, exist_ok=True)
    which = backend(pop)
    if which == "doctor":
        with tempfile.TemporaryDirectory(prefix="12-join-") as tmp:
            failures, not_checked, proof, lines = run_doctor(pop, a.out, tmp)
    elif which == "goose":
        if goose_not_checked(pop, a.out, started):
            return 0
        with tempfile.TemporaryDirectory(prefix="12-join-") as tmp:
            failures, not_checked, proof, lines = run_goose(pop, a.out, tmp)
    elif which == "reporter":
        if a.self_node and a.self_node not in [n["name"] for n in pop["nodes"]]:
            # A misspelt or stale name would quietly ask that node through its own console again.
            print(f"12-join: --self-node {a.self_node!r} is not a node in the population "
                  f"({', '.join(n['name'] for n in pop['nodes'])})", file=sys.stderr)
            return 2
        unknown = sorted(set(node_consoles) - {n["name"] for n in pop["nodes"]})
        if unknown:
            print(f"12-join: --node-console names {', '.join(unknown)}, not nodes in the population "
                  f"({', '.join(n['name'] for n in pop['nodes'])})", file=sys.stderr)
            return 2
        # Collect first (ask each node, keep every reply), then judge only the kept files (loop#188).
        run_reporter(pop, a.out, a.console, self_node=a.self_node, second_console=a.second_console,
                     node_consoles=node_consoles)
        r = judge_live(pop, a.out, started)
        print(f"12-join: {r['result']}: {r['detail']}", file=sys.stderr)
        return 0
    else:
        print(f"12-join: unknown probe backend {which!r}", file=sys.stderr)
        return 2
    r = conclude(a.out, pop["population"], failures, not_checked, proof, lines, started, which)
    print(f"12-join: {r['result']}: {r['detail']}", file=sys.stderr)
    return 0


def decide(work, population, started, pop_dir):
    """Step 08's entry: the finding decided again from the proof files in `work` alone (the doctor backend).

    The nodes are the population's (`pop_dir`/population.json), never the proof's own: a node whose join.sh exit
    code the proof does not keep is a FAIL, as is a population with no nodes. No join.sh is run. It writes
    finding.json and probe/*.verified.json into `work`, so the caller passes a scratch copy.
    """
    work = Path(work)
    capsulectl = tools()
    if not capsulectl.is_file():
        raise SystemExit(f"12-join: no capsulectl at {capsulectl}; run steps/12-join.setup.sh")
    names = [n["name"] for n in load(Path(pop_dir) / "population.json")["nodes"]]
    with tempfile.TemporaryDirectory(prefix="12-join-") as tmp:
        failures, not_checked, proof, lines = decide_nodes(work, names, capsulectl, tmp)
    if not names:
        failures.append("the population lists no nodes, so nothing was joined")
    return conclude(work, population, failures, not_checked, proof, lines, started, "doctor")


def conclude(out, population, failures, not_checked, proof, lines, started, which="doctor"):
    """Write the finding: FAIL if a checked part did not hold, else NOT_CHECKED while any part is unchecked."""
    result = "FAIL" if failures else ("NOT_CHECKED" if not_checked else "PASS")
    pinned = (PINNED if which == "doctor" else GOOSE_PINNED if which == "goose"
              else ["capsules", "mesh-llm", *finding.mesh_pr_pins(), "reporter", "aac-go", "capsule-cli"])
    shown = (failures + [x for x in lines if f": {CHANGED}: " in x]) if failures else lines
    detail = f"probe backend: {which}. " + "; ".join(shown) + "."
    return finding.write(out, result=result, population=population, asserts=GOOSE_ASSERTS if which == "goose" else ASSERTS,
                         pinned=pinned, proof=proof, detail=detail,
                         not_checked=not_checked, started=started)


if __name__ == "__main__":
    sys.exit(main())
