def tools():
    """The capsulectl core binary steps/12-join.setup.sh installed (or $CAPSULECTL)."""
    if os.environ.get("CAPSULECTL"):
        return Path(os.environ["CAPSULECTL"])
    return Path(os.environ.get("LOOP_TOOLS", Path.home() / ".cache/evidence-network-loop")) / "bin/capsulectl"


def sha256(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def load(path):
    return json.loads(Path(path).read_text(encoding="utf-8"))


# --- The commitment: the one place this step reads it ----------------------
# join.sh writes it in step 03's format (steps/03-advertise.md); its checkpoint
# member carries the book's checkpoint attestation whole: {book_id,
# checkpoint_key, statement}.
def advertised(node_dir):
    c = load(Path(node_dir) / "commitment.json")
    attestation = json.loads(base64.b64decode(c["checkpoint"]["bytes"]))
    return {"node_key": c["key_id"], "checkpoint_key": attestation["checkpoint_key"],
            "book_id": attestation["book_id"], "policy_digest": c["lcap"]["policy_digest"],
            "policy_uri": c["lcap"]["policy_uri"], "subjects": c["answers"]["subjects"],
            "derivations": c["answers"]["derivations"]}


def check_commitment(node_dir):
    """The commitment verifies with step 03's checker, its policy fetched beside it. Returns what did not."""
    try:
        doc = load(Path(node_dir) / "commitment.json")
    except (OSError, ValueError) as e:
        return [f"the commitment is not readable JSON ({e})"]
    errs, notes = check_commitment_.verify(doc, check_commitment_.file_fetcher(node_dir))
    return [f"the commitment does not verify: {e}" for e in errs + notes]


def check_doctor(node_dir, adv):
    """What capsulectl book doctor --probe found. Returns what did not hold."""
    node_dir = Path(node_dir)
    try:
        found = {f["check"]: f for f in load(node_dir / "doctor.json")["findings"]}
    except (OSError, ValueError, KeyError, TypeError) as e:
        return [f"doctor.json is not capsulectl book doctor's findings ({e})"]
    errs = []
    for check in DOCTOR_PROBES:
        f = found.get(check, {})
        if f.get("state") != "match":
            errs.append(f"doctor --probe {check}: {f.get('state', 'absent')} ({f.get('detail', 'no finding')})")
    binding = load(node_dir / "controller.json")["binding_digest"]
    if binding not in found.get("controller_binding", {}).get("records", []):
        errs.append(f"doctor does not list the controller binding {binding} as naming the node key")
    if found.get("checkpoint", {}).get("state") != "present":
        errs.append(f"doctor finds no checkpoint over the book: {found.get('checkpoint')}")
    return errs


def check_policy_match(node_dir, adv):
    """The answers match the advertised policy. Returns a list of what did not."""
    node_dir = Path(node_dir)
    errs = []
    published = node_dir / adv["policy_uri"]
    try:
        signed = load(published) if sha256(published) == adv["policy_digest"] else None
    except (OSError, ValueError):
        signed = None
    if signed is None or signed.get("policy") != load(node_dir / "policy.json"):
        errs.append("the node answers under a policy that is not the one it advertises")
    for probe in PROBES:
        req = load(node_dir / "probe" / f"{probe}.request.json")
        ans = load(node_dir / "probe" / f"{probe}.answer.json")
        asked = "+".join([*req["subject"], *([req["derivation"]] if "derivation" in req else [])])
        if not all(s in adv["subjects"] for s in req["subject"]) or \
                ("derivation" in req and req["derivation"] not in adv["derivations"]):
            errs.append(f"{asked} is not among the subjects and derivations the node advertises")
        if "artifact" not in ans or "reason" in ans:
            errs.append(f"{asked} is refused ({ans.get('reason', 'no artifact')}), "
                        "but the advertised policy answers it to anyone")
            continue
        if ans.get("subject") != req["subject"] or ans.get("derivation") != req.get("derivation"):
            errs.append(f"the answer to {asked} is for another subject or derivation")
    return errs


def verify_answers(node_dir, adv, capsulectl, work):
    """Each probe answer verifies under the advertised keys, by the pinned capsulectl-book.

    The stranger's book is copied into `work` and its profile made again
    there, so the proof bytes are never written to. Writes
    probe/<probe>.verified.json (the verifier's output) and returns a list of
    what did not verify.
    """
    node_dir, work = Path(node_dir), Path(work)
    st = node_dir / "probe" / "stranger"
    home = work / "stranger"
    shutil.copytree(st, home)
    for seed in home.glob("*.seed"):
        seed.chmod(0o600)
    env = dict(os.environ, XDG_CONFIG_HOME=str(home / "config"),
               CAPSULECTL_PLUGIN_ROOTS=os.environ.get("CAPSULECTL_PLUGIN_ROOTS", str(Path(capsulectl).parent)))
    prof = load(home / "profile.json")

    def cap(*args):
        return subprocess.run([str(capsulectl), *args], env=env, capture_output=True, text=True)

    r = cap("profile", "create", "--name", "stranger", "--type", "jsonl", "--jsonl-path", str(home / "store"),
            "--log-id", prof["log_id"], "--operator", prof["operator"],
            "--trusted-key", load(home / "signing.json")["public_key"],
            "--signing-key-file", str(home / "signing.seed"),
            "--checkpoint-signing-key-file", str(home / "checkpoint.seed"),
            "--checkpoint-trusted-key", load(home / "checkpoint.json")["public_key"])
    if r.returncode == 0:
        r = cap("store", "init", "--profile", "stranger")
    if r.returncode != 0:
        raise RuntimeError(f"could not make the stranger's profile again: {r.stderr.strip()}")
    errs = []
    for probe in PROBES:
        rid = load(node_dir / "probe" / f"{probe}.asked.json")["record_id"]
        r = cap("book", "request", "--profile", "stranger", "--for", rid,
                "--response", str(node_dir / "probe" / f"{probe}.answer.json"),
                "--responder-key", adv["node_key"], "--responder-checkpoint-key", adv["checkpoint_key"])
        out = r.stdout.strip().splitlines()[-1] if r.stdout.strip() else ""
        try:
            verdict = json.loads(out) if out else {}
        except ValueError:
            verdict = {}
        verdict.pop("response", None)
        verdict.pop("output", None)
        record = {"verifier": "capsulectl book request --for --response", "exit": r.returncode,
                  "result": verdict, "refused": r.stderr.strip().splitlines()[0] if r.returncode else ""}
        (node_dir / "probe" / f"{probe}.verified.json").write_text(json.dumps(record, indent=2, sort_keys=True) + "\n")
        if r.returncode != 0 or verdict.get("outcome") != "artifact":
            errs.append(f"the {probe} answer does not verify under the advertised node and checkpoint keys: "
                        f"{record['refused'] or verdict}")
    return errs


def judge(node_dir, capsulectl, work):
    """(failures, not_checked, proof paths relative to node_dir) for one joined node."""
    node_dir = Path(node_dir)
    errs = check_commitment(node_dir)
    try:
        adv = advertised(node_dir)
    except (OSError, ValueError, KeyError, TypeError) as e:
        return errs + [f"the commitment does not advertise the node's keys and policy ({e})"], [], list(PROOF)
    errs += check_doctor(node_dir, adv)
    errs += check_policy_match(node_dir, adv)
    errs += verify_answers(node_dir, adv, capsulectl, work)
    not_checked = []
    proof = list(PROOF)
    for probe in PROBES:
        proof += [f"probe/{probe}.{k}.json" for k in ("request", "asked", "answer", "verified")]
    return errs, not_checked, proof


def make_test_controller_key(path):
    """The rehearsal population has no controller keys: a test key made for this run."""
    subprocess.run(["openssl", "genpkey", "-algorithm", "ed25519", "-out", str(path)], check=True,
                   capture_output=True)


def merge(into, items):
    for item in items:
        if item not in into:
            into.append(item)


# --- Probe backend "doctor": join.sh on this machine, then the stranger probe --
def run_doctor(pop, out, tmp):
    """Join each node with join.sh and judge what it wrote. Returns (failures, not_checked, proof, lines)."""
    capsulectl = tools()
    if not capsulectl.is_file():
        raise SystemExit(f"12-join: no capsulectl at {capsulectl}; run steps/12-join.setup.sh")
    failures, not_checked, proof, lines = [], [], [], []
    for node in pop["nodes"]:
        name = node["name"]
        key_dir = ROOT / node["key_dir"]  # relative to the repository root, as population.json gives it
        controller = key_dir / "controller-key.pem"
        if not controller.is_file():
            controller = Path(tmp) / f"{name}-controller-key.pem"
            make_test_controller_key(controller)
        node_out = out / name
        if node_out.exists():
            shutil.rmtree(node_out)
        env = dict(os.environ, CAPSULECTL=str(capsulectl))
        r = subprocess.run([str(ROOT / "join.sh"), "--name", name, "--node-key", str(key_dir / "node-key.pem"),
                            "--controller-key", str(controller), "--out", str(node_out),
                            "--home", str(Path(tmp) / f"{name}-home")],
                           env=env, capture_output=True, text=True)
        (out / f"{name}.join.log").write_text(r.stdout + r.stderr)
        proof.append(f"{name}.join.log")
        if r.returncode != 0:
            failures.append(f"{name}: join.sh did not complete (exit {r.returncode}); see {name}.join.log")
            continue
        errs, nc, p = judge(node_out, capsulectl, Path(tmp) / f"{name}-verify")
        failures += [f"{name}: {e}" for e in errs]
        merge(not_checked, nc)
        proof += [f"{name}/{x}" for x in p]
        lines.append(f"{name}: joined; the commitment verifies, doctor --probe finds both answers verify and match "
                     "the policy, and the kept answers verify under the advertised keys and match the advertised "
                     "policy" if not errs else f"{name}: {len(errs)} check(s) did not hold")
    return failures, not_checked, proof, lines


# --- Probe backend "reporter": a Mesh node, asked through the daily reporter --
# doctor --probe asks a Go book's own responder in process and cannot reach a
# Mesh plugin node. For those the probe is the daily reporter's ask
# (scripts/daily_report.py, mesh_evidence_request through the reporter node's
# capsules plugin), reused as it is: the plugin verifies each answer under the
# key the node's host announces, and the reporter writes that verdict as a line.
LIVE_NOT_CHECKED = [
    {"what": "a controller binding for a Mesh node's key, recorded by its one command",
     "why": "the pinned capsules plugin's join records none, and its doctor reports the key unbound",
     "issue": "Mesh-LLM/capsules-plugin#54"},
    NO_BINDING_VERIFIER,
    {"what": "the signed join/1 a Mesh node's join switch sends the reporter, which lists the node",
     "why": "the pinned capsules plugin's join checks the node and returns its commitment but sends nothing",
     "issue": AFTER_PIN},
]
NODE_CONSOLE_ISSUE = "evidence-network/loop: lab/lab.sh loop gives each node's console (LOOP_NODE_CONSOLES)"
REPORTER_ASK_ISSUE = "evidence-network/loop: the daily reporter's ask (scripts/daily_report.py)"


def listed_entry(node):
    """A live node's nodes/ entry: node_id, key_id and what it lists as stranger-safe."""
    if "node_id" in node and "key_id" in node:
        return node
    return load(ROOT / "nodes" / f"{node.get('node_id', node['name'])}.json")


def judge_reporter_line(stem, line, entry):
    """(failure or None, not_checked or None) for one reporter verification line."""
    name = daily_report.QUESTION_NAMES[stem]
    state = line.split(" ", 1)[0]
    safe = entry.get("disclosure", {}).get("stranger_safe", list(daily_report.QUESTION_NAMES.values()))
    if state == "verified":
        if "listed_key=match" not in line.split():
            return f"the {name} answer verifies under the announced key, which is not the listed key: {line}", None
        return None, None
    if state in ("refusal", "not_evidence"):
        if state == "refusal" and name not in safe:
            return None, None
        why = ("is refused, but the node lists it as stranger-safe" if state == "refusal"
               else "does not verify under the announced key")
        return f"the {name} answer {why}: {line}", None
    return None, {"what": f"the {name} probe answer", "why": f"the reporter got no verifiable answer: {line}",
                  "issue": REPORTER_ASK_ISSUE}


def said(line):
    """A reporter line's state for detail. A "verified" line reaching detail matched the listed key; the
    finding words it so, as a NOT_CHECKED detail may not claim a check (steps/finding.py)."""
    state = line.split(" ", 1)[0]
    return "answered under the listed key" if state == "verified" else state


def tool(console, route, body, timeout):
    """(reply object or None, the bytes, what went wrong or None) for one plugin tool call."""
    try:
        status, raw = daily_report.http("POST", console + route, body, timeout)
    except OSError as e:
        return None, json.dumps({"error": str(e)}).encode(), f"no reply ({e})"
    if status != 200:
        return None, raw, f"http {status}: {raw.decode('utf-8', 'replace')[:200]}"
    try:
        reply = json.loads(raw)
    except ValueError:
        return None, raw, "the reply is not JSON"
    return (reply, raw, None) if isinstance(reply, dict) else (None, raw, "the reply is not a JSON object")


def judge_doctor(reply):
    """(failures, not_checked) for the plugin's doctor --probe findings."""
    try:
        found = {f["check"]: f for f in reply["findings"]}
    except (KeyError, TypeError):
        return ["doctor's reply carries no findings"], []
    fails, nc = [], []
    for check in DOCTOR_PROBES:
        f = found.get(check, {})
        state = f.get("state", "absent")
        if state == "NOT_CHECKED":
            nc.append({"what": f"doctor --probe {check}", "why": f"the plugin did not run it: {f.get('detail')}",
                       "issue": live.ISSUE})
        elif state != "match":
            fails.append(f"doctor --probe {check}: {state} ({f.get('detail', 'no finding')})")
    pic = found.get("policy_in_commitment", {})
    if pic.get("state") != "present":
        nc.append({"what": "the commitment the node serves on commitment/1, carrying the policy it answers under",
                   "why": f"doctor: {pic.get('state', 'absent')} ({pic.get('detail', 'no finding')})",
                   "issue": live.ISSUE})
    return fails, nc


def judge_join(reply, entry, node_dir):
    """(failures, not_checked) for the plugin's join report; writes the commitment pair it returns."""
    fails, nc = [], []
    pair = reply.get("commitment")
    if not isinstance(pair, dict):
        nc.append({"what": "the commitment join returns", "why": "join returns none (the node serves no "
                   "commitment yet)", "issue": live.ISSUE})
    else:
        try:
            doc, policy = pair["commitment"], base64.b64decode(pair["policy"], validate=True)
        except (KeyError, TypeError, ValueError) as e:
            doc, policy = None, None
            fails.append(f"join's commitment pair is not {{commitment, policy}} ({e})")
        if doc is not None:
            (node_dir / "commitment.json").write_text(json.dumps(doc, indent=2, sort_keys=True) + "\n")
            (node_dir / "disclosure-policy.json").write_bytes(policy)
            errs, notes = check_commitment_.verify(doc, lambda uri: policy)
            fails += [f"join's commitment does not verify: {e}" for e in errs + notes]
            if isinstance(doc, dict) and doc.get("key_id") != entry.get("key_id"):
                fails.append(f"join's commitment is under key {doc.get('key_id')}, not the listed key")
            if isinstance(doc, dict) and doc.get("node_id") != entry.get("node_id"):
                fails.append(f"join's commitment is for node {doc.get('node_id')}, not this node")
    if reply.get("joined") is not True:
        nc.append({"what": "the plugin's join", "why": "join reports pending: " +
                   "; ".join(map(str, reply.get("pending") or ["(no pending list)"])), "issue": live.ISSUE})
    return fails, nc


def check_node_tools(console, entry, node_dir, timeout):
    """(failures, not_checked, proof names in node_dir, line) for doctor --probe and join on the node's console."""
    fails, nc, proof = [], [], []
    for name, route, body, judge in (("doctor", DOCTOR_ROUTE, {"probe": True}, judge_doctor),
                                     ("join", JOIN_ROUTE, {}, None)):
        reply, raw, err = tool(console, route, body, timeout)
        (node_dir / f"{name}.json").write_bytes(raw)
        proof.append(f"{name}.json")
        if err:
            nc.append({"what": f"the plugin's {name} on the node's console", "why": err, "issue": live.ISSUE})
            continue
        f, n = judge(reply) if judge else judge_join(reply, entry, node_dir)
        fails += f
        nc += n
    proof += [p for p in ("commitment.json", "disclosure-policy.json") if (node_dir / p).is_file()]
    line = ("doctor --probe: both probes match; join: joined, its commitment holds under the listed key"
            if not fails and not nc else f"doctor and join: {len(fails)} failure(s), {len(nc)} part(s) not checked")
    return fails, nc, proof, line


NO_SECOND_CONSOLE_ISSUE = "evidence-network/loop: step 12 asks the reporter's own node through a second console"


def no_second_console(name):
    return {"what": f"{name}: the probe of the reporter's own node",
            "why": "a node can't be asked through its own console, and no second node's console was given "
                   "(--second-console, or LOOP_SECOND_CONSOLE)",
            "issue": NO_SECOND_CONSOLE_ISSUE}


def run_reporter(pop, out, console, timeout=30, self_node=None, second_console=None, node_consoles=None):
    failures, not_checked, proof, lines = [], list(LIVE_NOT_CHECKED), [], []
    node_consoles = node_consoles or {}
    at = daily_report.utc_now()
    for node in pop["nodes"]:
        name = node["name"]
        asker, via = console, "the reporter's console"
        if self_node and name == self_node:
            if not second_console:
                merge(not_checked, [no_second_console(name)])
                lines.append(f"{name}: not asked, the reporter's own node and no second console")
                continue
            asker, via = second_console, "a second node's console"
        try:
            entry = listed_entry(node)
        except FileNotFoundError:
            merge(not_checked, [{"what": f"live node {name}", "why": "node_id not set, or no nodes/<node_id>.json",
                                 "issue": "evidence-network/loop: the live lab run, which fills population/live"}])
            lines.append(f"{name}: not asked, no nodes/ entry")
            continue
        node_dir = out / name
        if node_dir.exists():
            shutil.rmtree(node_dir)
        node_dir.mkdir(parents=True)
        result = daily_report.ask_attempt(asker, entry, node_dir, list(daily_report.QUESTIONS), at, "by=ask",
                                          timeout)
        attempt = layout.attempts(node_dir)[-1]
        proof += [str(f.relative_to(out)) for f in sorted(attempt.iterdir()) if f.is_file()]
        bad = []
        for stem, line in result.items():
            fail, nc = judge_reporter_line(stem, line, entry)
            if fail:
                bad.append(f"{name}: {fail}")
            if nc:
                merge(not_checked, [{**nc, "what": f"{name}: {nc['what']}"}])
        failures += bad
        asked = f" (asked through {via})" if self_node else ""
        line = f"{name}{asked}: " + "; ".join(f"{daily_report.QUESTION_NAMES[k]} {said(v)}" for k, v in result.items())
        own = node_consoles.get(name)
        if own:
            fails, nc, files, said_tools = check_node_tools(own, entry, node_dir, timeout)
            failures += [f"{name}: {f}" for f in fails]
            merge(not_checked, [{**n, "what": f"{name}: {n['what']}"} for n in nc])
            proof += [f"{name}/{f}" for f in files]
            line += f"; {said_tools}"
        else:
            merge(not_checked, [{"what": f"{name}: the plugin's doctor --probe and join on the node",
                                 "why": "no console was given for the node (--node-consoles, or LOOP_NODE_CONSOLES)",
                                 "issue": NODE_CONSOLE_ISSUE}])
        lines.append(line)
    return failures, not_checked, proof, lines


def backend(pop):
    """The probe backend is the population's choice: `probe` in population.json, else by population."""
    return pop.get("probe") or ("reporter" if pop["population"] == "live" else "doctor")


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.strip().splitlines()[0])
    ap.add_argument("--population", required=True, type=Path)
    ap.add_argument("--out", required=True, type=Path)
    ap.add_argument("--console", default=os.environ.get("LOOP_CONSOLE", daily_report.DEFAULT_CONSOLE),
                    help="the reporter node's console, for the reporter backend")
    ap.add_argument("--self-node", default=os.environ.get("LOOP_SELF_NODE") or None,
                    help="the population node whose console --console is; it is asked through --second-console")
    ap.add_argument("--second-console", default=os.environ.get("LOOP_SECOND_CONSOLE") or None,
                    help="another node's console, to ask the self node through")
    ap.add_argument("--node-consoles", default=os.environ.get("LOOP_NODE_CONSOLES") or "{}",
                    help='each node\'s own console, for its doctor and join: JSON {"<node name>": "<url>"}')
    a = ap.parse_args(argv)
    started = finding.now()
    pop = load(a.population / "population.json")
    a.out.mkdir(parents=True, exist_ok=True)
    which = backend(pop)
    if which == "doctor":
        with tempfile.TemporaryDirectory(prefix="12-join-") as tmp:
            failures, not_checked, proof, lines = run_doctor(pop, a.out, tmp)
    elif which == "reporter":
        if a.self_node and a.self_node not in [n["name"] for n in pop["nodes"]]:
            # A misspelt or stale name would quietly ask that node through its own console again.
            print(f"12-join: --self-node {a.self_node!r} is not a node in the population "
                  f"({', '.join(n['name'] for n in pop['nodes'])})", file=sys.stderr)
            return 2
        try:
            node_consoles = json.loads(a.node_consoles)
            if not (isinstance(node_consoles, dict) and all(isinstance(v, str) for v in node_consoles.values())):
                raise ValueError("not an object of strings")
        except ValueError as e:
            print(f"12-join: --node-consoles is JSON {{\"<node name>\": \"<url>\"}} ({e})", file=sys.stderr)
            return 2
        failures, not_checked, proof, lines = run_reporter(pop, a.out, a.console, self_node=a.self_node,
                                                           second_console=a.second_console,
                                                           node_consoles=node_consoles)
    else:
        print(f"12-join: unknown probe backend {which!r}", file=sys.stderr)
        return 2
    r = conclude(a.out, pop["population"], failures, not_checked, proof, lines, started, which)
    print(f"12-join: {r['result']}: {r['detail']}", file=sys.stderr)
    return 0


def conclude(out, population, failures, not_checked, proof, lines, started, which="doctor"):
    """Write the finding: FAIL if a checked part did not hold, else NOT_CHECKED while any part is unchecked."""
    result = "FAIL" if failures else ("NOT_CHECKED" if not_checked else "PASS")
    pinned = PINNED if which == "doctor" else ["capsules", "mesh-llm", "mesh-llm-pr-2620", "reporter"]
    detail = f"probe backend: {which}. " + "; ".join(failures or lines) + "."
    if result == "PASS":  # a PASS covers its assertion; the binding's own verification is outside it
        detail += " " + BINDING_OUTSIDE
    return finding.write(out, result=result, population=population, asserts=ASSERTS, pinned=pinned, proof=proof,
                         detail=detail,
                         not_checked=not_checked, started=started)


if __name__ == "__main__":
    sys.exit(main())
