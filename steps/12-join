def binding_check(name, raw, digest, key, at, from_main=None):
    """(state, detail) of the Go verifier on the binding text `raw`, which must have `digest`, name `key` and apply
    at `at` (YYYY-MM-DDTHH:MM:SSZ). state: "ok"; "bad" (it does not apply, does not name the key, or names it as the
    delegator of a delegated_by binding); "unread" (it
    is not the binding `digest` names); "unsupported" (a method or key type the verifier lacks); "open" (it applies,
    but revocation is NOT_CHECKED: the verifier rejected the run's declaration). The revocation statements published for
    `digest` (nodes/revocations/) go to the verifier, declared complete as of `at` (CB-1 option A): one that applies
    at `at` makes it "bad", and with none that applies it is "ok" (revocation PASS on that snapshot). A live run
    passes `from_main`, the bv.snapshot of origin/main at `at`, and reads the file at that commit; a rehearsal reads
    its own checkout's fixtures."""
    no_list = None
    try:
        if from_main is not None:
            commit, text = bv.main_list(revocations_root(), digest, from_main)
            where = f"nodes/{bv.REVOCATIONS}/ at main {commit}"
        else:
            text, where = bv.checkout_list(nodes_dir(), digest), f"nodes/{bv.REVOCATIONS}/ in this checkout"
        listing = bv.revocation_list(digest, text, at, f"evidence-network/loop step 12 (checking at {at}), {where}")
    except LookupError as e:  # no main to read the merged list from: no declaration, so revocation stays open
        listing, no_list = None, str(e)
    except ValueError as e:  # a malformed nodes/revocations/<digest>.json: fail closed, with a verdict
        return "bad", f"{name}'s binding {digest}: the published revocation statements are unreadable ({e})"
    try:
        verdict, report, err, code = bv.verify(cross_language(), raw, key, [at], listing)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise SystemExit(f"12-join: cross_language binding did not run ({e}); run steps/01-seal.setup.sh")
    if verdict is None:
        raise SystemExit(f"12-join: cross_language binding exited {code} ({err}); run steps/01-seal.setup.sh")
    if not report.get("binding_digest"):
        return "unread", f"the verifier gave no report on {name}'s binding record"
    if report.get("binding_digest") != digest:
        return "unread", f"{name}'s binding is {report.get('binding_digest')}, not the {digest} it is held as"
    props = report.get("properties") or {}
    keys = report.get("keys") or []
    if verdict == "bad":
        why = ("does not name the node's key" if key not in keys else
               ", ".join(f"{k} {s}" for k, s in sorted(props.items()) if s == "FAIL"))
        return "bad", f"{name}'s binding {digest} does not apply: {why}"
    if report.get("claim") == DELEGATED_BY and report.get("delegator") == key:
        return "bad", (f"{name}'s binding {digest} names the node key as the delegator: it says the node delegated "
                       "to the other key, not that the node key is its controller's delegate (AAC#468)")
    if verdict == "unsupported":
        return "unsupported", (f"{name}'s binding {digest}: "
                               f"{', '.join(f'{k} {s}' for k, s in sorted(props.items()) if s == 'NOT_CHECKED')}")
    role = "as the delegate" if report.get("claim") == DELEGATED_BY else f"({report.get('claim')}: no role)"
    revoked, said = bv.revocation(report)
    if no_list:
        said += f": {no_list}"
    return "ok" if revoked == "PASS" else "open", (
        f"{name}'s binding {digest} names the node key {role} and applies at {at} (form, both signatures and "
        f"window PASS, {said})")


def revocation_open(detail):
    """The not_checked entry for a binding that applies with revocation NOT_CHECKED (binding_check's "open")."""
    return {**BINDING_REVOCATION, "why": f"{BINDING_REVOCATION['why']}: {detail}"}


def binding_unchecked(state, detail):
    """The not_checked entry for a binding_check state that is unread or unsupported, None for the others (ok,
    open and bad: revocation_open names open)."""
    why = {"unread": "its record could not be read as the held binding", "unsupported": "the verifier lacks its method or key type"}.get(state)
    issue = live.ISSUE if state == "unread" else bv.UNSUPPORTED_METHOD_ISSUE
    return {"what": "the controller binding record, checked by a second verifier", "why": f"{why}: {detail}",
            "issue": issue} if why else None


