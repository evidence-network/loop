PKCS8_ED25519 = bytes.fromhex("302e020100300506032b657004220420")


def capsulectl():
    """(capsulectl, [{what, why, issue}] for each tool missing or not at its pin)."""
    tools = Path(os.environ.get("LOOP_TOOLS", Path.home() / ".cache" / "evidence-network-loop"))
    cap = Path(os.environ.get("CAPSULECTL") or tools / "bin" / "capsulectl")
    plugins = Path(os.environ.get("CAPSULECTL_PLUGIN_ROOTS") or cap.parent)
    missing = []
    for name, binary in (("capsulectl", cap), ("capsulectl-book", plugins / "capsulectl-book")):
        want = finding.pins()[name][1].rsplit("/", 1)[-1]
        if not (binary.is_file() and os.access(binary, os.X_OK)):
            missing.append({"what": name, "why": f"{binary} is not installed", "issue": LIVE_SETUP})
            continue
        got = built_from(binary) if name == "capsulectl" else \
            (subprocess.run([str(binary), "--version"], capture_output=True, text=True).stdout.split()
             + ["", "unreadable"])[1]
        if got != want:
            missing.append({"what": name, "why": f"installed {got}, versions.lock pins {want}", "issue": LIVE_SETUP})
    return cap, missing


def built_from(core):
    """The evidencebook tag the capsulectl core was built from, per the stamp steps/12-join.setup.sh writes.

    The core reports its own (capsule-cli) version; the stamp names the tag whose
    capsulectl/go.mod chose it: `<repository> <tag> <commit>`.
    """
    try:
        return (core.parent / "capsulectl.built-from").read_text().split()[1]
    except (OSError, IndexError):
        return "unstamped"


def jcs(obj):
    """RFC 8785 for a book header: strings, integers, arrays and objects only."""
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()


def seed_of(pem):
    """The 32-byte seed of an Ed25519 PKCS#8 PEM key, as the hex seed file capsulectl reads."""
    der = base64.b64decode("".join(ln for ln in Path(pem).read_text().splitlines() if not ln.startswith("-----")))
    if len(der) != 48 or not der.startswith(PKCS8_ED25519):
        raise ValueError(f"{pem}: not an Ed25519 PKCS#8 private key")
    return der[16:].hex()


def profile_fields(text):
    """A capsulectl profile YAML as {dotted key: value or [items]}: the keys this step reads."""
    out, stack = {}, []
    for line in text.splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        indent, body = len(line) - len(line.lstrip()), line.strip()
        if body.startswith("- "):
            key = ".".join(k for _, k in stack)
            out.setdefault(key, [])
            if isinstance(out[key], list):
                out[key].append(body[2:].strip().strip('"'))
            continue
        while stack and stack[-1][0] >= indent:
            stack.pop()
        key, _, value = body.partition(":")
        stack.append((indent, key.strip()))
        if value.strip():
            out[".".join(k for _, k in stack)] = value.strip().strip('"')
    return out


def book_profile(book_dir):
    """The profile join.sh made for the book under book_dir: the one under its config whose
    store (connection.database) is book_dir/book. join.sh names it after its --name (lab/lab.sh
    passes lab-N), not after the operator's label in population.json. None when there is none."""
    want = (book_dir / "book").resolve()
    for p in sorted((book_dir / "config" / "capsule" / "profiles").glob("*.yaml")):
        try:
            f = profile_fields(p.read_text())
        except OSError:
            continue
        if f.get("connection.database") and Path(f["connection.database"]).resolve() == want:
            return {"trusted_keys": f.get("trusted_keys") or [],
                    "endpoint": f.get("checkpoint.endpoint", ""), "public_key": f.get("checkpoint.public_key", "")}
    return None


def spki_hex(pem):
    """The raw Ed25519 public key of an SPKI PEM as hex, or None."""
    try:
        der = base64.b64decode("".join(ln for ln in Path(pem).read_text().splitlines() if not ln.startswith("-----")))
    except (OSError, ValueError):
        return None
    return der[12:].hex() if len(der) == 44 and der.startswith(SPKI_ED25519) else None


def cbor(data, i=0):
    """One CBOR item at data[i]: (value, next index). Enough for a COSE receipt's headers."""
    major, info = data[i] >> 5, data[i] & 31
    i += 1
    if info < 24:
        n = info
    elif info <= 27:
        size = 1 << (info - 24)
        n, i = int.from_bytes(data[i:i + size], "big"), i + size
    else:
        raise ValueError("indefinite or reserved CBOR length")
    if major == 0:
        return n, i
    if major == 1:
        return -1 - n, i
    if major in (2, 3):
        v = bytes(data[i:i + n])
        return (v if major == 2 else v.decode()), i + n
    if major == 4:
        items = []
        for _ in range(n):
            v, i = cbor(data, i)
            items.append(v)
        return items, i
    if major == 5:
        m = {}
        for _ in range(n):
            k, i = cbor(data, i)
            m[k], i = cbor(data, i)
        return m, i
    if major == 6:
        return cbor(data, i)
    return {20: False, 21: True, 22: None}.get(n), i


def receipt_header(receipt):
    """(key id hex or None, signing time as unix seconds or None) from a COSE receipt's protected header."""
    msg, _ = cbor(receipt)
    protected = cbor(msg[0])[0] if msg[0] else {}
    kid, claims = protected.get(4), protected.get(15)
    iat = claims.get(6) if isinstance(claims, dict) else None
    return (kid.hex() if isinstance(kid, bytes) else None), (iat if isinstance(iat, int) else None)


def listing():
    """The lab test witness listing: its entries, [] when it is missing or unreadable."""
    try:
        return [e for e in json.loads(LISTING.read_text()).get("witnesses", []) if isinstance(e, dict)]
    except (OSError, ValueError, AttributeError):
        return []


def utc_seconds(text):
    return int(datetime.fromisoformat(str(text).replace("Z", "+00:00")).timestamp())


def witness_checks(status_rc, status, profile_key, node_keys, entries=None):
    """The checks on the receipt the book stored for its checkpoint: {name: {ok, detail}}. `entries` is the witness
    listing's entries (the repository's, listing(), unless given)."""
    receipt = base64.b64decode(((status or {}).get("receipt") or {}).get("Bytes") or "")
    kid, iat = receipt_header(receipt)
    entries = listing() if entries is None else entries
    entry = next((e for e in entries if e.get("key_id") == kid), None)
    when = datetime.fromtimestamp(iat, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ") if iat is not None else None
    checks = {"witness_listed": {"ok": entry is not None,
                                 "detail": f"receipt key id {kid}; the lab test witness listing has "
                                           f"{[e.get('key_id') for e in entries]}"},
              "witness_not_node": {"ok": kid is not None and kid not in node_keys,
                                   "detail": f"receipt key id {kid}; " + ("a node's own key" if kid in node_keys
                                                                         else "not a key of any node it witnesses")}}
    try:
        ok = entry is not None and iat is not None and iat >= utc_seconds(entry.get("not_before"))
    except (TypeError, ValueError):
        ok = False
    checks["witness_not_before"] = {"ok": ok, "detail": f"signed at {when}; the entry's not_before "
                                                        f"{entry.get('not_before') if entry else None}"}
    ok = status_rc == 0 and (status or {}).get("state") == "verified" and kid == profile_key
    checks["witness_receipt"] = {"ok": ok, "detail": f"capsulectl cll checkpoint status exit {status_rc}, state "
                                                     f"{(status or {}).get('state')}, under the book's witness key "
                                                     f"{profile_key}; receipt key id {kid}"}
    return checks


def live_book(cap, name, data_dir, book_dir, profile, node_keys, out, work, time):
    """Append one record to the node's book, then deliver its checkpoint to the book's witness, and keep what the
    judge reads (inputs.json beside the proof files); judge_book judges those files."""
    out.mkdir(parents=True, exist_ok=True)
    work.mkdir(mode=0o700, parents=True)
    env = dict(os.environ, XDG_CONFIG_HOME=str(work / "config"),
               CAPSULECTL_PLUGIN_ROOTS=os.environ.get("CAPSULECTL_PLUGIN_ROOTS", str(cap.parent)))
    if os.environ.get("LOOP_WITNESS_CA"):
        # The lab test witness serves HTTPS on loopback under its own certificate (lab/lab.sh witness).
        env["SSL_CERT_FILE"] = os.environ["LOOP_WITNESS_CA"]
    done = []
    # receipt_check: this run holds each receipt offline (loop#219); a run before it has none, and its receipt is
    # judged as it was then, on capsulectl's status alone.
    inputs = {"node": name, "node_keys": sorted(node_keys), "receipt_check": RECEIPT_CHECK}

    def cap_run(stem, *args, save=None):
        r = subprocess.run([str(cap), *map(str, args)], capture_output=True, text=True, env=env)
        if save:
            (out / save).write_text(r.stdout)
        if r.returncode != 0:
            (out / f"{stem}.stderr.txt").write_text(r.stderr)
            if stem not in ("publish", "status"):
                raise RuntimeError(stem)
        return r

    def keep(**more):
        inputs.update(more, done=done)
        (out / INPUTS_FILE).write_text(json.dumps(inputs, indent=2, sort_keys=True) + "\n")

    try:
        # The node key's seed, for this run only: capsulectl reads a key from a 0600 file.
        seed = work / "node.seed"
        fd = os.open(seed, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(seed_of(data_dir / "keys" / "node-key.pem") + "\n")
        node_pub = json.loads(cap_run("key", "key", "show-public", seed).stdout)["public_key"]
        cp_pub = json.loads(cap_run("key", "key", "show-public", book_dir / "checkpoint.seed").stdout)["public_key"]
        records = book_dir / "book" / "book" / "records"
        first = json.loads((records / "checkpoints.jsonl").read_text().splitlines()[0])
        book_id, book_key = first["log_id"], first["key_id"]
        bound = profile["trusted_keys"]
        inputs.update(node_pub=node_pub, checkpoint_pub=cp_pub, book_id=book_id, book_key=book_key, bound=bound,
                      witness={"endpoint": bool(profile["endpoint"]), "public_key": profile["public_key"]})
        # The book's witness, as its profile names it: the step delivers this run's checkpoint there.
        witness = (["--checkpoint-endpoint", profile["endpoint"], "--checkpoint-public-key", profile["public_key"]]
                   if profile["endpoint"] else [])
        cap_run("profile", "profile", "create", "--name", name, "--type", "jsonl", "--jsonl-path", book_dir / "book",
                "--log-id", book_id, "--operator", name, "--trusted-key", node_pub, "--signing-key-file", seed,
                "--checkpoint-signing-key-file", book_dir / "checkpoint.seed", "--checkpoint-trusted-key", cp_pub,
                *witness)
        request = work / "request.json"
        request.write_text(json.dumps({
            "spec_version": "capsule-seal-request/v1",
            "capsule": {"ActionID": f"{name}-loop-02-{time}", "ActionType": "fyi", "Operator": name,
                        "Developer": "loop-step-02", "Timestamp": time},
            "payload": {"loop": "step 02 book", "at": time}}))
        cap_run("seal", "seal", "--profile", name, "--request", request, "--output", out / "capsule.json")
        done.append("capsule.json")
        capsule_id = json.loads((out / "capsule.json").read_text())["capsule_id"]
        appended = json.loads(cap_run("append", "cll", "append", "--profile", name, "--capsule",
                                      out / "capsule.json", save="append.json").stdout)
        if not isinstance(appended, dict):
            raise ValueError("capsulectl cll append printed no JSON object")
        done.append("append.json")
        size = json.loads(cap_run("checkpoint", "cll", "checkpoint", "create", "--profile", name,
                                  save="checkpoint.json").stdout)["checkpoint"]
        done.append("checkpoint.json")
        cap_run("bundle", "book", "bundle", "--profile", name, "--root", capsule_id, "--out", out / "bundle.json")
        done.append("bundle.json")
    except RuntimeError as e:
        return keep(failed={"stage": str(e)})
    except (OSError, ValueError, KeyError, IndexError) as e:
        (out / "input.stderr.txt").write_text(f"{e}\n")
        return keep(failed={"stage": "input", "error": str(e)})

    # The book record that carries the appended capsule.
    line = next((ln for ln in (records / "records.jsonl").read_text().splitlines()
                 if json.loads(ln)["header"].get("subject_ref") == capsule_id), None)
    (out / "book-record.json").write_text((line or "null") + "\n")
    witnessed = {}
    if profile["endpoint"]:
        # Deliver this run's checkpoint to the book's witness; the book keeps the receipt it gets.
        published = cap_run("publish", "cll", "checkpoint", "publish", "--profile", name, "--checkpoint", size,
                            save="publish.json")
        witnessed.update(publish_rc=published.returncode,
                         publish_reason=(published.stderr.strip().splitlines() or [None])[-1])
        try:
            state = json.loads(published.stdout)
        except ValueError:
            state = {}
        if state.get("receipt"):
            # Re-verified from the receipt the book stored, offline, by the pinned capsulectl.
            r = cap_run("status", "cll", "checkpoint", "status", "--profile", name, "--checkpoint", size,
                        save="witness-status.json")
            witnessed.update(status_rc=r.returncode)
    return keep(capsule_id=capsule_id, checkpoint=size, **witnessed)


# What the live judge reads beside the proof files, so step 08 runs it again on the proof alone (loop#188).
INPUTS_FILE = "inputs.json"  # per node: the keys and book coordinates read, the witness exit codes, a failed stage
NODES_FILE = "nodes.json"  # the pins found, and per node whether its data_dir and book_dir were read


def judge_book(cap, out):
    """One node's verdict from what live_book kept under out (inputs.json and the proof files): capsulectl verify
    --bundle runs again on bundle.json, offline, and the checks run on the files: (result, proof, detail, gap)."""
    inputs = json.loads((out / INPUTS_FILE).read_text(encoding="utf-8"))
    name, done = inputs["node"], list(inputs["done"])
    failed = inputs.get("failed")
    if failed:
        stage = failed["stage"]
        if stage == "input":
            return ("FAIL", done + ["input.stderr.txt", INPUTS_FILE],
                    f"node {name}: the node's key or book could not be read: {failed.get('error')}", None)
        return ("FAIL", done + [f"{stage}.stderr.txt", INPUTS_FILE],
                f"node {name}: capsulectl {stage} did not run on the node's book (exit non-zero)", None)
    node_pub, cp_pub, bound = inputs["node_pub"], inputs["checkpoint_pub"], inputs["bound"]
    book_id, book_key, capsule_id = inputs["book_id"], inputs["book_key"], inputs["capsule_id"]
    size, witness = inputs["checkpoint"], inputs["witness"]
    appended = json.loads((out / "append.json").read_text())
    if not isinstance(appended, dict):
        raise ValueError("append.json is not a JSON object")
    with tempfile.TemporaryDirectory(prefix="02-verify-") as tmp:
        env = dict(os.environ, XDG_CONFIG_HOME=str(Path(tmp) / "config"),
                   CAPSULECTL_PLUGIN_ROOTS=os.environ.get("CAPSULECTL_PLUGIN_ROOTS", str(cap.parent)))
        r = subprocess.run([str(cap), "verify", "--bundle", str(out / "bundle.json")], capture_output=True, text=True,
                           env=env)
    (out / "verify.json").write_text(r.stdout)
    (out / "verify.stderr.txt").unlink(missing_ok=True)
    if r.returncode:
        (out / "verify.stderr.txt").write_text(r.stderr)
    checks = live_checks(r.returncode, out, capsule_id, appended, node_pub, book_id, book_key)
    checks["node_key"] = {"ok": node_pub in bound, "detail": f"node key {node_pub}; the book was bound to {bound}"}
    proof = LIVE_PROOF + [INPUTS_FILE, "checks.json"] + (["verify.stderr.txt"] if r.returncode else [])
    gap = None
    if not witness["endpoint"]:
        gap = LIVE_WITNESS_NOT_CHECKED
    else:
        proof += ["publish.json"] + (["publish.stderr.txt"] if inputs["publish_rc"] else [])
        try:
            state = json.loads((out / "publish.json").read_text())
        except ValueError:
            state = {}
        if not state.get("receipt") and state.get("state") == "failed":
            # capsulectl reports "failed" for a permanent failure (a receipt the book's verifier rejected, or a
            # client error) and "pending" for a retryable one (a witness that did not answer); it hides the cause.
            checks["witness_receipt"] = {"ok": False, "detail": f"the book's delivery of checkpoint {size} to its "
                                         "witness failed permanently, so it holds no receipt (the cause is hidden "
                                         "by capsulectl: a receipt the book rejects, or a refused request)"}
        elif not state.get("receipt"):
            reason = inputs.get("publish_reason") or f"state {state.get('state')}"
            gap = {"what": f"a witness receipt on node {name}'s checkpoint, and its verification",
                   "why": f"the book delivered checkpoint {size} to its witness and holds no receipt: {reason}",
                   "issue": "evidence-network/loop: the lab test witness gave no receipt (lab/lab.sh witness)"}
        else:
            status_rc = inputs["status_rc"]
            proof += ["witness-status.json"] + (["status.stderr.txt"] if status_rc else [])
            try:
                status = json.loads((out / "witness-status.json").read_text())
            except ValueError:
                status = state
            # The listing the run cites (witnesses.json beside the nodes), which 08 holds to the repository's.
            try:
                entries = [e for e in json.loads((out.parent / "witnesses.json").read_text()).get("witnesses", [])
                           if isinstance(e, dict)]
            except (OSError, ValueError, AttributeError):
                entries = None
            if entries is None:
                checks["witness_receipt"] = {"ok": False, "detail": "the run cites no readable witness listing "
                                                                   "(witnesses.json) to hold the receipt to"}
            else:
                try:
                    checks.update(witness_checks(status_rc, status, witness["public_key"],
                                                 set(inputs["node_keys"]) | {node_pub, cp_pub, *bound}, entries))
                except (ValueError, IndexError, TypeError, AttributeError, KeyError) as e:
                    checks["witness_receipt"] = {"ok": False, "detail": f"the stored receipt could not be read: {e}"}
                # The receipt itself, verified offline over the book's checkpoint statement (loop#219): the
                # capsulectl state above is the lab's reading; this check holds the receipt from the proof bytes.
                bin_ = driver()
                if inputs.get("receipt_check") != RECEIPT_CHECK:
                    pass  # a run before the offline receipt check: judged as it was, and step 08 names that
                elif bin_ is None or not openssl_ed25519():
                    gap = {"what": f"node {name}: the witness receipt's signature, verified offline",
                           "why": ("the step 02 driver is not installed where this step runs" if bin_ is None else
                                   "openssl 3.0 or later (Ed25519 pkeyutl -rawin) is not installed where this "
                                   "step runs"),
                           "issue": "evidence-network/loop: steps/02-book.setup.sh, run where 02 runs"}
                else:
                    checks["witness_signature"] = receipt_signature(bin_, out, status, entries, appended_checkpoint(out))
    (out / "checks.json").write_text(json.dumps({"node": name, "checks": checks}, indent=2, sort_keys=True) + "\n")
    failed = [f"{n} ({c['detail']})" for n, c in checks.items() if not c["ok"]]
    where = f"node {name}: book {book_id}, sequence {appended.get('sequence')}, capsule {capsule_id}"
    if failed:
        return "FAIL", proof, f"{where}: did not hold: {'; '.join(failed)}", None
    held = (f"{where}: these held on the proof bytes, by capsulectl verify --bundle, capsulectl cll checkpoint "
            f"status and this step's comparisons: {', '.join(checks)}.")
    if gap:
        return "NOT_CHECKED", proof, f"{held} Witness part not checked.", gap
    return "PASS", proof, (f"{held} The receipt is from the lab test witness (lab/witness/witnesses.json), "
                           f"one organization's test witness."), None


RECEIPT_CHECK = "offline"  # inputs.json's mark that the run verifies each receipt offline (loop#219)


def appended_checkpoint(out):
    """The checkpoint the node's bundle.json carries, or {} when it cannot be read."""
    try:
        cp = json.loads((Path(out) / "bundle.json").read_text())["checkpoint"]
        return cp if isinstance(cp, dict) else {}
    except (OSError, ValueError, KeyError, TypeError):
        return {}


def receipt_signature(bin_, out, status, entries, bundle_cp):
    """{ok, detail}: the stored receipt verifies, offline, under the listed witness key its key id names, over the
    book's raw COSE checkpoint statement (checkpoint.json), and that statement is the checkpoint the bundle carries
    (log id, size, root, signer, time). The step 02 driver's lab-check runs AAC's witness receipt verifier."""
    receipt = (status or {}).get("receipt")
    try:
        kid, _ = receipt_header(base64.b64decode((receipt or {}).get("Bytes") or ""))
    except (ValueError, IndexError, TypeError, AttributeError, KeyError):
        kid = None
    entry = next((e for e in entries if e.get("key_id") == kid), None)
    if not isinstance(receipt, dict) or entry is None:
        return {"ok": False, "detail": f"the receipt names key id {kid}, which the cited listing does not list"}
    try:
        statement = base64.b64decode(json.loads((Path(out) / "checkpoint.json").read_text())["statement"])
    except (OSError, ValueError, KeyError, TypeError) as e:
        return {"ok": False, "detail": f"checkpoint.json carries no readable COSE statement ({e})"}
    with tempfile.TemporaryDirectory(prefix="02-receipt-") as tmp:
        (Path(tmp) / "statement.cose").write_bytes(statement)
        (Path(tmp) / "receipt.json").write_text(json.dumps(receipt))
        r = subprocess.run([str(bin_), "lab-check", "--statement", str(Path(tmp) / "statement.cose"), "--receipt",
                            str(Path(tmp) / "receipt.json"), "--key-id", entry["key_id"]], capture_output=True, text=True)
    try:
        v = json.loads(r.stdout)
    except ValueError:
        return {"ok": False, "detail": f"loop-step02-book lab-check exit {r.returncode}: {r.stderr.strip()[-200:]}"}
    if r.returncode == 2 or not isinstance(v, dict):
        return {"ok": False, "detail": f"loop-step02-book lab-check exit {r.returncode}: {r.stderr.strip()[-200:]}"}
    stated = v.get("checkpoint") or {}
    same = all(stated.get(k) == bundle_cp.get(k) for k in ("log_id", "mmr_size", "root", "key_id", "timestamp"))
    held, why = receipt_openssl(receipt, entry["key_id"], bundle_cp)
    ok = r.returncode == 0 and v.get("ok") is True and same and held
    return {"ok": ok, "detail": v.get("detail", "") + ("" if same else
                                                     "; the witnessed checkpoint is not the one the bundle carries")
            + f"; {why}"}


# The checkpoint record's signing body, in field order (checkpointed-local-log's CheckpointRecord::signing_body at
# the pin); a decoded COSE checkpoint is always kind mmr_checkpoint, v 1 (DecodedCheckpointCose::to_checkpoint_record).
SIGNING_BODY = ("key_id", "kind", "log_id", "mmr_size", "prev_root", "prev_size", "root", "timestamp", "v")


def cbor_head(major, n):
    """A CBOR item head for a definite length n."""
    if n < 24:
        return bytes([major << 5 | n])
    size = 1 if n < 256 else 2 if n < 65536 else 4
    return bytes([major << 5 | {1: 24, 2: 25, 4: 26}[size]]) + n.to_bytes(size, "big")


def receipt_openssl(receipt, key_id, bundle_cp):
    """(ok, detail): the receipt's Ed25519 signature, checked apart from the Rust crates that sign and verify lab
    receipts. The signed payload is rebuilt here from bundle.json's checkpoint: the record digest (SHA-256 of its
    signing body), the entry hash (SHA-256 of the digest, which the receipt must state) and the RFC 9162 leaf; the
    COSE Sig_structure over the receipt's protected header is then verified by openssl under the listed key."""
    try:
        raw = base64.b64decode(receipt["Bytes"])
        msg, _ = cbor(raw)
        protected, sig = msg[0], msg[3]
        if not (len(msg) == 4 and isinstance(protected, bytes) and isinstance(sig, bytes) and msg[2] is None):
            return False, "openssl: the receipt is not a detached COSE_Sign1"
        if cbor(protected)[0].get(1) != -8:
            return False, "openssl: the receipt's algorithm is not EdDSA"
        rec = dict(bundle_cp, kind="mmr_checkpoint", v=1)
        body = "{" + ",".join(f"{json.dumps(k)}:{json.dumps(rec[k], ensure_ascii=False)}" for k in SIGNING_BODY) + "}"
    except (KeyError, ValueError, IndexError, TypeError, AttributeError) as e:
        return False, f"openssl: the receipt or the bundle's checkpoint could not be read ({e})"
    entry = hashlib.sha256(hashlib.sha256(body.encode()).digest()).digest()
    if entry.hex() != receipt.get("EntryHash"):
        return False, "openssl: the receipt's entry hash is not the bundle checkpoint's"
    leaf = hashlib.sha256(b"\0" + entry).digest()
    tbs = (cbor_head(4, 4) + cbor_head(3, 10) + b"Signature1" + cbor_head(2, len(protected)) + protected
           + cbor_head(2, 0) + cbor_head(2, len(leaf)) + leaf)
    with tempfile.TemporaryDirectory(prefix="02-receipt-") as tmp:
        m, s, p = Path(tmp) / "m", Path(tmp) / "s", Path(tmp) / "p.der"
        m.write_bytes(tbs)
        s.write_bytes(sig)
        p.write_bytes(SPKI_ED25519 + bytes.fromhex(key_id))
        r = subprocess.run(["openssl", "pkeyutl", "-verify", "-pubin", "-inkey", str(p), "-keyform", "DER", "-rawin",
                            "-in", str(m), "-sigfile", str(s)], capture_output=True)
    if r.returncode != 0:
        return False, f"openssl: the receipt's signature does not verify under {key_id} over the bundle's checkpoint"
    return True, f"openssl verifies the receipt's signature under {key_id} over the bundle's checkpoint"


def openssl_ed25519():
    """Whether the openssl on PATH is OpenSSL 3.0 or later, which verifies Ed25519 with pkeyutl -rawin."""
    if shutil.which("openssl") is None:
        return False
    r = subprocess.run(["openssl", "version"], capture_output=True, text=True)
    return r.returncode == 0 and r.stdout.startswith("OpenSSL ") and r.stdout[8:].split(".")[0].isdigit() \
        and int(r.stdout[8:].split(".")[0]) >= 3


def live_checks(rc, out, capsule_id, appended, node_pub, book_id, book_key):
    """The checks on one node's proof bytes: {name: {ok, detail}}."""
    def bad(e):
        return {"ok": False, "detail": f"unreadable: {e}"}
    checks = {}
    try:
        v = json.loads((out / "verify.json").read_text())
        ok = rc == 0 and v.get("verdict") == "VALID"
        checks["bundle"] = {"ok": ok, "detail": f"capsulectl verify --bundle exit {rc}, verdict {v.get('verdict')}"}
        parts = {k: (v.get(k) or {}).get("status") for k in ("checkpoint", "per_record_membership",
                                                              "producer_signatures")}
        checks["membership"] = {"ok": all(s == "pass" for s in parts.values()),
                                "detail": ", ".join(f"{k} {s}" for k, s in parts.items())}
    except (OSError, ValueError, AttributeError) as e:
        checks["bundle"] = bad(e)
    try:
        b = json.loads((out / "bundle.json").read_text())
        root = b["root"]
        rec = next(r for r in b["records"] if r.get("capsule_id") == root)
        book = json.loads((out / "book-record.json").read_text()) or {}
        header = book.get("header", {})
        digest = hashlib.sha256(jcs(header)).hexdigest()
        bound = rec.get("model_attestation", {}).get("compute_attestation", {}).get("agent_input_digest")
        ok = (book.get("record_id") == root and digest == bound and header.get("subject_ref") == capsule_id
              and header.get("book_id") == book_id)
        checks["record"] = {"ok": ok, "detail": f"book record {book.get('record_id')} (bundle root {root}) "
                                                f"carries capsule {header.get('subject_ref')} in book "
                                                f"{header.get('book_id')}; header digest {digest}, signed {bound}"}
        coords = b["completeness_certificate"]["memberships"][root]["log_coordinates"]
        ok = (coords.get("log_id") == book_id and coords.get("seq") == appended.get("sequence") == header.get("seq"))
        checks["position"] = {"ok": ok, "detail": f"log {coords.get('log_id')} seq {coords.get('seq')}, "
                                                  f"appended at {appended.get('sequence')}"}
        producer = b.get("extensions", {}).get("producer-key/v1", {}).get("public_key")
        ok = rec.get("key_id") == node_pub == producer
        checks["signer"] = {"ok": ok, "detail": f"record key_id {rec.get('key_id')}, producer key {producer}, "
                                                f"node key {node_pub}"}
        cp = b["checkpoint"]
        ok = cp.get("key_id") == book_key and cp.get("log_id") == book_id
        checks["checkpoint"] = {"ok": ok, "detail": f"checkpoint over {cp.get('mmr_size')} nodes of "
                                                    f"{cp.get('log_id')}, signed by {cp.get('key_id')}, the book's "
                                                    f"checkpoint key {book_key}"}
    except (OSError, ValueError, KeyError, StopIteration, AttributeError, TypeError) as e:
        checks.setdefault("record", bad(e))
    return checks


def main_live(pop, out, started):
    """Each live node appends to its own book (live_book), and the run keeps nodes.json; then judge_live judges what
    was kept, so the finding is a function of its proof."""
    cap, missing = capsulectl()
    out.mkdir(parents=True, exist_ok=True)
    for p in ("witnesses.json", NODES_FILE, "finding.json"):
        (out / p).unlink(missing_ok=True)
    if LISTING.is_file():
        shutil.copyfile(LISTING, out / "witnesses.json")
    # Every node's own key: a receipt under any of them is not a witness's.
    node_keys = {k for k in (spki_hex(d / "keys" / "node-key.pub.pem") for d in
                             (live.readable(n, "data_dir", "keys/node-key.pub.pem") for n in pop["nodes"]) if d) if k}
    nodes = {}
    with tempfile.TemporaryDirectory(prefix="02-book-") as tmp:
        for entry in pop["nodes"]:
            name = entry["name"]
            if Path(name).name != name or name in ("", ".", ".."):
                raise SystemExit(f"02-book: node name {name!r} is not a single path component")
            shutil.rmtree(out / name, ignore_errors=True)
            need = {"data_dir": ("keys/node-key.pem",),
                    "book_dir": ("checkpoint.seed", "book/book/records/checkpoints.jsonl",
                                 "book/book/records/records.jsonl")}
            dirs = {f: live.readable(entry, f, *files) for f, files in need.items()}
            why = {f: live.why_not(entry, f, *need[f]) for f, d in dirs.items() if d is None}
            profile = book_profile(dirs["book_dir"]) if dirs["book_dir"] else None
            if dirs["book_dir"] and profile is None:
                why["book_dir"] = "book_dir has no book profile whose store is its book/ (config/capsule/profiles)"
            if why or missing:
                nodes[name] = {"read": "no", "why": [[f, w] for f, w in why.items()]}  # in the order checked
                continue
            live_book(cap, name, dirs["data_dir"], dirs["book_dir"], profile, node_keys, out / name,
                      Path(tmp) / name, started)
            nodes[name] = {"read": "ok"}
    (out / NODES_FILE).write_text(json.dumps({"missing": missing, "nodes": nodes}, indent=2, sort_keys=True) + "\n")
    judge_live(pop, out, started)
    return 0


def judge_live(pop, out, started):
    """The live finding from what main_live kept under out (nodes.json, each node's inputs.json and proof files)."""
    out = Path(out)
    cap, _ = capsulectl()
    results, proof, details, not_checked = [], [], [], []
    try:
        kept = json.loads((out / NODES_FILE).read_text(encoding="utf-8"))
        missing, nodes = kept["missing"], kept["nodes"]
        if not (isinstance(missing, list) and isinstance(nodes, dict)):
            raise TypeError("missing or nodes has the wrong type")
    except (OSError, ValueError, KeyError, TypeError) as e:
        return finding.write(out, result="FAIL", population=pop["population"], asserts=ASSERTS, pinned=LIVE_PINNED,
                             proof=[], detail=f"{NODES_FILE} is not readable ({type(e).__name__}: {e})",
                             started=started)
    not_checked += missing
    proof.append(NODES_FILE)
    if (out / "witnesses.json").is_file():
        proof.append("witnesses.json")
    names = [e["name"] for e in pop["nodes"]]
    if sorted(nodes) != sorted(names):
        results.append("FAIL")
        details.append(f"{NODES_FILE} names nodes {sorted(nodes)}, the population {sorted(names)}")
    for name in names:
        if name not in nodes:
            continue
        node = nodes[name] if isinstance(nodes[name], dict) else {}
        why = node.get("why")
        if node.get("read") == "no" and isinstance(why, list) and all(
                isinstance(x, list) and len(x) == 2 and all(isinstance(y, str) for y in x) for x in why) and (why or missing):
            results.append("NOT_CHECKED")
            not_checked += [live.not_checked(name, f, w) for f, w in why]
            details.append(f"node {name}: not checked, {'; '.join(w for _, w in why) or 'a pinned tool is missing'}")
            continue
        if node.get("read") != "ok" or missing or not (out / name / INPUTS_FILE).is_file():
            results.append("FAIL")
            details.append(f"node {name}: {NODES_FILE} records {node!r}, which its kept files do not bear out")
            continue
        try:
            result, files, detail, gap = judge_book(cap, out / name)
        except (OSError, ValueError, KeyError, TypeError, AttributeError) as e:
            result, files, detail, gap = ("FAIL", [], f"node {name}: its kept inputs are not readable "
                                                      f"({type(e).__name__}: {e})", None)
        results.append(result)
        proof += [f"{name}/{f}" for f in files if (out / name / f).is_file()]
        details.append(detail)
        if result == "NOT_CHECKED" and gap and gap not in not_checked:
            not_checked.append(gap)
    return finding.write(out, result=live.worst(results), population=pop["population"], asserts=ASSERTS,
                         pinned=LIVE_PINNED, proof=proof, detail="; ".join(details), not_checked=not_checked,
                         started=started)


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--population", required=True)
    ap.add_argument("--out", required=True)
    a = ap.parse_args(argv)
    started = finding.now()
    pop = json.loads((Path(a.population) / "population.json").read_text(encoding="utf-8"))
    if pop["population"] == "live":
        return main_live(pop, Path(a.out), started)
    bin_ = driver()
    if bin_ is None:
        print("02-book: the driver is not installed; run steps/02-book.setup.sh", file=sys.stderr)
        return 2
    population, key, pub = node(a.population, "alice")
    out = Path(a.out)
    out.mkdir(parents=True, exist_ok=True)
    for p in PROOF + ["finding.json"]:
        (out / p).unlink(missing_ok=True)
    book_id = f"{population}-alice"
    book(bin_, key, book_id, out, started)
    w = witness_of(a.population)
    if w is not None:
        witnessed(bin_, w, out)
    decide(bin_, out, population=population, book_id=book_id, pub=pub, started=started)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
