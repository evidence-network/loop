def driver():
    """The installed driver binary, or None."""
    env = os.environ.get("LOOP_STEP02_BOOK_BIN")
    if env:
        p = Path(env)
    else:
        tools = Path(os.environ.get("LOOP_TOOLS", Path.home() / ".cache" / "evidence-network-loop"))
        p = tools / "02-book" / "bin" / "loop-step02-book"
    return p if p.is_file() and os.access(p, os.X_OK) else None


def node(population_dir, name):
    """(population name, private key PEM, public key PEM) of the named node."""
    pop = json.loads((Path(population_dir) / "population.json").read_text(encoding="utf-8"))
    for n in pop["nodes"]:
        if n["name"] == name:
            key_dir = Path(n["key_dir"])
            key_dir = key_dir if key_dir.is_absolute() else ROOT / key_dir
            return pop["population"], key_dir / "node-key.pem", key_dir / "node-key.pub.pem"
    raise KeyError(f"{population_dir}: no node named {name}")


def witness_of(population_dir):
    """The population's witness: {url, key, directory} with paths resolved, or None."""
    w = json.loads((Path(population_dir) / "population.json").read_text(encoding="utf-8")).get("witness")
    if not w:
        return None

    def at(p):
        p = Path(p)
        return p if p.is_absolute() else ROOT / p
    return {"name": w["name"], "url": w["url"], "key": at(w["key_dir"]) / "witness-key.pem",
            "directory": at(w["directory"])}


def run(bin_, *args):
    return subprocess.run([str(bin_), *map(str, args)], capture_output=True, text=True)


def book(bin_, key, book_id, out, time, note="rehearsal record"):
    """Make a new book, append, cut a checkpoint; write the proof files into out."""
    with tempfile.TemporaryDirectory() as work:
        r = run(bin_, "book", "--key", key, "--book-id", book_id, "--book-dir", Path(work) / "book",
                "--out", out, "--time", time, "--note", note)
    if r.returncode != 0:
        raise RuntimeError(f"driver book: {r.stderr.strip()}")


def witnessed(bin_, w, out):
    """Give the checkpoint to the witness; keep its receipt on the checkpoint, and the directory, in out."""
    out = Path(out)
    r = run(bin_, "witness", "--key", w["key"], "--url", w["url"], "--checkpoint", out / "checkpoint.json")
    if r.returncode != 0:
        raise RuntimeError(f"driver witness: {r.stderr.strip()}")
    (out / "witness-receipt.json").write_text(r.stdout)
    cp = json.loads((out / "checkpoint.json").read_text())
    cp["witnesses"] = cp.get("witnesses", []) + [json.loads(r.stdout)]
    (out / "checkpoint.json").write_text(json.dumps(cp, indent=2) + "\n")
    shutil.copyfile(w["directory"], out / "witnesses.json")


def decide(bin_, out, *, population, book_id, pub, started):
    """Verify the proof bytes in out with the driver and write the finding.

    The witness part is verified when out holds a witness directory
    (witnesses.json); without one it is NOT_CHECKED.
    """
    out = Path(out)
    has_witness = (out / "witnesses.json").is_file()
    r = run(bin_, "verify", "--pub", pub, "--book-id", book_id, "--dir", out,
            *(["--witnesses", out / "witnesses.json"] if has_witness else []))
    if r.returncode not in (0, 1):
        raise RuntimeError(f"driver verify: {r.stderr.strip()}")
    (out / "verify.json").write_text(r.stdout)
    verdict = json.loads(r.stdout)
    held = [c["check"] for c in verdict["checks"] if c["ok"]]
    failed = [f"{c['check']} ({c['detail']})" for c in verdict["checks"] if not c["ok"]]
    proof = [p for p in PROOF if (out / p).is_file()]
    where = f"book {book_id}, position {verdict['position']}, record {verdict['record_id']}"
    if r.returncode == 1 or failed:
        return finding.write(out, result="FAIL", population=population, asserts=ASSERTS, pinned=PINNED,
                             proof=proof, detail=f"{where}: did not hold: {'; '.join(failed)}",
                             started=started)
    if has_witness:
        detail = (f"{where}: evidencebook found these held on the proof bytes: {', '.join(held)}. "
                  f"The checkpoint's receipt from {', '.join(verdict['witnesses_verified'])} verifies under "
                  f"witnesses.json; that witness is the rehearsal TEST witness.")
        return finding.write(out, result="PASS", population=population, asserts=ASSERTS, pinned=PINNED,
                             proof=proof, detail=detail, started=started)
    detail = (f"{where}: evidencebook found these held on the proof bytes: {', '.join(held)}. "
              f"Witness part not checked ({verdict['witness_receipts']} receipts on the checkpoint).")
    return finding.write(out, result="NOT_CHECKED", population=population, asserts=ASSERTS, pinned=PINNED,
                         proof=proof, detail=detail, not_checked=[WITNESS_NOT_CHECKED], started=started)


