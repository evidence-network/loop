# --- The asked node's advertisement ----------------------------------------
def advertisement(adv_dir, name="commitment.json"):
    """(advertised, errors): the asked node's keys, answers, policy and answers_within, from its commitment.

    `name` is the commitment's file in adv_dir; its policy is read at lcap.policy_uri beside it.

    The commitment verifies with step 03's checker (its signature under the node
    key, the policy digest against the signed policy beside it) before anything
    in it is used.
    """
    adv_dir = Path(adv_dir)
    try:
        doc = load(adv_dir / name)
    except (OSError, ValueError) as e:
        return None, [f"the asked node's commitment is not readable JSON ({e})"]
    errs, notes = check_commitment.verify(doc, check_commitment.file_fetcher(adv_dir))
    errs = [f"the asked node's commitment does not verify: {e}" for e in errs + notes]
    if errs:
        return None, errs
    try:
        adv = step12.advertised(adv_dir, name)
        adv["answers_within"] = doc["answers_within"]
        adv["within"] = duration(doc["answers_within"])
        adv["policy"] = load(adv_dir / adv["policy_uri"])["policy"]
    except (OSError, ValueError, KeyError, TypeError) as e:
        return None, [f"the commitment does not give the node's keys, policy and answers_within ({e})"]
    return adv, []


def stranger_safe(request, adv):
    """Whether the advertised answers make this request public: a listed derivation, or a listed bare subject."""
    if "derivation" in request:
        return request["derivation"] in adv["derivations"]
    return list(request.get("subject", {})) == ["checkpoints"] and "checkpoints" in adv["subjects"]


def policy_answers(request, adv, requester_authenticated=True):
    """Whether the advertised policy answers this request to this asker."""
    if stranger_safe(request, adv):
        return True
    kind = next(iter(request.get("subject", {})), None)
    if kind in ("exchange", "record"):
        # "peers" answers any authenticated peer; "counterparties" only a party
        # every record the subject names names as its counterparty; "off" no one.
        return requester_authenticated and adv["policy"].get("history_segments") == "peers"
    return False


# Why a node refuses, against what its advertised policy answers (Mesh-LLM/capsules-plugin#112, #114): only
# these two reasons withhold an answer the policy promises; under evidence-interop/0 policy_declined and
# not_authorized also cover limits no policy promises past (a full stranger pool, an oversized answer, a full
# replay cache), so a refusal under them cannot be judged; under /1 they are policy (below).
# Anything else, a reason the spec does not name included, is a breach (vectors/aac-evidence-request in
# capsules-plugin). no_such_subject and derivation_unsupported withhold; the reasons below blame the request.
WITHHOLDING_REASONS = ("no_such_subject", "derivation_unsupported")
REQUEST_REASONS = ("coverage_unsatisfiable", "deadline_unmet", "request_malformed")
# retention_expired is right only once the node's retention commitment for the subject has lapsed; inside it the
# refusal breaches the promise (ER §9, ERV A9). No node publishes a retention commitment the step can read, so
# such a refusal cannot be judged and is never counted as answered (evidence-network/loop#60).
RETENTION_REASONS = ("retention_expired",)
RETENTION_ISSUE = "evidence-network/loop#60"
AMBIGUOUS_REASONS = ("policy_declined", "not_authorized")
REFUSAL_ISSUE = "Mesh-LLM/capsules-plugin#114"
# Interop profile evidence-interop/1 (AAC spec/interop-profile-v1.md, Evidence Request -02): a node declines for a
# limit of its own with capacity_exceeded and refuses a requester authentication that fails with
# request_unauthenticated, so under /1 policy_declined and not_authorized are policy only and a refusal under them of
# a subject the policy answers is a breach. A refusal carries no profile: it is read by its request's (IP v1 §6.3).
PROFILE_V0, PROFILE_V1 = "evidence-interop/0", "evidence-interop/1"
LIMIT_REASONS = ("capacity_exceeded",)
V1_REQUEST_REASONS = ("request_unauthenticated",)


def request_profile(request):
    """The identifier a sealed request asks for: its `profile`, or evidence-interop/0 when it names none (IP v1
    §3.3 step 2)."""
    return (request.get("profile") if isinstance(request, dict) else None) or PROFILE_V0


def refusal_verdict(reason, profile=PROFILE_V0):
    """"fail" if a refusal for `reason` of a subject the policy answers breaches the policy (a withholding reason, or
    one the spec does not name), "not_checked" if the reason is one an honest node also sends, "ok" if it blames
    the request. `profile` is the identifier the request asked for (request_profile; every caller holds the
    request in the proof). Under evidence-interop/1 policy_declined and not_authorized are policy, so a breach,
    capacity_exceeded (a limit of the node's own) is not checked and request_unauthenticated blames the request.
    evidence-interop/0 registers neither -02 token, so either answering a /0 request is an unregistered reason, a
    breach, and policy_declined and not_authorized cannot be judged (IP v1 §6.3, §9.1). retention_expired is not
    checked under either profile: it is right only once a retention commitment lapses, and none is readable
    (loop#60)."""
    if reason in REQUEST_REASONS:
        return "ok"
    if reason in RETENTION_REASONS:
        return "not_checked"
    if reason in LIMIT_REASONS or reason in V1_REQUEST_REASONS:
        if profile != PROFILE_V1:
            return "fail"
        return "not_checked" if reason in LIMIT_REASONS else "ok"
    if reason in AMBIGUOUS_REASONS:
        return "fail" if profile == PROFILE_V1 else "not_checked"
    return "fail"


def refusal_not_checked(what, reason):
    if reason in RETENTION_REASONS:
        return {"what": what, "issue": RETENTION_ISSUE,
                "why": f"the refusal's reason {reason} is right only after the node's retention commitment for the "
                       "subject lapses, and the node publishes none the step can read, so it cannot be judged"}
    if reason in LIMIT_REASONS:
        why = f"the refusal's reason {reason} is a limit of the node's own, which no policy promises past"
    else:
        # The text the sealed findings hold (step 08 reproduces them byte for byte).
        why = (f"the refusal's reason {reason} is also sent for limits no policy promises past, "
               "so it cannot be judged against the policy")
    return {"what": what, "why": why, "issue": REFUSAL_ISSUE}


# --- Backend "book": asks between joined rehearsal books ---------------------
class Node:
    """A joined node: its capsulectl home, book profile, keys and published advertisement."""

    def __init__(self, name, home, joined, capsulectl):
        self.name, self.home, self.joined, self.capsulectl = name, Path(home), Path(joined), capsulectl
        book = load(self.joined / "book.json")
        self.book_id, self.key, self.checkpoint_key = book["book_id"], book["node_key"], book["checkpoint_key"]
        self.first_record = book["first_record"]

    def cap(self, *args, check=True):
        env = dict(os.environ, XDG_CONFIG_HOME=str(self.home / "config"),
                   CAPSULECTL_PLUGIN_ROOTS=os.environ.get("CAPSULECTL_PLUGIN_ROOTS",
                                                          str(Path(self.capsulectl).parent)))
        r = subprocess.run([str(self.capsulectl), *args, "--profile", self.name], env=env, capture_output=True,
                           text=True)
        if check and r.returncode != 0:
            raise RuntimeError(f"{self.name}: capsulectl {' '.join(args[:2])}: {r.stderr.strip() or r.stdout}")
        return r


def keep(stdout):
    """capsulectl's JSON result without the local paths it names."""
    d = json.loads(stdout.strip().splitlines()[-1])
    d.pop("output", None)
    return d


def write_json(path, data):
    Path(path).write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")


class Carrier:
    """The rehearsal carrier: it hands request bytes to the asked node and replies back, and logs when."""

    def __init__(self, log):
        self.log = Path(log)

    def note(self, ask, event, **fields):
        with self.log.open("a") as f:
            f.write(json.dumps({"ask": ask, "event": event, "at": stamp(now()), **fields}, sort_keys=True) + "\n")


class Ask:
    """One ask from `asker` to `asked`. make_fixtures.py overrides parts of it to plant failures."""

    def __init__(self, asker, asked, name, spec, pair_dir, carrier, within):
        self.asker, self.asked, self.name, self.spec = asker, asked, name, spec
        self.dir, self.carrier, self.within = Path(pair_dir) / name, carrier, within
        self.dir.mkdir(parents=True)
        self.sent_at = self.deadline = self.reply = self.outcome = None

    def request_map(self):
        if "request" in self.spec:
            return self.spec["request"]
        return {"subject": {"exchange": self.asker.first_record}, "coverage": {"min_freshness": 1}}

    def seal(self):
        (self.dir / "request.in.json").write_text(json.dumps(self.request_map()) + "\n")
        r = self.asker.cap("book", "request", "--request", str(self.dir / "request.in.json"),
                           "--responder", self.asked.book_id, "--output", str(self.dir / "request.json"))
        (self.dir / "request.in.json").unlink()
        self.record = keep(r.stdout)
        write_json(self.dir / "asked.json", self.record)

    def send(self):
        data = (self.dir / "request.json").read_bytes()
        self.carrier.note(self.name, "sent", to=self.asked.book_id, request_sha256=sha256(data))
        self.sent_at = utc(self.carrier_events()[-1]["at"])
        self.deadline = self.sent_at + self.within

    def carrier_events(self):
        return [e for e in map(json.loads, self.carrier.log.read_text().splitlines()) if e["ask"] == self.name]

    def respond(self):
        """The asked node answers, as the carrier authenticated the asker (by its node key)."""
        self.asked.cap("book", "respond", "--policy", str(self.asked.joined / "policy.json"),
                       "--request", str(self.dir / "request.json"), "--requester", self.asker.key,
                       "--output", str(self.dir / "answer.json"))
        self.reply = (self.dir / "answer.json").read_bytes()

    def deliver(self):
        self.carrier.note(self.name, "delivered", reply_sha256=sha256(self.reply))

    def record_response(self):
        r = self.asker.cap("book", "request", "--for", self.record["record_id"],
                           "--response", str(self.dir / "answer.json"),
                           "--responder-key", self.asked.key, "--responder-checkpoint-key", self.asked.checkpoint_key)
        self.outcome = keep(r.stdout)

    def record_absence(self):
        until = dt.datetime.fromtimestamp(math.ceil(self.deadline.timestamp()), dt.timezone.utc)
        r = self.asker.cap("book", "request", "--for", self.record["record_id"],
                           "--absent-until", until.strftime("%Y-%m-%dT%H:%M:%SZ"), "--route", ROUTE)
        self.outcome = keep(r.stdout)

    def disclose(self):
        write_json(self.dir / "outcome.json", self.outcome)
        self.asker.cap("disclose", "--root", self.outcome["record_id"], "--out",
                       str(self.dir / "outcome.bundle.json"))

    def on_time(self):
        """Seal, send, answer and deliver. Returns True when the reply is in hand now, False when held."""
        self.seal()
        self.send()
        self.respond()
        if self.spec["delivery"] == "late":
            self.carrier.note(self.name, "held")
            return False
        self.deliver()
        self.record_response()
        self.disclose()
        return True

    def after_deadline(self):
        """The held reply arrives after the deadline: the ask is recorded absent, the late reply kept."""
        self.deliver()
        self.record_absence()
        self.disclose()


def join(node, tmp, capsulectl, out_dir):
    """join.sh for one rehearsal node, answering within REHEARSAL_ANSWERS_WITHIN. Returns its Node."""
    name = node["name"]
    key_dir = ROOT / node["key_dir"]
    controller = key_dir / "controller-key.pem"
    if not controller.is_file():
        controller = Path(tmp) / f"{name}-controller-key.pem"
        step12.make_test_controller_key(controller)
    joined, home = Path(tmp) / f"{name}-joined", Path(tmp) / f"{name}-home"
    r = subprocess.run([str(ROOT / "join.sh"), "--name", name, "--node-key", str(key_dir / "node-key.pem"),
                        "--controller-key", str(controller), "--out", str(joined), "--home", str(home),
                        "--answers-within", REHEARSAL_ANSWERS_WITHIN],
                       env=dict(os.environ, CAPSULECTL=str(capsulectl)), capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"{name}: join.sh did not complete (exit {r.returncode}): {r.stderr.strip()[-500:]}")
    adv = Path(out_dir) / name / "advertised"
    adv.mkdir(parents=True)
    for f in ADVERTISED:
        shutil.copy2(joined / f, adv / f)
    return Node(name, home, joined, capsulectl)


def run_asks(runs):
    """Each (out, asker, asked, {ask: (spec, Ask class)}) asks; late replies wait out their deadline together.

    Writes <out>/<asker>/asks/<asked>/; the asked node's advertisement is read
    from <out>/<asked>/advertised/.
    """
    held = []
    for out, asker, asked, asks in runs:
        pair_dir = Path(out) / asker.name / "asks" / asked.name
        pair_dir.mkdir(parents=True)
        carrier = Carrier(pair_dir / "carrier.jsonl")
        within = duration(load(Path(out) / asked.name / "advertised" / "commitment.json")["answers_within"])
        for name, (spec, ask_class) in asks.items():
            a = ask_class(asker, asked, name, spec, pair_dir, carrier, within)
            if not a.on_time():
                held.append(a)
    if held:
        last = max(a.deadline for a in held)
        while now() <= last + dt.timedelta(seconds=1):
            time.sleep(min(5.0, max(0.1, (last - now()).total_seconds() + 1.1)))
        for a in held:
            a.after_deadline()


# --- The judge: on the proof bytes ------------------------------------------
def verify_bundle(path, capsulectl):
    """(verdict, errors) for an outcome bundle, from `capsulectl verify --bundle`."""
    r = subprocess.run([str(capsulectl), "verify", "--bundle", str(path)], capture_output=True, text=True)
    try:
        verdict = json.loads(r.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return {}, [f"capsulectl verify --bundle gave no verdict ({r.stderr.strip()[:200]})"]
    errs = []
    if r.returncode != 0 or verdict.get("verdict") != "VALID":
        errs.append(f"the outcome bundle does not verify: {verdict.get('verdict')} "
                    f"{json.dumps({k: v for k, v in verdict.items() if isinstance(v, dict) and v.get('status') not in (None, 'pass', 'withheld')})}")
    return verdict, errs


class Verifier:
    """A fresh verifier book, to verify a reply's bytes again under the listed keys."""

    def __init__(self, work, capsulectl):
        self.home, self.capsulectl = Path(work), capsulectl
        self.home.mkdir(parents=True)
        self.n = 0

    def cap(self, *args):
        env = dict(os.environ, XDG_CONFIG_HOME=str(self.home / "config"),
                   CAPSULECTL_PLUGIN_ROOTS=os.environ.get("CAPSULECTL_PLUGIN_ROOTS",
                                                          str(Path(self.capsulectl).parent)))
        return subprocess.run([str(self.capsulectl), *args], env=env, capture_output=True, text=True)

    def check(self, request_path, reply_path, key, checkpoint_key):
        """(outcome, refusal text) of the reply verified again for exactly these request bytes."""
        self.n += 1
        name, d = f"v{self.n}", self.home / f"v{self.n}"
        d.mkdir()
        keys = {}
        for k in ("signing", "checkpoint"):
            r = self.cap("key", "generate", "--output", str(d / f"{k}.seed"))
            keys[k] = json.loads(r.stdout)["public_key"]
        r = self.cap("profile", "create", "--name", name, "--type", "jsonl", "--jsonl-path", str(d / "store"),
                     "--log-id", name, "--operator", "verifier", "--trusted-key", keys["signing"],
                     "--signing-key-file", str(d / "signing.seed"),
                     "--checkpoint-signing-key-file", str(d / "checkpoint.seed"),
                     "--checkpoint-trusted-key", keys["checkpoint"])
        if r.returncode == 0:
            r = self.cap("store", "init", "--profile", name)
        if r.returncode == 0:
            r = self.cap("book", "request", "--profile", name, "--request", str(request_path), "--responder",
                         "asked", "--output", str(d / "request.json"))
        if r.returncode != 0:
            raise RuntimeError(f"could not make a verifier book: {r.stderr.strip()}")
        if (d / "request.json").read_bytes() != Path(request_path).read_bytes():
            return None, "the verifier book seals other bytes than the request's"
        rid = json.loads(r.stdout.strip().splitlines()[-1])["record_id"]
        r = self.cap("book", "request", "--profile", name, "--for", rid, "--response", str(reply_path),
                     "--responder-key", key, "--responder-checkpoint-key", checkpoint_key)
        if r.returncode != 0:
            return None, (r.stderr.strip().splitlines() or ["refused"])[0]
        return json.loads(r.stdout.strip().splitlines()[-1]).get("outcome"), ""


def disclosed(bundle, capsule_id):
    """A bundle record's disclosed header (agent_input), or None."""
    return (bundle.get("disclosures", {}).get(capsule_id) or {}).get("agent_input")


def judge_ask(ask_dir, adv, asker_key, events, verdict, verifier, not_checked=None):
    """(errors, answered_at or None) for one ask, on its proof bytes; parts it cannot judge go to `not_checked`."""
    ask_dir = Path(ask_dir)
    name = ask_dir.name
    errs = []
    bundle = load(ask_dir / "outcome.bundle.json")
    status = {d["capsule_id"]: d["status"] for d in verdict.get("disclosures", [])}
    records = {r["capsule_id"]: r for r in bundle.get("records", [])}
    root = bundle.get("root")
    out_h = disclosed(bundle, root)
    if out_h is None or status.get(root) != "disclosure_match":
        return [f"{name}: the outcome record's header is not disclosed and matched in its bundle"], None
    cited = [link["target"] for link in out_h.get("links", []) if link.get("type") == "cites"]
    req_id = cited[0] if len(cited) == 1 else None
    req_h = disclosed(bundle, req_id) if req_id else None
    if req_h is None or status.get(req_id) != "disclosure_match" or req_h.get("record_type") != REQUEST_RECORD:
        return [f"{name}: the outcome does not cite one request record disclosed and matched in its bundle"], None
    for rid in (root, req_id):
        if records.get(rid, {}).get("key_id") != asker_key:
            errs.append(f"{name}: record {rid[:12]} is not signed by the asker's key")
    # The request: exactly the bytes sent, sealed before they were sent.
    request_bytes = (ask_dir / "request.json").read_bytes()
    request = json.loads(request_bytes)
    if req_h["statement"].get("request") != request:
        errs.append(f"{name}: the request record does not hold the request bytes")
    if utc(req_h.get("committed_at")) != utc(records[req_id].get("timestamp")):  # the same instant; Go trims zeros
        errs.append(f"{name}: the request record's committed_at is not its signed capsule's timestamp")
    sent = [e for e in events if e["event"] == "sent"]
    if len(sent) != 1:
        return errs + [f"{name}: the carrier log has {len(sent)} sends of this ask, not one"], None
    if sent[0].get("request_sha256") != sha256(request_bytes):
        errs.append(f"{name}: the carrier sent other bytes than the request record holds")
    sealed_at, sent_at = utc(req_h["committed_at"]), utc(sent[0]["at"])
    if not sealed_at < sent_at:
        errs.append(f"{name}: the request was sealed at {req_h['committed_at']}, not before it was sent at "
                    f"{sent[0]['at']}")
    deadline = sent_at + adv["within"]
    st = out_h.get("statement", {})
    if st.get("request_digest") != sha256(request_bytes):
        errs.append(f"{name}: the outcome is for another request")
    if out_h.get("record_type") == RESPONSE_RECORD:
        recorded_at = utc(out_h["committed_at"])
        if st.get("outcome") not in ANSWERED:
            errs.append(f"{name}: the answer is {st.get('outcome')} ({st.get('failure', st.get('reason', ''))}), "
                        "neither a verified artifact nor a conforming signed refusal")
        if st.get("key_id") != adv["node_key"] or st.get("checkpoint_key_id") != adv["checkpoint_key"]:
            errs.append(f"{name}: the answer is recorded under key {st.get('key_id', '')[:16]}, not the listed key "
                        f"{adv['node_key'][:16]} and its advertised checkpoint key")
        if recorded_at > deadline:
            errs.append(f"{name}: the answer was counted as answered at {out_h['committed_at']}, after the "
                        f"deadline {stamp(deadline)} (sent plus answers_within {adv['answers_within']})")
        reply = ask_dir / "answer.json"
        payloads = bundle.get("extensions", {}).get("evidencebook/payloads", {})
        kept = (out_h.get("payload_commitments") or [None])[0]
        if not reply.is_file() or kept not in payloads or sha256(reply.read_bytes()) != kept:
            errs.append(f"{name}: the reply bytes are not the ones the response record keeps")
        else:
            outcome, refused = verifier.check(ask_dir / "request.json", reply, adv["node_key"],
                                              adv["checkpoint_key"])
            if outcome != st.get("outcome"):
                errs.append(f"{name}: the reply does not verify again under the listed key: "
                            f"{refused or outcome}")
        if st.get("outcome") == "refusal" and policy_answers(request, adv):
            what = "stranger-safe" if stranger_safe(request, adv) else "answered to this asker"
            verdict_r = refusal_verdict(st.get("reason"), request_profile(request))
            if verdict_r == "fail":
                errs.append(f"{name}: {asked(request)} is refused ({st.get('reason')}), but the advertised policy "
                            f"lists it as {what}")
            elif verdict_r == "not_checked":
                if not_checked is not None:
                    merge(not_checked, [refusal_not_checked(f"{name}: the refusal of {asked(request)}",
                                                            st.get("reason"))])
                return errs, None  # not judged allowed, so not counted as answered
        answered = None if errs else recorded_at
        return errs, answered
    if out_h.get("record_type") != "recorded_absence" or st.get("outcome") != "recorded_absence":
        return errs + [f"{name}: the outcome record is a {out_h.get('record_type')}, neither a response nor an "
                       "absence"], None
    window = st.get("window", {})
    try:
        opened, closed = utc(window.get("opened")), utc(window.get("closed"))
    except ValueError as e:
        return errs + [f"{name}: the absence window is malformed ({e})"], None
    if opened.replace(microsecond=0) != sealed_at.replace(microsecond=0):
        errs.append(f"{name}: the absence window opens at {window.get('opened')}, not at the request record")
    if closed < deadline:
        errs.append(f"{name}: the absence was recorded with its window closing at {window.get('closed')}, before "
                    f"the deadline {stamp(deadline)}")
    delivered = [utc(e["at"]) for e in events if e["event"] == "delivered"]
    if any(at <= deadline for at in delivered):
        errs.append(f"{name}: the reply was delivered by the deadline {stamp(deadline)}, but the outcome is an "
                    "absence")
    return errs, None


def asked(request):
    return "+".join([*request.get("subject", {}), *([request["derivation"]] if "derivation" in request else [])])


def judge_pair(pair_dir, adv_dir, asker_key, capsulectl, work, not_checked=None):
    """(errors, [(answered_at, ask)], proof paths relative to pair_dir, line) for one asker's asks of one node."""
    pair_dir = Path(pair_dir)
    adv, errs = advertisement(adv_dir)
    proof = ["carrier.jsonl"]
    if adv is None:
        return errs, [], proof, "the asked node's advertisement does not verify"
    events = [json.loads(line) for line in (pair_dir / "carrier.jsonl").read_text().splitlines()]
    verifier = Verifier(work, capsulectl)
    answered, outcomes = [], []
    sent = sorted({e["ask"] for e in events if e["event"] == "sent"})
    for name in sorted({*sent, *(d.name for d in pair_dir.iterdir() if d.is_dir())}):
        d = pair_dir / name
        if not (d / "outcome.bundle.json").is_file():
            errs.append(f"{name}: sent, but neither answered nor recorded absent")
            continue
        proof += [f"{name}/{f.name}" for f in sorted(d.iterdir()) if f.is_file()]
        verdict, verrs = verify_bundle(d / "outcome.bundle.json", capsulectl)
        if verrs:
            errs += [f"{name}: {e}" for e in verrs]
            continue
        e, at = judge_ask(d, adv, asker_key, [x for x in events if x["ask"] == name], verdict, verifier, not_checked)
        errs += e
        if at is not None:
            answered.append((at, name))
        st = disclosed(load(d / "outcome.bundle.json"), load(d / "outcome.bundle.json")["root"]) or {}
        outcomes.append(f"{name} {st.get('statement', {}).get('outcome', '?')}")
    return errs, answered, proof, ", ".join(outcomes)


def judge_run(out, nodes_keys, capsulectl, tmp, not_checked=None):
    """Judge every <asker>/asks/<asked>/ under out. Returns (failures, answered, proof, lines)."""
    out = Path(out)
    failures, answered, proof, lines = [], [], [], []
    for asker, key in nodes_keys.items():
        if not (out / asker / "asks").is_dir():
            continue
        for pair_dir in sorted((out / asker / "asks").iterdir()):
            asked_name = pair_dir.name
            adv_dir = out / asked_name / "advertised"
            errs, ans, p, line = judge_pair(pair_dir, adv_dir, key, capsulectl,
                                            Path(tmp) / f"verify-{asker}-{asked_name}", not_checked)
            failures += [f"{asker} asked {asked_name}: {e}" for e in errs]
            answered += [(at, f"{asker} asked {asked_name} {name}") for at, name in ans]
            proof += [f"{asker}/asks/{asked_name}/{x}" for x in p]
            if adv_dir.is_dir():
                merge(proof, [f"{asked_name}/advertised/{f}" for f in ADVERTISED if (adv_dir / f).is_file()])
            lines.append(f"{asker} asked {asked_name}: {line}")
    return failures, answered, proof, lines


def run_book(pop, out, tmp):
    capsulectl = tools()
    if not capsulectl.is_file():
        raise SystemExit(f"07-ask: no capsulectl at {capsulectl}; run steps/07-ask.setup.sh")
    for n in pop["nodes"]:  # a rerun into the same --out starts clean, as the reporter backend does
        shutil.rmtree(Path(out) / n["name"], ignore_errors=True)
    nodes = [join(n, tmp, capsulectl, out) for n in pop["nodes"]]
    asks = {name: (spec, Ask) for name, spec in ASKS.items()}
    run_asks([(out, asker, asked, asks) for asker in nodes for asked in nodes if asker is not asked])
    not_checked = []
    failures, answered, proof, lines = judge_run(out, {n.name: n.key for n in nodes}, capsulectl, tmp, not_checked)
    return failures, not_checked, answered, proof, lines


# --- Backend "reporter": Mesh nodes, asked through the daily reporter ---------
def commitment_time(doc):
    """A commitment's issued_at as an aware datetime, or None when it is not a UTC `...Z` timestamp."""
    text = doc.get("issued_at")
    try:
        return dt.datetime.strptime(text, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc)
    except (TypeError, ValueError):
        return None


def live_commitment(entry):
    """(advertised, [not_checked]) for a live node: the newest by `issued_at` of the node's signed commitments that
    verify, among its join records under lab/runs and its published one under nodes/commitments.

    The pinned plugin signs a different policy after a plugin move, and lab/runs is only as fresh as the last
    lab pack, while the published commitment is the one step 03 verifies against the listed key. Only a record
    that verifies and has a UTC `issued_at` is ranked, so an unusable newer record cannot hide a good one; each
    one skipped is named in not_checked. A tie goes to the published record.
    """
    found = sorted(LAB_RUNS.glob("*/join/*/commitment.json"))
    published = PUBLISHED / f"{entry.get('node_id')}.json"
    if published.is_file():
        found.append(published)  # last, so a tie in issued_at goes to it
    ranked, skipped = [], []  # ranked: (issued_at, position, path, advertised); skipped: (issued_at or None, note)
    for order, path in enumerate(found):
        node_record = path == published  # the published file is this node's by name; a join dir may be another's
        try:
            doc = load(path)
            if not isinstance(doc, dict):
                raise ValueError("not a JSON object")
        except (OSError, ValueError) as e:
            if node_record:
                skipped.append((None, note(path, [f"not readable ({e})"])))
            continue
        if doc.get("key_id") != entry.get("key_id"):
            if node_record:
                skipped.append((None, note(path, ["names a key other than the node's listed key"])))
            continue
        adv, errs = advertisement(path.parent, path.name)
        issued = commitment_time(doc)
        if adv is not None and issued is None:
            errs = ["issued_at is not a UTC timestamp (YYYY-MM-DDTHH:MM:SSZ)"]
        if errs:
            skipped.append((issued, note(path, errs)))
        else:
            ranked.append((issued, order, path, adv))
    if not ranked:
        return None, [n for _, n in skipped] or [{
            "what": "the deadline (answers_within)", "issue": NO_COMMITMENT_ISSUE,
            "why": "no signed commitment for the node's listed key under lab/runs or nodes/commitments"}]
    issued, _, path, adv = max(ranked, key=lambda r: r[:2])
    adv["commitment"] = str(path.relative_to(ROOT) if path.is_relative_to(ROOT) else path)
    # A skipped record is named only if it could have been the choice: its time is unknown or not older than the
    # winner's. An older one that no longer verifies cannot change the outcome and would never clear.
    return adv, [n for t, n in skipped if t is None or t >= issued]


def note(path, errs):
    """The not_checked entry for a commitment record the live ask did not use."""
    return {"what": "the deadline (answers_within): a commitment record of the node",
            "why": f"{path.relative_to(ROOT) if path.is_relative_to(ROOT) else path}: {'; '.join(errs)}",
            "issue": NO_COMMITMENT_ISSUE}


def ask_posted(console, entry, node_dir, stem, at, timeout, posted):
    """daily_report.ask_attempt for one question, noting in `posted` when its request went out: the attempt looks
    the node's key up first, and that is not part of the answer time."""
    real = daily_report.http

    def http(method, *args):
        if method == "POST":
            posted.append(dt.datetime.now(dt.timezone.utc))
        return real(method, *args)

    daily_report.http = http
    try:
        return daily_report.ask_attempt(console, entry, node_dir, [stem], at, "by=ask", timeout)
    finally:
        daily_report.http = real


def judge_live_line(stem, line, entry, profile=PROFILE_V0):
    """step 12's verdict on a reporter line, except a refusal of a stranger-safe question: that is judged by its
    reason (refusal_verdict), as the book backend judges it."""
    qname = daily_report.QUESTION_NAMES[stem]
    safe = entry.get("disclosure", {}).get("stranger_safe", list(daily_report.QUESTION_NAMES.values()))
    if line.split(" ", 1)[0] != "refusal":
        return step12.judge_reporter_line(stem, line, entry)
    if "listed_key=match" not in line.split():  # a refusal is signed too: under the listed key, like an artifact
        return f"the {qname} refusal is signed under a key that is not the listed key: {line}", None
    if qname not in safe:
        return None, None
    reason = next((w[len("reason="):] for w in line.split() if w.startswith("reason=")), None)
    verdict = refusal_verdict(reason, profile)
    if verdict == "fail":
        return f"the {qname} answer is refused ({reason}), but the node lists it as stranger-safe: {line}", None
    if verdict == "not_checked":
        return None, refusal_not_checked(f"the refusal of {qname}", reason)
    return None, None


# --- The asker's sealed records (the pinned plugin's ask book, capsules-plugin PR #110) -------------
BOOK_BLOCK = "evidence_book_entry"
ABSENCE_RECORD = "recorded_absence"
MINIMUM_ABSENCE_WINDOW = dt.timedelta(seconds=60)  # evidencebook MINIMUM_ABSENCE_WINDOW_SECONDS
OPEN_WINDOW_WAIT = dt.timedelta(seconds=90)  # the longest the step waits for a window to close to read its absence


def ledger_lines(path, raw=None):
    """The JSON object lines of a ledger file (or of `raw`, its bytes as read); None when it cannot be read."""
    pairs = ledger_numbered(path, raw)
    return None if pairs is None else [rec for _, rec in pairs]


def ledger_numbered(path, raw=None):
    """(line number, record) of the JSON object lines of a ledger file (or of `raw`, its bytes as read), numbered
    from 0 as the ledger counts lines (a leaf of its checkpoint); None when it cannot be read."""
    try:
        text = Path(path).read_text(encoding="utf-8") if raw is None else raw.decode("utf-8")
    except (OSError, UnicodeDecodeError):
        return None
    out = []
    for n, line in enumerate(text.split("\n")):
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if isinstance(rec, dict):
            out.append((n, rec))
    return out


def ask_records(ledger, raw=None, numbered=False):
    """The ask-book records of a node's capsules ledger, in ledger order, as (capsule_id, header); with `numbered`,
    as (capsule_id, header, line number). None when the ledger cannot be read. `raw` is the ledger's bytes when the
    caller has read them."""
    recs = ledger_numbered(Path(ledger) / "capsules.jsonl", raw)
    if recs is None:
        return None
    records = []
    for n, rec in recs:
        att = rec.get("model_attestation")
        comp = att.get("compute_attestation") if isinstance(att, dict) else None
        header = comp.get(BOOK_BLOCK) if isinstance(comp, dict) else None
        if isinstance(header, dict) and isinstance(rec.get("capsule_id"), str):
            records.append((rec["capsule_id"], header, n) if numbered else (rec["capsule_id"], header))
    return records


def request_digest(request):
    try:
        return sha256(check_commitment.canonical(request))
    except ValueError:
        return None


def ask_bracket(posted, back):
    """The times an ask's sealed evidence_request may carry: committed_at has whole seconds."""
    return posted - dt.timedelta(seconds=1), back + dt.timedelta(seconds=1)


def is_ask_request(h, node_id, request, lo, hi):
    """Whether an ask-book header is the evidence_request the plugin sealed for this ask: to the node, of the
    question, committed within [lo, hi]."""
    st = (h.get("statement") or {}) if isinstance(h, dict) else {}
    sent = (st.get("request") or {}) if isinstance(st, dict) else {}
    if not isinstance(sent, dict):
        return False
    try:
        at = utc(h.get("committed_at"))
    except ValueError:
        return False
    return (h.get("record_type") == REQUEST_RECORD and lo <= at <= hi
            and (st.get("responder_ref") == node_id or sent.get("audience") == node_id)
            and all(sent.get(k) == v for k, v in request.items())  # the plugin only adds audience, nonce, auth
            and sent.get("derivation") == request.get("derivation"))


def window_close(req_h, within):
    """The earliest an absence for this sealed request may close: the later of the minimum absence window, the
    commitment's answers_within and the request's own deadline, each from the seal."""
    sealed = utc(req_h["committed_at"])
    close = sealed + MINIMUM_ABSENCE_WINDOW
    if within is not None:
        close = max(close, sealed + within)
    if req_h["statement"]["request"].get("deadline"):
        close = max(close, utc(req_h["statement"]["request"]["deadline"]))
    return close


def citing(records, rids):
    """The outcome records (index, id, header) that cite one of `rids`."""
    return [(i, orid, h) for i, (orid, h) in enumerate(records)
            if h.get("record_type") in (RESPONSE_RECORD, ABSENCE_RECORD)
            and any(isinstance(l, dict) and l.get("type") == "cites" and l.get("target") in rids
                    for l in h.get("links") or [])]


def select_ask(records, node_id, request, posted, back):
    """(found, got) of one ask in a node's ask-book `records` (ask_records with numbered=True): every
    evidence_request the plugin sealed for the ask, and every outcome record citing one, each as
    (index in records, capsule_id, header, line number). The one selection both the live read (ledger_extract) and
    the check against the kept copy (judge_ledger_proof) make."""
    lo, hi = ask_bracket(posted, back)
    found = [(i, rid, h, n) for i, (rid, h, n) in enumerate(records) if is_ask_request(h, node_id, request, lo, hi)]
    rids = {rid for _, rid, _, _ in found}
    got = [(i, orid, h, records[i][2]) for i, orid, h in citing([(r, h) for r, h, _ in records], rids)]
    return found, got


def extract_rows(items):
    return [{"index": i, "record": rid, "header": h, "line": n} for i, rid, h, n in items]


def ledger_extract(ledger, node_id, request, posted, back, saw, within):
    """What judge_sealed reads of the asker's ledger for one ask, kept as the ask's <stem>.ledger.json so the judge
    runs again on the proof alone (step 08): whether the ledger was read, when, every evidence_request the plugin
    sealed for this ask and every outcome record citing one, each with its position in the ledger.

    An outcome not sealed yet, for an ask the reporter saw unanswered, is waited for while its window closes
    within OPEN_WINDOW_WAIT."""
    def read():
        """(records, held) from one read of the ledger: `held` is its sha256 and line count, so the extract can be
        audited against the node later (loop#193)."""
        try:
            raw = (Path(ledger) / "capsules.jsonl").read_bytes()
        except OSError:
            return None, None
        return ask_records(ledger, raw, numbered=True), {"sha256": sha256(raw), "lines": len(raw.splitlines())}

    records, held = read() if ledger else (None, None)
    if records is None:
        return {"ledger": None, "read_at": stamp(now())}
    found, got = select_ask(records, node_id, request, posted, back)
    if len(found) == 1 and saw not in ("verified", "refusal"):
        close = window_close(found[0][2], within)
        while not got and now() < close + dt.timedelta(seconds=5) and close - now() <= OPEN_WINDOW_WAIT:
            time.sleep(max(1.0, min(5.0, (close - now()).total_seconds())))
            again, again_held = read()
            if again is not None:
                records, held = again, again_held
                found, got = select_ask(records, node_id, request, posted, back)
    return {"ledger": "read", "read_at": stamp(now()), "held": held, "requests": extract_rows(found),
            "outcomes": extract_rows(got)}


def judge_sealed(extract, node_id, request, posted, back, saw, within, policy_digest=None):
    """(errors, not_checked reasons) for one live ask, from its ledger extract (ledger_extract): its
    evidence_request is in the asker's book, and an evidence_response or a recorded_absence citing it agrees with
    what the reporter saw. `posted` and `back` bracket the ask; `saw` is what the reporter saw: "verified",
    "refusal" or None when it saw no signed answer; `within` is the commitment's answers_within as a timedelta, or
    None; `policy_digest` is the digest of the policy the peer's commitment pins, or None. The wire send is after
    the seal, so the true deadline is no earlier than the seal plus `within`: an absence must close no earlier
    than that.

    The plugin seals a request before it writes it to the stream, and the response it seals cites that request's
    record and the digest of the bytes sent: the digest the sealed request hashes to, which is checked here."""
    errs, notes = [], []
    answered = saw in ("verified", "refusal")
    if not isinstance(extract, dict) or extract.get("ledger") != "read":
        return errs, [LEDGER_GAP]
    try:
        read_at = utc(extract["read_at"])
        found = [(r["index"], r["record"], r["header"]) for r in extract["requests"]]
        got = [(r["index"], r["record"], r["header"]) for r in extract["outcomes"]]
    except (KeyError, TypeError, ValueError) as e:
        return [f"the ask's ledger extract is malformed ({type(e).__name__}: {e})"], []
    lo, hi = ask_bracket(posted, back)
    if not all(isinstance(h, dict) and is_ask_request(h, node_id, request, lo, hi) for _, _, h in found):
        return ["the ask's ledger extract holds a request record that is not this ask's"], []
    if len(found) != 1:
        if not found and not answered:
            return errs, ["the ask did not reach the plugin's ask book (no evidence_request in the asker's ledger "
                          "for it)"]
        return [f"the asker's ledger holds {len(found)} sealed evidence_request records for this ask, not one"], []
    index, rid, req_h = found[0]
    if any(not isinstance(h, dict) for _, _, h in got) or len(citing([(o, h) for _, o, h in got], {rid})) != len(got):
        return ["the ask's ledger extract holds an outcome record that does not cite the request"], []
    sealed = utc(req_h["committed_at"])
    digest = request_digest(req_h["statement"]["request"])
    close = window_close(req_h, within)
    if len(got) > 1:
        return [f"{len(got)} outcome records cite the request, not one"], []
    if not got:
        if read_at < close:
            return errs, [f"the ask's window closes at {stamp(close)}, after this read; its outcome is not sealed yet"]
        return [f"no outcome sealed for the request: its window closed at {stamp(close)} with no evidence_response "
                "or recorded_absence"], []
    oi, orid, out_h = got[0]
    st = out_h.get("statement") or {}
    if oi <= index:
        errs.append("the outcome record precedes the request record in the ledger")
    if digest is None or st.get("request_digest") != digest:
        errs.append("the outcome record names another request than the one sealed (request_digest differs)")
    if out_h.get("record_type") == RESPONSE_RECORD:
        if st.get("outcome") not in ANSWERED:
            errs.append(f"the response was recorded as {st.get('outcome')}, neither an artifact nor a refusal")
        elif answered and st.get("outcome") != ("artifact" if saw == "verified" else "refusal"):
            errs.append(f"the response was recorded as {st.get('outcome')}, but the reporter saw {saw}")
        if not answered:
            notes.append("the plugin sealed a reply after the reporter's call returned")
        if st.get("outcome") == "refusal":
            check = (st.get("verification") or {}).get("policy_check")
            check = check if isinstance(check, dict) else {}
            status, shown = check.get("status"), check.get("policy_digest")
            if status == "MISMATCH":
                errs.append("the refusal is checked against the policy the peer's commitment pins and does not match")
            elif status == "NOT_CHECKED":
                notes.append("the refusal's policy check (capsules-plugin PR #112) is NOT_CHECKED in the sealed record: "
                             f"{check.get('why')}")
            elif status != "MATCH":
                errs.append(f"the refusal's policy_check has no status the step knows ({status!r}); it must be "
                            "MATCH, MISMATCH or NOT_CHECKED")
            if status in ("MATCH", "MISMATCH") or shown is not None:
                if policy_digest is None:
                    notes.append("the peer's commitment is not at hand, so the refusal's policy_check cannot be tied to "
                                 "the policy it pins")
                elif shown != policy_digest:
                    errs.append(f"the refusal's policy_check names policy {shown}, not the {policy_digest} the peer's "
                                "commitment pins")
    else:
        window = st.get("window") or {}
        try:
            opened, closed = utc(window.get("opened")), utc(window.get("closed"))
        except ValueError as e:
            return errs + [f"the absence window is malformed ({e})"], notes
        if opened != sealed:
            errs.append(f"the absence window opens at {window.get('opened')}, not at the request record {req_h['committed_at']}")
        if closed < close:
            errs.append(f"the absence closes its window at {window.get('closed')}, before {stamp(close)}")
        if answered:
            errs.append("the plugin recorded an absence, but the reporter saw a signed answer")
    return errs, notes


# --- The exchange ask: about a half the asked node holds from the asker (step 05's deal half) -------------------
EXCHANGE = "exchange"
COUNTERPARTY_HALF = "counterparty_half"
EXCHANGE_GAP = ("the asker's ledger and the asked node's data_dir (ledger/received-capsules.jsonl and "
                "ledger/capsules.jsonl) must be readable to name a half the asked node holds from the asker")


def exchange_subject(node, asker_data_dir):
    """(half id, None) or (None, why not): the newest half the asked node holds that the asker's own chain also
    holds (the asker sent it) and that the asked node's chain cites as `counterparty_half`, so the asked node's
    policy answers the asker an exchange request about it. The ids come from the two ledgers, not from the asked
    node's word."""
    held = live.readable(node, "data_dir", "ledger/received-capsules.jsonl", "ledger/capsules.jsonl")
    if held is None or asker_data_dir is None:
        return None, EXCHANGE_GAP
    sent = ledger_lines(Path(asker_data_dir) / "ledger" / "capsules.jsonl")
    got = ledger_lines(held / "ledger" / "received-capsules.jsonl")
    chain = ledger_lines(held / "ledger" / "capsules.jsonl")
    if sent is None or got is None or chain is None:
        return None, EXCHANGE_GAP
    mine = {r["capsule_id"] for r in sent if isinstance(r.get("capsule_id"), str)}
    cited = {ref.get("digest") for r in chain if isinstance(r.get("references"), list)
             for ref in r["references"] if isinstance(ref, dict) and ref.get("citation_purpose") == COUNTERPARTY_HALF
             and isinstance(ref.get("digest"), str)}
    for r in reversed(got):
        cid = r.get("capsule_id")
        if isinstance(cid, str) and cid in mine and cid in cited:
            return cid, None
    return None, ("the asked node holds no half the asker sent that its own chain cites as a counterparty half "
                  "(step 05's live run leaves them)")


def exchange_question(half, profile=PROFILE_V1):
    """The exchange request about `half`, as the plugin answers it (subject = the half's id, pinned to it). Asked
    under evidence-interop/1, where a policy refusal is a statement about policy, so 07 can judge it
    (capsules-plugin#114). Runs before that asked it under /0; their proofs are judged under the profile they record
    (expected_question)."""
    return {"profile": profile, "coverage": {"expected_pin": half}, "subject": {EXCHANGE: half}}


def expected_question(stem, half, request):
    """The question an attempt's sealed request must be: for the exchange ask, the exchange question under the profile
    the proof records (/0 for runs before /1, /1 since), so an earlier proof is judged as it was recorded; for the
    others, the reporter's question."""
    if stem == EXCHANGE:
        recorded = request.get("profile") if isinstance(request, dict) else None
        return exchange_question(half, recorded if recorded in (PROFILE_V0, PROFILE_V1) else PROFILE_V1)
    return daily_report.QUESTIONS[stem]


class exchange_registered:
    """Registers the exchange question with the reporter's ask for the length of a node's asks (None: nothing)."""

    def __init__(self, half):
        self.half = half

    def __enter__(self):
        if self.half:
            daily_report.QUESTIONS[EXCHANGE] = exchange_question(self.half)
            daily_report.QUESTION_NAMES[EXCHANGE] = EXCHANGE

    def __exit__(self, *exc):
        daily_report.QUESTIONS.pop(EXCHANGE, None)
        daily_report.QUESTION_NAMES.pop(EXCHANGE, None)


def exchange_records_cite(response, half):
    """Whether a verified exchange answer serves records, and each cites `half` as a counterparty half: (errors,
    reasons it could not be read). The plugin verified the answer; this reads the records it served."""
    try:
        reply = json.loads(Path(response).read_text(encoding="utf-8"))
        answer = reply["answer"]
        artifact = answer.get("artifact") or answer["envelope"]["artifact"]
        body = json.loads(base64.urlsafe_b64decode(artifact + "=" * (-len(artifact) % 4)))
        served = [json.loads(bytes.fromhex(r["body"])) for r in body["records"]]
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return [], ["the served exchange records could not be read from the answer"]
    if not served:
        return ["the exchange answer serves no record, but the asked node cites the half"], []
    def cites(r):
        refs = r.get("references") if isinstance(r, dict) else None
        return isinstance(refs, list) and any(
            isinstance(x, dict) and x.get("citation_purpose") == COUNTERPARTY_HALF and x.get("digest") == half
            for x in refs)

    bad = [r for r in served if not cites(r)]
    return ([f"{len(bad)} of {len(served)} served records do not cite the asked half as a counterparty half"]
            if bad else []), []


def judge_exchange_line(line, entry, profile=PROFILE_V0):
    """(failure or None, not_checked or None) for the exchange ask's reporter line. The asker is a counterparty
    holding a half the node cites, so a refusal is judged by its reason: a withholding or unnamed reason is a FAIL
    (the policy answers it), an ambiguous one is not checked, and a request-blaming one is fine, except coverage_unsatisfiable (the
    no_checkpoint_yet line): its key is checked and the ask is left NOT_CHECKED on loop#94."""
    if line.split(" ", 1)[0] not in ("refusal", "no_checkpoint_yet"):  # coverage_unsatisfiable reads as the latter
        return step12.judge_reporter_line(EXCHANGE, line, entry)
    if "listed_key=match" not in line.split():
        return f"the exchange refusal is signed under a key that is not the listed key: {line}", None
    reason = next((w[len("reason="):] for w in line.split() if w.startswith("reason=")), None)
    verdict = refusal_verdict(reason, profile)
    if verdict == "ok" and line.startswith("no_checkpoint_yet"):  # the request names a pin the node may not have cut
        return None, {"what": "the exchange ask", "why": f"the node refused it as unsatisfiable coverage: {line}",
                      "issue": EXCHANGE_ISSUE}
    if verdict == "fail":
        return (f"the exchange answer is refused ({reason}), but the asker holds a half the node cites as a "
                f"counterparty half: {line}"), None
    if verdict == "not_checked":
        return None, refusal_not_checked("the refusal of the exchange ask", reason)
    return None, None


# What the reporter backend keeps beside the attempts, so its judge reads only the proof (judge_reporter).
ASK_FILE = "ask.json"  # which node was asked through which console, or why it was not asked
SUBJECT_FILE = "exchange-subject.json"  # per node: the half the exchange ask is about, or why there is none
COMMITMENT_DIR = "commitment"  # per node: the commitment the deadline came from, its policy, and choice.json
OWN_NODE = "the reporter's own node and no second console"
ASKER_LEDGER = "asker-ledger"  # per asker: the whole ledger/capsules.jsonl the checkpoint replies cover (loop#276)
ASKER_UNNAMED = "console"  # the asker's directory when its node is not named, so no listed key checks its replies
CHECKPOINT_SUFFIX = ".checkpoint.json"  # per ask: the asker's ledger-checkpoint reply, or the refusal text
NO_LISTING = "no nodes/ entry"


def run_reporter(pop, out, console, timeout=30, self_node=None, second_console=None, console_data_dir=None,
                 second_data_dir=None, second_node=None):
    """Ask each live node through the reporter's console and keep, under `out`, everything judge_reporter reads:
    the attempts, each ask's timing and ledger extract, each node's exchange subject and ask.json. Returns
    judge_reporter's verdict on those files, so the finding is a function of its proof (step 08 runs it again)."""
    console_data_dir, second_data_dir = (Path(os.path.expandvars(d)) if d else None
                                         for d in (console_data_dir, second_data_dir))
    if console_data_dir is None and self_node:  # the reporter's console is its own node's: the node's data_dir
        own = next((n for n in pop["nodes"] if n["name"] == self_node), {})
        console_data_dir = live.readable(own, "data_dir", "ledger/capsules.jsonl")
    out = Path(out)
    for n in pop["nodes"]:  # a rerun into the same --out starts clean
        shutil.rmtree(out / n["name"], ignore_errors=True)
    shutil.rmtree(out / ASKER_LEDGER, ignore_errors=True)
    asked = {}
    pending = []  # the asks whose extract is made again from the kept copy of the asker's ledger
    askers = {}  # asker's directory name under ASKER_LEDGER -> its ledger dir
    for node in pop["nodes"]:
        name = node["name"]
        asker, via, ledger, asker_node = console, "the reporter's console", console_data_dir, self_node
        if self_node and name == self_node:
            if not second_console:
                asked[name] = {"asked": False, "why": OWN_NODE}
                continue
            asker, via, ledger, asker_node = second_console, "a second node's console", second_data_dir, second_node
        try:
            entry = step12.listed_entry(node)
        except FileNotFoundError:
            asked[name] = {"asked": False, "why": NO_LISTING}
            continue
        adv, ncs = live_commitment(entry)
        node_dir = out / name
        node_dir.mkdir(parents=True)
        keep_commitment(node_dir, adv, ncs)
        half, why = exchange_subject(node, ledger)
        write_json(node_dir / SUBJECT_FILE, {"half": half, "why": why})
        asked[name] = {"asked": True, "via": via, "asker": asker_node}
        asker_dir = asker_node or ASKER_UNNAMED
        if ledger:
            askers[asker_dir] = Path(ledger) / "ledger"
        # One attempt per question, so each answer has its own send and receive times.
        last = None
        stems = [*daily_report.QUESTIONS, *([EXCHANGE] if half else [])]
        with exchange_registered(half):
            for stem in stems:
                while last is not None and daily_report.utc_now().replace(microsecond=0) <= last:
                    time.sleep(0.05)  # an attempt is named by its second: one per node per second
                at = last = daily_report.utc_now()
                last = last.replace(microsecond=0)
                posted = []
                result = ask_posted(asker, entry, node_dir, stem, at, timeout, posted)
                back = now()
                attempt = layout.attempts(node_dir)[-1]
                sent = posted[0] if posted else at  # the request's own send time, not the key lookup before it
                sent_at = sent if sent.tzinfo else sent.replace(tzinfo=dt.timezone.utc)
                write_json(attempt / "timing.json", {
                    "asked_at": stamp(sent_at), "back_at": stamp(back),
                    "answers_within": adv["answers_within"] if adv else None,
                    "deadline": stamp(sent_at + adv["within"]) if adv else None,
                    "commitment": adv["commitment"] if adv else None,
                    "late": adv is not None and back > sent_at + adv["within"]})
                for stem, line in result.items():
                    saw = line.split(" ", 1)[0]
                    write_json(attempt / f"{stem}.ledger.json", ledger_extract(
                        Path(ledger) / "ledger" if ledger else None, entry["node_id"], daily_report.QUESTIONS[stem],
                        sent_at, back, saw if saw in ("verified", "refusal") else None,
                        adv["within"] if adv else None))
                    if ledger:  # after the ask's outcome is sealed (the extract's last read): the asker's checkpoint
                        write_json(attempt / f"{stem}{CHECKPOINT_SUFFIX}", {
                            "asker": asker_node, **ledger_proof.fetch(asker, ledger_proof.CHAIN, timeout,
                                                                      daily_report.http)})
                        pending.append((attempt, stem, entry["node_id"], sent_at, back, asker_dir))
    keep_askers(out, askers, pending)
    write_json(out / ASK_FILE, {"self_node": self_node, "second_console": bool(second_console), "nodes": asked})
    return judge_reporter(pop, out)


def keep_askers(out, askers, pending):
    """Keep each asker's whole ledger/capsules.jsonl (read once, after every checkpoint reply it gave: the chain only
    grows, so each reply's first lines are a prefix of this copy), then make each checked ask's extract again from
    the first lines its reply covers, so the extract is the selection judge_ledger_proof repeats over the same
    bytes. A copy keeps every line, a payment preimage's value replaced (live.copy_redacted)."""
    kept = {}
    for name, ledger_dir in askers.items():
        try:
            ledger_proof.keep_copy(ledger_dir / ledger_proof.CHAIN, Path(out) / ASKER_LEDGER / name / ledger_proof.CHAIN)
            kept[name] = (Path(out) / ASKER_LEDGER / name).joinpath(ledger_proof.CHAIN).read_bytes()
        except OSError:
            continue
    for attempt, stem, node_id, sent_at, back, name in pending:
        try:
            ck, extract = load(attempt / f"{stem}{CHECKPOINT_SUFFIX}"), load(attempt / f"{stem}.ledger.json")
            n = ledger_proof.covered(ck["reply"]) if ck.get("reply") else None
            cut = ledger_proof.prefix(kept[name], n) if n and name in kept else None
            if cut is None or extract.get("ledger") != "read":
                continue
            records = ask_records(Path(out) / ASKER_LEDGER / name, cut, numbered=True)
            found, got = select_ask(records, node_id, load(attempt / f"{stem}.request.json"), sent_at, back)
        except (OSError, ValueError, KeyError, TypeError):
            continue
        extract.update({"held": {"sha256": sha256(cut), "lines": n}, "requests": extract_rows(found),
                        "outcomes": extract_rows(got)})
        write_json(attempt / f"{stem}.ledger.json", extract)


def keep_commitment(node_dir, adv, ncs):
    """Copy the commitment live_commitment chose, and the policy it pins, into <node>/commitment/, with choice.json
    naming where it came from and the records it skipped. The judge reads this copy, so a commitment re-signed or a
    lab pack made after the ask does not change the verdict on it."""
    d = Path(node_dir) / COMMITMENT_DIR
    d.mkdir(parents=True)
    if adv is not None:
        src = Path(adv["commitment"])
        src = src if src.is_absolute() else ROOT / src
        shutil.copyfile(src, d / "commitment.json")
        (d / adv["policy_uri"]).parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src.parent / adv["policy_uri"], d / adv["policy_uri"])
    write_json(d / "choice.json", {"commitment": adv["commitment"] if adv else None, "not_checked": ncs})


def kept_commitment(node_dir, entry):
    """(advertised or None, [not_checked], [errors]) from the commitment keep_commitment copied: it is under the
    node's listed key, has a UTC issued_at and verifies with step 03's checker against the policy copied beside it."""
    d = Path(node_dir) / COMMITMENT_DIR
    try:
        choice = load(d / "choice.json")
        chosen, ncs = choice["commitment"], choice["not_checked"]
        if not isinstance(ncs, list) or not all(isinstance(n, dict) for n in ncs):
            raise TypeError("not_checked is not a list of entries")
    except (OSError, ValueError, KeyError, TypeError) as e:
        return None, [], [f"{COMMITMENT_DIR}/choice.json is not readable ({type(e).__name__}: {e})"]
    if chosen is None:  # live_commitment always says why it chose none: a choice with no reason is not one
        return None, ncs, [] if ncs else [f"{COMMITMENT_DIR}/choice.json names no commitment and no reason why"]
    try:
        doc = load(d / "commitment.json")
        uri = Path(doc["lcap"]["policy_uri"])
    except (OSError, ValueError, KeyError, TypeError) as e:
        return None, ncs, [f"the kept commitment is not readable ({type(e).__name__}: {e})"]
    if doc.get("key_id") != entry.get("key_id"):
        return None, ncs, ["the kept commitment names a key other than the node's listed key"]
    if uri.is_absolute() or ".." in uri.parts:
        return None, ncs, [f"the kept commitment's policy_uri {str(uri)!r} is not a path beside it"]
    if commitment_time(doc) is None:
        return None, ncs, ["the kept commitment's issued_at is not a UTC timestamp (YYYY-MM-DDTHH:MM:SSZ)"]
    adv, errs = advertisement(d, "commitment.json")
    if errs:
        return None, ncs, errs
    adv["commitment"] = chosen
    return adv, ncs, []


def reporter_line(attempt, stem, listed):
    """(line, error or None): the attempt's verification line for `stem`. When the attempt holds the reply, the
    line is computed again from it, the announced key (peer-key.json) and the listed key, and must be the line
    kept; with no reply, the kept line may not claim one."""
    try:
        kept = (attempt / f"{stem}.verification").read_text(encoding="utf-8").strip()
    except OSError:
        return None, f"the attempt holds no {stem}.verification"
    reply = attempt / f"{stem}.response.json"
    if not reply.is_file():
        if kept.split(" ", 1)[0] in ("verified", "refusal", "no_checkpoint_yet", "no_announced_key"):
            return kept, f"the verification line claims a reply the attempt does not hold: {kept}"
        return kept, None
    announced = None
    try:
        said_key = json.loads((attempt / "peer-key.json").read_text(encoding="utf-8"))
        key = said_key.get("announced_key_id") if isinstance(said_key, dict) else None
        announced = key if isinstance(key, str) and daily_report.HEX64.match(key) else None
    except (OSError, ValueError):
        pass
    again = daily_report.verification_line(200, reply.read_bytes(), None, announced, listed)
    if again != kept:
        return kept, f"the verification line kept ({kept}) is not the one its reply gives ({again})"
    return kept, None


def attempt_stems(node_dir):
    """{stem: [attempt dirs]} of a node's attempts, by the <stem>.request.json each holds."""
    found = {}
    for a in layout.attempts(node_dir):
        for r in sorted(a.glob("*.request.json")):
            found.setdefault(r.name[:-len(".request.json")], []).append(a)
    return found


ENVELOPE_SIGNED = ("profile", "request_digest", "subject", "derivation", "anchor", "artifact_digest", "verification",
                   "responder", "issued_at")  # evidence-interop §6.2: the members an answer's signature covers
REFUSAL_SIGNED = ("issued_at", "reason", "request_digest")  # §6.3


def verify_reply_signature(reply_path, extract, listed_key):
    """Errors for one reply, offline and in this process: its signed answer (the artifact envelope or the signed
    refusal) verifies under the node's listed key, whatever the plugin's own `verification` says (loop#193). An
    artifact's digest must be the SHA-256 of its bytes. When the asker's ledger extract holds one sealed request, the
    answer's request_digest must also be that request's digest; without it the signature is still verified and the
    binding is left to judge_sealed, which fails or names a missing sealed request."""
    try:
        reply = json.loads(Path(reply_path).read_text(encoding="utf-8"))
        answer = reply["answer"]
        if not isinstance(answer, dict):
            raise TypeError("answer is not an object")
    except (OSError, ValueError, KeyError, TypeError) as e:
        return [f"the reply carries no signed answer ({type(e).__name__}: {e})"]
    errs = []
    sealed = (extract or {}).get("requests") if isinstance(extract, dict) else None
    if isinstance(sealed, list) and len(sealed) == 1:
        try:
            digest = request_digest(sealed[0]["header"]["statement"]["request"])
        except (KeyError, TypeError):
            digest = None
        if digest is None or answer.get("request_digest") != digest:
            errs.append("the signed answer is not for the request the asker's ledger sealed")
    if "artifact" in answer:
        key, members = answer.get("responder"), ENVELOPE_SIGNED
        try:
            if sha256(check_commitment.unb64url(answer["artifact"])) != answer.get("artifact_digest"):
                errs.append("the artifact's bytes are not the artifact_digest the answer signs")
        except (ValueError, TypeError):
            errs.append("the artifact is not base64url bytes")
    else:
        key, members = answer.get("key_id"), REFUSAL_SIGNED
    if key != listed_key:
        errs.append(f"the answer is signed by {key}, not the listed key {listed_key}")
    try:
        body = check_commitment.canonical({k: answer[k] for k in members if k in answer})
        sig = bytes.fromhex(answer.get("sig"))
        assert len(sig) == 64 and isinstance(listed_key, str) and len(listed_key) == 64
        spki = check_commitment.ED25519_SPKI + bytes.fromhex(listed_key)
    except (ValueError, TypeError, AssertionError):
        return errs + ["the answer's signature or its signed members are not in the forms §5.2 gives"]
    if not check_commitment.verify_raw(body, sig, spki):
        errs.append("the answer's signature does not verify under the listed key")
    return errs


def judge_reporter(pop, out):
    """(failures, not_checked, answered, proof, lines) of the reporter backend, from the files run_reporter kept
    under `out` and the repository (the nodes/ listings, nodes/commitments and lab/runs) only: no console and no
    data dir is read, so step 08 gets the same verdict from the cited proof."""
    out = Path(out)
    failures, not_checked, answered, proof, lines = [], [], [], [], []
    try:
        ask = load(out / ASK_FILE)
        asked = ask["nodes"]
        if not isinstance(asked, dict):
            raise TypeError("nodes is not an object")
    except (OSError, ValueError, KeyError, TypeError) as e:
        return [f"{ASK_FILE} is not readable ({type(e).__name__}: {e})"], [], [], [], []
    proof.append(ASK_FILE)
    names = [n["name"] for n in pop["nodes"]]
    if sorted(asked) != sorted(names):
        failures.append(f"{ASK_FILE} names nodes {sorted(asked)}, the population {sorted(names)}")
    for node in pop["nodes"]:
        name = node["name"]
        how = asked.get(name) if isinstance(asked.get(name), dict) else {}
        own = name == ask.get("self_node")
        if own and not ask.get("second_console"):
            merge(not_checked, [step12.no_second_console(name)])
            lines.append(f"{name}: not asked, {OWN_NODE}")
            if how.get("asked") is not False:
                failures.append(f"{name}: {ASK_FILE} says it was asked, but it is the reporter's own node and no "
                                "second console was given")
            continue
        try:
            entry = step12.listed_entry(node)
        except FileNotFoundError:
            merge(not_checked, [{"what": f"live node {name}", "why": "node_id not set, or no nodes/<node_id>.json",
                                 "issue": "evidence-network/loop: the live lab run, which fills population/live"}])
            lines.append(f"{name}: not asked, {NO_LISTING}")
            continue
        if how.get("asked") is not True:
            failures.append(f"{name}: not asked ({how.get('why')}), though it is listed and asked through a console")
            continue
        node_dir = out / name
        adv, ncs, bad = kept_commitment(node_dir, entry)
        failures += [f"{name}: {e}" for e in bad]
        merge(not_checked, [{**nc, "what": f"{name}: {nc.get('what')}"} for nc in ncs])
        proof += sorted(str(f.relative_to(out)) for f in (node_dir / COMMITMENT_DIR).rglob("*") if f.is_file())
        try:
            subject = load(node_dir / SUBJECT_FILE)
            half, why = subject["half"], subject["why"]
            if half is not None and not (isinstance(half, str) and daily_report.HEX64.match(half)):
                raise ValueError(f"half {half!r} is neither null nor a capsule id")
        except (OSError, ValueError, KeyError, TypeError) as e:
            failures.append(f"{name}: {SUBJECT_FILE} is not readable ({type(e).__name__}: {e})")
            continue
        proof.append(f"{name}/{SUBJECT_FILE}")
        if half is None:
            merge(not_checked, [{"what": f"{name}: a later exchange request on a Mesh node", "why": why,
                                 "issue": EXCHANGE_ISSUE}])
        stems = [*daily_report.QUESTIONS, *([EXCHANGE] if half else [])]
        found = attempt_stems(node_dir)
        failures += [f"{name}: {s}: {len(found.get(s, []))} attempts in the proof, not one" for s in stems
                     if len(found.get(s, [])) != 1]
        failures += [f"{name}: an attempt asks {s}, which this run does not ask" for s in sorted(found)
                     if s not in stems]
        proof += [str(f.relative_to(out)) for a in layout.attempts(node_dir) for f in sorted(a.iterdir()) if f.is_file()]
        kept = f"{ASKER_LEDGER}/{how.get('asker')}/{ledger_proof.CHAIN}"
        if how.get("asker") and (out / kept).is_file() and kept not in proof:  # none when its ledger was not read
            proof.append(kept)
        said = []
        with exchange_registered(half):
            for stem in stems:
                if len(found.get(stem, [])) != 1:
                    continue
                attempt = found[stem][0]
                qname = daily_report.QUESTION_NAMES[stem]
                try:
                    request = load(attempt / f"{stem}.request.json")
                    timing = load(attempt / "timing.json")
                    sent_at, back = utc(timing["asked_at"]), utc(timing["back_at"])
                except (OSError, ValueError, KeyError, TypeError) as e:
                    failures.append(f"{name}: {qname}: the attempt's request or timing is not readable "
                                    f"({type(e).__name__}: {e})")
                    continue
                if request != expected_question(stem, half, request):
                    failures.append(f"{name}: {qname}: the attempt's request is not the question this step asks")
                    continue
                line, bad = reporter_line(attempt, stem, entry["key_id"])
                if bad:
                    failures.append(f"{name}: {qname}: {bad}")
                    continue
                late = adv is not None and back > sent_at + adv["within"]
                try:
                    extract = load(attempt / f"{stem}.ledger.json")
                except (OSError, ValueError):
                    extract = None
                saw = line.split(" ", 1)[0]
                errs, notes = judge_sealed(extract, entry["node_id"], request, sent_at, back,
                                           saw if saw in ("verified", "refusal") else None,
                                           adv["within"] if adv else None, adv["policy_digest"] if adv else None)
                failures += [f"{name}: {qname}: {e}" for e in errs]
                merge(not_checked, [{"what": f"{name}: {qname}: the sealed request and its outcome", "why": n,
                                     "issue": SEAL_ISSUE} for n in notes])
                if saw in ("verified", "refusal", "no_checkpoint_yet") and (attempt / f"{stem}.response.json").is_file():
                    failures += [f"{name}: {qname}: {e}" for e in
                                 verify_reply_signature(attempt / f"{stem}.response.json", extract, entry["key_id"])]
                if isinstance(extract, dict) and extract.get("ledger") == "read":
                    perrs, pnotes = judge_ledger_proof(out, pop, how, attempt, stem, extract, entry["node_id"],
                                                       request, sent_at, back)
                    failures += [f"{name}: {qname}: {e}" for e in perrs]
                    merge(not_checked, pnotes)
                fail, nc2 = (judge_exchange_line(line, entry, request_profile(request)) if stem == EXCHANGE
                             else judge_live_line(stem, line, entry, request_profile(request)))
                cited_ok = True
                if stem == EXCHANGE and not fail and saw == "verified":
                    cite_errs, cite_notes = exchange_records_cite(attempt / f"{stem}.response.json", half)
                    cited_ok = not cite_errs and not cite_notes
                    failures += [f"{name}: exchange: {e}" for e in cite_errs]
                    merge(not_checked, [{"what": f"{name}: exchange: the served records", "why": n,
                                         "issue": EXCHANGE_ISSUE} for n in cite_notes])
                if fail:
                    failures.append(f"{name}: {fail}")
                if nc2:
                    merge(not_checked, [{**nc2, "what": f"{name}: {nc2['what']}"}])
                if not fail and not nc2 and cited_ok and saw in ("verified", "refusal"):  # a refusal not judged allowed is not one
                    if late:
                        said.append(f"{qname} back after the deadline, counted absent")
                        continue
                    if adv is not None:
                        answered.append((back, f"{name} {qname}"))
                said.append(f"{qname} {step12.said(line)}")
        asked_via = f" (asked through {how.get('via')})" if ask.get("self_node") else ""
        lines.append(f"{name}{asked_via}: " + "; ".join(said))
    return failures, not_checked, answered, proof, lines


LOOP_ISSUE = "evidence-network/loop: step 07's ledger check needs the asker's listed key and loop-ledger-check (steps/ledger-check.setup.sh)"


def predates_checkpoints(ask):
    """Whether ask.json is from a run before loop#276, which named no asker for any node it asked."""
    nodes = ask.get("nodes")
    return not (isinstance(nodes, dict) and any(isinstance(v, dict) and "asker" in v for v in nodes.values()))


def judge_ledger_proof(out, pop, how, attempt, stem, extract, node_id, request, sent_at, back):
    """(errors, not_checked entries) for one ask's ledger extract against the asker's signed ledger checkpoint
    (loop#276): the kept reply verifies, under the key the asker's nodes/ listing gives, for the first lines of the
    kept copy of the asker's ledger; the ask's requests and outcomes picked again from those lines are the extract's,
    with the lines they sit at; and every record the extract holds is on a line the copy has (a shorter copy under an
    older genuine reply cannot pass). A refusal, no reply and a missing checker are NOT_CHECKED, never a pass."""
    asker = how.get("asker")
    who = asker or "the asker"
    what = f"{who}: the ledger extract is all its ledger held for the asks"
    gap = lambda why, issue=ledger_proof.ISSUE: ([], [{"what": what, "why": why, "issue": issue}])  # noqa: E731
    try:
        ck = load(attempt / f"{stem}{CHECKPOINT_SUFFIX}")
        reply, refusal = ck.get("reply"), ck.get("refusal")
    except (OSError, ValueError, AttributeError):
        if "asker" in how:  # a run that asked for checkpoints kept one for every ask
            return [f"{stem}{CHECKPOINT_SUFFIX} is missing or not readable"], []
        return [], []  # a run before loop#276: 08 names the gap it left (rederive_07_live)
    if ck.get("asker") != asker:
        return [f"{CHECKPOINT_SUFFIX} names asker {ck.get('asker')!r}, ask.json {asker!r}"], []
    if reply is None:
        return gap(f"the asker's node gave no checkpoint reply: {refusal}")
    node = next((n for n in pop["nodes"] if n["name"] == asker), None)
    if node is None:
        return gap(f"the asker's node is not named ({ASKER_UNNAMED}), so no listed key checks its checkpoint",
                   LOOP_ISSUE)
    try:
        key_id = step12.listed_entry(node)["key_id"]
    except (FileNotFoundError, KeyError, ValueError):
        return gap(f"{asker} has no nodes/ entry with a key", LOOP_ISSUE)
    copy = Path(out) / ASKER_LEDGER / asker / ledger_proof.CHAIN
    try:
        raw = copy.read_bytes()
    except OSError:
        return [f"the kept copy of {asker}'s ledger ({ASKER_LEDGER}/{asker}/{ledger_proof.CHAIN}) is missing"], []
    try:
        info, why = ledger_proof.check(raw, reply, key_id, ledger_proof.CHAIN)
    except FileNotFoundError:
        return gap("loop-ledger-check is not installed (steps/ledger-check.setup.sh)", LOOP_ISSUE)
    if why:
        return [f"{asker}'s ledger checkpoint does not show the kept copy whole: {why}"], []
    n = ledger_proof.covered(reply)
    errs = []
    try:  # the ask's own records were appended before the reply, so its cut is no earlier than the ask's minute
        if utc(info["cut"]) < sent_at.replace(second=0, microsecond=0):
            errs.append(f"the checkpoint was cut at {info['cut']}, before the ask was sent at {stamp(sent_at)}: an "
                        "older reply does not cover the ask")
    except (KeyError, ValueError, TypeError):
        errs.append("the checker named no checkpoint time")
    records = ask_records(copy.parent, ledger_proof.prefix(raw, n), numbered=True)
    found, got = select_ask(records, node_id, request, sent_at, back)
    for kind, picked in (("requests", found), ("outcomes", got)):
        if extract.get(kind) != json.loads(json.dumps(extract_rows(picked))):
            errs.append(f"picked again from the checkpointed copy, the ask's {kind} are not the extract's")
    stale = [r for r in [*extract.get("requests", []), *extract.get("outcomes", [])]
             if not isinstance(r, dict) or not isinstance(r.get("line"), int) or r["line"] >= n]
    if stale:
        errs.append(f"the extract holds a record at a line the checkpointed copy ({n} lines) does not reach")
    return errs, []


def backend(pop):
    return pop.get("ask") or ("reporter" if pop["population"] == "live" else "book")


def sealed_all(out):
    """Every reporter ask in `out` has its one sealed request read from the asker's ledger (<stem>.ledger.json)."""
    def one(request):
        try:
            return len(load(str(request)[:-len(".request.json")] + ".ledger.json").get("requests") or []) == 1
        except (OSError, ValueError, AttributeError):
            return False

    asks = list(Path(out).glob("*/attempts/*/*.request.json"))
    return bool(asks) and all(one(a) for a in asks)


def conclude(out, population, failures, not_checked, answered, proof, lines, started, which="book"):
    """Write first-answered.json and the finding: FAIL if a checked part did not hold, else NOT_CHECKED while any
    part is unchecked, else PASS."""
    out = Path(out)
    first = min(answered) if answered else None
    write_json(out / "first-answered.json",
               {"answered_at": stamp(first[0]) if first else None,
                "ask": first[1] if first else None,
                # whether this step read each request sealed in the asker's book: the book backend does; the
                # reporter backend does when every ask has its sealed record read from the asker's ledger
                "sealed": which == "book" or sealed_all(out)})
    proof = ["first-answered.json", *proof]
    result = "FAIL" if failures else ("NOT_CHECKED" if not_checked else "PASS")
    detail = f"ask backend: {which}. " + "; ".join(failures or lines) + "."
    pinned = PINNED_BOOK if which == "book" else PINNED_REPORTER
    return finding.write(out, result=result, population=population, asserts=ASSERTS, pinned=pinned, proof=proof,
                         detail=detail, not_checked=not_checked, started=started)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.strip().splitlines()[0])
    ap.add_argument("--population", required=True, type=Path)
    ap.add_argument("--out", required=True, type=Path)
    ap.add_argument("--console", default=os.environ.get("LOOP_CONSOLE", daily_report.DEFAULT_CONSOLE),
                    help="the reporter node's console, for the reporter backend")
    ap.add_argument("--console-data-dir", default=os.environ.get("LOOP_CONSOLE_DATA_DIR") or None,
                    help="the data dir of the node --console is (its ledger/capsules.jsonl holds the asker's sealed "
                         "records); default: the --self-node's data_dir in the population")
    ap.add_argument("--second-data-dir", default=os.environ.get("LOOP_SECOND_DATA_DIR") or None,
                    help="the data dir of the node --second-console is")
    ap.add_argument("--self-node", default=os.environ.get("LOOP_SELF_NODE") or None,
                    help="the population node whose console --console is; it is asked through --second-console")
    ap.add_argument("--second-console", default=os.environ.get("LOOP_SECOND_CONSOLE") or None,
                    help="another node's console, to ask the self node through")
    ap.add_argument("--second-node", default=os.environ.get("LOOP_SECOND_NODE") or None,
                    help="the population node whose console --second-console is: the key its ledger checkpoints are "
                         "checked under")
    a = ap.parse_args(argv)
    started = finding.now()
    pop = load(a.population / "population.json")
    a.out.mkdir(parents=True, exist_ok=True)
    which = backend(pop)
    if which == "book":
        with tempfile.TemporaryDirectory(prefix="07-ask-") as tmp:
            failures, not_checked, answered, proof, lines = run_book(pop, a.out, tmp)
    elif which == "reporter":
        if a.self_node and a.self_node not in [n["name"] for n in pop["nodes"]]:
            print(f"07-ask: --self-node {a.self_node!r} is not a node in the population "
                  f"({', '.join(n['name'] for n in pop['nodes'])})", file=sys.stderr)
            return 2
        failures, not_checked, answered, proof, lines = run_reporter(pop, a.out, a.console, self_node=a.self_node,
                                                                     second_console=a.second_console,
                                                                     console_data_dir=a.console_data_dir,
                                                                     second_data_dir=a.second_data_dir,
                                                                     second_node=a.second_node)
    else:
        print(f"07-ask: unknown ask backend {which!r}", file=sys.stderr)
        return 2
    r = conclude(a.out, pop["population"], failures, not_checked, answered, proof, lines, started, which)
    print(f"07-ask: {r['result']}: {r['detail']}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
