# ~/.config/loop-reporter/env on the reporter node, read by the daily and the
# rehearsal unit. A node can't be asked through its own console, so the reporter
# asks its own node through another lab node's console.
# The reporter node's own mesh-llm console, required by scripts/refresh_now.sh
# (the units default to 127.0.0.1:3131 and this file overrides that; the script
# itself never assumes mesh-llm's 3131):
LOOP_CONSOLE=http://127.0.0.1:<the reporter node's console port>
# Another lab node's mesh-llm console (not the reporter's own):
LOOP_SECOND_CONSOLE=http://127.0.0.1:<that node's console port>
# The reporter's label in population/live/population.json; checked against
# reporter.json's node_id. Optional.
LOOP_SELF_NODE=<the reporter node's label>
